@inherits LayoutComponentBase
@using demoVer.Shared
@using System
@using System.Threading.Tasks
@rendermode InteractiveServer
@inject IJSRuntime JS
<CascadingValue Value="this" Name="MainLayout">
    <CascadingValue Value="IsDarkTheme" Name="IsDarkTheme">
        <div class="page" @onclick="HandleGlobalClick">
            <main>
                <TopRow @ref="_topRow"
                        OnSendToParent="HandleTopRowEditModeChanged"
                        InformParentTo_OpenAddCard="HandleTopRowRequestOpenAddCard"
                        InformParentTo_SaveCardsInfo="HandleTopRowRequestSaveCardsInfo"
                        InformParentTo_ApplySetting="HandleTopRowRequestApplySetting"
                        InformParentTo_UseDefaultValue="HandleTopRowRequestUseDefaultValue" />

                <!-- ✅ 確保 @Body 在 CascadingValue 裡 -->
                <div class="content">
                    @Body
                </div>

                <BottomRow @ref="_bottomRow" />
            </main>
        </div>

        <div id="blazor-error-ui">
            An unhandled error has occurred.
            <a href="" class="reload">Reload</a>
            <a class="dismiss">🗙</a>
        </div>
    </CascadingValue>
</CascadingValue>


@code {
    //以下是 以MainLayout 為中介，讓 TopRow 與各 Page 溝通的相關程式碼
    private TopRow? _topRow;
    private BottomRow? _bottomRow;
    private object? _topRowCallbacksOwner;
    private Func<bool, Task>? _onSendToParent;
    private Func<Task>? _onOpenAddCard;
    private Func<Task>? _onSaveCardsInfo;
    private Func<Task>? _onApplySetting;
    private Func<Task>? _onUseDefaultValue;

    public bool IsDarkTheme { get; private set; } = true; // 默認暗色主題

    public void HideMenu()
    {
        _topRow?.HideMenu();
        _bottomRow?.HideMenu();
    }

    public void HideNotifications()
    {
        _topRow?.CloseNotifications();
    }

    private void HandleGlobalClick()
    {
        Console.WriteLine("Global click");
        HideMenu();
        HideNotifications();
    }
    public async Task ToggleTheme()
    {
        IsDarkTheme = !IsDarkTheme;
        await JS.InvokeVoidAsync("setThemePreference", IsDarkTheme);
        
        // 直接切換頁面主題
        if (IsDarkTheme)
        {
            await JS.InvokeVoidAsync("document.body.classList.remove", "theme-light");
        }
        else
        {
            await JS.InvokeVoidAsync("document.body.classList.add", "theme-light");
        }

        // 重新渲染所有圖表以應用新主題
        await JS.InvokeVoidAsync("redrawAllCharts");
        
        StateHasChanged(); // 通知子組件主題已改變
    }

    public void RegisterTopRowCallbacks(
        object owner,
        Func<bool, Task>? onSendToParent = null,
        Func<Task>? informParentToOpenAddCard = null,
        Func<Task>? informParentToSaveCardsInfo = null,
        Func<Task>? informParentToApplySetting = null,
        Func<Task>? informParentToUseDefaultValue = null)
    {
        _topRowCallbacksOwner = owner;
        _onSendToParent = onSendToParent;
        _onOpenAddCard = informParentToOpenAddCard;
        _onSaveCardsInfo = informParentToSaveCardsInfo;
        _onApplySetting = informParentToApplySetting;
        _onUseDefaultValue = informParentToUseDefaultValue;
    }

    public void ClearTopRowCallbacks(object owner)
    {
        if (!ReferenceEquals(_topRowCallbacksOwner, owner))
        {
            return;
        }

        ResetTopRowCallbacks();
    }

    private void ResetTopRowCallbacks()
    {
        _topRowCallbacksOwner = null;
        _onSendToParent = null;
        _onOpenAddCard = null;
        _onSaveCardsInfo = null;
        _onApplySetting = null;
        _onUseDefaultValue = null;
    }

    private async Task HandleTopRowEditModeChanged(bool isEditing)
    {
        if (_onSendToParent != null)
        {
            await _onSendToParent.Invoke(isEditing);
        }
    }

    private async Task HandleTopRowRequestOpenAddCard()
    {
        if (_onOpenAddCard != null)
        {
            await _onOpenAddCard.Invoke();
        }
    }

    private async Task HandleTopRowRequestSaveCardsInfo()
    {
        if (_onSaveCardsInfo != null)
        {
            await _onSaveCardsInfo.Invoke();
        }
    }

    private async Task HandleTopRowRequestApplySetting()
    {
        if (_onApplySetting != null)
        {
            await _onApplySetting.Invoke();
        }
    }

    private async Task HandleTopRowRequestUseDefaultValue()
    {
        if (_onUseDefaultValue != null)
        {
            await _onUseDefaultValue.Invoke();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // 從 localStorage 讀取主題偏好
            var storedTheme = await JS.InvokeAsync<string>("getThemePreference");
            if (!string.IsNullOrEmpty(storedTheme))
            {
                IsDarkTheme = storedTheme == "dark";
                
                // 直接應用主題
                if (IsDarkTheme)
                {
                    await JS.InvokeVoidAsync("document.body.classList.remove", "theme-light");
                }
                else
                {
                    await JS.InvokeVoidAsync("document.body.classList.add", "theme-light");
                }
                
                StateHasChanged(); // 讓頁面更新
            }
        }
    }
}
