    private void addCard(CardType selection)
    {
        if(!CardDefinitionRegistry.TryGet(selection, out var definition))
        {
            Console.WriteLine($"[addCard] No definition found for {selection}");
            return;
        }

        var newCard = definition!.CreateDefaultCard();
        newCard.card_Type = definition.CardType;
        newCard.widthClass ??= definition.DefaultWidthClass;
        newCard.ID = Guid.NewGuid().ToString("N");
        newCard.showSequence = (byte)CardInfos.Count;

        Console.WriteLine("[addCard][1]");
        CardInfos.Add(newCard);
        Console.WriteLine("[addCard][2]");
        afterAddCard_Flag = true;
        StateHasChanged();
        CloseModal();

    }

