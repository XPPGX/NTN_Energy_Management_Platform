    private const string DefaultCardThumbnail = "images/cardSelection-default.png";

    private static string ResolveDisplayName(ICardDefinition definition) =>
        string.IsNullOrWhiteSpace(definition.DisplayName) ? definition.CardType.ToString() : definition.DisplayName;

    private static string ResolveThumbnail(ICardDefinition definition) =>
        string.IsNullOrWhiteSpace(definition.ThumbnailPath) ? DefaultCardThumbnail : definition.ThumbnailPath;

    private void HandleCardUpdate(CardInfo _updatedCard)
    {
        var index = CardInfos.FindIndex(c => c.ID == _updatedCard.ID);
        if(index != -1)
        {
            Console.WriteLine("[NTN_HOME] : Card.ID : " + _updatedCard.ID + " updated");
            CardInfos[index] = _updatedCard;
            
            if(_updatedCard.card_Type == CardType.Chart)
            {
                Notifier.Notify(_updatedCard.ID);
            }
        }
        
        

        Console.WriteLine("[NTN_HOME] CardInfos: ");
        string json = JsonSerializer.Serialize(CardInfos, new JsonSerializerOptions{
            WriteIndented = true
        });
        Console.WriteLine(json);
        CloseModal();
        StateHasChanged();
    }

    private async Task Read_CardInfos_FromJsonFile()
    {
         
        // string linuxPath = "/userdata/CMU3/UserSetting/5040/visibleCards.json";
        // var filePath = linuxPath;
        // var filePath = "visibleCards.json";
        string filePath = Path.Combine(dataCenter.get_basePath(), "visibleCards.json");

        try
        {
            string json = File.ReadAllText(filePath);
            var options = new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            };

            CardInfos = JsonSerializer.Deserialize<List<CardInfo>>(json, options) ?? new();
            CardInfos = CardInfos.OrderBy(c => c.showSequence).ToList();
            
            var CardInfos_jsonFormat = JsonSerializer.Serialize(CardInfos, new JsonSerializerOptions{
                WriteIndented = true
            });
            Console.WriteLine(CardInfos_jsonFormat);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"JSON read fail: {ex.Message}");
            CardInfos = new();
        }
    }

