@page "/Link_status"

@inject IDialogService DialogService
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject DataCenter DataCenter
@inject GlobalVar globalVar
@using demoVer.Components.Layout
@using System.Text.Json
@using demoVer.Models
@using demoVer.Utils
@inject HeartbeatService Heartbeat
@using demoVer.Interfaces
@inject IGroupsDataDecoder Decoder
<MudPopoverProvider/>
<PageTitle>Link Status</PageTitle>
<TopRow />

<div class="content-container">
    <div class="card-grid">
        <div class="w50">
            <div class="card-container">
                <MudChart ChartType="ChartType.Donut" Width="250px" Height="250px" LegendPosition="Position.Left" InputData="@data" InputLabels="@labels">
                    <CustomGraphics>
                        <text class="donut-inner-text" x="50%" y="35%" dominant-baseline="middle" text-anchor="middle" fill="black" font-family="Helvetica" font-size="20">Total</text>
                        <text class="donut-inner-text" x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" fill="black" font-family="Helvetica" font-size="50">@data.Sum().ToString()</text>
                    </CustomGraphics>
                </MudChart>
            </div>
        </div>

        <div class="w50">
            <div class="card-container">
                <MudTabs Rounded="true" Centered="false" @bind-ActivePanelIndex="@activeTabIndex" Class="mud-width-full"
                    PrevIcon="@Icons.Material.Filled.SkipPrevious" NextIcon="@Icons.Material.Filled.SkipNext">
                    @foreach (var group in TimelineGroups)
                    {
                        Console.WriteLine($"[Group] {group.StateName}: {group.Items?.Count} items");
                        foreach (var item in group.Items)
                        {
                            Console.WriteLine($"--> {item.Address}, {item.Message}, {item.Severity}, {item.Color}");
                        }
                        <MudTabPanel Text="@group.StateName">
                            <LinkStatusTimeline Items="@group.Items" IsMobile = "@IsMobile" deviceCheckCompleted = "@checkMobile_complete"/>
                        </MudTabPanel>
                    }
                </MudTabs>
            </div>
        </div>

        <div class="table-wrapper">
            <MudTable @ref="mudTable" Items="@Elements"
                    Dense="true" Hover="true" Striped="true"
                    RowClass="cursor-pointer" RowClassFunc="@SelectedRow_cssClassFunc" 
                    OnRowClick="@((TableRowClickEventArgs<Element> e) => RowClickEvent(e))">
                <HeaderContent>
                    <MudTh>Address</MudTh>
                    <MudTh>ModelName</MudTh>
                    <MudTh>LinkStatus</MudTh>
                    <MudTh>RunningState</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Address">@((context.Address == 9999) ? "N/A" : context.Address)</MudTd>
                    <MudTd DataLabel="ModelName">@context.ModelName</MudTd>
                    <MudTd DataLabel="LinkStatus">
                        @{
                            Color tempColor;
                            switch(context.LinkStatus)
                            {
                                case "Linked" :
                                    tempColor = Color.Success;
                                    break;
                                case "Error" :
                                    tempColor = Color.Error;
                                    break;
                                default :
                                    tempColor = Color.Default;
                                    break;
                            }
                            <MudChip T="string" Color="@tempColor" Size="Size.Small">
                                @context.LinkStatus
                            </MudChip>
                        }
                        
                    </MudTd>
                    <MudTd DataLabel="RunningState">@context.RunningState</MudTd>
                </RowTemplate>
                @* <FooterContent>
                    @if (Elements.Count < 10)
                    {
                        foreach (var _ in Enumerable.Range(0, 10 - Elements.Count))
                        {
                            <MudTr class="non-clickable-row">
                                <MudTd colspan="4" style="height: 40px; width: 25%; background-color: transparent;"></MudTd>
                            </MudTr>
                        }
                    }
                </FooterContent> *@
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </div>
    </div>
    @if(modal_IsOpen)
    {
        <div @ref="jumpWindow" class="modal-overlay" @onclick="CloseModal">
            @if(InfoCard_isOpen)
            {
                <div class="info-card" @onclick:stopPropagation>
                    <div class="card-title" id="Address"></div>
                    <div class="card-body">
                        <div class="info-item">
                            <span class="label">ModelName</span>
                            <span class="value" id="modelname-display"></span>
                        </div>
                        <div class="info-item">
                            <span class="label">Revision:</span>
                            <span class="value" id="Revision-display"></span>
                        </div>
                        <div class="info-item">
                            <span class="label">Status:</span>
                            <span class="value" id="InvSetting-display"></span>
                        </div>
                        <div class="info-item">
                            <span class="label">Load Current:</span>
                            <span class="value" id="Load_Current"></span>
                        </div>
                        <div class="info-item">
                            <span class="label">Load Power:</span>
                            <span class="value" id="Load_Power"></span>
                        </div>
                        <div class="info-item">
                            <span class="label">DC current:</span>
                            <span class="value" id="DC_Current"></span>
                        </div>
                        <div class="info-item">
                            <span class="label">Battery Voltage:</span>
                            <span class="value" id="V_BAT"></span>
                        </div>
                        <div class="info-item">
                            <span class="label">Temperature:</span>
                            <span class="value" id="Temperature_display"></span>
                        </div>
                        <div class="info-item">
                            <span class="label">FAN SPEED 1:</span>
                            <span class="value" id="FAN_SPEED_1"></span>
                        </div>
                        <div class="info-item">
                            <span class="label">FAN SPEED 2</span>
                            <span class="value" id="FAN_SPEED_2"></span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>


@code
{
    @* const uint STATUS_INV           = 0x00000001 << 0;
    const uint STATUS_BYP           = 0x00000001 << 1;
    const uint STATUS_UTI_OK        = 0x00000001 << 2;
    const uint STATUS_CHG           = 0x00000001 << 3;
    const uint STATUS_SOLAR_EN      = 0x00000001 << 4;
    const uint STATUS_SAVING        = 0x00000001 << 5;
    const uint STATUS_BAT_LOW_ALM   = 0x00000001 << 6; *@
    
    //for log
    private string _category;

    private uint[] _linkedSnapshot = Array.Empty<uint>();

    Queue<(uint addr, string status, DateTime date_time)> recent_RunningStatus = new();
    Queue<(uint addr, string status, DateTime date_time)> recent_ErrorStatus = new();

    private Dictionary<uint, string> allDevicesRunningStatus = new();
    private uint pageTimer_Cnt = 0;
    private MudTable<Element> mudTable;
    private int activeTabIndex = 0;
    private int selectedRowNumber = -1;

    private bool InfoCard_isOpen = false;
    private bool modal_IsOpen = false;
    private bool NotifyJS = false;
    private uint selectedAddr = 0;
    private ElementReference jumpWindow;
    private bool IsMobile = false;
    private bool checkMobile_complete = false;
    public class Element
    {
        public uint Address {get; set;}
        public string ModelName {get; set;}
        public string LinkStatus {get; set;}
        public string RunningState {get; set;}
    }

    protected override async Task OnInitializedAsync()
    {
        _category = GetType().FullName!;

        _linkedSnapshot = globalVar.LinkedDevices.SnapshotSorted();

        globalVar.LinkedDevices.linkChanged += OnLinksChanged;

        getINVsLink();
        UpdateDonutChart();
        summarizeDevicesStatus_Timeline();
        await InvokeAsync(StateHasChanged);     
    }

    private void OnLinksChanged()
    {
        _linkedSnapshot = globalVar.LinkedDevices.SnapshotSorted();
    }



    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            @* await JS.InvokeVoidAsync("startSignalR"); *@
            Heartbeat.OnTick += pageTimer;
            IsMobile = await JS.InvokeAsync<bool>("checkIsMobile");
            checkMobile_complete = true;
            await InvokeAsync(StateHasChanged);
        }
        if(modal_IsOpen && !NotifyJS && jumpWindow.Context != null)
        {
            NotifyJS = true;
            @* await JS.InvokeVoidAsync("subscribeCommands_fixedCommand_dynamicAddr", SubscribeCommands, selectedAddr); *@
        }
    }

    private void CloseModal()
    {   
        //close modal
        modal_IsOpen = false;
        InfoCard_isOpen = false;
        CancelAllSubscriptions();
    }

    private void getINVsLink()
    {
        var addrs = _linkedSnapshot;

        //取得當前的有連線的addr Set
        Console.Write("Current Linking Model addr : { ");
        @* foreach(var addr in globalVar.Device_ReadData.GetLinkAddressesSnapShot())
        {
            Console.Write(addr + ", ");
        }
        Console.WriteLine("\n}"); *@
        
        foreach (var addr in addrs)
        {
            Console.Write(addr + ", ");
        }
        Console.WriteLine("\n}");

        //traverse MOD_DATA，取出各Addr對應的當前modelName跟Status
        
        Elements = new List<Element>();


        @* foreach(var addr in globalVar.Device_ReadData.GetLinkAddressesSnapShot()) *@
        foreach(var addr in addrs)
        {
            //string modelName = decode_ModelName(addr);
            //string runningStatus = decode_INV_Status(addr);
            Group_CommandRawData tmp_Group = globalVar.Device_ReadData.GetCommandGroups(addr, "MFR_MODEL"); 
            var modelName = Decoder.Decode(tmp_Group, "MFR_MODEL")?.ToString() ?? "N/A";
            string runningStatus = decode_INV_Status(addr);

            Console.WriteLine($"Addr = {addr}, ModelName = {modelName}, LinkStatus = Linked, runningStatus = {runningStatus}");
            
            Elements.Add(new Element
            {
                Address = addr,
                ModelName = modelName.ToString(),
                LinkStatus = "Linked",
                RunningState = runningStatus,
            });

            if(!allDevicesRunningStatus.ContainsKey(addr))
            {
                allDevicesRunningStatus[addr] = runningStatus;
                AddStatus(addr, runningStatus);
            }
            else if(allDevicesRunningStatus[addr] != runningStatus)
            {
                allDevicesRunningStatus[addr] = runningStatus;
                AddStatus(addr, runningStatus);
            }
        }
        
        int paddingCount = 10 - (Elements.Count % 10);
        Console.WriteLine($"Element.Count = {Elements.Count}, paddingCount = {paddingCount}");
        for(int i = 0 ; i < paddingCount ; i ++)
        {
            Elements.Add(new Element{
                Address = 9999,
                ModelName = "N/A",
                LinkStatus = "N/A",
                RunningState = "N/A",
            });
        }
    }

    private List<Element> Elements = new List<Element>()
    {
        @* new Element() { Address = 0, ModelName = "NTN-5K-1481231", LinkStatus = "Linked", RunningState = "ByPass" }, *@
        
    };
    
    public double[] data = {};
    public string[] labels = { "Error", "Saving", "Inverter", "Bypass", "Charger", "Standby" };
    public Dictionary<string, int> mapLabelsToData = new Dictionary<string, int>{
        {"Error",       0},
        {"Saving",      1},
        {"Inverter",    2},
        {"Bypass",      3},
        {"Charger",     4},
        {"Standby",     5},
    };

    private List<RunningStateTimelineGroup> TimelineGroups = new()
    {
        new()
        {
            StateName = "Running",
            Items = new()
            {
                @* new() { Address = 1, Message = "設備 1 運行中", Timestamp = DateTime.Now.AddMinutes(-5), Severity = Severity.Success, Color = Color.Success },
                new() { Address = 2, Message = "設備 2 正常", Timestamp = DateTime.Now.AddMinutes(-2), Severity = Severity.Info, Color = Color.Primary },
                new() { Address = 3, Message = "設備 3 正常", Timestamp = DateTime.Now.AddMinutes(4), Severity = Severity.Info, Color = Color.Primary } *@
            }
        },
        new()
        {
            StateName = "Error",
            Items = new()
            {
                @* new() { Address = 3, Message = "設備 3 過熱", Timestamp = DateTime.Now.AddMinutes(-3), Severity = Severity.Error, Color = Color.Error },
                new() { Address = 4, Message = "設備 4 通訊中斷", Timestamp = DateTime.Now.AddMinutes(-1), Severity = Severity.Warning, Color = Color.Warning } *@
            }
        }
    };

    private async void RowClickEvent(TableRowClickEventArgs<Element> args)
    {
        @* Elements.Where(e => e.LinkStatus != "Linked" || e.RunningState == "Error") *@
        if(args.Item == null)
        {
            return;
        }
        
        try
        {
            AppLogger.Log_To_File_log(_category, $"[Link_status.razor][RowClickEvent] : selectedAddr = {args.Item.Address}", AppLogLevel.Debug);

            selectedAddr = args.Item.Address;

            Console.WriteLine($"Row clicked : {selectedAddr}");
            mudTable.SetSelectedItem(args.Item); // <-- 關鍵這一行
            
            modal_IsOpen = true;
            InfoCard_isOpen = true;
            NotifyJS = false;

            await JS.InvokeVoidAsync("DataSocket");
            await JS.InvokeVoidAsync("subscribeGroup_fixedCommands_dynamicAddr", SubscribeCommands, selectedAddr);
        }
        catch(Exception ex)
        {
            AppLogger.Log_To_File_log(_category, $"[Link_status.razor][RowClickEvent] : Error, {ex}", AppLogLevel.Error);
        }
        
        
        @* await JS.InvokeVoidAsync("startSignalR"); *@
        @* await JS.InvokeVoidAsync("subscribeCommands_fixedCommand_dynamicAddr", SubscribeCommands, selectedAddr); *@
        
    }


    private string SelectedRow_cssClassFunc(Element element, int rowNumber)
    {
        var result = mudTable?.SelectedItem == element ? "selected" : string.Empty;
        Console.WriteLine($"RowClassFunc → Address={element.Address}, Class={result}");
        return result;

        @* Color="Color.Success"Severity="Severity.Success" *@
    }
    

    private readonly string[] SubscribeCommands = new[]
    {
        //Table Info
        "MFR_MODEL",
        "INV_STATUS",
        "INV_FAULT",
        "MFR_REVISION_B0B5",
        //Modal Info
        "READ_FAN_SPEED_1",
        "READ_FAN_SPEED_2",
        "READ_AC_VOUT",
        "READ_OP_VA",
        "READ_CHG_CURR",
        "READ_VBAT",
        "READ_TEMPERATURE_1",
    };

    private void UpdateDonutChart()
    {
        Console.WriteLine($"[UpdateDonutChart]");
        double[] new_data = new double[6];
        foreach(var device in Elements)
        {
            Console.WriteLine($"addr = {device.Address}, status = {device.RunningState}");
            if(device.RunningState == "N/A"){continue;}
            new_data[mapLabelsToData[device.RunningState]] ++;
        }
        foreach(var val in new_data)
        {
            Console.Write(val + ",");
        }
        data = new_data;
    }

    

    public async Task pageTimer()
    {
        if(modal_IsOpen) return;

        if(pageTimer_Cnt >= 3)
        {
            pageTimer_Cnt = 0;
            await InvokeAsync(() => 
            {
                getINVsLink();
                UpdateDonutChart();
                summarizeDevicesStatus_Timeline();
                StateHasChanged();
            });
        }
        else
        {
            pageTimer_Cnt ++;
        }
    }
    public void Dispose()
    {
        Heartbeat.OnTick -= pageTimer;
        globalVar.LinkedDevices.linkChanged -= OnLinksChanged;
        Console.WriteLine($"Heartbeat 註冊 : {this.GetHashCode()}");
    }

    public async Task CancelAllSubscriptions()
    {
        //主動關閉dataHub()
        await JS.InvokeVoidAsync("unsubscribeAllGroups");
        @* await JS.InvokeVoidAsync("hubDisconnect"); *@
    }

    

