@* @page "/Link_status" *@


@rendermode InteractiveServer
@using System.Text.Json
@using System.Linq
@using Microsoft.AspNetCore.Components.Web
@using demoVer.Components.Layout
@using demoVer.Interfaces
@using demoVer.Models
@using demoVer.Utils

@inject IDialogService DialogService
@inject IJSRuntime JS
@inject DataCenter DataCenter
@inject GlobalVar globalVar
@inject LinkAddrManager linkAddrManager
@inject HeartbeatService Heartbeat
@inject IGroupsDataDecoder Decoder
@inject IStringLocalizer<SharedResource> Localizer
@inject SubSystemManager subsystemManager
@inject CodeTranslator codeTranslator

<MudPopoverProvider/>
<PageTitle>@Localizer["LinkStatus-PageTitle"]</PageTitle>

<div class="content-container">
    <div class="card-grid">
        <div class="w50">
            <div class="card-container card-container-base">
                <MudChart ChartType="ChartType.Donut" Width="250px" Height="250px" LegendPosition="Position.Left" InputData="@data" InputLabels="@labels">
                    <CustomGraphics>
                        <text class="donut-inner-text" x="50%" y="35%" dominant-baseline="middle" text-anchor="middle" fill="var(--text-primary)" font-family="Helvetica" font-size="20">@Localizer["LinkStatus-Total"]</text>
                        <text class="donut-inner-text" x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" fill="var(--text-primary)" font-family="Helvetica" font-size="50">@data.Sum().ToString()</text>
                    </CustomGraphics>
                </MudChart>
            </div>
        </div>

        <div class="w50">
            <div class="card-container card-container-base custom-tabs">
                <div class="custom-tabs-toolbar">
                    <div class="tab-list">
                        @for (var i = 0; i < TimelineGroups.Count; i++)
                        {
                            var index = i;
                            var group = TimelineGroups[index];
                            var isActive = activeTabIndex == index;
                            AppLogger.Log_To_File_log(_category, $"[LinkStatus][html] group = {group.StateName}: {group.Items?.Count} items", AppLogLevel.Trace);
                            <button type="button" class="custom-tab theme-tab @(isActive ? "active" : string.Empty)" @onclick="(() => SetActiveTab(index))">
                                @group.StateName
                            </button>
                        }
                    </div>
                </div>
                <div class="custom-tab-panel theme-tab-panel">
                    @if (TimelineGroups.Count > 0 && activeTabIndex >= 0 && activeTabIndex < TimelineGroups.Count)
                    {
                        var activeGroup = TimelineGroups[activeTabIndex];
                        <LinkStatusTimeline Items="@activeGroup.Items" IsMobile="@IsMobile" deviceCheckCompleted="@checkMobile_complete" />
                    }
                </div>
            </div>
        </div>

        <div class="table-wrapper">
            <div class="link-status-table-container">
                @if (!IsMobile)
                {
                    <table class="custom-table link-status-table">
                        <thead>
                            <tr>
                                <th>@Localizer["LinkStatus-Address"]</th>
                                <th>@Localizer["LinkStatus-ModelName"]</th>
                                <th>@Localizer["LinkStatus-LinkStatus"]</th>
                                <th>@Localizer["LinkStatus-RunningState"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (CurrentPageItems.Any())
                            {
                                foreach (var element in CurrentPageItems)
                                {
                                    <tr class="@GetRowClass(element)" @onclick="() => OnRowClick(element)">
                                        <td data-label="Address">@FormatAddress(element.Address)</td>
                                        <td data-label="ModelName">@element.ModelName</td>
                                        <td data-label="LinkStatus">
                                            <span class="status-pill @GetStatusClass(element.LinkStatus)">@element.LinkStatus</span>
                                        </td>
                                        <td data-label="RunningState">@element.RunningState</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr class="link-status-empty-row">
                                    <td colspan="4">@Localizer["LinkStatus-NoDeviceData"]</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="card-table link-status-card-table">
                        @if (CurrentPageItems.Any())
                        {
                            foreach (var element in CurrentPageItems)
                            {
                                <div class="card-table-row link-status-card-row @(selectedAddr == element.Address ? "selected" : string.Empty)" @onclick="() => OnRowClick(element)">
                                    <div class="card-table-item">
                                        <span class="card-table-label">@Localizer["LinkStatus-Address"]</span>
                                        <span class="card-table-value">@FormatAddress(element.Address)</span>
                                    </div>
                                    <div class="card-table-item">
                                        <span class="card-table-label">@Localizer["LinkStatus-ModelName"]</span>
                                        <span class="card-table-value">@element.ModelName</span>
                                    </div>
                                    <div class="card-table-item">
                                        <span class="card-table-label">@Localizer["LinkStatus-LinkStatus"]</span>
                                        <span class="card-table-value">
                                            <span class="status-pill @GetStatusClass(element.LinkStatus)">@element.LinkStatus</span>
                                        </span>
                                    </div>
                                    <div class="card-table-item">
                                        <span class="card-table-label">@Localizer["LinkStatus-RunningState"]</span>
                                        <span class="card-table-value">@element.RunningState</span>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="link-status-card-empty">@Localizer["LinkStatus-NoDeviceData"]</div>
                        }
                    </div>
                }

                <div class="link-status-pagination">
                    <button type="button" class="link-status-page-btn" @onclick="PreviousPage" disabled="@(!CanGoPrevious)">⟨</button>
                    <div class="link-status-page-info">
                        <div class="page_info_div">@Localizer["LinkStatus-Page"]</div>
                        <input type="number"
                               min="1"
                               max="@TotalPages"
                               class="link-status-page-input"
                               @bind="pageInput"
                               @bind:event="oninput"
                               @onkeydown="OnPageInputKeyDown"
                               @onblur="ResetPageInput" />
                        <div class="page_info_div">@Localizer["LinkStatus-Of"] @TotalPages</div>
                    </div>
                    <button type="button" class="link-status-page-btn" @onclick="NextPage" disabled="@(!CanGoNext)">⟩</button>
                </div>
            </div>
        </div>
    </div>
    @if(modal_IsOpen)
    {
        <div @ref="jumpWindow" class="modal-overlay" @onclick="CloseModal">
            @if(InfoCard_isOpen)
            {
                <div class="jumpInfo-card" @onclick:stopPropagation>
                    <div class="card-title" id="Address"></div>
                    <div class="card-body">
                        <div class="info-item">
                            <span class="label">@Localizer["LinkStatus-ModelNameLabel"]</span>
                            <span class="value" id="modelname-display"></span>
                        </div>
                        <div class="info-item">
                            <span class="label">@Localizer["LinkStatus-Revision"]</span>
                            <span class="value" id="Revision-display"></span>
                        </div>
                        <div class="info-item">
                            <span class="label">@Localizer["LinkStatus-Status"]</span>
                            <span class="value" id="InvSetting-display"></span>
                        </div>
                        <div class="info-item">
                            <span class="label">@Localizer["LinkStatus-Error"]</span>
                            <span class="value" id="ErrorMessage"></span>
                        </div>
                        <div class="info-item">
                            <span class="label">@Localizer["LinkStatus-LoadCurrent"]</span>
                            <span class="value" id="Load_Current"></span>
                        </div>
                        <div class="info-item">
                            <span class="label">@Localizer["LinkStatus-LoadPower"]</span>
                            <span class="value" id="Load_Power"></span>
                        </div>
                        <div class="info-item">
                            <span class="label">@Localizer["LinkStatus-DCCurrent"]</span>
                            <span class="value" id="DC_Current"></span>
                        </div>
                        <div class="info-item">
                            <span class="label">@Localizer["LinkStatus-BatteryVoltage"]</span>
                            <span class="value" id="V_BAT"></span>
                        </div>
                        <div class="info-item">
                            <span class="label">@Localizer["LinkStatus-Temperature"]</span>
                            <span class="value" id="Temperature_display"></span>
                        </div>
                        <div class="info-item">
                            <span class="label">@Localizer["LinkStatus-FanSpeed1"]</span>
                            <span class="value" id="FAN_SPEED_1"></span>
                        </div>
                        <div class="info-item">
                            <span class="label">@Localizer["LinkStatus-FanSpeed2"]</span>
                            <span class="value" id="FAN_SPEED_2"></span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>


@code
{
    [CascadingParameter(Name = "MainLayout")] public MainLayout? MainLayout { get; set; }
    
    //for log
    private string _category;

    private uint[] _linkedSnapshot = Array.Empty<uint>();

    Queue<(uint addr, string status, DateTime date_time)> recent_RunningStatus = new();
    Queue<(uint addr, string status, DateTime date_time)> recent_ErrorStatus = new();

    private Dictionary<uint, string> allDevicesRunningStatus = new();
    private uint pageTimer_Cnt = 0;
    private int activeTabIndex = 0;

    private bool InfoCard_isOpen = false;
    private bool modal_IsOpen = false;
    private bool NotifyJS = false;
    private uint selectedAddr = 0;
    private ElementReference jumpWindow;
    private bool IsMobile = false;
    private bool checkMobile_complete = false;
    private const int PageSize = 10;
    private int currentPage = 1;
    private int pageInput = 1;
    private bool topRowCallbacksRegistered = false;
    private List<string> SubscribeCmdCodes = new List<string>();
    private List<string> UserDefinedCmdNames = new List<string>();
    
    public class Element
    {
        public uint Address {get; set;}
        public string ModelName {get; set;}
        public string LinkStatus {get; set;}
        public string RunningState {get; set;}
    }

    protected override async Task OnInitializedAsync()
    {
        _category = GetType().FullName!;

        @* _linkedSnapshot = globalVar.LinkedDevices.SnapshotSorted(); *@
        _linkedSnapshot = linkAddrManager.SnapshotSorted();

        @* globalVar.LinkedDevices.linkChanged += OnLinksChanged; *@
        linkAddrManager.linkChanged += OnLinksChanged;

        // Initialize localized labels
        labels = new string[] { Localizer["LinkStatus-ErrorGroup"], Localizer["LinkStatus-Saving"], Localizer["LinkStatus-Inverter"], Localizer["LinkStatus-Bypass"], Localizer["LinkStatus-Charger"], Localizer["LinkStatus-Standby"] };
        mapLabelsToData = new Dictionary<string, int>{
            {"Error",       0},
            {"Saving",      1},
            {"Inverter",    2},
            {"Bypass",      3},
            {"Charger",     4},
            {"Standby",     5},
        };

        getINVsLink();
        UpdateDonutChart();
        summarizeDevicesStatus_Timeline();
        await InvokeAsync(StateHasChanged);     
    }

    protected override void OnParametersSet()
    {
        if (!topRowCallbacksRegistered && MainLayout != null)
        {
            MainLayout.RegisterTopRowCallbacks(this);
            topRowCallbacksRegistered = true;
        }
    }

    private void SetActiveTab(int index)
    {
        Console.WriteLine($"index = {index}, TimelineGroups.Count = {TimelineGroups.Count}");

        if (index < 0 || index >= TimelineGroups.Count)
        {
            return;
        }

        activeTabIndex = index;
    }

    private IEnumerable<Element> CurrentPageItems => Elements
        .Skip((Math.Max(currentPage, 1) - 1) * PageSize)
        .Take(PageSize);

    private int TotalPages => Elements.Count == 0 ? 1 : (int)Math.Ceiling(Elements.Count / (double)PageSize);

    private bool CanGoPrevious => Elements.Count > 0 && currentPage > 1;

    private bool CanGoNext => Elements.Count > 0 && currentPage < TotalPages;

    private string GetRowClass(Element element)
    {
        var classes = "link-status-row";
        if (selectedAddr != 0 && element.Address == selectedAddr)
        {
            classes += " selected";
        }

        return classes;
    }

    private static string FormatAddress(uint address) => address == 9999 ? "N/A" : address.ToString();

    private static string GetStatusClass(string status) => status switch
    {
        "Linked" => "status-linked",
        "Error" => "status-error",
        _ => "status-default",
    };

    private async Task PreviousPage()
    {
        if (!CanGoPrevious)
        {
            return;
        }

        await GoToPage(currentPage - 1);
    }

    private async Task NextPage()
    {
        if (!CanGoNext)
        {
            return;
        }

        await GoToPage(currentPage + 1);
    }

    private async Task GoToPage(int page)
    {
        if (Elements.Count == 0)
        {
            currentPage = 1;
            pageInput = 1;
            await InvokeAsync(StateHasChanged);
            return;
        }

        var clamped = Math.Clamp(page, 1, TotalPages);
        currentPage = clamped;
        pageInput = clamped;
        await InvokeAsync(StateHasChanged);
    }

    private void ResetPageInput()
    {
        pageInput = currentPage;
    }

    private async Task OnPageInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await GoToPage(pageInput);
        }
    }

    private void SyncPaginationAfterDataRefresh()
    {
        if (Elements.Count == 0)
        {
            currentPage = 1;
            pageInput = 1;

            if (selectedAddr != 0)
            {
                selectedAddr = 0;
            }

            Console.WriteLine("Current elements count is 0");
            return;
        }

        var totalPages = TotalPages;
        if (currentPage > totalPages)
        {
            currentPage = totalPages;
        }
        if (currentPage < 1)
        {
            currentPage = 1;
        }

        pageInput = currentPage;

        if (selectedAddr != 0 && !Elements.Any(e => e.Address == selectedAddr))
        {
            selectedAddr = 0;
        }
    }

    private void OnLinksChanged()
    {
        _linkedSnapshot = linkAddrManager.SnapshotSorted();
    }



    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Heartbeat.OnTick += pageTimer;
            IsMobile = await JS.InvokeAsync<bool>("checkIsMobile");
            checkMobile_complete = true;
            await InvokeAsync(StateHasChanged);
        }
        if(modal_IsOpen && !NotifyJS && jumpWindow.Context != null)
        {
            NotifyJS = true;
        }
    }

    private async Task CloseModal()
    {   
        //close modal
        modal_IsOpen = false;
        InfoCard_isOpen = false;
        await CancelAllSubscriptions();
    }

    private void getINVsLink()
    {
        var addrs = _linkedSnapshot;

        //取得當前的有連線的addr Set
        AppLogger.Log_To_File_log(_category, $"[Link_status][getINVsLink] Current Linking Model addr :", AppLogLevel.Trace);
        //AppLogger.Log_To_File_log(_category, $"{string.Join(", ", addrs)}", AppLogLevel.Trace);
        
        Elements = new List<Element>();
        
        foreach(var addr in addrs)
        {
            //1. 取 該addr 的 DeviceData快照
            var oneDeviceData_snapShot = globalVar.Real_Devices_ReadData.Get_oneDevice_DataSnapshot(addr);
            if(oneDeviceData_snapShot == null) continue;

            //2. 取 映射 FixedCmdName => FixedCmdCode => UserDefinedCmdName
            var UserDefCmdName = codeTranslator.Translate_FixedCmdName_To_UserDefinedName("MFR_MODEL", addr);
            if(UserDefCmdName is null)
            {
                AppLogger.Log_To_File_log(_category, $"[Link_status][getINVsLink] : Translate_FixedCmdName_To_UserDefinedName failed for addr {addr}, FixedCmdName = MFR_MODEL", AppLogLevel.Warning);
                continue;
            }

            //3. 取 ModelName的值
            var modelName = oneDeviceData_snapShot.parseCmdData(UserDefCmdName) ?? "N/A";
            
            //如果modelName收到空值，直接忽略這個連線
            if(string.IsNullOrEmpty(modelName.ToString()))
            {
                Console.WriteLine($"[Link_status][getINVsLink] modelName is null or empty, addr = {addr}");
                AppLogger.Log_To_File_log(_category, $"[Link_status][getINVsLink] : modelName is null or empty for addr {addr}", AppLogLevel.Warning);
                
                
                continue;
            }

            string runningStatus = string.Empty;
            runningStatus = decode_INV_Status(addr);
            
            AppLogger.Log_To_File_log(_category, $"[Link_status][getINVsLink] : Addr = {addr}, ModelName = {modelName}, LinkStatus = Linked, runningStatus = {runningStatus}", AppLogLevel.Trace);

            if(!mapLabelsToData.ContainsKey(runningStatus))
            {
                runningStatus = "Error";
            }

            Elements.Add(new Element
            {
                Address = addr,
                ModelName = modelName.ToString() ?? "Unknown",
                LinkStatus = "Linked",
                RunningState = runningStatus
            });
            
            if(!allDevicesRunningStatus.ContainsKey(addr))
            {
                allDevicesRunningStatus[addr] = runningStatus;
                AddStatus(addr, runningStatus);
            }
            else if(allDevicesRunningStatus[addr] != runningStatus)
            {
                allDevicesRunningStatus[addr] = runningStatus;
                AddStatus(addr, runningStatus);
            }
        }
        
        SyncPaginationAfterDataRefresh();
    }

    private List<Element> Elements = new List<Element>()
    {
        @* new Element() { Address = 0, ModelName = "NTN-5K-1481231", LinkStatus = "Linked", RunningState = "ByPass" }, *@
        
    };
    
    public double[] data = {};
    public string[] labels = new string[6];
    public Dictionary<string, int> mapLabelsToData = new Dictionary<string, int>();

    private List<RunningStateTimelineGroup> TimelineGroups = new()
    {
        new()
        {
            StateName = "Running",
            Items = new()
            {
                @* new() { Address = 1, Message = "設備 1 運行中", Timestamp = DateTime.Now.AddMinutes(-5), Severity = Severity.Success, Color = Color.Success },
                new() { Address = 2, Message = "設備 2 正常", Timestamp = DateTime.Now.AddMinutes(-2), Severity = Severity.Info, Color = Color.Primary },
                new() { Address = 3, Message = "設備 3 正常", Timestamp = DateTime.Now.AddMinutes(4), Severity = Severity.Info, Color = Color.Primary } *@
            }
        },
        new()
        {
            StateName = "Error",
            Items = new()
            {
                @* new() { Address = 3, Message = "設備 3 過熱", Timestamp = DateTime.Now.AddMinutes(-3), Severity = Severity.Error, Color = Color.Error },
                new() { Address = 4, Message = "設備 4 通訊中斷", Timestamp = DateTime.Now.AddMinutes(-1), Severity = Severity.Warning, Color = Color.Warning } *@
            }
        }
    };

    private async Task OnRowClick(Element element)
    {
        if (element == null || element.Address == 9999 || string.Equals(element.LinkStatus, "N/A", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        try
        {
            AppLogger.Log_To_File_log(_category, $"[Link_status][OnRowClick] : selectedAddr = {element.Address}", AppLogLevel.Trace);

            selectedAddr = element.Address;
            modal_IsOpen = true;
            InfoCard_isOpen = true;
            NotifyJS = false;
            
            bool Is_GetMapping_Success = get_UserDefCmdNames_By_Mapping(selectedAddr);
            if(Is_GetMapping_Success is false)
            {
                AppLogger.Log_To_File_log(_category, $"[Link_status][OnRowClick] : get_UserDefCmdNames_By_Mapping failed for addr {selectedAddr}", AppLogLevel.Warning);
                return;
            }
            else
            {
                await JS.InvokeVoidAsync("DataSocket");
                await JS.InvokeVoidAsync("subscribeGroup_fixedCommands_dynamicAddr", UserDefinedCmdNames, selectedAddr);
            }
        }
        catch(Exception ex)
        {
            AppLogger.Log_To_File_log(_category, $"[Link_status][OnRowClick] : Error, {ex}", AppLogLevel.Error);
        }
    }
    
    //FixedCmdNames
    //預計用這個 FixedCmdNames => FixedCmdCodes => UserDefined CmdNames
    private readonly string[] SubscribeCommands = new[]
    {
        "MFR_MODEL",
        "INV_STATUS",
        "INV_FAULT",
        "MFR_REVISION_B0B5",
        "READ_FAN_SPEED_1",
        "READ_FAN_SPEED_2",
        "READ_AC_VOUT",
        "READ_OP_VA",
        "READ_CHG_CURR",
        "READ_VBAT",
        "READ_TEMPERATURE_1",
    };

    private bool get_UserDefCmdNames_By_Mapping(uint addr)
    {
        try
        {
            //1. 判斷addr屬於哪個 子系統
            var (port, protocol) = subsystemManager.Mapping_Addr_To_SubSys.GetValueOrDefault(addr.ToString(), ("", ""));
            if(string.IsNullOrEmpty(port) || string.IsNullOrEmpty(protocol))
            {
                AppLogger.Log_To_File_log(_category, $"[Link_status][get_UserDefCmdNames_By_Mapping] : addr {addr} has no SubSystem mapping", AppLogLevel.Warning);
                return false;
            }
            var clearPort = Custom.getPort_ExceptFor_Num(port); //Just "CAN" or "MOD"

            //2. 根據port取出對應的 CmdCodes
            Console.WriteLine("clearPort = " + clearPort);
            if(GlobalVar.HardCodes.TryGetValue(clearPort, out Dictionary<string, string>? cmdCodeDict))
            {
                SubscribeCmdCodes.Clear();
                foreach(var cmdName in SubscribeCommands)
                {
                    if(cmdCodeDict.TryGetValue(cmdName, out var cmdCode))
                    {
                        SubscribeCmdCodes.Add(cmdCode);
                    }
                }
            }
            else
            {
                AppLogger.Log_To_File_log(_category, $"[Link_status][get_UserDefCmdNames_By_Mapping] : port {clearPort} has no HardCode mapping", AppLogLevel.Warning);
                return false;
            }
            
            //3. 取出addr所屬的子系統
            var subSystem = subsystemManager.GetOneSubSystem_Ref(port, protocol);
            if(subSystem is null)
            {
                AppLogger.Log_To_File_log(_category, $"[Link_status][get_UserDefCmdNames_By_Mapping] : addr {addr} has no SubSystem instance", AppLogLevel.Warning);
                return false;
            }

            //4. 根據CmdCodes 取出對應子系統中的 UserDefined CmdNames
            UserDefinedCmdNames.Clear();
            foreach (var cmdCode in SubscribeCmdCodes)
            {
                var cmdName = subSystem.Get_UserDefined_CmdName_By_CmdCode(cmdCode);
                if(string.IsNullOrEmpty(cmdName))
                {
                    //紀錄log並跳過
                    AppLogger.Log_To_File_log(_category, $"[Link_status][get_UserDefCmdNames_By_Mapping] : cmdCode {cmdCode} has no UserDefined CmdName mapping in SubSystem", AppLogLevel.Warning);
                }
                else
                {
                    //加入清單
                    UserDefinedCmdNames.Add(cmdName);
                }
            }

            //[Debug]
            foreach(var cmdName in UserDefinedCmdNames)
            {
                AppLogger.Log_To_File_log(_category, $"[Link_status][get_UserDefCmdNames_By_Mapping] : addr {addr}, UserDefCmdName = {cmdName}", AppLogLevel.Debug);
            }
            return true;
        }
        catch(Exception ex)
        {
            AppLogger.Log_To_File_log(_category, $"[Link_status][get_UserDefCmdNames_By_Mapping] : Error, {ex}", AppLogLevel.Error);
            return false;
        }
    }

    private void UpdateDonutChart()
    {
        double[] new_data = new double[6];
        foreach(var device in Elements)
        {
            AppLogger.Log_To_File_log(_category, $"[LinkStatus][UpdateDonutChart] addr = {device.Address}, status = {device.RunningState}", AppLogLevel.Debug);
            if(device.RunningState == "N/A"){continue;}
            new_data[mapLabelsToData[device.RunningState]] ++;
        }
        data = new_data;
    }

    

    public async Task pageTimer()
    {
        if(modal_IsOpen) return;

        if(pageTimer_Cnt >= 3)
        {
            pageTimer_Cnt = 0;
            await InvokeAsync(() => 
            {
                getINVsLink();
                UpdateDonutChart();
                summarizeDevicesStatus_Timeline();
                StateHasChanged();
            });
        }
        else
        {
            pageTimer_Cnt ++;
        }
    }
    public void Dispose()
    {
        Heartbeat.OnTick -= pageTimer;
        linkAddrManager.linkChanged -= OnLinksChanged;
        @* globalVar.LinkedDevices.linkChanged -= OnLinksChanged; *@
        Console.WriteLine($"Heartbeat 註冊 : {this.GetHashCode()}");
        if (topRowCallbacksRegistered)
        {
            MainLayout?.ClearTopRowCallbacks(this);
            topRowCallbacksRegistered = false;
        }
    }

    public async Task CancelAllSubscriptions()
    {
        //主動關閉dataHub()
        await JS.InvokeVoidAsync("unsubscribeAllCmds");
        @* await JS.InvokeVoidAsync("hubDisconnect"); *@
    }

    private string decode_INV_Status(uint addr)
    {
        //取得addr的DeviceData快照
        var oneDeviceData_SnapShot = globalVar.Real_Devices_ReadData.Get_oneDevice_DataSnapshot(addr);
        if(oneDeviceData_SnapShot == null) {
            AppLogger.Log_To_File_log(_category, $"[Link_status][decode_INV_Status] : oneDeviceData_SnapShot is null, addr = {addr}", AppLogLevel.Warning);
            return "N/A";
        }
        
        //取得addr的 FixedCmdName(INV_FAULT) => FixedCmdCode => UserDefinedCmdName
        var INV_FAULT_UserDefCmdName = codeTranslator.Translate_FixedCmdName_To_UserDefinedName("INV_FAULT", addr);
        if(INV_FAULT_UserDefCmdName is null)
        {
            AppLogger.Log_To_File_log(_category, $"[Link_status][decode_INV_Status] : Translate_FixedCmdName_To_UserDefinedName failed for addr {addr}, FixedCmdName = INV_FAULT", AppLogLevel.Warning);
            return "N/A";
        }
        //取得addr的 INV_FAULT解碼內容
        var INV_FAULT_rawValue = oneDeviceData_SnapShot.parseCmdData(INV_FAULT_UserDefCmdName);
        if(INV_FAULT_rawValue == null) {
            AppLogger.Log_To_File_log(_category, $"[Link_status][decode_INV_Status] : INV_FAULT_rawValue is null, addr = {addr}", AppLogLevel.Warning);
            return "N/A";
        }
        if(BitFieldParser.Is_Any_INV_FAULT_By_rawValue(INV_FAULT_rawValue))
        {
            return "Error";
        }
        
        //取得addr的 FixedCmdName(INV_STATUS) => FixedCmdCode => UserDefinedCmdName
        var INV_STATUS_UserDefCmdName = codeTranslator.Translate_FixedCmdName_To_UserDefinedName("INV_STATUS", addr);
        if(INV_STATUS_UserDefCmdName is null)
        {
            AppLogger.Log_To_File_log(_category, $"[Link_status][decode_INV_Status] : Translate_FixedCmdName_To_UserDefinedName failed for addr {addr}, FixedCmdName = INV_STATUS", AppLogLevel.Warning);
            return "N/A";
        }
        //取得addr的 INV_STATUS解碼內容
        var INV_STATUS_rawValue = oneDeviceData_SnapShot.parseCmdData(INV_STATUS_UserDefCmdName);
        if(INV_STATUS_rawValue == null)
        {
            AppLogger.Log_To_File_log(_category, $"[Link_status][decode_INV_Status] : INV_STATUS_rawValue is null, addr = {addr}", AppLogLevel.Warning);
            return "N/A";
        }
        string INV_STATUS_str = BitFieldParser.parse_INV_STATUS_By_rawValue(INV_STATUS_rawValue);
        if(string.IsNullOrEmpty(INV_STATUS_str))
        {
            AppLogger.Log_To_File_log(_category, $"[Link_status][decode_INV_Status] : INV_STATUS_str is null or empty, addr = {addr}", AppLogLevel.Warning);
            return "Error";
        }
        
        return INV_STATUS_str;
    }

    private void AddStatus(uint addr, string status)
    {
        if(status == "Error")
        {
            recent_ErrorStatus.Enqueue((addr, status, DateTime.Now));
            if(recent_ErrorStatus.Count > 3)
            {
                recent_ErrorStatus.Dequeue();
            }
        }
        else
        {
            recent_RunningStatus.Enqueue((addr, status, DateTime.Now));
            if(recent_RunningStatus.Count > 3)
            {
                recent_RunningStatus.Dequeue();
            }
        }
    }
    
    private string ShortenStatus(string status)
    {
        if(IsMobile)
        {
            return status switch
            {
                "Inverter" => "INV",
                "Bypass" => "BYP",
                "Charger" => "CHG",
                "Saving" => "SAV",
                "Standby" => "STB",
                _ => status,
            };
        }
        else
        {
            return status;
        }
    }

    private void summarizeDevicesStatus_Timeline()
    {
        List<RunningStateTimelineItem> temp_TimelineItem_list_running   = new();
        List<RunningStateTimelineItem> temp_TimelineItem_list_error     = new();
        
        foreach(var tempItem in recent_RunningStatus)
        {
            temp_TimelineItem_list_running.Add(new RunningStateTimelineItem()
            {
                Address = tempItem.Item1,
                Message = Localizer["LinkStatus-DeviceStatus", tempItem.Item1, ShortenStatus(tempItem.Item2)],
                Timestamp = tempItem.Item3,
                Severity = Severity.Info,
                Color = Color.Primary,
            });
        }
        var group_run = TimelineGroups.FirstOrDefault(g => g.StateName == Localizer["LinkStatus-Running"] || g.StateName == "Running");
        if(group_run != null)
        {
            group_run.StateName = Localizer["LinkStatus-Running"];
            group_run.Items = temp_TimelineItem_list_running;
        }

        foreach(var tempItem in recent_ErrorStatus)
        {
            temp_TimelineItem_list_error.Add(new RunningStateTimelineItem()
            {
                Address = tempItem.Item1,
                Message = Localizer["LinkStatus-DeviceError", tempItem.Item1],
                Timestamp = tempItem.Item3,
                Severity = Severity.Info,
                Color = Color.Default,
                @* Color = Color.Primary, *@
            });
        }
        
        var group_err = TimelineGroups.FirstOrDefault(g => g.StateName == Localizer["LinkStatus-ErrorGroup"] || g.StateName == "Error");
        if(group_err != null)
        {
            group_err.StateName = Localizer["LinkStatus-ErrorGroup"];
            group_err.Items = temp_TimelineItem_list_error;
        }
    }

    
