@page "/Link_status"

@inject IDialogService DialogService
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject DataCenter DataCenter
@using demoVer.Components.Layout
@using System.Text.Json
@using demoVer.Models
@using demoVer.Utils
<MudPopoverProvider/>
<PageTitle>Link Status</PageTitle>
<TopRow />

<div class="content-container">
    <div class="card-grid">
        <div class="w50">
            <div class="card-container">
                <MudChart ChartType="ChartType.Donut" Width="250px" Height="250px" LegendPosition="Position.Left" InputData="@data" InputLabels="@labels">
                    <CustomGraphics>
                        <text class="donut-inner-text" x="50%" y="35%" dominant-baseline="middle" text-anchor="middle" fill="black" font-family="Helvetica" font-size="20">Total</text>
                        <text class="donut-inner-text" x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" fill="black" font-family="Helvetica" font-size="50">@data.Sum().ToString()</text>
                    </CustomGraphics>
                </MudChart>
            </div>
        </div>

        <div class="w50">
            <div class="card-container">
                <MudTabs Rounded="true" Centered="false" @bind-ActivePanelIndex="@activeTabIndex" Class="mud-width-full">
                    @foreach (var group in TimelineGroups)
                    {
                        Console.WriteLine($"[Group] {group.StateName}: {group.Items?.Count} items");
                        foreach (var item in group.Items)
                        {
                            Console.WriteLine($"--> {item.Address}, {item.Message}, {item.Severity}, {item.Color}");
                        }
                        <MudTabPanel Text="@group.StateName">
                            <LinkStatusTimeline Items="@group.Items" />
                        </MudTabPanel>
                    }
                </MudTabs>
            </div>
        </div>

        <div class="table-wrapper">
            <MudTable @ref="mudTable" Items="@Elements"
                    Dense="true" Hover="true" Striped="true"
                    RowClass="cursor-pointer" RowClassFunc="@SelectedRow_cssClassFunc" 
                    OnRowClick="@((TableRowClickEventArgs<Element> e) => RowClickEvent(e))">
                <HeaderContent>
                    <MudTh>Address</MudTh>
                    <MudTh>ModelName</MudTh>
                    <MudTh>LinkStatus</MudTh>
                    <MudTh>RunningState</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Address">@context.Address</MudTd>
                    <MudTd DataLabel="ModelName">@context.ModelName</MudTd>
                    <MudTd DataLabel="LinkStatus">
                        <MudChip T="string" Color="@(context.LinkStatus == "Linked" ? Color.Success : Color.Error)" Size="Size.Small">
                            @context.LinkStatus
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="RunningState">@context.RunningState</MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </div>
    </div>

    
</div>



