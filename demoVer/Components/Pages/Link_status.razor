    private string decode_INV_Status(uint addr)
    {
        var Group1 = globalVar.Device_ReadData.GetCommandGroups(addr, "INV_FAULT");
        var Group2 = globalVar.Device_ReadData.GetCommandGroups(addr, "INV_STATUS");
        if(Group1 == null || Group2 == null){return "N/A";}

        uint INV_FAULT = (((uint)Group1.Groups[0].Data[1]) << 8) | ((uint)Group1.Groups[0].Data[0]);
        @* if(VarTranslator.Get_INV_Fault(INV_FAULT) != 0){return "Error";} *@

        uint INV_STATUS = (((uint)Group2.Groups[0].Data[1]) << 8) | ((uint)Group2.Groups[0].Data[0]);
        string INV_STATUS_str = globalVar.Get_INV_Status(INV_FAULT, INV_STATUS);

        return INV_STATUS_str;
        
        @* if(((INV_STATUS & STATUS_INV) != 0) && ((INV_STATUS & STATUS_SAVING) != 0)){return "Saving";}
        else if((INV_STATUS & STATUS_INV) != 0){return "Inverter";}
        else if((INV_STATUS & STATUS_BYP) != 0){return "Bypass";}
        else if((INV_STATUS & STATUS_CHG) != 0){return "Charger";}
        else{return "Standby";} *@
    }

    private void AddStatus(uint addr, string status)
    {
        if(status == "Error")
        {
            recent_ErrorStatus.Enqueue((addr, status, DateTime.Now));
            if(recent_ErrorStatus.Count > 3)
            {
                recent_ErrorStatus.Dequeue();
            }
        }
        else
        {
            recent_RunningStatus.Enqueue((addr, status, DateTime.Now));
            if(recent_RunningStatus.Count > 3)
            {
                recent_RunningStatus.Dequeue();
            }
        }
    }
    
    private string ShortenStatus(string status)
    {
        if(IsMobile)
        {
            return status switch
            {
                "Inverter" => "INV",
                "Bypass" => "BYP",
                "Charger" => "CHG",
                "Saving" => "SAV",
                "Standby" => "STB",
                _ => status,
            };
        }
        else
        {
            return status;
        }
    }

    private void summarizeDevicesStatus_Timeline()
    {
        List<RunningStateTimelineItem> temp_TimelineItem_list_running   = new();
        List<RunningStateTimelineItem> temp_TimelineItem_list_error     = new();
        
        foreach(var tempItem in recent_RunningStatus)
        {
            temp_TimelineItem_list_running.Add(new RunningStateTimelineItem()
            {
                Address = tempItem.Item1,
                Message = $"device {tempItem.Item1} : {ShortenStatus(tempItem.Item2)}",
                Timestamp = tempItem.Item3,
                Severity = Severity.Info,
                Color = Color.Primary,
            });
        }
        var group_run = TimelineGroups.FirstOrDefault(g => g.StateName == "Running");
        if(group_run != null)
        {
            group_run.Items = temp_TimelineItem_list_running;
        }

        foreach(var tempItem in recent_ErrorStatus)
        {
            temp_TimelineItem_list_error.Add(new RunningStateTimelineItem()
            {
                Address = tempItem.Item1,
                Message = $"device {tempItem.Item1} Error",
                Timestamp = tempItem.Item3,
                Severity = Severity.Info,
                Color = Color.Default,
                @* Color = Color.Primary, *@
            });
        }
        
        var group_err = TimelineGroups.FirstOrDefault(g => g.StateName == "Error");
        if(group_err != null)
        {
            group_err.Items = temp_TimelineItem_list_error;
        }
    }
}