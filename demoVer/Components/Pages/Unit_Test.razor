@page "/Unit_Test"
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject DataCenter DataCenter
@inject HeartbeatService Heartbeat
@inject ApiManager apiManager
@inject GlobalVar globalVar
@using demoVer.Models
@using demoVer.Interfaces
@using System.Diagnostics
@using System.Text.Json
@inject IGroupsDataDecoder Decoder
@using demoVer.Utils
@inject WriteProcess writeProcess

<div class="btn-grid">
    <button class="glow-btn" @onclick="testFunc">
        <span class="btn-inner">
            🚀 READ_LINK_STATUS
        </span>
        <span class="btn-glow" aria-hidden="true"></span>
    </button>

    <button class="glow-btn" @onclick="TEST_readReal_DeviceData">
        <span class="btn-inner">
            🚀 apiReadReal_DeviceData
        </span>
        <span class="btn-glow" aria-hidden="true"></span>
    </button>
</div>

@code{
    private LinkStatus_JsonFormat rcv_LinkStatus = new();    

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {

        }
    }
    

    protected override void OnInitialized()
    {

    }

    public void Dispose()
    {

    }
    
    public async Task testFunc()
    {
        rcv_LinkStatus = await apiManager.apiRead_LinkStatus();

        var rawJsonData_String = JsonSerializer.Serialize(rcv_LinkStatus, new JsonSerializerOptions{
            WriteIndented = true
        });

        Console.WriteLine(rawJsonData_String);
    }

    public async Task TEST_readReal_DeviceData()
    {
        var result = await apiManager.apiReadReal_OneDeviceData("MOD1", 0);

        var rawJsonData_String = JsonSerializer.Serialize(result, new JsonSerializerOptions{
            WriteIndented = true
        });

        Console.WriteLine(rawJsonData_String);
    }
}