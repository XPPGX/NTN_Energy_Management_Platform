    public long MeasureMs(Action action, int warmup = 3, int rounds = 10)
    {
        //預熱
        for(int i = 0 ; i < warmup ; i ++) action();

        var sw = new Stopwatch();
        
        sw.Start();
        for(int i = 0 ; i < rounds ; i ++) action();
        sw.Stop();

        return sw.ElapsedMilliseconds;
        
    }
