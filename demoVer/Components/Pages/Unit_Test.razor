    public async Task testFunc()
    {
        var result = await apiManager.apiRead_LinkStatus();
        if (result != null)
        {
            rcv_LinkStatus = result;
        }

        var rawJsonData_String = JsonSerializer.Serialize(rcv_LinkStatus, new JsonSerializerOptions{
            WriteIndented = true
        });

        Console.WriteLine(rawJsonData_String);
