    public async Task TEST_writeReal_WriteMemory()
    {
        WriteVal writeVal = new();
        writeVal.Number = 100;
        writeVal.Text   = null;
        writeVal.Bits   = null;
        
        Post_RealSingleRawSettingCMD_JsonFormat body = new();
        body.Type           = "MOD1";
        body.Protocol       = "NTN-5K_MOD.json";
        body.CommandName    = "CURVE_CC";
        body.Target         = writeVal;
        body.AddrValues     = null;
        var IsSendSucc = await apiManager.apiWrite_SetSingleCMD(body);
        Console.WriteLine($"[TEST_Write] IsSendSucc = {IsSendSucc}");
    }
    
