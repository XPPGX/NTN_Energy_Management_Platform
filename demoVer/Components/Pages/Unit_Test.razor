@page "/Unit_Test"
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject DataCenter DataCenter
@inject HeartbeatService Heartbeat
@inject ApiManager apiManager
@inject GlobalVar globalVar
@using demoVer.Models
@using demoVer.Interfaces
@using System.Diagnostics
@using System.Text.Json
@inject IGroupsDataDecoder Decoder
@using demoVer.Utils
@inject WriteProcess writeProcess

<div class="btn-grid">
    <button class="glow-btn" @onclick="testFunc">
        <span class="btn-inner">
            🚀 READ_LINK_STATUS
        </span>
        <span class="btn-glow" aria-hidden="true"></span>
    </button>

    <button class="glow-btn" @onclick="TEST_readReal_ReadMemory">
        <span class="btn-inner">
            🚀 apiReadReal_DeviceData
        </span>
        <span class="btn-glow" aria-hidden="true"></span>
    </button>

    <button class="glow-btn" @onclick="TEST_readReal_WriteMemory">
        <span class="btn-inner">
            🚀 apiReadReal_SettingData
        </span>
        <span class="btn-glow" aria-hidden="true"></span>
    </button>

    <button class="glow-btn" @onclick="TEST_writeReal_WriteMemory">
        <span class="btn-inner">
            🚀 apiWriteReal_SettingData
        </span>
        <span class="btn-glow" aria-hidden="true"></span>
    </button>
</div>

@code{
    private LinkStatus_JsonFormat rcv_LinkStatus = new();    

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {

        }
    }
    

    protected override void OnInitialized()
    {

    }

    public void Dispose()
    {

    }
    
    public async Task testFunc()
    {
        rcv_LinkStatus = await apiManager.apiRead_LinkStatus();

        var rawJsonData_String = JsonSerializer.Serialize(rcv_LinkStatus, new JsonSerializerOptions{
            WriteIndented = true
        });

        Console.WriteLine(rawJsonData_String);
    }

    public async Task TEST_readReal_ReadMemory()
    {
        var result = await apiManager.apiReadReal_OneDeviceData("CAN1", 0);

        var rawJsonData_String = JsonSerializer.Serialize(result, new JsonSerializerOptions{
            WriteIndented = true
        });

        Console.WriteLine(rawJsonData_String);
    }

    public async Task TEST_readReal_WriteMemory()
    {
        var result = await apiManager.apiReadReal_SettingData("CAN1", "NTN-5K_CAN.json");
        var rawJsonData_String = JsonSerializer.Serialize(result, new JsonSerializerOptions{
            WriteIndented = true
        });

        Console.WriteLine(rawJsonData_String);
    }

    public async Task TEST_writeReal_WriteMemory()
    {
        WrtieVal writeVal = new();
        writeVal.Number = 100;
        writeVal.Text   = null;
        writeVal.Bits   = null;
        
        Post_RealSingleRawSettingCMD_JsonFormat body = new();
        body.Type           = "CAN1";
        body.Protocol       = "NTN-5K_CAN.json";
        body.CommandName    = "CURVE_CC";
        body.Target         = writeVal;

        var IsSendSucc = await apiManager.apiWrite_SetSingleCMD(body);
        Console.WriteLine($"[TEST_Write] IsSendSucc = {IsSendSucc}");
    }
}