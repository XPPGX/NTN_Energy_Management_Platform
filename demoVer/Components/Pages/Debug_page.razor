@page "/Debug_page"
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject DataCenter DataCenter
@inject HeartbeatService Heartbeat
@using demoVer.Models

<p>電壓: <span id="vin-display">N/A</span></p>
<p>電流: <span id="iin-display">N/A</span></p>
<p>ModelName : <span id="modelname-display">N/A</span></p>
<p>INV Status : <span id="InvSetting-display">N/A</span></p>
<p>Revision : <span id="Revision-display">N/A</span></p>
<p>FAN_SPEED_1 : <span id="FAN_SPEED_1">N/A</span></p>
<p>FAN_SPEED_2 : <span id="FAN_SPEED_2">N/A</span></p>
<p>V_BAT : <span id="V_BAT">N/A</span></p>
<p>Load Current : <span id="Load_Current">N/A</span></p>
<p>Load Power : <span id="Load_Power">N/A</span></p>
<p>DC Current : <span id="DC_Current">N/A</span></p>
<p>Temperature : <span id="Temperature_display">N/A</span></p>

<MudButton OnClick="CancelAllSubscriptions">取消訂閱</MudButton>

@code {
    private string vinValue = "N/A";
    private string ModelName = "N/A";
    private bool _signalRStarted = false;

    protected override async Task OnInitializedAsync()
    {
        await SimulateJsonInputAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_signalRStarted)
        {
            _signalRStarted = true;


            await JS.InvokeVoidAsync("startSignalR");

            
            var batch = new List<object>
            {
                @* new {addr = 0, cmd = "READ_VIN"},
                new {addr = 0, cmd = "READ_IIN"}, *@
                new {addr = 0, cmd = "MFR_MODEL_B0B5"},
                new {addr = 0, cmd = "MFR_MODEL_B6B11"},
                new {addr = 0, cmd = "INV_STATUS"},
                new {addr = 0, cmd = "INV_FAULT"},
                new {addr = 0, cmd = "MFR_REVISION_B0B5"},

                new {addr = 0, cmd = "READ_FAN_SPEED_1"},
                new {addr = 0, cmd = "READ_FAN_SPEED_2"},
                new {addr = 0, cmd = "READ_AC_VOUT"},
                new {addr = 0, cmd = "READ_OP_VA_HI"},
                new {addr = 0, cmd = "READ_OP_VA_LO"},
                new {addr = 0, cmd = "READ_CHG_CURR"},
                new {addr = 0, cmd = "READ_VBAT"},
                new {addr = 0, cmd = "READ_TEMPERATURE_1"},
            };

            await JS.InvokeVoidAsync("subscribeCommands", batch); // 測試訂閱 READ_VIN
            
        }
    }

    public async Task SimulateJsonInputAsync()
    {
        var filePath = "test_INVData.json";
        var fake_JsonData_list = await DataCenter.LoadMockJsonAsync(filePath);
        uint fake_ID = 0;

        DataCenter.MOD_DATA.Read_oneDevice_ModData(fake_ID, fake_JsonData_list);

        StateHasChanged();
    }

    public async Task CancelAllSubscriptions()
    {
        await JS.InvokeVoidAsync("hubDisconnect");
    }
}
