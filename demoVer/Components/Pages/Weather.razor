@page "/"
@inject IJSRuntime JS
@using System.Net.Sockets
@rendermode InteractiveServer
@inject NavigationManager NavManager
@inject IStringLocalizer<SharedResource> Localizer
<PageTitle>@Localizer["Weather-PageTitle"]</PageTitle>

<div style="display: flex; justify-content: center; align-items: center; height: 100vh; flex-direction: column; background: var(--bg-primary); color: var(--text-primary);">
    <h1 style="color: var(--text-primary); margin-bottom: 20px;">@Localizer["Weather-Developing"]</h1>
    <button style="background: var(--bg-secondary); color: var(--accent-color); border: 1px solid var(--accent-color); padding: 10px 20px; border-radius: 6px; cursor: pointer; transition: background-color 0.2s ease;" @onclick="JumpToFramework">@Localizer["Weather-ReturnToMainFramework"]</button>
</div>
@code
{
    public async Task JumpToFramework()
    {
        await JS.InvokeVoidAsync(identifier: "jumpToApp", 5039);
    }
}