@page "/Log"

@rendermode InteractiveServer
@inject IJSRuntime JS
@using System.Diagnostics
@using demoVer.Components.Layout
@using demoVer.Models
@using demoVer.Utils
@using demoVer.Services
@inject SqlProcessor _sqlProcessor
@inject IStringLocalizer<SharedResource> Localizer
@using System.Text.Json

<MudPopoverProvider/>

@*Web Content*@
<PageTitle>@Localizer["Log-PageTitle"]</PageTitle>

@if(showExportDialog)
{
    <div class="export-overlay">
        <div class="export-dialog">
            <h3>@Localizer["Log-Exporting"]</h3>
            <progress value="@exportProgress" max="100"></progress>
            <div>@exportProgress %</div>
            <button class="btn" @onclick="CancelExport">@Localizer["Log-Cancel"]</button>
        </div>
    </div>
}

@if (isTableSelectorOpen)
{
    <div class="table-selection-overlay" @onclick="() => CloseTableSelector()">
        <div class="table-selection-dialog" @onclick:stopPropagation="true">
            <h4 style="color: var(--text-primary);">@Localizer["Log-SelectTable"]</h4>

            @if (isLoadingDataTables)
            {
                <p>@Localizer["Log-Loading"]</p>
            }
            else if (!string.IsNullOrEmpty(dataTableLoadError))
            {
                <p class="table-error">@dataTableLoadError</p>
            }
            else if (filteredDataLogTables.Count == 0)
            {
                <p class="table-hint">@Localizer["Log-NoMatchingTables"]</p>
            }
            else
            {
                @foreach (var table in filteredDataLogTables)
                {
                    <button class="btn table-option" @onclick="() => SelectDataTable(table)">@table</button>
                }
            }

            <button class="btn btn-bubble-red" @onclick="CloseTableSelector">@Localizer["Log-Close"]</button>
        </div>
    </div>
}

<div id="whole-container" class="content-container">
    <div class="top-panel @(isCollapsed ? "collapsed" : "expanded")" @onclick="TogglePanel" @onclick:stopPropagation="true">
        @if(isCollapsed)
        {
            <div class="collapsed-label-only">
                @Localizer["Log-ConditionSettings"]
            </div>
        }
        else
        {
            <div class="filter-card card-container-base" @onclick:stopPropagation="true">
                <div class="filter-grid">
                    <div class="filter-group">
                        <label class="filter-label" for="logType" style="margin-bottom: 0px;">@Localizer["Log-LogType"]</label>
                        
                        <select id="logType" class="filter-select" value="@selectedLogType" @onchange="OnLogTypeChanged" @onclick:stopPropagation="true" @onchange:stopPropagation="true">
                            <option value="">@Localizer["Log-SelectOption"]</option>
                            <option value="event">@Localizer["Log-EventLog"]</option>
                            <option value="data">@Localizer["Log-DataLog"]</option>
                        </select>

                        @if (string.Equals(selectedLogType, "data", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="radio-group" @onclick:stopPropagation="true" @onchange:stopPropagation="true">
                                <label class="radio-option">
                                    <input type="radio" name="DataType" value="CAN/1" checked="@string.Equals(port, "CAN1", StringComparison.OrdinalIgnoreCase)" @onchange="DataTypeChanged" />
                                    <span class="radio-label">@Localizer["Log-CAN1"]</span>
                                </label>
                                <label class="radio-option">
                                    <input type="radio" name="DataType" value="CAN/2" checked="@string.Equals(port, "CAN2", StringComparison.OrdinalIgnoreCase)" @onchange="DataTypeChanged" />
                                    <span class="radio-label">@Localizer["Log-CAN2"]</span>
                                </label>
                                <label class="radio-option">
                                    <input type="radio" name="DataType" value="MOD/1" checked="@string.Equals(port, "MOD1", StringComparison.OrdinalIgnoreCase)" @onchange="DataTypeChanged" />
                                    <span class="radio-label">@Localizer["Log-MOD1"]</span>
                                </label>
                                <label class="radio-option">
                                    <input type="radio" name="DataType" value="MOD/2" checked="@string.Equals(port, "MOD2", StringComparison.OrdinalIgnoreCase)" @onchange="DataTypeChanged" />
                                    <span class="radio-label">@Localizer["Log-MOD2"]</span>
                                </label>
                            </div>

                            <div class="table-select-controls" @onclick:stopPropagation="true">
                                <button class="btn btn-blue" @onclick="OpenTableSelector">@(string.IsNullOrEmpty(selectedDataTableName) ? @Localizer["Log-SelectTable"] : @Localizer["Log-SwitchTable"])</button>

                                @if (isLoadingDataTables)
                                {
                                    <span class="table-loading">@Localizer["Log-Loading"]</span>
                                }
                                else if (!string.IsNullOrEmpty(dataTableLoadError))
                                {
                                    <span class="table-error">@dataTableLoadError</span>
                                }
                                else if (!string.IsNullOrEmpty(selectedDataTableName))
                                {
                                    <span class="selected-table-label">@Localizer["Log-Current"]: @selectedDataTableName</span>
                                }
                                else if (!string.IsNullOrEmpty(selectedDataType))
                                {
                                    <span class="table-error">@Localizer["Log-NoTablesFor"] @selectedDataType</span>
                                }
                                else
                                {
                                    <span class="table-hint">@Localizer["Log-SelectDataTypeFirst"]</span>
                                }
                            </div>
                        }
                    </div>

                    <div class="filter-group filter-group-dates">
                        <span class="filter-label">@Localizer["Log-DateRange"]</span>
                        <div class="dateCol">
                            <div class="dateRow">
                                <label for="startDate">@Localizer["Log-StartDate"]</label>
                                <div class="dateInputs">
                                    <input type="date" id="startDate" @bind="selectedStartDate" placeholder="@Localizer["Log-ClickToSelectDate"]" @onclick:stopPropagation="true" @onchange:stopPropagation="true">
                                    <input type="time" id="startTime" @bind="selectedStartTime" placeholder="@Localizer["Log-ClickToSelectTime"]" @onclick:stopPropagation="true" @onchange:stopPropagation="true" />
                                </div>
                            </div>

                            <div class="dateRow">
                                <label for="endDate">@Localizer["Log-EndDate"]</label>
                                <div class="dateInputs">
                                    <input type="date" id="endDate" @bind="selectedEndDate" placeholder="@Localizer["Log-ClickToSelectDate"]" @onclick:stopPropagation="true" @onchange:stopPropagation="true">
                                    <input type="time" id="endTime" @bind="selectedEndTime" placeholder="@Localizer["Log-ClickToSelectTime"]" @onclick:stopPropagation="true" @onchange:stopPropagation="true" />
                                </div>
                            </div>
                            <div class="radio-group" @onclick:stopPropagation="true" @onchange:stopPropagation="true">
                                <div class="time-selection-row">
                                    <label class="radio-option">
                                        <input type="radio" name="TimePreset" value="0.5yr" checked="@string.Equals(selectedTimeRangePreset, "0.5yr", StringComparison.OrdinalIgnoreCase)" @onchange="OnTimePresetChanged" />
                                        <span class="radio-label">@Localizer["Log-0_5Year"]</span>
                                    </label>
                                    <label class="radio-option">
                                        <input type="radio" name="TimePreset" value="1month" checked="@string.Equals(selectedTimeRangePreset, "1month", StringComparison.OrdinalIgnoreCase)" @onchange="OnTimePresetChanged" />
                                        <span class="radio-label">@Localizer["Log-1Month"]</span>
                                    </label>
                                    <label class="radio-option">
                                        <input type="radio" name="TimePreset" value="1week" checked="@string.Equals(selectedTimeRangePreset, "1week", StringComparison.OrdinalIgnoreCase)" @onchange="OnTimePresetChanged" />
                                        <span class="radio-label">@Localizer["Log-1Week"]</span>
                                    </label>
                                    <label class="radio-option">
                                        <input type="radio" name="TimePreset" value="1day" checked="@string.Equals(selectedTimeRangePreset, "1day", StringComparison.OrdinalIgnoreCase)" @onchange="OnTimePresetChanged" />
                                        <span class="radio-label">@Localizer["Log-1Day"]</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="filter-group filter-actions">
                        <span class="filter-label">@Localizer["Log-Actions"]</span>
                        <div class="button-row" @onclick:stopPropagation="true">
                            <button class="btn btn-blue" @onclick="searchClick" @onclick:stopPropagation="true">@Localizer["Log-Search"]</button>
                            <button class="btn btn-red" @onclick="exportClick" @onclick:stopPropagation="true">@Localizer["Log-Export"]</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div id="log-table-container" class="bottom-panel">
        <div class="table-header">
            <div>
                <h3>@(tableHeader?? @Localizer["Log-LogTable"])</h3>
                <span>@(Localizer["Log-TotalPages"] + ": " + TCB.nowTotalPages)</span>
            </div>
            <div>
                <button class="btn btn-blue" @onclick="ToggleColumnChooser">@Localizer["Log-ShowColumns"]</button>
            </div>
        </div>

        <!-- 📱 手機：Modal 選單 -->
        @if (IsMobile && isColumnChooserOpen)
        {
            <div class="column-chooser-modal">
                <div class="modal-content">
                    <h4>@Localizer["Log-SelectColumnsToShow"]</h4>
                    @foreach (var col in allColumns)
                    {
                        <label class="multi-option">
                            <input type="checkbox"
                                value="@col"
                                checked="@visibleColumns.Contains(col)"
                                @onchange="e => OnColumnToggle(col, e)" />
                            @col
                        </label>
                    }
                    <button class="btn btn-bubble-red" @onclick="ToggleColumnChooser">@Localizer["Log-Close"]</button>
                </div>
            </div>
        }

        <!-- 桌機版 Column Chooser -->
        @if (!IsMobile && isColumnChooserOpen)
        {
            <div class="column-chooser">
                @foreach (var col in allColumns)
                {
                    <div class="multi-option">
                        <input type="checkbox"
                            value="@col"
                            checked="@visibleColumns.Contains(col)"
                            @onchange="e => OnColumnToggle(col, e)" />
                        <div>@col</div>
                    </div>
                }
            </div>
        }

        @{ var orderedColumns = GetOrderedVisibleColumns(); }

        <!-- 📊 桌機表格 -->
        @if (!IsMobile)
        {
            <table class="custom-table">
                <thead>
                    <tr>
                        @foreach (var col in orderedColumns)
                        {
                            <th>@col</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in tableData)
                    {
                        <tr>
                            @foreach (var col in orderedColumns)
                            {
                                <td>@GetCellValue(row, col)</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
            <!-- 📑 翻頁控制區 -->
            <div class="pagination-container">
                <button class="btn btn-blue no-flex" @onclick="turnToPreviousPage">@Localizer["Log-PreviousPage"]</button>
                <span class="page-info">@Localizer["Log-Page"] <input type="number" min="1" class="page-input" @bind="UI_PageNum"
                    @onkeyup="OnKeyUp" @onfocus="() => PageInputFocus()" @onblur="() => PageInputBlur()"/> @Localizer["Log-PageUnit"]</span>
                <button class="btn btn-blue no-flex" @onclick="turnToNextPage">@Localizer["Log-NextPage"]</button>
            </div>
        }

        <!-- 📱 手機卡片 -->
        @if (IsMobile)
        {
            <div class="card-table">
                @foreach (var row in tableData)
                {
                    <div class="card-table-row">
                        @foreach (var col in orderedColumns)
                        {
                            <div class="card-table-item">
                                <span class="card-table-label">@col</span>
                                <span class="card-table-value">@GetCellValue(row, col)</span>
                            </div>
                        }
                    </div>
                }
            </div>
            <!-- 📑 翻頁控制區  -->
            <div class="pagination-container">
                <button class="btn btn-blue no-flex" @onclick="turnToPreviousPage">⟨</button>
                <span class="page-info">@Localizer["Log-Page"] <input type="number" min="1" class="page-input" @bind="UI_PageNum" 
                    @onkeyup="OnKeyUp" @onfocus="() => PageInputFocus()" @onblur="() => PageInputBlur()"/> @Localizer["Log-PageUnit"]</span>
                <button class="btn btn-blue no-flex" @onclick="turnToNextPage">⟩</button>
            </div>
        }

    </div>
</div>

@code
{
    [CascadingParameter(Name = "MainLayout")] public MainLayout? MainLayout { get; set; }

    private string _category    = "";

    private const int LogType   = 1;
    private const int Date      = 2;
    private const int Btn       = 3;

    private int currentStep     = 1;
    private string? selectedLogType = string.Empty;
    private string? selectedDataType = string.Empty;
    private string port = string.Empty;
    private string? selectedTimeRangePreset = string.Empty;
    private bool isCollapsed = false;
    private bool IsMobile = false;

    private bool isColumnChooserOpen            = false;
    private List<string> allColumns             = new();
    private List<string> visibleColumns         = new();
    private List<string> eventLog_allColumns    = new();
    private List<string> dataLog_allColumns     = new();
    private List<string> filteredDataLogTables  = new();
    private string? selectedDataTableName;
    private bool isTableSelectorOpen;
    private bool isLoadingDataTables;
    private string? dataTableLoadError;
    private List<Dictionary<string, object>> tableData = new();
    private string tableHeader = "Table";
    private TableControlBlock TCB = new();
    private int UI_PageNum = 1;
    private string? CurrentFocus {get; set;}

    private DateTime? selectedStartDate;
    private TimeOnly? selectedStartTime;
    private DateTime? selectedEndDate;
    private TimeOnly? selectedEndTime;

    private bool showExportDialog = false;
    private int exportProgress = 0;
    private CancellationTokenSource? exportCts;
    private bool topRowCallbacksRegistered = false;

    private static object? GetCellValue(Dictionary<string, object> row, string column)
    {
        return row.TryGetValue(column, out var value) ? value : string.Empty;
    }

    protected override void OnInitialized()
    {
        _category = GetType().FullName!;
    }

    protected override void OnParametersSet()
    {
        if (!topRowCallbacksRegistered && MainLayout != null)
        {
            MainLayout.RegisterTopRowCallbacks(this);
            topRowCallbacksRegistered = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            IsMobile = await JS.InvokeAsync<bool>("checkIsMobile");
            await InvokeAsync(StateHasChanged);

            // await InitColumn();

            // 添加假資料用於測試
            // await AddTestData();
        }
    }

    #region Appearance_Control
    private async Task GoStep(int step)
    {
        currentStep = step;
        switch(currentStep)
        {
            case LogType:
                selectedLogType = string.Empty;
                Console.WriteLine("LogType");
                break;
            case Date:
                Console.WriteLine("Date");
                break;
            case Btn:
                Console.WriteLine("Btn");
                break;
            default:
                break;
        }
    }

    private string GetStepClass(int step)
    {
        if (step == currentStep) return "card active";
        if (step < currentStep) return "card left";
        if (step > currentStep) return "card right";
        return "card";
    }

    private void TogglePanel()
    {
        if(IsMobileView())
        {
            if(isCollapsed is true)
            {
                ExpandPanel();
            }
        }
    }

    private bool IsMobileView()
    {
        return IsMobile;
    }

    private void CollapsePanel()
    {
        // isCollapsed = true;
        if(IsMobileView())
        {
            isCollapsed = true;
        }
    }

    private void ExpandPanel()
    {
        isCollapsed = false;
    } 

    private async Task OnLogTypeChanged(ChangeEventArgs e)
    {
        selectedLogType = e.Value?.ToString();

        if (!string.Equals(selectedLogType, "data", StringComparison.OrdinalIgnoreCase))
        {
            selectedDataType = string.Empty;
            port = string.Empty;
            TCB.Port = string.Empty;
            isTableSelectorOpen = false;
            isLoadingDataTables = false;
            dataTableLoadError = null;
            filteredDataLogTables.Clear();
            selectedDataTableName = null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (!string.IsNullOrEmpty(selectedDataType))
        {
            await LoadDataLogTablesAsync();
        }
    }

    private void OnDateChanged(int index, ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {

            if(index == 0)
            {
                selectedStartDate = dt;
                Console.WriteLine("START Time Chosen");
            }
            else if(index == 1)
            {
                selectedEndDate = dt;
                Console.WriteLine("END Time Chosen");
            }
        }
    }

    private void ToggleColumnChooser()
    {
        isColumnChooserOpen = !isColumnChooserOpen;
    }

    private void OnColumnToggle(string col, ChangeEventArgs e)
    {
        bool isChecked = e.Value?.ToString()?.ToLower() == "true";

        if (isChecked)
        {
            if (!visibleColumns.Contains(col))
            {
                visibleColumns.Add(col);
            }
        }
        else
        {
            visibleColumns.Remove(col);
        }
    }

    private IReadOnlyList<string> GetOrderedVisibleColumns()
    {
        if (visibleColumns.Count == 0 || allColumns.Count == 0)
        {
            return Array.Empty<string>();
        }

        var ordered = new List<string>(visibleColumns.Count);
        var columnSet = new HashSet<string>(allColumns);

        foreach (var column in visibleColumns)
        {
            if (columnSet.Contains(column))
            {
                ordered.Add(column);
            }
        }

        return ordered;
    }

    private async Task searchClick()
    {
        CollapsePanel();

        //清空 表格 、 Column
        tableData.Clear();
        visibleColumns.Clear();

        if(await InitColumn() is false)
        {
            AppLogger.Log_To_File_log(_category, $"[Log][searchClick] Error, InitColumn() failed", AppLogLevel.Trace);
            return;
        }

        if(string.Equals(selectedLogType, "event", StringComparison.OrdinalIgnoreCase))
        {
            //1. 更換表格名稱
            tableHeader = "Event Log";
            //2. 更換Column選擇
            allColumns = eventLog_allColumns;
            TCB.Port = string.Empty;
        }
        else if(string.Equals(selectedLogType, "data", StringComparison.OrdinalIgnoreCase))
        {
            //1. 更換表格名稱
            tableHeader = "Data Log";
            //2. 更換Column選擇
            allColumns = dataLog_allColumns;
            if (string.IsNullOrWhiteSpace(port))
            {
                dataTableLoadError = Localizer["Log-SelectPortFirst"];
                await InvokeAsync(StateHasChanged);
                return;
            }

            TCB.Port = port;
        }
        else
        {
            TCB.Port = string.Empty;
        }

        if(allColumns is null || allColumns.Count == 0)
        {
            AppLogger.Log_To_File_log(_category, $"[Log][searchClick] Error, allColumns is null or empty", AppLogLevel.Trace);
            return;
        }
        //讓visible顯示前5個col
        visibleColumns.Clear();
        for(int i = 0 ; i < allColumns.Count && i < 5 ; i ++)
        {
            visibleColumns.Add(allColumns[i]);
        }

        //撈資料，顯示在Table上
        

        await QueryFromDB_InitTCB();
        UI_PageNum = 1;
        await InvokeAsync(StateHasChanged);
        await JS.InvokeVoidAsync("scrollToElement", "log-table-container"); //這還要再調整，捲到的位置有點怪
    }

    private async Task exportClick()
    {
        CollapsePanel();
        await exportTask();
    }

    private void PageInputFocus()
    {
        CurrentFocus = "PageInput";
    }

    private void PageInputBlur()
    {
        CurrentFocus = null;
    }

    private async Task OnKeyUp(KeyboardEventArgs e)
    {
        if(e.Key == "Enter" && string.Equals(CurrentFocus, "PageInput", StringComparison.OrdinalIgnoreCase))
        {
            await turnToCertainPage();
        }
    }

    private async Task DataTypeChanged(ChangeEventArgs e)
    {
        var received = e.Value?.ToString() ?? string.Empty;
        var segments = received.Split('/', StringSplitOptions.RemoveEmptyEntries);

        selectedDataType = segments.Length > 0 ? segments[0] : string.Empty;
        var portSuffix = segments.Length > 1 ? segments[1] : string.Empty;
        port = string.IsNullOrEmpty(selectedDataType) ? string.Empty : string.Concat(selectedDataType, portSuffix);
        TCB.Port = port;

        Console.WriteLine($"selectedDataType = {selectedDataType}, port = {port}");

        isTableSelectorOpen = false;
        dataTableLoadError = null;

        await LoadDataLogTablesAsync();

        if (filteredDataLogTables.Count > 0)
        {
            isTableSelectorOpen = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnTimePresetChanged(ChangeEventArgs e)
    {
        selectedTimeRangePreset = e.Value?.ToString();

        if (string.IsNullOrWhiteSpace(selectedTimeRangePreset))
        {
            return;
        }

        ApplyTimePreset(selectedTimeRangePreset);
    }

    private void ApplyTimePreset(string preset)
    {
        var now = DateTime.Now;
        var start = preset switch
        {
            "0.5yr" => now.AddDays(-182),
            "1month" => now.AddDays(-30),
            "1week" => now.AddDays(-7),
            "1day" => now.AddDays(-1),
            _ => now
        };

        selectedEndDate = now.Date;
        selectedEndTime = TimeOnly.FromDateTime(now);
        selectedStartDate = start.Date;
        selectedStartTime = TimeOnly.FromDateTime(start);

        _ = InvokeAsync(StateHasChanged);
    }

    private async Task LoadDataLogTablesAsync()
    {
        if (!string.Equals(selectedLogType, "data", StringComparison.OrdinalIgnoreCase))
        {
            filteredDataLogTables.Clear();
            selectedDataTableName = null;
            dataTableLoadError = null;
            return;
        }

        if (string.IsNullOrEmpty(selectedDataType))
        {
            filteredDataLogTables.Clear();
            selectedDataTableName = null;
            dataTableLoadError = null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (isLoadingDataTables)
        {
            return;
        }

        isLoadingDataTables = true;
        dataTableLoadError = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            //[Release] 
            var tableNames = await _sqlProcessor.GetAllTableNames();
            if (tableNames is null)
            {
                filteredDataLogTables.Clear();
                selectedDataTableName = null;
                dataTableLoadError = Localizer["Log-CannotGetTableList"];
                return;
            }

            filteredDataLogTables = tableNames
                .Where(t => t.Contains("datalog", StringComparison.OrdinalIgnoreCase) &&
                            t.Contains(selectedDataType, StringComparison.OrdinalIgnoreCase))
                .OrderBy(t => t, StringComparer.OrdinalIgnoreCase)
                .ToList(); 

            //[Debug]
            // filteredDataLogTables = new List<string>
            // { 
            //     "datalog_NTN-5K_CAN",
            //     "datalog_NTG-2K2_CAN",
            //     "datalog_NTN-5K_CAN",
            //     "datalog_NTN-5K_CAN",
            //     "datalog_NTN-5K_CAN",
            //     "datalog_NTN-5K_CAN",
            //     "datalog_NTN-5K_CAN",
            //     "datalog_NTN-5K_CAN",
            //     "datalog_NTN-5K_CAN",
            //     "datalog_NTN-5K_CAN",
            //     "datalog_NTN-5K_CAN",
            //     "datalog_NTN-5K_CAN",
            // };
            if (filteredDataLogTables.Count == 0)
            {
                selectedDataTableName = null;
                dataTableLoadError = Localizer["Log-NoTablesFor"] + selectedDataType;
            }
            else
            {
                var matched = filteredDataLogTables.FirstOrDefault(t => string.Equals(t, selectedDataTableName, StringComparison.OrdinalIgnoreCase));
                selectedDataTableName = matched ?? filteredDataLogTables.First();
            }
        }
        catch (Exception ex)
        {
            filteredDataLogTables.Clear();
            selectedDataTableName = null;
            dataTableLoadError = Localizer["Log-TableLoadError"];
            AppLogger.Log_To_File_log(_category, $"[Log][LoadDataLogTablesAsync] Error : {ex}", AppLogLevel.Trace);
        }
        finally
        {
            isLoadingDataTables = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenTableSelector()
    {
        if (isLoadingDataTables)
        {
            isTableSelectorOpen = true;
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (string.IsNullOrEmpty(selectedDataType))
        {
            dataTableLoadError = Localizer["Log-SelectDataTypeFirst"];
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (!isLoadingDataTables && filteredDataLogTables.Count == 0)
        {
            await LoadDataLogTablesAsync();
        }

        if (filteredDataLogTables.Count == 0)
        {
            return;
        }

        isTableSelectorOpen = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task CloseTableSelector()
    {
