            }
            AppLogger.Log_To_File_log(_category, $"[Log][dataLog_Query] step2: Put data records into table, success", AppLogLevel.Trace);

            //3. 在TCB中紀錄 現在10筆資料 的 最早時間 與 最晚時間，用於翻頁時查詢資料庫的WHERE語法
            var firstRow    = tableData.FirstOrDefault();
            var lastRow     = tableData.LastOrDefault();
            if(firstRow != null && firstRow.ContainsKey("timestamp") && firstRow["timestamp"] is DateTime lastedTime)   TCB.lastedTime_InTable      = lastedTime;
            if(lastRow != null && firstRow.ContainsKey("timestamp") && lastRow["timestamp"] is DateTime earliestTime)   TCB.earliestTime_InTable    = earliestTime;
            if(firstRow != null && firstRow.ContainsKey("id") && firstRow["id"] is long lastedId)                       TCB.lastedId_InTable        = lastedId;
            if(lastRow != null && lastRow.ContainsKey("id") && lastRow["id"] is long earliestId)                        TCB.earliestId_InTable      = earliestId;

            AppLogger.Log_To_File_log(_category, $"[Log][dataLog_Query] step3: earliestTime_InTable = {TCB.earliestTime_InTable}, lastedTime_InTable = {TCB.lastedTime_InTable}", AppLogLevel.Trace);
            AppLogger.Log_To_File_log(_category, $"[Log][dataLog_Query] step3: earliestId_InTable = {TCB.earliestId_InTable}, lastedId_InTable = {TCB.lastedId_InTable}", AppLogLevel.Trace);

            return true;
        }
        catch(Exception e)
        {
            AppLogger.Log_To_File_log(_category, $"[Log][dataLog_Query] Error : {e}", AppLogLevel.Trace);
            return false;
        }
