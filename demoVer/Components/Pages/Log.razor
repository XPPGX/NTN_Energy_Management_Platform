@page "/Log"

@rendermode InteractiveServer
@inject IJSRuntime JS
@using demoVer.Components.Layout
@using demoVer.Models
@using demoVer.Utils
@using demoVer.Services
@inject SqlProcessor _sqlProcessor
@using System.Text.Json

<MudPopoverProvider/>

@*Web Content*@
<PageTitle>Log</PageTitle>
<TopRow />

@if(showExportDialog)
{
    <div class="export-overlay">
        <div class="export-dialog">
            <h3>匯出中...</h3>
            <progress value="@exportProgress" max="100"></progress>
            <div>@exportProgress %</div>
            <button class="btn btn-cancel" @onclick="CancelExport">取消</button>
        </div>
    </div>
}

<div id="whole-container" class="content-container">
    <div class="top-panel @(isCollapsed ? "collapsed" : "expanded")" @onclick="TogglePanel" @onclick:stopPropagation="true">
        @if(isCollapsed)
        {
            <div class="collapsed-label-only">
                條件設置
            </div>
        }
        else
        {
            <!-- Step 1 -->
            <div class="@GetStepClass(1)" @onclick="() => GoStep(1)" @onclick:stopPropagation="true">
                @if (currentStep == LogType)
                {
                    <label for="logType">Log Type</label>
                    <select id="logType" @onchange="OnLogTypeChanged" @onclick:stopPropagation="true" @onchange:stopPropagation="true">
                        <option value="">-- Select --</option>
                        <option value="event">Event Log</option>
                        <option value="data">Data Log</option>
                    </select>

                    if(string.Equals(selectedLogType, "data", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="radio-group" @onchange:stopPropagation="true" @onclick:stopPropagation="true">
                            <label class="radio-option">
                                <input type="radio" name="DataType" value="CAN" @onchange="DataTypeChanged"/>
                                <span class="radio-label">CAN Data</span>
                            </label>
                            
                            <label class="radio-option">
                                <input type="radio" name="DataType" value="MOD" @onchange="DataTypeChanged"/>
                                <span class="radio-label">MOD Data</span>
                            </label>
                        </div>
                    }
                }
                else
                {
                    <div class="step-inner">
                        <div class="collapsed-label">
                            Log Type: @(selectedLogType ?? "未選擇")
                        </div>
                    </div>
                }
            </div>

            <!-- Step 2 -->
            <div class="@GetStepClass(2)" @onclick="() => GoStep(2)" @onclick:stopPropagation="true">
                @if (currentStep == Date)
                {
                    <div class="dateCol">
                        
                        <div class="dateRow">
                            <label for="startDate">Start Date</label>
                            <div class="dateInputs">
                                <input type="date" id="startDate" @bind="selectedStartDate" placeholder="點擊選擇日期" @onclick:stopPropagation="true" @onchange:stopPropagation="true">
                                <input type="time" id="startTime" @bind="selectedStartTime" placeholder="點擊選擇時間" @onclick:stopPropagation="true" @onchange:stopPropagation="true"/>
                            </div>
                        </div>
                        
                        <div class="dateRow">
                            <label for="endDate">End Date</label>
                            <div class="dateInputs">
                                <input type="date" id="endDate" @bind="selectedEndDate" placeholder="點擊選擇日期" @onclick:stopPropagation="true" @onchange:stopPropagation="true">
                                <input type="time" id="endTime" @bind="selectedEndTime" placeholder="點擊選擇時間" @onclick:stopPropagation="true" @onchange:stopPropagation="true"/>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="step-inner">
                        <div class="collapsed-label">                            
                            Date: @(selectedStartDate?.ToShortDateString() ?? "未選擇")
                            ~ @(selectedEndDate?.ToShortDateString() ?? "未選擇")
                        </div>
                    </div>
                }
            </div>

            <!-- Step 3 -->
            <div class="@GetStepClass(3)" @onclick="() => GoStep(3)" @onclick:stopPropagation="true">
                @if (currentStep == Btn)
                {
                    <div class="button-row">
                        <button class="btn btn-search" @onclick="searchClick" @onclick:stopPropagation="true">查詢</button>
                        <button class="btn btn-export" @onclick="exportClick" @onclick:stopPropagation="true">匯出</button>
                    </div>
                }
                else
                {
                    <div class="step-inner">
                        <div class="collapsed-label">
                            操作選項
                        </div>
                    </div>
                }
            </div>
        }
    </div>
    <div id="log-table-container" class="bottom-panel">
        <div class="table-header">
            <div>
                <h3>@(tableHeader?? "Log Table")</h3>
                <span>@($"總頁數: {TCB.nowTotalPages}")</span>
            </div>
            <div>
                <button class="btn btn-columns" @onclick="ToggleColumnChooser">⚙ 顯示欄位</button>
            </div>
        </div>

        <!-- 📱 手機：Modal 選單 -->
        @if (IsMobile && isColumnChooserOpen)
        {
            <div class="column-chooser-modal">
                <div class="modal-content">
                    <h4>選擇要顯示的欄位</h4>
                    @foreach (var col in allColumns)
                    {
                        <label class="multi-option">
                            <input type="checkbox"
                                value="@col"
                                checked="@visibleColumns.Contains(col)"
                                @onchange="e => OnColumnToggle(col, e)" />
                            @col
                        </label>
                    }
                    <button class="btn btn-close" @onclick="ToggleColumnChooser">關閉</button>
                </div>
            </div>
        }

        <!-- 桌機版 Column Chooser -->
        @if (!IsMobile && isColumnChooserOpen)
        {
            <div class="column-chooser">
                @foreach (var col in allColumns)
                {
                    <label class="multi-option">
                        <input type="checkbox"
                            value="@col"
                            checked="@visibleColumns.Contains(col)"
                            @onchange="e => OnColumnToggle(col, e)" />
                        @col
                    </label>
                }
            </div>
        }

        <!-- 📊 桌機表格 -->
        @if (!IsMobile)
        {
            <table class="custom-table">
                <thead>
                    <tr>
                        @foreach (var col in allColumns.Where(c => visibleColumns.Contains(c)))
                        {
                            <th>@col</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in tableData)
                    {
                        <tr>
                            @foreach (var col in allColumns.Where(c => visibleColumns.Contains(c)))
                            {
                                <td>@row[col]</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
            <!-- 📑 翻頁控制區 -->
            <div class="pagination-container">
                <button class="btn-page" @onclick="turnToPreviousPage">⟨ 上一頁</button>
                <span class="page-info">第 <input type="number" min="1" class="page-input" @bind="UI_PageNum"
                    @onkeyup="OnKeyUp" @onfocus="() => PageInputFocus()" @onblur="() => PageInputBlur()"/> 頁</span>
                <button class="btn-page" @onclick="turnToNextPage">下一頁 ⟩</button>
            </div>
        }

        <!-- 📱 手機卡片 -->
        @if (IsMobile)
        {
            <div class="card-table">
                @foreach (var row in tableData)
                {
                    <div class="card-row">
                        @foreach (var col in allColumns.Where(c => visibleColumns.Contains(c)))
                        {
                            <div class="card-item">
                                <span class="card-label">@col</span>
                                <span class="card-value">@row[col]</span>
                            </div>
                        }
                    </div>
                }
            </div>
            <!-- 📑 翻頁控制區  -->
            <div class="pagination-container">
                <button class="btn-page" @onclick="turnToPreviousPage">⟨</button>
                <span class="page-info">第 <input type="number" min="1" class="page-input" @bind="UI_PageNum" 
                    @onkeyup="OnKeyUp" @onfocus="() => PageInputFocus()" @onblur="() => PageInputBlur()"/> 頁</span>
                <button class="btn-page" @onclick="turnToNextPage">⟩</button>
            </div>
        }

    </div>
</div>

@code
{
    private string _category    = "";
    
    private const int LogType   = 1;
    private const int Date      = 2;
    private const int Btn       = 3;
    
    private int currentStep     = 1;
    private string? selectedLogType = string.Empty;
    private string? selectedDataType = string.Empty;
    private bool isCollapsed = false;
    private bool IsMobile = false;

    private bool isColumnChooserOpen            = false;
    private List<string> allColumns             = new();
    private HashSet<string> visibleColumns      = new();
    private List<string> eventLog_allColumns    = new();
    private List<string> dataLog_allColumns     = new();
    private List<Dictionary<string, object>> tableData = new();
    private string tableHeader = "Table";
    private TableControlBlock TCB = new();
    private int UI_PageNum = 1;
    private string? CurrentFocus {get; set;}

    private DateTime? selectedStartDate;
    private TimeOnly? selectedStartTime;
    private DateTime? selectedEndDate;
    private TimeOnly? selectedEndTime;

    private bool showExportDialog = false;
    private int exportProgress = 0;
    private CancellationTokenSource? exportCts;

    protected override void OnInitialized()
    {
        _category = GetType().FullName!;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            IsMobile = await JS.InvokeAsync<bool>("checkIsMobile");
            await InvokeAsync(StateHasChanged);
            
            await InitColumn();
        }
    }
    
    #region Appearance_Control
    private async Task GoStep(int step)
    {
        currentStep = step;
        switch(currentStep)
        {
            case LogType:
                selectedLogType = string.Empty;
                Console.WriteLine("LogType");
                break;
            case Date:
                Console.WriteLine("Date");
                break;
            case Btn:
                Console.WriteLine("Btn");
                break;
            default:
                break;
        }
    }

    private string GetStepClass(int step)
    {
        if (step == currentStep) return "step active";
        if (step < currentStep) return "step left";
        if (step > currentStep) return "step right";
        return "step";
    }

    private void TogglePanel()
    {
        if(IsMobileView())
        {
            if(isCollapsed is true)
            {
                ExpandPanel();
            }
        }
    }

    private bool IsMobileView()
    {
        return IsMobile;
    }

    private void CollapsePanel()
    {
        if(IsMobileView())
        {
            isCollapsed = true;
        }
    }

    private void ExpandPanel()
    {
        isCollapsed = false;
    } 

    private void OnLogTypeChanged(ChangeEventArgs e)
    {
        selectedLogType = e.Value?.ToString();
    }

    private void OnDateChanged(int index, ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {

            if(index == 0)
            {
                selectedStartDate = dt;
                Console.WriteLine("START Time Chosen");
            }
            else if(index == 1)
            {
                selectedEndDate = dt;
                Console.WriteLine("END Time Chosen");
            }
        }
    }

    private void ToggleColumnChooser()
    {
        isColumnChooserOpen = !isColumnChooserOpen;
    }

    private void OnColumnToggle(string col, ChangeEventArgs e)
    {
        bool isChecked = e.Value?.ToString()?.ToLower() == "true";

        if (isChecked)
            visibleColumns.Add(col);
        else
            visibleColumns.Remove(col);
    }

    private async Task searchClick()
    {
        CollapsePanel();

        //清空 表格 、 Column
        tableData.Clear();
        visibleColumns.Clear();

        if(string.Equals(selectedLogType, "event", StringComparison.OrdinalIgnoreCase))
        {
            //1. 更換表格名稱
            tableHeader = "Event Log";
            //2. 更換Column選擇
            allColumns = eventLog_allColumns;
            //3. 讓Visible顯示前5個col
            visibleColumns.Clear();
            for(int i = 0 ; i < 5 ; i ++)
            {
                visibleColumns.Add(allColumns[i]);
            }
        }
        else if(string.Equals(selectedLogType, "data", StringComparison.OrdinalIgnoreCase))
        {
            //1. 更換表格名稱
            tableHeader = "Data Log";
            //2. 更換Column選擇
            allColumns = dataLog_allColumns;
            //3. 讓visible顯示前5個col
            visibleColumns.Clear();
            for(int i = 0 ; i < 5 ; i ++)
            {
                visibleColumns.Add(allColumns[i]);
            }
        }

        //撈資料，顯示在Table上
        await QueryFromDB_InitTCB();
        UI_PageNum = 1;
        await JS.InvokeVoidAsync("scrollToElement", "log-table-container"); //這還要再調整，捲到的位置有點怪
    }

    private async Task exportClick()
    {
        CollapsePanel();
        exportTask();
    }

    private void PageInputFocus()
    {
        CurrentFocus = "PageInput";
    }

    private void PageInputBlur()
    {
        CurrentFocus = null;
    }

    private void OnKeyUp(KeyboardEventArgs e)
    {
        if(e.Key == "Enter" && string.Equals(CurrentFocus, "PageInput", StringComparison.OrdinalIgnoreCase))
        {
            turnToCertainPage();
        }
    }

    private void DataTypeChanged(ChangeEventArgs e)
    {
        selectedDataType = e.Value?.ToString();
        Console.WriteLine($"selectedDataType = {selectedDataType}");
    }

    #endregion //Appearance_Control

    #region Logic_Control
    private async Task InitColumn()
    {//可動態接收資料庫欄位變動
        //1. 清空當前 所有Column選擇
        allColumns.Clear();
        visibleColumns.Clear();
        eventLog_allColumns.Clear();
        dataLog_allColumns.Clear();

        //2. 載入當前資料表 所有Column
        eventLog_allColumns = await _sqlProcessor.GetTableColumn("event_log");
        dataLog_allColumns  = await _sqlProcessor.GetTableColumn("datalog_NTN-5K_CAN");

        var Json_Str = JsonSerializer.Serialize(eventLog_allColumns, new JsonSerializerOptions{
            WriteIndented = true
        });
        Console.WriteLine(Json_Str);

        Json_Str = JsonSerializer.Serialize(dataLog_allColumns, new JsonSerializerOptions{
            WriteIndented = true
        });
        Console.WriteLine(Json_Str);
    }
    
    private DateTime? dateTime_Transform(DateTime? date, TimeOnly? time)
    {
        try
        {
            if(date is null)
            {
                AppLogger.Log_To_File_log(_category, $"[Log][dateTime_Transform] 日期不可為 null", AppLogLevel.Trace);
                return null;
            }
            if(time is null)
            {
                AppLogger.Log_To_File_log(_category, $"時間不可為 null", AppLogLevel.Trace);
                return null;
            }
            
            var time_AfterSpaned =  time.Value.ToTimeSpan();

            if(date == DateTime.MinValue)
            {
                AppLogger.Log_To_File_log(_category, $"日期參數無效", AppLogLevel.Trace);
                return null;
            }
            if(time_AfterSpaned < TimeSpan.Zero || time_AfterSpaned >= TimeSpan.FromDays(1))
            {
                AppLogger.Log_To_File_log(_category, $"時間必須在 00:00:00 ~ 23:59:59 之間", AppLogLevel.Trace);
                return null;
            }

            var combined = date.Value.Date + time_AfterSpaned;
            return DateTime.SpecifyKind(combined, DateTimeKind.Utc);
        }
        catch(Exception e)
        {
            AppLogger.Log_To_File_log(_category, $"[Log][dateTime_Transform] : Error, {e}", AppLogLevel.Trace);
            return null;
        }
    }

    private async Task exportTask()
    {
        TCB.TableName = string.Empty;
        //參數檢查
        if(string.Equals(selectedLogType, "event", StringComparison.OrdinalIgnoreCase))
        {
            TCB.TableName = "event_log";
        }
        else if(string.Equals(selectedLogType, "data", StringComparison.OrdinalIgnoreCase))
        {
            switch(selectedDataType)
            {
                case "CAN": TCB.TableName = "datalog_NTN-5K_CAN"; break;
                case "MOD": TCB.TableName = "datalog_NTN-5K_MOD"; break;
                default: 
                    AppLogger.Log_To_File_log(_category, $"[Log][exportTask] Error, LogType = data, selectedDataType = None", AppLogLevel.Trace);
                    return;
            }
        }
        else
        {
            AppLogger.Log_To_File_log(_category, $"[Log][exportTask] Error, LogType = {selectedLogType}, DataType = {selectedDataType}", AppLogLevel.Trace);
            return;
        }
        

        showExportDialog = true;
        exportProgress = 0;
        exportCts = new CancellationTokenSource();
        
        try
        {
            //1. 驗證並取得時間
            var startTime_Formatted = dateTime_Transform(selectedStartDate, selectedStartTime);
            var endTime_Formatted   = dateTime_Transform(selectedEndDate, selectedEndTime);
            Console.WriteLine($"[Log][exportTask] startTime_Formatted = {startTime_Formatted}");
            Console.WriteLine($"[Log][exportTask] endTime_Formatted = {endTime_Formatted}");
            if(endTime_Formatted < startTime_Formatted)
            {
                AppLogger.Log_To_File_log(_category, $"[Log][exportTask] : endTime < startTime", AppLogLevel.Trace);
                return;
            }

            // 2. 開始Export動作(查詢、寫檔、更新進度)
            await foreach (var (percent, fileUrl) in 
                _sqlProcessor.ExportBigDataAsync(TCB.TableName, startTime_Formatted, endTime_Formatted, exportCts.Token))
            {
                exportProgress = percent;
                await InvokeAsync(StateHasChanged);

                if (fileUrl != null)
                {
                    AppLogger.Log_To_File_log(_category, $"[Log][exportTask] Export 完成", AppLogLevel.Trace);

                    await JS.InvokeVoidAsync("startDownload", fileUrl);
                    
                    AppLogger.Log_To_File_log(_category, $"[Log][exportTask] Download 完成: {fileUrl}", AppLogLevel.Trace);
                }
            }
        }
        catch(OperationCanceledException)
        {
            AppLogger.Log_To_File_log(_category, "[Log][exportTask] 匯出已取消", AppLogLevel.Trace);
            return;
        }
        finally
        {
            showExportDialog = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CancelExport()
    {
        exportCts?.Cancel();
    }

    private async Task QueryFromDB_InitTCB()
    {   
        try
        {
            //1. 驗證並取得時間
            var startTime_Formatted = dateTime_Transform(selectedStartDate, selectedStartTime);
            var endTime_Formatted   = dateTime_Transform(selectedEndDate, selectedEndTime);
            Console.WriteLine($"[Log][QueryFromDB_InitTCB] startTime_Formatted = {startTime_Formatted}");
            Console.WriteLine($"[Log][QueryFromDB_InitTCB] endTime_Formatted = {endTime_Formatted}");
            if(endTime_Formatted < startTime_Formatted)
            {
                AppLogger.Log_To_File_log(_category, $"[Log][QueryFromDB_InitTCB] : endTime < startTime", AppLogLevel.Trace);
                return;
            }
            TCB.startTime   = startTime_Formatted; //本次查詢的時間範圍起始點，存進TCB
            TCB.endTime     = endTime_Formatted; //本次查詢的時間範圍結束點，存進TCB
            AppLogger.Log_To_File_log(_category, $"[Log][QueryFromDB_InitTCB] step1 : startTime_Formatted = {startTime_Formatted}, endTime_Formatted = {endTime_Formatted}", AppLogLevel.Trace);

            //2. 根據選項 logType, dataType 決定資料表
            TCB.TableName = string.Empty;
            if(string.Equals(selectedLogType, "event", StringComparison.OrdinalIgnoreCase))
            {
                TCB.TableName = "event_log";
            }
            else if(string.Equals(selectedLogType, "data", StringComparison.OrdinalIgnoreCase))
            {
                switch(selectedDataType)
                {
                    case "CAN": TCB.TableName = "datalog_NTN-5K_CAN"; break;
                    case "MOD": TCB.TableName = "datalog_NTN-5K_MOD"; break;
                    default: 
                        AppLogger.Log_To_File_log(_category, $"[Log][QueryFromDB_InitTCB] step2: Error, LogType = data, selectedDataType = None", AppLogLevel.Trace);
                        return;
                }
            }
            else
            {
                AppLogger.Log_To_File_log(_category, $"[Log][QueryFromDB_InitTCB] step2: Error, LogType = {selectedLogType}, DataType = {selectedDataType}", AppLogLevel.Trace);
                return;
            }
            AppLogger.Log_To_File_log(_category, $"[Log][QueryFromDB_InitTCB] step2 : TCB.TableName = {TCB.TableName}", AppLogLevel.Trace);

            //3. 根據時間 查資料總共筆數
            var rangeInfo = await _sqlProcessor.GetTable_Range_AfterWHERE(TCB.TableName, startTime_Formatted, endTime_Formatted);
            getRangeInfo(rangeInfo);

            AppLogger.Log_To_File_log(_category, $"[Log][QueryFromDB_InitTCB] step3 : nowQueryRecordsNum = {TCB.nowQueryRecordsNum}, nowTotalPages = {TCB.nowTotalPages}", AppLogLevel.Trace);
            AppLogger.Log_To_File_log(_category, $"[Log][QueryFromDB_InitTCB] step3 : startId = {TCB.startId}, endId = {TCB.endId}", AppLogLevel.Trace);
            
            //4. 根據LogType查詢(現在只有EventLog)
            if(string.Equals(TCB.TableName, "event_log", StringComparison.OrdinalIgnoreCase))
            {
                bool IsSucc = await eventLog_Query(startTime_Formatted, endTime_Formatted);
                if(!IsSucc)
                {
                    //可以顯示一個 懸浮的FAIL訊息
                    return;
                }
            }
            else
            {
                bool IsSucc = await dataLog_Query(TCB.TableName, startTime_Formatted, endTime_Formatted);
                if(!IsSucc)
                {
                    //可以顯示一個 懸浮的FAIL訊息
                    return;
                }
            }
            
        
            AppLogger.Log_To_File_log(_category, $"[Log][QueryFromDB_InitTCB] step3 : Query Done...", AppLogLevel.Trace);

            //5. 設當前page為1
            TCB.nowTablePage = 1; 
            AppLogger.Log_To_File_log(_category, $"[Log][QueryFromDB_InitTCB] step4 : nowTablePage = {TCB.nowTablePage}", AppLogLevel.Trace);
            //[DEBUG]印出結果
            // var Json_Str = JsonSerializer.Serialize(eventLog_records, new JsonSerializerOptions{
            //     WriteIndented = true
            // });
            // Console.WriteLine(Json_Str);
        }
        catch(Exception e)
        {
            AppLogger.Log_To_File_log(_category, $"[Log][QueryFromDB_InitTCB] Error : {e}", AppLogLevel.Trace);
            return;
        }
    }

    private void getRangeInfo(TableRangeResult rangeInfo)
    {
        if(rangeInfo is not null)
        {
            TCB.nowQueryRecordsNum  = rangeInfo.Count;
            TCB.startId             = rangeInfo.FirstId;
            TCB.endId               = rangeInfo.LastId;
            TCB.nowTotalPages       = (TCB.nowQueryRecordsNum / 10) + 1;
        }
        else
        {
            TCB.nowQueryRecordsNum  = 0;
            TCB.startId             = null;
            TCB.endId               = null;
            TCB.nowTotalPages       = (TCB.nowQueryRecordsNum / 10) + 1;
            AppLogger.Log_To_File_log(_category, $"[Log][getRangeInfo] rangeInfo is null", AppLogLevel.Trace);
            return;
        }
    }

    private async Task<bool> eventLog_Query(DateTime? startTime_Formatted, DateTime? endTime_Formatted)
    {
        try
        {
            //1. 根據時間Query 前10筆 eventLog Table 內的資料
            var eventLog_records = await _sqlProcessor.GetEventLog_WHERE_Time(startTime_Formatted, endTime_Formatted, 10);
            if(eventLog_records is null)
            {
                AppLogger.Log_To_File_log(_category, $"[Log][eventLog_Query] : eventLog_records is null", AppLogLevel.Trace);
                return false;
            }
            AppLogger.Log_To_File_log(_category, $"[Log][eventLog_Query] step1 : GetEventLog_WHERE_Time success", AppLogLevel.Trace);

            //2. 塞進tableData
            tableData.Clear();
            foreach(var record in eventLog_records)
            {
                var row = new Dictionary<string, object>();
                
                foreach(var col in eventLog_allColumns)
                {
                    if(record.TryGetValue(col, out var val))
                    {
                        row[col] = val ?? string.Empty;
                    }
                    else
                    {
                        row[col] = string.Empty;
                    }
                }

                tableData.Add(row);
            }
            AppLogger.Log_To_File_log(_category, $"[Log][eventLog_Query] step2: Put event records into table, success", AppLogLevel.Trace);
            
            //3. 在TCB中紀錄 現在10筆資料 的 最早時間 與 最晚時間，用於翻頁時查詢資料庫的WHERE語法
            var firstRow    = tableData.FirstOrDefault();
            var lastRow     = tableData.LastOrDefault();
            if(firstRow != null && firstRow.ContainsKey("time") && firstRow["time"] is DateTime lastedTime) TCB.lastedTime_InTable      = lastedTime; 
            if(lastRow != null && firstRow.ContainsKey("time") && lastRow["time"] is DateTime earliestTime) TCB.earliestTime_InTable    = earliestTime;
            if(firstRow != null && firstRow.ContainsKey("id") && firstRow["id"] is int lastedId)            TCB.lastedId_InTable        = lastedId;
            if(lastRow != null && firstRow.ContainsKey("id") && lastRow["id"] is int earliestId)            TCB.earliestId_InTable      = earliestId;

            AppLogger.Log_To_File_log(_category, $"[Log][eventLog_Query] step3: earliestTime_InTable = {TCB.earliestTime_InTable}, lastedTime_InTable = {TCB.lastedTime_InTable}", AppLogLevel.Trace);
            AppLogger.Log_To_File_log(_category, $"[Log][eventLog_Query] step3: earliestId_InTable = {TCB.earliestId_InTable}, lastedId_InTable = {TCB.lastedId_InTable}", AppLogLevel.Trace);

            return true;
        }
        catch(Exception e)
        {
            AppLogger.Log_To_File_log(_category, $"[Log][eventLog_Query] Error : {e}", AppLogLevel.Trace);
            return false;
        }
    }
    
    private async Task<bool> dataLog_Query(string targetTable, DateTime? startTime_Formatted, DateTime? endTime_Formatted)
    {
        try
        {
            //1. 根據時間 Query 前10筆 DataLog Table內的資料
            var dataLog_records = await _sqlProcessor.GetDataLog_WHERE_Time(targetTable, startTime_Formatted, endTime_Formatted, 10);
