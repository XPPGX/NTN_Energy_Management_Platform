            if(lastRow != null && lastRow.ContainsKey("timestamp") && lastRow["timestamp"] is DateTime earliestTime)    TCB.earliestTime_InTable    = earliestTime;
            if(firstRow != null && firstRow.ContainsKey("id") && firstRow["id"] is long lastedId)                       TCB.lastedId_InTable        = lastedId;
