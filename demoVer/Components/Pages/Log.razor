    private async Task turnToNextPage() //往右
    {
        //檢查頁數是否超出範圍
        if(TCB.nowTablePage >= TCB.nowTotalPages)
        {
            TCB.nowTablePage = TCB.nowTotalPages;
            UI_PageNum = TCB.nowTablePage;
            AppLogger.Log_To_File_log(_category, $"[Log][turnToNextPage] 已翻到最後一頁", AppLogLevel.Trace);
            return;
        }
        
        //查詢資料，放入TABLE
        bool IsSucc = false;
        if(string.Equals(TCB.TableName, "event_log", StringComparison.OrdinalIgnoreCase))
        {//Event 翻頁
            IsSucc = await eventLog_TurnPage("right", TCB.earliestId_InTable, TCB.startId);
            AppLogger.Log_To_File_log(_category, $"[Log][turnToNextPage] EventLog", AppLogLevel.Trace);
        }
        else 
        {//Data 翻頁
            if (string.IsNullOrEmpty(TCB.TableName))
            {
                AppLogger.Log_To_File_log(_category, "[Log][turnToNextPage] DataLog tableName is null", AppLogLevel.Trace);
                return;
            }

            IsSucc = await dataLog_TurnPage(TCB.TableName, "right", TCB.earliestId_InTable, TCB.startId, TCB.Port);
            AppLogger.Log_To_File_log(_category, $"[Log][turnToNextPage] DataLog", AppLogLevel.Trace);
        }
        if(!IsSucc)
        {
            //可以顯示一個 懸浮的FAIL訊息
            AppLogger.Log_To_File_log(_category, $"[Log][turnToNextPage] Fail", AppLogLevel.Trace);
            return;
        }

        //頁數 + 1
        TCB.nowTablePage ++;
        UI_PageNum = TCB.nowTablePage;
        AppLogger.Log_To_File_log(_category, $"[Log][turnToNextPage] 查詢成功，nowTablePage = {TCB.nowTablePage}", AppLogLevel.Trace);

        //捲軸捲至最上方
        await JS.InvokeVoidAsync("scrollToTop", "log-table-container");
    }
    
    private async Task turnToPreviousPage()
    {
        //檢查頁數是否超出範圍
        if(TCB.nowTablePage <= 1)
        {
            TCB.nowTablePage = 1;
            UI_PageNum = TCB.nowTablePage;
            AppLogger.Log_To_File_log(_category, $"[Log][turnToPreviousPage] 已翻置第一頁", AppLogLevel.Trace);
            return;
        }

        //查詢資料，放入TABLE
        bool IsSucc = false;
        if(string.Equals(TCB.TableName, "event_log", StringComparison.OrdinalIgnoreCase))
        {//Event 翻頁
            AppLogger.Log_To_File_log(_category, $"[Log][turnToNextPage] EventLog", AppLogLevel.Trace);
            IsSucc = await eventLog_TurnPage("left", TCB.lastedId_InTable, TCB.endId);
        }
        else 
        {//Data 翻頁
            AppLogger.Log_To_File_log(_category, $"[Log][turnToNextPage] DataLog", AppLogLevel.Trace);
            if (string.IsNullOrEmpty(TCB.TableName))
            {
                AppLogger.Log_To_File_log(_category, "[Log][turnToPreviousPage] DataLog tableName is null", AppLogLevel.Trace);
                return;
            }

            IsSucc = await dataLog_TurnPage(TCB.TableName, "left", TCB.lastedId_InTable, TCB.endId, TCB.Port);
        }
        if(!IsSucc)
        {
            //可以顯示一個 懸浮的FAIL訊息
            AppLogger.Log_To_File_log(_category, $"[Log][turnToNextPage] Fail", AppLogLevel.Trace);
            return;
        }

        //頁數 - 1
        TCB.nowTablePage --;
        UI_PageNum = TCB.nowTablePage;
        AppLogger.Log_To_File_log(_category, $"[Log][turnToPreviousPage] 查詢成功，nowTablePage = {TCB.nowTablePage}", AppLogLevel.Trace);

        //捲軸捲至最上方
        await JS.InvokeVoidAsync("scrollToTop", "log-table-container");
    }

    private async Task turnToCertainPage()
    {
        Console.WriteLine("TurnToCertainPage");
        
        //檢查頁數是否超出範圍
        if(UI_PageNum < 1 || UI_PageNum > TCB.nowTotalPages)
        {
            UI_PageNum = TCB.nowTablePage;
            AppLogger.Log_To_File_log(_category, $"[Log][turnToCertainPage] 目標page超出範圍", AppLogLevel.Trace);
            return;
        }
        if(TCB.endId is null)
        {
            AppLogger.Log_To_File_log(_category, $"[Log][turnToCertainPage] TCB.endId is null", AppLogLevel.Trace);
            return;
        }

        //由 目標頁數，算 新的 lastedId_InTable，準備當作參數丟到 Function
        long tmp_lastedId_InTable = (TCB.endId ?? 0) - (10 * (UI_PageNum - 1)) + 1;
        AppLogger.Log_To_File_log(_category, $"[Log][turnToCertainPage] tmp_lastedId_InTable = {tmp_lastedId_InTable}", AppLogLevel.Trace);
        
        //查詢資料，放入TABLE
        bool IsSucc = false;
        if(string.Equals(TCB.TableName, "event_log", StringComparison.OrdinalIgnoreCase))
        {
            AppLogger.Log_To_File_log(_category, $"[Log][turnToCertainPage] EventLog", AppLogLevel.Trace);
            IsSucc = await eventLog_TurnPage("right", tmp_lastedId_InTable, TCB.startId);
        }
        else
        {
            AppLogger.Log_To_File_log(_category, $"[Log][turnToCertainPage] DataLog", AppLogLevel.Trace);
            if (string.IsNullOrEmpty(TCB.TableName))
            {
                AppLogger.Log_To_File_log(_category, "[Log][turnToCertainPage] DataLog tableName is null", AppLogLevel.Trace);
                return;
            }

            IsSucc = await dataLog_TurnPage(TCB.TableName, "right", tmp_lastedId_InTable, TCB.startId, TCB.Port);
        }
        if(!IsSucc)
        {
            //可以顯示一個 懸浮的FAIL訊息
            AppLogger.Log_To_File_log(_category, $"[Log][turnToCertainPage] Fail : eventLog_TurnPage", AppLogLevel.Trace);
            return;
        }

        //頁數到指定的頁數
        TCB.nowTablePage = UI_PageNum;
        AppLogger.Log_To_File_log(_category, $"[Log][turnToCertainPage] 查詢成功，nowTablePage = {TCB.nowTablePage}", AppLogLevel.Trace);

        //UI重繪
        await InvokeAsync(StateHasChanged);

        //捲軸捲至最上方
        await JS.InvokeVoidAsync("scrollToTop", "log-table-container");
    }

