    private(double min, double max) GetDisplaySliderRange(string label)
    {
        return label switch
        {
            "CC" => (DataCenter.Battery.CC_Min_Display, DataCenter.Battery.CC_Max_Display),
            "TC" => (DataCenter.Battery.TC_Min_Display, DataCenter.Battery.CC_Max_Display),
            "CV" => (DataCenter.Battery.CV_Min_Display, DataCenter.Battery.CV_Max_Display),
            "FV" => (DataCenter.Battery.FV_Min_Display, DataCenter.Battery.CV_Max_Display),
            _ => (0, 100)
        };
    }

    private async Task OnSliderMouseDown(MouseEventArgs e, int index, string label)
    {
        var (min, displayMax) = GetDisplaySliderRange(label);
        await StartMouseDrag(e, index, min, displayMax);
    }

    private async Task OnSliderTouchStart(TouchEventArgs e, int index, string label)
    {
        var (min, displayMax) = GetDisplaySliderRange(label);
        await StartTouchDrag(e, index, min, displayMax);
    }

    private void OnCCTimeoutValueChanged()
    {
        if (CC_Timeout_value < 0)
        {
            CC_Timeout_value = 0;
        }
    }

    private void OnCVTimeoutValueChanged()
    {
        if (CV_Timeout_value < 0)
        {
            CV_Timeout_value = 0;
        }
    }

    private void OnFVTimeoutValueChanged()
    {
        if (FV_Timeout_value < 0)
        {
            FV_Timeout_value = 0;
        }
    }

    private async Task ReceiveFrom_TopRow_SaveBatterySetting()
    {
        TriggerAlert("Save");
    }

    private async Task ReceiveFrom_TopRow_ApplyDefaultValue()
    {
        TriggerAlert("DefaultVal");
    }

    private void TriggerAlert(string _alertMessage_FromOtherFunc)
    {
        
        modal_IsOpen = true;

        AlertMessage_parent     = "";
        ConfirmBtn_Text_parent  = "";
        CancelBtn_Text_parent   = "";
        ConfirmBtn_Func_parent  = EventCallback.Empty;
        CancelBtn_Func_parent   = EventCallback.Empty;
        switch(_alertMessage_FromOtherFunc)
        {
            case "Save":
                AlertMessage_parent     = "是否確定要保存？";
                ConfirmBtn_Text_parent  = "確定";
                CancelBtn_Text_parent   = "取消";
                ConfirmBtn_Func_parent  = EventCallback.Factory.Create(this, ConfirmSave);
                CancelBtn_Func_parent   = EventCallback.Factory.Create(this, CancelSave);
                break;
            case "DefaultVal":
                AlertMessage_parent     = "確定要還原預設？";
                ConfirmBtn_Text_parent  = "確定";
                CancelBtn_Text_parent   = "取消";
                ConfirmBtn_Func_parent  = EventCallback.Factory.Create(this, ConfirmDefault);
                CancelBtn_Func_parent   = EventCallback.Factory.Create(this, CancelDefault);
                break;
            default:
                break;
        }
    }

    private void CloseAlert()
    {
        AlertMessage_parent = null;
    }
    private void CloseModal()
    {   
        //close modal
        modal_IsOpen = false;
        //Close Alert
        AlertMessage_parent = null;
    }

    private async Task<Dictionary<string, byte[]>> nowUIData_transformTo_apiWriteData(List<double> sliderValues)
    {
        Dictionary<string, byte[]> packedByteData = new ();
        byte[] CURVE_CC = new byte[2];
        byte[] CURVE_TC = new byte[2];
        byte[] CURVE_CV = new byte[2];
        byte[] CURVE_FV = new byte[2];
        byte[] CURVE_CONFIG = new byte[2];
        //CURVE_CONFIG bit description
        //bit 6: curve stage
        //bit 8: CC timeout enable
        //bit 9: CV timeout enable
        //bit 10: FV timeout enable
        byte[] CURVE_CC_TIMEOUT = new byte[2];
        byte[] CURVE_CV_TIMEOUT = new byte[2];
        byte[] CURVE_FV_TIMEOUT = new byte[2];

        //CURVE_CONFIG (STGS)
        switch(selectedStage)
        {
            case true:
                CURVE_CONFIG[0] = (byte)(CURVE_CONFIG[0] & (byte)(0b_1011_1111));
                CURVE_CONFIG[0] = (byte)(CURVE_CONFIG[0] | (byte)(0b_0100_0000));
                break;
            case false:
                CURVE_CONFIG[0] = (byte)(CURVE_CONFIG[0] & (byte)(0b_1011_1111));
                break;
            default:
                CURVE_CONFIG[0] = (byte)(CURVE_CONFIG[0] & (byte)(0b_1011_1111));
                break;
        }

        //CURVE_CONFIG (CCTOE);
        switch(CCT_Enable)
        {
            case true:
                CURVE_CONFIG[1] = (byte)(CURVE_CONFIG[1] & (byte)(0b_1111_1110));
                CURVE_CONFIG[1] = (byte)(CURVE_CONFIG[1] | (byte)(0b_0000_0001));
                break;
            case false:
                CURVE_CONFIG[1] = (byte)(CURVE_CONFIG[1] & (byte)(0b_1111_1110));
                break;
            default:
                CURVE_CONFIG[1] = (byte)(CURVE_CONFIG[1] & (byte)(0b_1111_1110));
                break;
        }

        //CURVE_CONFIG (CVTOE);
        switch(CVT_Enable)
        {
            case true:
                CURVE_CONFIG[1] = (byte)(CURVE_CONFIG[1] & (byte)(0b_1111_1101));
                CURVE_CONFIG[1] = (byte)(CURVE_CONFIG[1] | (byte)(0b_0000_0010));
                break;
            case false:
                CURVE_CONFIG[1] = (byte)(CURVE_CONFIG[1] & (byte)(0b_1111_1101));
                break;
            default:
                CURVE_CONFIG[1] = (byte)(CURVE_CONFIG[1] & (byte)(0b_1111_1101));
                break;
        }

        //CURVE_CONFIG (FVTOE);
        switch(FVT_Enable)
        {
            case true:
                CURVE_CONFIG[1] = (byte)(CURVE_CONFIG[1] & (byte)(0b_1111_1011));
                CURVE_CONFIG[1] = (byte)(CURVE_CONFIG[1] | (byte)(0b_0000_0100));
                break;
            case false:
                CURVE_CONFIG[1] = (byte)(CURVE_CONFIG[1] & (byte)(0b_1111_1011));
                break;
            default:
                CURVE_CONFIG[1] = (byte)(CURVE_CONFIG[1] & (byte)(0b_1111_1011));
                break;
        }

        CURVE_CC = await writeProcess.UIvalueTransformToWriteFormat(sliderValues[0], "CURVE_CC");
        CURVE_TC = await writeProcess.UIvalueTransformToWriteFormat(sliderValues[1], "CURVE_TC");
        CURVE_CV = await writeProcess.UIvalueTransformToWriteFormat(sliderValues[2], "CURVE_CV");
        CURVE_FV = await writeProcess.UIvalueTransformToWriteFormat(sliderValues[3], "CURVE_FV");
        
        CURVE_CC_TIMEOUT = await writeProcess.UIvalueTransformToWriteFormat(CC_Timeout_value, "CURVE_CC_TIMEOUT");
        CURVE_CV_TIMEOUT = await writeProcess.UIvalueTransformToWriteFormat(CV_Timeout_value, "CURVE_CV_TIMEOUT");
        CURVE_FV_TIMEOUT = await writeProcess.UIvalueTransformToWriteFormat(FV_Timeout_value, "CURVE_FV_TIMEOUT");

        AppLogger.Log_To_File_log(_category, $"[Battery_setting][nowUIData_transformTo_apiWriteData] CURVE_CC          = {CURVE_CC[1]:X2} {CURVE_CC[0]:X2}",      AppLogLevel.Trace);
        AppLogger.Log_To_File_log(_category, $"[Battery_setting][nowUIData_transformTo_apiWriteData] CURVE_TC          = {CURVE_TC[1]:X2} {CURVE_TC[0]:X2}",      AppLogLevel.Trace);
        AppLogger.Log_To_File_log(_category, $"[Battery_setting][nowUIData_transformTo_apiWriteData] CURVE_CV          = {CURVE_CV[1]:X2} {CURVE_CV[0]:X2}",      AppLogLevel.Trace);
        AppLogger.Log_To_File_log(_category, $"[Battery_setting][nowUIData_transformTo_apiWriteData] CURVE_FV          = {CURVE_FV[1]:X2} {CURVE_FV[0]:X2}",      AppLogLevel.Trace);
        AppLogger.Log_To_File_log(_category, $"[Battery_setting][nowUIData_transformTo_apiWriteData] CURVE_CC_TIMEOUT  = {CURVE_CC_TIMEOUT[1]:X2} {CURVE_CC_TIMEOUT[0]:X2}",      AppLogLevel.Trace);
        AppLogger.Log_To_File_log(_category, $"[Battery_setting][nowUIData_transformTo_apiWriteData] CURVE_CV_TIMEOUT  = {CURVE_CV_TIMEOUT[1]:X2} {CURVE_CV_TIMEOUT[0]:X2}",      AppLogLevel.Trace);
        AppLogger.Log_To_File_log(_category, $"[Battery_setting][nowUIData_transformTo_apiWriteData] CURVE_FV_TIMEOUT  = {CURVE_FV_TIMEOUT[1]:X2} {CURVE_FV_TIMEOUT[0]:X2}",      AppLogLevel.Trace);
        AppLogger.Log_To_File_log(_category, $"[Battery_setting][nowUIData_transformTo_apiWriteData] CURVE_CONFIG      = {CURVE_CONFIG[1]:X2} {CURVE_CONFIG[0]:X2}",      AppLogLevel.Trace);


        packedByteData["CURVE_CC"]          = CURVE_CC;
        packedByteData["CURVE_TC"]          = CURVE_TC;
        packedByteData["CURVE_CV"]          = CURVE_CV;
        packedByteData["CURVE_FV"]          = CURVE_FV;
        packedByteData["CURVE_CC_TIMEOUT"]  = CURVE_CC_TIMEOUT;
        packedByteData["CURVE_CV_TIMEOUT"]  = CURVE_CV_TIMEOUT;
        packedByteData["CURVE_FV_TIMEOUT"]  = CURVE_FV_TIMEOUT;
        packedByteData["CURVE_CONFIG"]      = CURVE_CONFIG;
        return packedByteData;
    }

    private async Task ConfirmSave()
    {
        //Get CC, TC, CV, FV Data
        var sliderValues = new List<double>();
        sliderValues = (await JS.InvokeAsync<double[]>("transferSliderValue")).ToList();

        //arrange data
        BatterySetting Data = new BatterySetting()
        {
            CC_Display = sliderValues[0],
            TC_Display = sliderValues[1],
            CV_Display = sliderValues[2],
            FV_Display = sliderValues[3],
            CurveStage = selectedStage,
            CCT_Enable = CCT_Enable,
            CC_TimeOut_Display = CC_Timeout_value,
            CVT_Enable = CVT_Enable,
            CV_TimeOut_Display = CV_Timeout_value,
            FVT_Enable = FVT_Enable,
            FV_TimeOut_Display = FV_Timeout_value,
        };

        //1. 轉 UI值 成 WriteAPI值
        var _packedByteData_dict = await nowUIData_transformTo_apiWriteData(sliderValues);
        //2. _packedByteData 傳到 WriteProcess發送
        try
        {
            bool isWriteSuccess = await writeProcess.Write_To_Framework(_packedByteData_dict, 0);
            if(isWriteSuccess is false)
            {
                AppLogger.Log_To_File_log(_category, $"[Battery_setting][ConfirmSave] Writing To device failed", AppLogLevel.Trace);
                return;
            }

            //成功寫值到Framework之後
            //3. 將設定值存於記憶體，JsonFile
            bool isSaveSettingToFile_Succ = await DataCenter.save_BATSetting(Data);
            if(isSaveSettingToFile_Succ is false)
            {
                AppLogger.Log_To_File_log(_category, $"[Battery_setting][ConfirmSave] save To memory or Json failed", AppLogLevel.Trace);
                return;
            }
            //4. 同步Battery setting值到其他Client端
            await DataCenter.BroadcastBatteryChangeAsync();
        }
        finally
        {
            CloseAlert();
            CloseModal();
            Console.WriteLine("[ConfirmSave]");
        }
        
        //save into DataCenter (for boardcast)
        @* if(DataCenter.Battery.SaveSettingData(Data))
        {
            await DataCenter.BroadcastBatteryChangeAsync();
        } *@
         
        //save as Json file (Or use API to call framework to save the setting)
        @*這裡或許要改成用API去改值就好，讓框架去下命令後保存此次設定以便下次帶入*@
        string jsonString = JsonSerializer.Serialize(Data, new JsonSerializerOptions{WriteIndented=true});
        Console.WriteLine(jsonString);
    }

