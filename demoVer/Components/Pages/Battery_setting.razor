<MudPopoverProvider/>
@*Web Content*@
<PageTitle>Battery Setting</PageTitle>



@if(modal_IsOpen)
{
    <div class="modal-overlay" @onclick="CloseModal">
        @if(!string.IsNullOrEmpty(AlertMessage_parent))
        {
            <AlertMessageBox
                Message         = "@AlertMessage_parent"
                ConfirmBtn_Text = "@ConfirmBtn_Text_parent"
                CancelBtn_Text  = "@CancelBtn_Text_parent"
                ConfirmBtn_Func = "@ConfirmBtn_Func_parent"
                CancelBtn_Func  = "@CancelBtn_Func_parent"
                />
        }
    </div>
}

<div class="whole">
    <div class="top">
        <div class="leftPart">
            <div class="subsystem-select-group">
                <label for="subsystem-select" class="local-label">子系統選擇</label>
                <select id="subsystem-select" class="subsystem-select" value="@SelectedSubSystemKey" @onchange="Local_OnSubSystemChanged" @onclick:stopPropagation="true" @onchange:stopPropagation="true">
                    @if(_subSystemOptions.Count == 0)
                    {
                        <option value="">請選擇子系統</option>
                        @* <option value="" disabled>無可用子系統</option> *@
                    }
                    else
                    {
                        foreach (var subSystem in _subSystemOptions)
                        {
                            <option value="@BuildKey(subSystem.Port, subSystem.Protocol)">@GetSubSystemDisplay(subSystem)</option>
                        }
                    }
                </select>
            </div>
        </div>
        <div class="rightPart">
            <button type="button" class="btn btn-blue no-flex" @onclick="OnRefreshButtonClick">重新整理</button>
            <button type="button" class="btn btn-primary no-flex" @onclick="OnSaveButtonClick">保存設定</button>
        </div>
    </div>
    <div class="content-container">
    <div class="card-grid">
        <div class="cell4 card-container-layout card-container-base">
            @if(Init_Flag)
            {
                <h3></h3>
                for(int i = 0 ; i < Sliders.Count ; i ++)
                {
                    var localIndex = i;
                    var slider = Sliders[i];
                    <div class="slider-wrapper">
                        <div class="vue-vertical-slider"
                            style="@(slider.Label == "FV" && !selectedStage ? "opacity: 0.5;" : "")"
                            @onmousedown="@(e => (slider.Label == "FV" && !selectedStage) ? Task.CompletedTask : OnSliderMouseDown(e, localIndex, slider.Label))"
                            @ontouchstart="@(e => (slider.Label == "FV" && !selectedStage) ? Task.CompletedTask : OnSliderTouchStart(e, localIndex, slider.Label))">
                            <div class="vue-vertical-fill" @ref="@FillRefs[localIndex]"></div>
                            <div class="vue-vertical-thumb" @ref="@ThumbRefs[localIndex]"></div>
                        </div>
                        <input type="number"
                                id="slider-input-@localIndex"
                                step="0.1"
                                min=""
                                max=""
                                class="slider-input"
                                style="text-align: center;"
                                disabled="@(slider.Label == "FV" && !selectedStage)"/>
                        @* <div class="slider-label">值: @slider.Value</div> *@
                        <label>@slider.Label</label>
                    </div>
                }
            }
        </div>
        
        <div class="cell8">
            <div class="right-part">
                <div class="card-container-stage card-container-base">
                    <canvas id="stageChart" class="stage-chart"></canvas>
                    <div class="stage-controls">
                        <select value="@selectedStage.ToString().ToLower()" @onchange="OnStageSelectChanged" @onclick:stopPropagation="true" @onchange:stopPropagation="true">
                            <option value="false">2階段</option>
                            <option value="true">3階段</option>
                        </select>
                    </div>
                </div>
                
                <div class="card-container-timeout card-container-base">
                    <div class="timeout-group">
                        <label class="custom-toggle-button" title="@(CCT_Enable ? "On" : "Off")">
                            <input type="checkbox" @bind="CCT_Enable" />
                            <span class="toggle-slider"></span>
                        </label>
                        <span style="display: inline-block;">@(!isMobile ? "CC timeout" : "CCT")</span>
                        <div class="inputField">
                            <input type="number" @bind-value="CC_Timeout_value" @bind-value:after="OnCCTimeoutValueChanged" placeholder="CCT" min="0" />
                            @if(!isMobile)
                            {
                                <MudText Typo="Typo.body1">@FormatToHourMin(CC_Timeout_value)</MudText>
                            }
                            else
                            {
                                <div class="dateTime">@FormatToHourMin(CC_Timeout_value)</div>
                            }
                        </div>
                        @if(!isMobile)
                        {
                            <div class="responsive-slider">
                                <input type="range" @bind="CC_Timeout_value" @bind:event="oninput" min="0" max="6000" step="1" class="custom-slider" />
                            </div>
                        }
                    </div>
                    <div class="timeout-group">
                        <label class="custom-toggle-button" title="@(CVT_Enable ? "On" : "Off")">
                            <input type="checkbox" @bind="CVT_Enable" />
                            <span class="toggle-slider"></span>
                        </label>
                        <span style="display: inline-block;">@(!isMobile ? "CV timeout" : "CVT")</span>
                        <div class="inputField">
                            <input type="number" @bind-value="CV_Timeout_value" @bind-value:after="OnCVTimeoutValueChanged" placeholder="CVT" min="0" />
                            @if(!isMobile)
                            {
                                <MudText Typo="Typo.body1">@FormatToHourMin(CV_Timeout_value)</MudText>
                            }
                            else
                            {
                                <div class="dateTime">@FormatToHourMin(CV_Timeout_value)</div>
                            }
                        </div>
                        @if(!isMobile)
                        {
                            <div class="responsive-slider">
                                <input type="range" @bind="CV_Timeout_value" @bind:event="oninput" min="0" max="6000" step="1" class="custom-slider" />
                            </div>
                        }
                    </div>
                    <div class="timeout-group">
                        <label class="custom-toggle-button" title="@(FVT_Enable ? "On" : "Off")">
                            <input type="checkbox" @bind="FVT_Enable" />
                            <span class="toggle-slider"></span>
                        </label>
                        <span style="display: inline-block;">@(!isMobile ? "FV timeout" : "FVT")</span>
                        <div class="inputField">
                            <input type="number" @bind-value="FV_Timeout_value" @bind-value:after="OnFVTimeoutValueChanged" placeholder="FVT" min="0"/>
                            @if(!isMobile)
                            {
                                <MudText Typo="Typo.body1">@FormatToHourMin(FV_Timeout_value)</MudText>
                            }
                            else
                            {
                                <div class="dateTime">@FormatToHourMin(FV_Timeout_value)</div>
                            }
                        </div>
                        @if(!isMobile)
                        {
                            <div class="responsive-slider">
                                <input type="range" @bind="FV_Timeout_value" @bind:event="oninput" min="0" max="6000" step="1" class="custom-slider" />
                            </div>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
</div> 




