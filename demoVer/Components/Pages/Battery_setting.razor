@page "/Battery_setting"

@rendermode InteractiveServer
@inject IJSRuntime JS
@inject DataCenter DataCenter
@using demoVer.Components.Layout
@using demoVer.Models
@using System.Text.Json
@using System.IO
@using demoVer.Utils
@inject WriteProcess writeProcess
@inject CommonData commonData
@inject HeartbeatService Heartbeat

<MudPopoverProvider/>
@*Web Content*@
<PageTitle>Battery Setting</PageTitle>



@if(modal_IsOpen)
{
    <div class="modal-overlay" @onclick="CloseModal">
        @if(!string.IsNullOrEmpty(AlertMessage_parent))
        {
            <AlertMessageBox
                Message         = "@AlertMessage_parent"
                ConfirmBtn_Text = "@ConfirmBtn_Text_parent"
                CancelBtn_Text  = "@CancelBtn_Text_parent"
                ConfirmBtn_Func = "@ConfirmBtn_Func_parent"
                CancelBtn_Func  = "@CancelBtn_Func_parent"
                />
        }
    </div>
}

<div class="content-container">
    <div class="card-grid">
        <div class="cell4 card-container-layout card-container-base">
            @if(Init_Flag)
            {
                <h3></h3>
                for(int i = 0 ; i < Sliders.Count ; i ++)
                {
                    var localIndex = i;
                    var slider = Sliders[i];
                    <div class="slider-wrapper">
                        <div class="vue-vertical-slider"
                            style="@(slider.Label == "FV" && !selectedStage ? "opacity: 0.5;" : "")"
                            @onmousedown="@(e => (slider.Label == "FV" && !selectedStage) ? Task.CompletedTask : OnSliderMouseDown(e, localIndex, slider.Label))"
                            @ontouchstart="@(e => (slider.Label == "FV" && !selectedStage) ? Task.CompletedTask : OnSliderTouchStart(e, localIndex, slider.Label))">
                            <div class="vue-vertical-fill" @ref="@FillRefs[localIndex]"></div>
                            <div class="vue-vertical-thumb" @ref="@ThumbRefs[localIndex]"></div>
                        </div>
                        <input type="number"
                                id="slider-input-@localIndex"
                                step="0.1"
                                min=""
                                max=""
                                class="slider-input"
                                style="text-align: center;"
                                disabled="@(slider.Label == "FV" && !selectedStage)"/>
                        @* <div class="slider-label">值: @slider.Value</div> *@
                        <label>@slider.Label</label>
                    </div>
                }
            }
        </div>
        
        <div class="cell8">
            <div class="right-part">

                <div class="card-container-stage card-container-base">
                    <canvas id="stageChart" class="stage-chart"></canvas>
                    <div class="stage-controls">
                        <select value="@selectedStage.ToString().ToLower()" @onchange="OnStageSelectChanged" @onclick:stopPropagation="true" @onchange:stopPropagation="true">
                            <option value="false">2階段</option>
                            <option value="true">3階段</option>
                        </select>
                    </div>
                </div>
                
                <div class="card-container-timeout card-container-base">
                    <div class="timeout-group">
                        <label class="custom-toggle-button" title="@(CCT_Enable ? "On" : "Off")">
                            <input type="checkbox" @bind="CCT_Enable" />
                            <span class="toggle-slider"></span>
                        </label>
                        <span style="display: inline-block;">@(!isMobile ? "CC timeout" : "CCT")</span>
                        <div class="inputField">
                            <input type="number" @bind-value="CC_Timeout_value" @bind-value:after="OnCCTimeoutValueChanged" placeholder="CCT" min="0" />
                            @if(!isMobile)
                            {
                                <MudText Typo="Typo.body1">@FormatToHourMin(CC_Timeout_value)</MudText>
                            }
                            else
                            {
                                <div class="dateTime">@FormatToHourMin(CC_Timeout_value)</div>
                            }
                        </div>
                        @if(!isMobile)
                        {
                            <div class="responsive-slider">
                                <input type="range" @bind="CC_Timeout_value" @bind:event="oninput" min="0" max="6000" step="1" class="custom-slider" />
                            </div>
                        }
                    </div>
                    <div class="timeout-group">
                        <label class="custom-toggle-button" title="@(CVT_Enable ? "On" : "Off")">
                            <input type="checkbox" @bind="CVT_Enable" />
                            <span class="toggle-slider"></span>
                        </label>
                        <span style="display: inline-block;">@(!isMobile ? "CV timeout" : "CVT")</span>
                        <div class="inputField">
                            <input type="number" @bind-value="CV_Timeout_value" @bind-value:after="OnCVTimeoutValueChanged" placeholder="CVT" min="0" />
                            @if(!isMobile)
                            {
                                <MudText Typo="Typo.body1">@FormatToHourMin(CV_Timeout_value)</MudText>
                            }
                            else
                            {
                                <div class="dateTime">@FormatToHourMin(CV_Timeout_value)</div>
                            }
                        </div>
                        @if(!isMobile)
                        {
                            <div class="responsive-slider">
                                <input type="range" @bind="CV_Timeout_value" @bind:event="oninput" min="0" max="6000" step="1" class="custom-slider" />
                            </div>
                        }
                    </div>
                    <div class="timeout-group">
                        <label class="custom-toggle-button" title="@(FVT_Enable ? "On" : "Off")">
                            <input type="checkbox" @bind="FVT_Enable" />
                            <span class="toggle-slider"></span>
                        </label>
                        <span style="display: inline-block;">@(!isMobile ? "FV timeout" : "FVT")</span>
                        <div class="inputField">
                            <input type="number" @bind-value="FV_Timeout_value" @bind-value:after="OnFVTimeoutValueChanged" placeholder="FVT" min="0"/>
                            @if(!isMobile)
                            {
                                <MudText Typo="Typo.body1">@FormatToHourMin(FV_Timeout_value)</MudText>
                            }
                            else
                            {
                                <div class="dateTime">@FormatToHourMin(FV_Timeout_value)</div>
                            }
                        </div>
                        @if(!isMobile)
                        {
                            <div class="responsive-slider">
                                <input type="range" @bind="FV_Timeout_value" @bind:event="oninput" min="0" max="6000" step="1" class="custom-slider" />
                            </div>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@code
{
    [CascadingParameter(Name = "MainLayout")] public MainLayout? MainLayout { get; set; }

    private string _category = "";

    bool modal_IsOpen = false;
    string AlertMessage_parent = null;
    string ConfirmBtn_Text_parent = null;
    string CancelBtn_Text_parent = null;
    public EventCallback ConfirmBtn_Func_parent {get; set;}
    public EventCallback CancelBtn_Func_parent {get; set;}

    private bool isMobile;
    private DotNetObjectReference<Battery_setting> dotNetRef;
    private bool Init_Flag = false;
    private List<ElementReference>  FillRefs = new();
    private List<ElementReference>  ThumbRefs = new();

    private bool[] _sliderInitFlags;
    public class SliderItem
    {
        public double Value {get; set;}
        public string Label {get; set;} = null;
    }

    public List<SliderItem> Sliders = new();
    private ElementReference FillRef;
    private ElementReference ThumbRef;

    private double rangeValue;
    public bool CCT_Enable {get; set;}
    public bool CVT_Enable {get; set;}
    public bool FVT_Enable {get; set;}
    private int CC_Timeout_value;
    private int CV_Timeout_value;
    private int FV_Timeout_value;

    private bool selectedStage = false; //預設為 3段
    private bool topRowCallbacksRegistered = false;

    private string FormatToHourMin(double totalMin)
    {
        int hours = (int)(totalMin / 60);
        int minutes = (int)(totalMin % 60);
        return $"{hours} 小時 {minutes} 分";
    }

    private async Task OnStageSelectChanged(ChangeEventArgs e)
    {
        Console.WriteLine($"stageChanged");
        if (e.Value != null && bool.TryParse(e.Value.ToString(), out bool value))
        {
            selectedStage = value;
            Console.WriteLine($"selectedStage = {selectedStage}");

            await JS.InvokeVoidAsync("setStage", selectedStage);
            await JS.InvokeVoidAsync("drawChart_Stage");
            InvokeAsync(StateHasChanged);
        }
    }



    protected override void OnInitialized()
    {
        _category = GetType().FullName!;
        DataCenter.Battery.OnUpdated += OnBatteryChanged;

        Sliders = new List<SliderItem>
        {
            //index = 0
            new SliderItem { Label = "CC", Value = DataCenter.Battery.CC_Display},
            //index = 1
            new SliderItem { Label = "TC", Value = DataCenter.Battery.TC_Display},
            //index = 2
            new SliderItem { Label = "CV", Value = DataCenter.Battery.CV_Display},
            //index = 3
            new SliderItem { Label = "FV", Value = DataCenter.Battery.FV_Display}
        };
        FillRefs = new List<ElementReference>(new ElementReference[Sliders.Count]);
        ThumbRefs = new List<ElementReference>(new ElementReference[Sliders.Count]);
        
        Init_Flag = true;

        _sliderInitFlags = new bool[Sliders.Count];
        
    }

    protected override void OnParametersSet()
    {
        if (!topRowCallbacksRegistered && MainLayout != null)
        {
            MainLayout.RegisterTopRowCallbacks(
                this,
                informParentToApplySetting: ReceiveFrom_TopRow_SaveBatterySetting,
                informParentToUseDefaultValue: ReceiveFrom_TopRow_ApplyDefaultValue);
            topRowCallbacksRegistered = true;
        }
    }

    private void OnBatteryChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        DataCenter.Battery.OnUpdated -= OnBatteryChanged;
        if (topRowCallbacksRegistered)
        {
            MainLayout?.ClearTopRowCallbacks(this);
            topRowCallbacksRegistered = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            //把JS中的chartInstances清空
            await JS.InvokeVoidAsync("destroyAllCharts");

            Console.WriteLine($"isMobile = {isMobile}");
            dotNetRef = DotNetObjectReference.Create(this);
        
            await JS.InvokeVoidAsync("startBatteryHub", dotNetRef);

            await JS.InvokeVoidAsync("setSliderBars_Info", new{
                cc_val = DataCenter.Battery.CC_Display,
                cc_controlMax = DataCenter.Battery.CC_Max_Display,
                cc_minValue = DataCenter.Battery.CC_Min_Display,
                cc_UI_MAX = DataCenter.Battery.CC_Max_Display,
                cc_fill = FillRefs[0],
                cc_thumb = ThumbRefs[0],

                tc_val = DataCenter.Battery.TC_Display,
                tc_controlMax = DataCenter.Battery.TC_Max_Display,
                tc_minValue = DataCenter.Battery.TC_Min_Display,
                tc_UI_MAX = DataCenter.Battery.CC_Max_Display,
                tc_fill = FillRefs[1],
                tc_thumb = ThumbRefs[1],

                cv_val = DataCenter.Battery.CV_Display,
                cv_controlMax = DataCenter.Battery.CV_Max_Display,
                cv_minValue = DataCenter.Battery.CV_Min_Display,
                cv_UI_MAX = DataCenter.Battery.CV_Max_Display,
                cv_fill = FillRefs[2],
                cv_thumb = ThumbRefs[2],

                fv_val = DataCenter.Battery.FV_Display,
                fv_controlMax = DataCenter.Battery.CV_Max_Display,
                fv_minValue = DataCenter.Battery.FV_Min_Display,
                fv_UI_MAX = DataCenter.Battery.CV_Max_Display,
                fv_fill = FillRefs[3],
                fv_thumb = ThumbRefs[3],
            });

            for(int i = 0 ; i < Sliders.Count ; i ++)
            {
                var slider = Sliders[i];
                var (_, max) = GetDisplaySliderRange(slider.Label);

                await JS.InvokeVoidAsync("updateSliderVisual", new{
                    fill = FillRefs[i],
                    thumb = ThumbRefs[i],
                    value = slider.Value,
                    displayMaxValue = max,
                });
            }
            
            await JS.InvokeVoidAsync("sliderUpdateFromInput", dotNetRef);
            await JS.InvokeVoidAsync("setStage", selectedStage);
            await JS.InvokeVoidAsync("drawChart_Stage", true);
            isMobile = await JS.InvokeAsync<bool>("checkIsMobile");
            if(isMobile)
            {
                StateHasChanged();
            }
        }
    }

    private async Task StartMouseDrag(MouseEventArgs e, int index, double _Min, double _displayMax)
    {
        var slider = Sliders[index];
        await JS.InvokeVoidAsync("startVerticalSliderDrag", new{
            fill = FillRefs[index],
            thumb = ThumbRefs[index],
            dotNetHelper = dotNetRef,
            index = index,
            minValue = _Min,
            displayMaxValue = _displayMax
        });
    }

    private async Task StartTouchDrag(TouchEventArgs e, int index, double _Min, double _displayMax)
    {
        var slider = Sliders[index];
        await JS.InvokeVoidAsync("startVerticalSliderDrag", new{
            fill = FillRefs[index],
            thumb = ThumbRefs[index],
            dotNetHelper = dotNetRef,
            index = index,
            minValue = _Min,
            displayMaxValue = _displayMax
        });
    }

    private async Task OnSliderInputChanged(int index)
    {
        var value = Sliders[index].Value;
        var (_, max) = GetDisplaySliderRange(Sliders[index].Label);
        await JS.InvokeVoidAsync("updateSliderVisual", new{
            fill = FillRefs[index],
            thumb = ThumbRefs[index],
            value = Sliders[index].Value,
            displayMaxValue = max,
        });
    }


