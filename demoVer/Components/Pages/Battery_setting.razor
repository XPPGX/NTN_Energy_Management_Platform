    #region JsCallerAndCallee
    [JSInvokable("OnSubSysUpdated")]
    public async Task OnSubSysUpdated(JsonElement SubSysConfigurableData)
    {
        // 解析 batteryData → 更新 Sliders / Timeout / Enable 等 UI
        // 然後刷新畫面
        var options = new JsonSerializerOptions
        {
            PropertyNameCaseInsensitive = true
        };

        var ReceiveData_FromSignalR = SubSysConfigurableData.Deserialize<PageUsableVars>(options);
        if (ReceiveData_FromSignalR == null)
        {
            Console.WriteLine("❌ [Battery_setting][OnSubSysUpdated] 無法反序列化 SubSysConfigurableData_To_JS");
            return;
        }
        Console.WriteLine("🔁 收到 SubSysConfigurableData 更新");

        //從FrameWork讀回來的時候，不會進到這四個if-statement，因為機器的值不會在上下限之外
        if ( ReceiveData_FromSignalR.CURVE_CC_val < ReceiveData_FromSignalR.CURVE_CC_Min_val ||
             ReceiveData_FromSignalR.CURVE_CC_val > ReceiveData_FromSignalR.CURVE_CC_Max_val ) { ReceiveData_FromSignalR.CURVE_CC_val = ReceiveData_FromSignalR.CURVE_CC_Min_val; } //CC
        if ( ReceiveData_FromSignalR.CURVE_TC_val < ReceiveData_FromSignalR.CURVE_TC_Min_val ||
             ReceiveData_FromSignalR.CURVE_TC_val > ReceiveData_FromSignalR.CURVE_TC_Max_val ) { ReceiveData_FromSignalR.CURVE_TC_val = ReceiveData_FromSignalR.CURVE_TC_Min_val; } //TC
        if ( ReceiveData_FromSignalR.CURVE_CV_val < ReceiveData_FromSignalR.CURVE_CV_Min_val ||
             ReceiveData_FromSignalR.CURVE_CV_val > ReceiveData_FromSignalR.CURVE_CV_Max_val ) { ReceiveData_FromSignalR.CURVE_CV_val = ReceiveData_FromSignalR.CURVE_CV_Min_val; } //CV
        if ( ReceiveData_FromSignalR.CURVE_FV_val < ReceiveData_FromSignalR.CURVE_FV_Min_val ||
             ReceiveData_FromSignalR.CURVE_FV_val > ReceiveData_FromSignalR.CURVE_FV_Max_val ) { ReceiveData_FromSignalR.CURVE_FV_val = ReceiveData_FromSignalR.CURVE_FV_Min_val;} //FV
        await JS.InvokeVoidAsync("setSliderBars_Info", new{
            cc_val = ReceiveData_FromSignalR.CURVE_CC_val,
            cc_controlMax = ReceiveData_FromSignalR.CURVE_CC_Max_val,
            cc_minValue = ReceiveData_FromSignalR.CURVE_CC_Min_val,
            cc_UI_MAX = ReceiveData_FromSignalR.CURVE_CC_Max_val,
            cc_fill = FillRefs[0],
            cc_thumb = ThumbRefs[0],

            tc_val = ReceiveData_FromSignalR.CURVE_TC_val,
            tc_controlMax = ReceiveData_FromSignalR.CURVE_TC_Max_val,
            tc_minValue = ReceiveData_FromSignalR.CURVE_TC_Min_val,
            tc_UI_Max = ReceiveData_FromSignalR.CURVE_CC_Max_val,
            tc_fill = FillRefs[1],
            tc_thumb = ThumbRefs[1],

            cv_val = ReceiveData_FromSignalR.CURVE_CV_val,
            cv_controlMax = ReceiveData_FromSignalR.CURVE_CV_Max_val,
            cv_minValue = ReceiveData_FromSignalR.CURVE_CV_Min_val,
            cv_UI_Max = ReceiveData_FromSignalR.CURVE_CV_Max_val,
            cv_fill = FillRefs[2],
            cv_thumb = ThumbRefs[2],

            fv_val = ReceiveData_FromSignalR.CURVE_FV_val,
            fv_controlMax = ReceiveData_FromSignalR.CURVE_CV_Max_val,
            fv_minValue = ReceiveData_FromSignalR.CURVE_FV_Min_val,
            fv_UI_Max = ReceiveData_FromSignalR.CURVE_CV_Max_val,
            fv_fill = FillRefs[3],
            fv_thumb = ThumbRefs[3],
        });

        await JS.InvokeVoidAsync("refreshSliderVisuals");

        _sliderRangeOverrides["CC"] = (0, ReceiveData_FromSignalR.CURVE_CC_Max_val);
        _sliderRangeOverrides["TC"] = (0, ReceiveData_FromSignalR.CURVE_TC_Max_val);
        _sliderRangeOverrides["CV"] = (0, ReceiveData_FromSignalR.CURVE_CV_Max_val);
        _sliderRangeOverrides["FV"] = (0, ReceiveData_FromSignalR.CURVE_FV_Max_val);

        Sliders[0].Value    = ReceiveData_FromSignalR.CURVE_CC_val;
        Sliders[1].Value    = ReceiveData_FromSignalR.CURVE_TC_val;
        Sliders[2].Value    = ReceiveData_FromSignalR.CURVE_CV_val;
        Sliders[3].Value    = ReceiveData_FromSignalR.CURVE_FV_val;

        selectedStage       = ReceiveData_FromSignalR.selectStage;

        CCT.Enabled         = ReceiveData_FromSignalR.CCT_Enable;
        CCT.value           = (int)ReceiveData_FromSignalR.CC_Timeout_val;
        CCT.Max             = (int)ReceiveData_FromSignalR.CC_Timeout_Max_val;
        CCT.Min             = (int)ReceiveData_FromSignalR.CC_Timeout_Min_val;
        CCT.value = Math.Clamp(CCT.value, CCT.Min, CCT.Max);


        CVT.Enabled         = ReceiveData_FromSignalR.CVT_Enable;
        CVT.value           = (int)ReceiveData_FromSignalR.CV_Timeout_val;
        CVT.Max             = (int)ReceiveData_FromSignalR.CV_Timeout_Max_val;
        CVT.Min             = (int)ReceiveData_FromSignalR.CV_Timeout_Min_val;
        CVT.value = Math.Clamp(CVT.value, CVT.Min, CVT.Max);

        FVT.Enabled         = ReceiveData_FromSignalR.FVT_Enable;
        FVT.value           = (int)ReceiveData_FromSignalR.FV_Timeout_val;
        FVT.Max             = (int)ReceiveData_FromSignalR.FV_Timeout_Max_val;
        FVT.Min             = (int)ReceiveData_FromSignalR.FV_Timeout_Min_val;
        FVT.value = Math.Clamp(FVT.value, FVT.Min, FVT.Max);
        
        await reDrawChart_Stage();
        _sliderFillRefreshRequested = true;
        // await InvokeAsync(StateHasChanged);
    }

    private async Task ReSubscribeSubSys()
    {
        //1. [JS]嘗試解除當前訂閱的子系統
        if (!await TryInvokeVoidAsync("unsubscribeAllSubSys"))
        {
            return;
        }
        //2. [JS]訂閱新的子系統
        var (port, protocol) = GetSelectedSubSystemPortAndProtocol();
        Console.WriteLine($"[ReSubscribeSubSys] port = {port}, protocol = {protocol}");
        await TryInvokeVoidAsync("subscribeBatteryHub", port, protocol);
    }
    private async Task subSystemSelectionChangedHandler()
    {
        //1. 重新訂閱子系統
        await ReSubscribeSubSys();
    }
