    private async Task OnHeartbeatTickAsync()
    {
        try
        {
            await RefreshSubSystemOptions();
            if(FirstAutoGet_SubSys_done is false && DotNetHelper_Is_OK is true)
            {
                FirstAutoGet_SubSys_done = true;
                await subSystemSelectionChangedHandler();
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (JSException ex) when (IsSignalRDisconnected(ex))
        {
            DotNetHelper_Is_OK = false;
            AppLogger.Log_To_File_log(_category, $"[Battery_setting][OnHeartbeatTickAsync] JS disconnected: {ex.Message}", AppLogLevel.Trace);
            if (_heartbeatSubscribed)
            {
                Heartbeat.OnTick -= OnHeartbeatTickAsync;
                _heartbeatSubscribed = false;
            }
        }
        catch (JSDisconnectedException ex)
        {
            DotNetHelper_Is_OK = false;
            AppLogger.Log_To_File_log(_category, $"[Battery_setting][OnHeartbeatTickAsync] JS runtime unavailable: {ex.Message}", AppLogLevel.Trace);
            if (_heartbeatSubscribed)
            {
                Heartbeat.OnTick -= OnHeartbeatTickAsync;
                _heartbeatSubscribed = false;
            }
        }
        catch (InvalidOperationException ex) when (ex.Message.Contains("JSRuntime"))
        {
            DotNetHelper_Is_OK = false;
            AppLogger.Log_To_File_log(_category, $"[Battery_setting][OnHeartbeatTickAsync] JS invoke failed: {ex.Message}", AppLogLevel.Trace);
            if (_heartbeatSubscribed)
            {
                Heartbeat.OnTick -= OnHeartbeatTickAsync;
                _heartbeatSubscribed = false;
            }
        }
    }

    private async Task<bool> TryInvokeVoidAsync(string identifier, params object?[] args)
    {
        try
        {
            await JS.InvokeVoidAsync(identifier, args);
            return true;
        }
        catch (JSException ex) when (IsSignalRDisconnected(ex))
        {
            DotNetHelper_Is_OK = false;
            AppLogger.Log_To_File_log(_category, $"[Battery_setting][TryInvokeVoidAsync] SignalR disconnected while calling {identifier}: {ex.Message}", AppLogLevel.Trace);
        }
        catch (JSDisconnectedException ex)
        {
            DotNetHelper_Is_OK = false;
            AppLogger.Log_To_File_log(_category, $"[Battery_setting][TryInvokeVoidAsync] JS disconnected while calling {identifier}: {ex.Message}", AppLogLevel.Trace);
        }
        catch (InvalidOperationException ex) when (ex.Message.Contains("JSRuntime"))
        {
            DotNetHelper_Is_OK = false;
            AppLogger.Log_To_File_log(_category, $"[Battery_setting][TryInvokeVoidAsync] JS runtime unavailable for {identifier}: {ex.Message}", AppLogLevel.Trace);
        }

        return false;
    }

    private static bool IsSignalRDisconnected(JSException ex)
    {
        return ex.Message.Contains("connection is not in the 'Connected' State", StringComparison.OrdinalIgnoreCase);
    }

