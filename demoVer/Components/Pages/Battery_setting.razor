@page "/Battery_setting"

@rendermode InteractiveServer
@inject IJSRuntime JS
@inject DataCenter DataCenter
@using demoVer.Components.Layout
@using demoVer.Models
@using demoVer.Services
@using System.Text.Json
@using System.IO
@using System
@using Microsoft.JSInterop
@using demoVer.Utils
@inject HeartbeatService Heartbeat
@inject GlobalVar GlobalVar
@inject SubSystemManager SubSystemManager
@inject IStringLocalizer<SharedResource> Localizer
<MudPopoverProvider/>
@*Web Content*@
<PageTitle>@Localizer["BatterySetting-PageTitle"]</PageTitle>



@if(modal_IsOpen)
{
    <div class="modal-overlay" @onclick="CloseModal">
        @if(!string.IsNullOrEmpty(AlertMessage_parent))
        {
            <AlertMessageBox
                Message         = "@AlertMessage_parent"
                ConfirmBtn_Text = "@ConfirmBtn_Text_parent"
                CancelBtn_Text  = "@CancelBtn_Text_parent"
                ConfirmBtn_Func = "@ConfirmBtn_Func_parent"
                CancelBtn_Func  = "@CancelBtn_Func_parent"
                />
        }
    </div>
}

<div class="whole">
    <div class="top">
        <div class="leftPart">
            <div class="subsystem-select-group">
                <label for="subsystem-select" class="local-label" style="margin-bottom: 0px!important;">@Localizer["BatterySetting-Subsystem"]</label>
                <select id="subsystem-select" class="subsystem-select" value="@SelectedSubSystemKey" @onchange="Local_OnSubSystemChanged" @onclick:stopPropagation="true" @onchange:stopPropagation="true">
                    @if(_subSystemOptions.Count == 0)
                    {
                        <option value="">@Localizer["BatterySetting-PleaseSelectSubsystem"]</option>
                        @* <option value="" disabled>無可用子系統</option> *@
                    }
                    else
                    {
                        foreach (var subSystem in _subSystemOptions)
                        {
                            <option value="@BuildKey(subSystem.Port, subSystem.Protocol)">@GetSubSystemDisplay(subSystem)</option>
                        }
                    }
                </select>
            </div>
        </div>
        <div class="rightPart">
            <button type="button" class="btn btn-primary no-flex" @onclick="OnSaveButtonClick">@Localizer["BatterySetting-SaveSettings"]</button>
            <button type="button" class="btn btn-primary no-flex" @onclick="OnDefaultButtonClick">@Localizer["BatterySetting-RestoreDefault"]</button>
        </div>
    </div>
    <div class="content-container">
    <div class="card-grid">
        <div class="cell4 card-container-layout card-container-base">
            @if(Init_Flag)
            {
                <h3></h3>
                for(int i = 0 ; i < Sliders.Count ; i ++)
                {
                    var localIndex = i;
                    var slider = Sliders[i];
                    <div class="slider-wrapper">
                        <div class="vue-vertical-slider"
                            style="@(slider.Label == "FV" && selectedStage ? "opacity: 0.5;" : "")"
                            @onmousedown="@(e => (slider.Label == "FV" && selectedStage) ? Task.CompletedTask : OnSliderMouseDown(e, localIndex, slider.Label))"
                            @ontouchstart="@(e => (slider.Label == "FV" && selectedStage) ? Task.CompletedTask : OnSliderTouchStart(e, localIndex, slider.Label))">
                            <div class="vue-vertical-fill" @ref="@FillRefs[localIndex]"></div>
                            <div class="vue-vertical-thumb" @ref="@ThumbRefs[localIndex]"></div>
                        </div>
                        <input type="number"
                                id="slider-input-@localIndex"
                                step="0.1"
                                min=""
                                max=""
                                class="slider-input"
                                style="text-align: center;"
                                disabled="@(slider.Label == "FV" && selectedStage)"/>
                        @* <div class="slider-label">值: @slider.Value</div> *@
                        <label>@slider.Label</label>
                    </div>
                }
            }
        </div>
        
        <div class="cell8">
            <div class="right-part">
                <div class="card-container-stage card-container-base">
                    <canvas id="stageChart" class="stage-chart"></canvas>
                    <div class="stage-controls">
                        <select value="@selectedStage.ToString().ToLower()" @onchange="OnStageSelectChanged" @onclick:stopPropagation="true" @onchange:stopPropagation="true">
                            <option value="true">@Localizer["BatterySetting-2Stage"]</option>
                            <option value="false">@Localizer["BatterySetting-3Stage"]</option>
                        </select>
                    </div>
                </div>
                
                <div class="card-container-timeout card-container-base">
                    <div class="timeout-group">
                        <label class="custom-toggle-button" title="@(CCT.Enabled ? "On" : "Off")">
                            <input type="checkbox" @bind="CCT.Enabled" />
                            <span class="toggle-slider"></span>
                        </label>
                        <span style="display: inline-block;">@(!isMobile ? Localizer["BatterySetting-CCTimeout"] : Localizer["BatterySetting-CCT"])</span>
                        <div class="inputField">
                            <input type="number" @bind-value="CCT.value" @bind-value:after="OnCCTimeoutValueChanged" placeholder="CCT" min="@CCT.Min" />
                            @if(!isMobile)
                            {
                                <MudText Typo="Typo.body1">@FormatToHourMin(CCT.value)</MudText>
                            }
                            else
                            {
                                @* <div class="dateTime">@FormatToHourMin(CC_Timeout_value)</div> *@
                                <div class="dateTime">@Localizer["BatterySetting-Minutes"]</div>
                            }
                        </div>
                        @if(!isMobile)
                        {
                            <div class="responsive-slider">
                                <input type="range" @bind="CCT.value" @bind:event="oninput" min="@CCT.Min" max="@CCT.Max" step="1" class="custom-slider" />
                            </div>
                        }
                    </div>
                    <div class="timeout-group">
                        <label class="custom-toggle-button" title="@(CVT.Enabled ? "On" : "Off")">
                            <input type="checkbox" @bind="CVT.Enabled" />
                            <span class="toggle-slider"></span>
                        </label>
                        <span style="display: inline-block;">@(!isMobile ? Localizer["BatterySetting-CVTimeout"] : Localizer["BatterySetting-CVT"])</span>
                        <div class="inputField">
                            <input type="number" @bind-value="CVT.value" @bind-value:after="OnCVTimeoutValueChanged" placeholder="CVT" min="@CVT.Min" />
                            @if(!isMobile)
                            {
                                <MudText Typo="Typo.body1">@FormatToHourMin(CVT.value)</MudText>
                            }
                            else
                            {
                                @* <div class="dateTime">@FormatToHourMin(CV_Timeout_value)</div> *@
                                <div class="dateTime">@Localizer["BatterySetting-Minutes"]</div>
                            }
                        </div>
                        @if(!isMobile)
                        {
                            <div class="responsive-slider">
                                <input type="range" @bind="CVT.value" @bind:event="oninput" min="@CVT.Min" max="@CVT.Max" step="1" class="custom-slider" />
                            </div>
                        }
                    </div>
                    <div class="timeout-group">
                        <label class="custom-toggle-button" title="@(FVT.Enabled ? "On" : "Off")">
                            <input type="checkbox" @bind="FVT.Enabled" disabled="@selectedStage" />
                            <span class="toggle-slider"></span>
                        </label>
                        <span style="display: inline-block;">@(!isMobile ? Localizer["BatterySetting-FVTimeout"] : Localizer["BatterySetting-FVT"])</span>
                        <div class="inputField">
                            <input type="number" @bind-value="FVT.value" @bind-value:after="OnFVTimeoutValueChanged" placeholder="FVT" min="@FVT.Min" disabled="@selectedStage"/>
                            @if(!isMobile)
                            {
                                <MudText Typo="Typo.body1">@FormatToHourMin(FVT.value)</MudText>
                            }
                            else
                            {
                                @* <div class="dateTime">@FormatToHourMin(FV_Timeout_value)</div> *@
                                <div class="dateTime">@Localizer["BatterySetting-Minutes"]</div>
                            }
                        </div>
                        @if(!isMobile)
                        {
                            <div class="responsive-slider">
                                <input type="range" @bind="FVT.value" @bind:event="oninput" min="@FVT.Min" max="@FVT.Max" step="1" class="custom-slider" disabled="@selectedStage"/>
                            </div>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
</div> 




@code
{
    [CascadingParameter(Name = "MainLayout")] public MainLayout? MainLayout { get; set; }

    private string _category = "";

    bool DotNetHelper_Is_OK = false;
    bool FirstAutoGet_SubSys_done = false;
    bool modal_IsOpen = false;
    string AlertMessage_parent = string.Empty;
    string ConfirmBtn_Text_parent = string.Empty;
    string CancelBtn_Text_parent = string.Empty;
    public EventCallback ConfirmBtn_Func_parent {get; set;}
    public EventCallback CancelBtn_Func_parent {get; set;}
    private IReadOnlyList<SubSystem> _subSystemOptions = Array.Empty<SubSystem>();
    private string? _selectedSubSystemKey = string.Empty;
    private string SelectedSubSystemKey => _selectedSubSystemKey ?? string.Empty;
    
    private bool isMobile;
    private DotNetObjectReference<Battery_setting> dotNetRef;
    private bool Init_Flag = false;
    private List<ElementReference>  FillRefs = new();
    private List<ElementReference>  ThumbRefs = new();
    private bool _sliderFillRefreshRequested;

    private bool _heartbeatSubscribed = false;
    private int _heartbeatCounter = 0;
    private readonly Dictionary<string, (double Min, double Max)> _sliderRangeOverrides = new(StringComparer.OrdinalIgnoreCase);

    public class SliderItem
    {
        public double Value {get; set;}
        public string Label {get; set;} = null;
    }

    public List<SliderItem> Sliders = new();
    private ElementReference FillRef;
    private ElementReference ThumbRef;

    public TimeoutGroup CCT = new TimeoutGroup();
    public TimeoutGroup CVT = new TimeoutGroup();
    public TimeoutGroup FVT = new TimeoutGroup();

    private bool selectedStage = false; //true = 2階段, false = 3階段
    private bool topRowCallbacksRegistered = false;

    #region System Task
    protected override void OnInitialized()
    {
        _category = GetType().FullName!;

        Sliders = new List<SliderItem>
        {
            new SliderItem { Label = "CC", Value = 0.0}, //index = 0
            new SliderItem { Label = "TC", Value = 0.0}, //index = 1
            new SliderItem { Label = "CV", Value = 0.0}, //index = 2
            new SliderItem { Label = "FV", Value = 0.0}  //index = 3
        };
        FillRefs = new List<ElementReference>(new ElementReference[Sliders.Count]);
        ThumbRefs = new List<ElementReference>(new ElementReference[Sliders.Count]);

        Init_Flag = true; //控制直向slider顯示
    }

    protected override void OnParametersSet()
    {

        if (!topRowCallbacksRegistered && MainLayout != null)
        {
            MainLayout.RegisterTopRowCallbacks(
                this,
                informParentToApplySetting: ReceiveFrom_TopRow_SaveBatterySetting,
                informParentToUseDefaultValue: ReceiveFrom_TopRow_ApplyDefaultValue);
            topRowCallbacksRegistered = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            if (!_heartbeatSubscribed)
            {
                Heartbeat.OnTick += OnHeartbeatTickAsync;
                _heartbeatSubscribed = true;
            }


            //把JS中的chartInstances清空
            await JS.InvokeVoidAsync("destroyAllCharts");

            Console.WriteLine($"isMobile = {isMobile}");
            dotNetRef = DotNetObjectReference.Create(this);

            await JS.InvokeVoidAsync("startBatteryHub", dotNetRef);
            DotNetHelper_Is_OK = true;

            await JS.InvokeVoidAsync("sliderUpdateFromInput", dotNetRef);
            await JS.InvokeVoidAsync("setStage", selectedStage);

            await JS.InvokeVoidAsync("drawChart_Stage", true);
            isMobile = await JS.InvokeAsync<bool>("checkIsMobile");
            if(isMobile)
            {
                StateHasChanged();
            }
        }

        if (_sliderFillRefreshRequested && DotNetHelper_Is_OK)
        {
            _sliderFillRefreshRequested = false;
            await JS.InvokeVoidAsync("sliderFill.refresh");
        }
    }

    public void Dispose()
    {
        DataCenter.Battery.OnUpdated -= OnBatteryChanged;
        if (_heartbeatSubscribed)
        {
            Heartbeat.OnTick -= OnHeartbeatTickAsync;
            _heartbeatSubscribed = false;
        }
        if (topRowCallbacksRegistered)
        {
            MainLayout?.ClearTopRowCallbacks(this);
            topRowCallbacksRegistered = false;
        }
        DotNetHelper_Is_OK = false;
        FirstAutoGet_SubSys_done = false;
    }
    #endregion System Task

    private string FormatToHourMin(double totalMin)
    {
        return $"{totalMin} {Localizer["BatterySetting-MinutesUnit"]}";
    }

    private async Task OnStageSelectChanged(ChangeEventArgs e)
    {
        Console.WriteLine($"stageChanged");
        if (e.Value != null && bool.TryParse(e.Value.ToString(), out bool value))
        {
            selectedStage = value;
            Console.WriteLine($"selectedStage = {selectedStage}");

            await reDrawChart_Stage();
        }
    }
    
    private async Task reDrawChart_Stage()
    {
        await JS.InvokeVoidAsync("setStage", selectedStage);
        await JS.InvokeVoidAsync("drawChart_Stage");
        await InvokeAsync(StateHasChanged);
    }

    private void OnBatteryChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    #region SubSystemFuncs
    private async Task RefreshSubSystemOptions()
    {
        var snapshot = SubSystemManager.GetAllSubSystems_Ref_In_List();
        if (snapshot is null || snapshot.Count == 0)
        {
            _subSystemOptions = Array.Empty<SubSystem>();
            _selectedSubSystemKey = null;
            return;
        }
        //Local變數，取得最新的子系統List快照
        _subSystemOptions = snapshot;
        // await InvokeAsync(StateHasChanged);
        //如果目前選取的子系統仍存在，則不更動選取值
        if (!string.IsNullOrWhiteSpace(_selectedSubSystemKey) && ContainsSubSystemKey(_selectedSubSystemKey))
        {
            return;
        }

        _selectedSubSystemKey = _subSystemOptions.Count > 0
            ? BuildKey(_subSystemOptions[0].Port, _subSystemOptions[0].Protocol)
            : null;
    }

    private bool ContainsSubSystemKey(string key)
    {
        if (string.IsNullOrWhiteSpace(key))
        {
            return false;
        }

        foreach (var subSystem in _subSystemOptions)
        {
            if (string.Equals(BuildKey(subSystem.Port, subSystem.Protocol), key, System.StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }

        return false;
    }

    private static string BuildKey(string? port, string? protocol) => $"{port ?? string.Empty}|{protocol ?? string.Empty}";

    private string GetSubSystemDisplay(SubSystem subSystem)
    {
        var port = string.IsNullOrWhiteSpace(subSystem.Port) ? Localizer["BatterySetting-Unknown"] : subSystem.Port;
        var protocol = string.IsNullOrWhiteSpace(subSystem.Protocol) ? Localizer["BatterySetting-NA"] : subSystem.Protocol;
        return $"{port} - {protocol}";
    }

    private async Task Local_OnSubSystemChanged(ChangeEventArgs e)
    {
        var rawValue = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(rawValue))
        {
            _selectedSubSystemKey = null;

        }

        Console.WriteLine($"[Battery_setting][Local_OnSubSystemChanged] rawValue = {rawValue}");
        _selectedSubSystemKey = ContainsSubSystemKey(rawValue) ? rawValue : null;
        
        await subSystemSelectionChangedHandler();
    }

    /// <summary>
    /// 取得目前選取的子系統的 Port 與 Protocol。
    /// </summary>
    /// <returns>回傳一個元組，包含 Port 與 Protocol。如果未選取子系統，則回傳空字串。</returns>
    public (string, string) GetSelectedSubSystemPortAndProtocol()
    {
        if (string.IsNullOrWhiteSpace(_selectedSubSystemKey))
        {
            return (string.Empty, string.Empty);
        }

        var parts = _selectedSubSystemKey.Split('|');
        if (parts.Length != 2)
        {
            return (string.Empty, string.Empty);
        }

        return (parts[0], parts[1]);
    }
    #endregion SubSystemFuncs
    

    




    #region SliderFuncs
    private async Task StartMouseDrag(MouseEventArgs e, int index, double _Min, double _displayMax)
    {
        var slider = Sliders[index];
        await JS.InvokeVoidAsync("startVerticalSliderDrag", new{
            fill = FillRefs[index],
            thumb = ThumbRefs[index],
            dotNetHelper = dotNetRef,
            index = index,
            minValue = _Min,
            displayMaxValue = _displayMax
        });
    }

    private async Task StartTouchDrag(TouchEventArgs e, int index, double _Min, double _displayMax)
    {
        var slider = Sliders[index];
        await JS.InvokeVoidAsync("startVerticalSliderDrag", new{
            fill = FillRefs[index],
            thumb = ThumbRefs[index],
            dotNetHelper = dotNetRef,
            index = index,
            minValue = _Min,
            displayMaxValue = _displayMax
        });
    }

    private async Task OnSliderInputChanged(int index)
    {
        var value = Sliders[index].Value;
        var (_, max) = GetDisplaySliderRange(Sliders[index].Label);
        await JS.InvokeVoidAsync("updateSliderVisual", new{
            fill = FillRefs[index],
            thumb = ThumbRefs[index],
            value = Sliders[index].Value,
            displayMaxValue = max,
        });
    }


    //根據拉動的某一條bar，修改UI上對應的input value數值
    [JSInvokable("UpdateSliderValue")]
    public void UpdateSliderValueFromJs(int index, double value)
    {
        @* 
        index 0 : CC
        index 1 : TC
        index 2 : CV
        index 3 : FV 
        *@

        var currentSlider = Sliders[index];
        currentSlider.Value = value;
        StateHasChanged();
    }

    private(double min, double max) GetDisplaySliderRange(string label)
    {
        if (_sliderRangeOverrides.TryGetValue(label, out var range))
        {
            return range;
        }
        return (0.0, 0.0);
    }

    private async Task OnSliderMouseDown(MouseEventArgs e, int index, string label)
    {
        var (min, displayMax) = GetDisplaySliderRange(label);
        await StartMouseDrag(e, index, min, displayMax);
    }

    private async Task OnSliderTouchStart(TouchEventArgs e, int index, string label)
    {
        var (min, displayMax) = GetDisplaySliderRange(label);
        await StartTouchDrag(e, index, min, displayMax);
    }
    #endregion SliderFuncs


    #region UI InteractionFuncs
    private void OnCCTimeoutValueChanged()
    {
        CCT.value = Math.Clamp(CCT.value, CCT.Min, CCT.Max);
        _sliderFillRefreshRequested = true;
    }

    private void OnCVTimeoutValueChanged()
    {
        CVT.value = Math.Clamp(CVT.value, CVT.Min, CVT.Max);
        _sliderFillRefreshRequested = true;
    }

    private void OnFVTimeoutValueChanged()
    {
        FVT.value = Math.Clamp(FVT.value, FVT.Min, FVT.Max);
        _sliderFillRefreshRequested = true;
    }

    private async Task ReceiveFrom_TopRow_SaveBatterySetting()
    {
        TriggerAlert("Save");
    }

    private async Task ReceiveFrom_TopRow_ApplyDefaultValue()
    {
        TriggerAlert("DefaultVal");
    }
    private void TriggerAlert(string _alertMessage_FromOtherFunc)
    {

        modal_IsOpen = true;

        AlertMessage_parent     = "";
        ConfirmBtn_Text_parent  = "";
        CancelBtn_Text_parent   = "";
        ConfirmBtn_Func_parent  = EventCallback.Empty;
        CancelBtn_Func_parent   = EventCallback.Empty;
        switch(_alertMessage_FromOtherFunc)
        {
            case "Save":
                AlertMessage_parent     = Localizer["BatterySetting-ConfirmSave"];
                ConfirmBtn_Text_parent  = Localizer["Common-Confirm"];
                CancelBtn_Text_parent   = Localizer["Common-Cancel"];
                ConfirmBtn_Func_parent  = EventCallback.Factory.Create(this, ConfirmSave);
                CancelBtn_Func_parent   = EventCallback.Factory.Create(this, CancelModal);
                break;
            case "DefaultVal":
                AlertMessage_parent     = Localizer["BatterySetting-ConfirmRestoreDefault"];
                ConfirmBtn_Text_parent  = Localizer["Common-Confirm"];
                CancelBtn_Text_parent   = Localizer["Common-Cancel"];
                ConfirmBtn_Func_parent  = EventCallback.Factory.Create(this, ConfirmRestoreDefault);
                CancelBtn_Func_parent   = EventCallback.Factory.Create(this, CancelModal);
                break;
            default:
                break;
        }
    }

    private void CloseAlert()
    {
        AlertMessage_parent = null;
    }
    private void CloseModal()
    {   
        //close modal
        modal_IsOpen = false;
        //Close Alert
        AlertMessage_parent = null;
    }
    
    private async Task OnSaveButtonClick()
    {
        // await ReceiveFrom_TopRow_SaveBatterySetting();
        TriggerAlert("Save");
    }
    
    private async Task OnDefaultButtonClick()
    {
        TriggerAlert("DefaultVal");
    }
    #endregion UI InteractionFuncs





    private List<Post_RealSingleRawSettingCMD_JsonFormat> nowUiData_transformTo_apiWriteData(List<double> sliderValues)
    {
        List<Post_RealSingleRawSettingCMD_JsonFormat> configurableCmdDatas = new();

        string port = string.Empty;
        string protocol = string.Empty;
        (port, protocol) = GetSelectedSubSystemPortAndProtocol();
        Console.WriteLine($"[nowUiData_transformTo_apiWriteData] port: {port}, protocol: {protocol}");

        //CC (0x00B0)
        var cc_cmdData = SubSystemManager.createOneWriteCmdData(port, protocol, "00B0", RealNumber: sliderValues[0]);
        if (cc_cmdData != null) { configurableCmdDatas.Add(cc_cmdData); }

        //CV (0x00B1)
        var cv_cmdData = SubSystemManager.createOneWriteCmdData(port, protocol, "00B1", RealNumber: sliderValues[1]);
        if (cv_cmdData != null) { configurableCmdDatas.Add(cv_cmdData); }

        //FV (0x00B2)
        var fv_cmdData = SubSystemManager.createOneWriteCmdData(port, protocol, "00B2", RealNumber: sliderValues[2]);
        if (fv_cmdData != null) { configurableCmdDatas.Add(fv_cmdData); }

        //check if BatRchg > FV (0x00BB)
        double now_BAT_RCHG_VOLT = SubSystemManager.Get_Now_Cmd_value(port, protocol, "00BB");
        var fv_value = sliderValues[2];
        if(now_BAT_RCHG_VOLT >= fv_value) //BAT_RCHG must < FV
        {
            var fixed_BAT_RCHG_VOLT = fv_value;
            var BAT_RCHG_cmdData = SubSystemManager.createOneWriteCmdData(port, protocol, "00BB", RealNumber: fixed_BAT_RCHG_VOLT);
            if (BAT_RCHG_cmdData != null) { configurableCmdDatas.Add(BAT_RCHG_cmdData); }
        }

        //TC (0x00B3)
        var tc_cmdData = SubSystemManager.createOneWriteCmdData(port, protocol, "00B3", RealNumber: sliderValues[3]);
        if (tc_cmdData != null) { configurableCmdDatas.Add(tc_cmdData); }

        //CurveStage in (0x00B4 "BIT_6")
        //CCT_Enable in (0x00B4 "BIT_8")
        //CVT_Enable in (0x00B4 "BIT_9")
        //FVT Enable in (0x00B4 "BIT_10")
        Console.WriteLine($"[nowUiData_transformTo_apiWriteData] selectedStage: {selectedStage}, CCT_Enable: {CCT.Enabled}, CVT_Enable: {CVT.Enabled}, FVT_Enable: {FVT.Enabled}");
        var CurveStage_BitKey = SubSystemManager.GetBitKey_FromSubSys(port, protocol, "00B4", 6);
        var CCT_Enable_BitKey = SubSystemManager.GetBitKey_FromSubSys(port, protocol, "00B4", 8);
        var CVT_Enable_BitKey = SubSystemManager.GetBitKey_FromSubSys(port, protocol, "00B4", 9);
        var FVT_Enable_BitKey = SubSystemManager.GetBitKey_FromSubSys(port, protocol, "00B4", 10);
        var Bits_tmp = SubSystemManager.GetRealBitsFormat(port, protocol, "00B4");
        if(Bits_tmp != null)
        {
            if(CurveStage_BitKey is not null){Bits_tmp[CurveStage_BitKey] = selectedStage ? 1 : 0;}
            if(CCT_Enable_BitKey is not null){Bits_tmp[CCT_Enable_BitKey] = CCT.Enabled ? 1 : 0;}
            if(CVT_Enable_BitKey is not null){Bits_tmp[CVT_Enable_BitKey] = CVT.Enabled ? 1 : 0;}
            if(FVT_Enable_BitKey is not null){Bits_tmp[FVT_Enable_BitKey] = FVT.Enabled ? 1 : 0;}

            Console.WriteLine($"[nowUiData_transformTo_apiWriteData] Bits_tmp: {JsonSerializer.Serialize(Bits_tmp)}");
            var curveStage_cmdData = SubSystemManager.createOneWriteCmdData(port, protocol, "00B4", RealBits: Bits_tmp);
            if (curveStage_cmdData != null) { configurableCmdDatas.Add(curveStage_cmdData); }
        }
        //CC_Timeout (0x00B5)
        var cc_timeout_cmdData = SubSystemManager.createOneWriteCmdData(port, protocol, "00B5", RealNumber: CCT.value);
        if (cc_timeout_cmdData != null) { configurableCmdDatas.Add(cc_timeout_cmdData); }

        //CV_Timeout (0x00B6)
        var cv_timeout_cmdData = SubSystemManager.createOneWriteCmdData(port, protocol, "00B6", RealNumber: CVT.value);
        if (cv_timeout_cmdData != null) { configurableCmdDatas.Add(cv_timeout_cmdData); }

        //FV_Timeout (0x00B7)
        var fv_timeout_cmdData = SubSystemManager.createOneWriteCmdData(port, protocol, "00B7", RealNumber: FVT.value);
        if (fv_timeout_cmdData != null) { configurableCmdDatas.Add(fv_timeout_cmdData); }

        //[Debug] print out all the cmdCodes in configurableCmdDatas
        foreach(var cmdData in configurableCmdDatas)
        {
            AppLogger.Log_To_File_log(_category, $"[nowUiData_transformTo_apiWriteData] cmdName: {cmdData.CommandName}, RealNumber: {cmdData.Target!.Number}, RealBits: {JsonSerializer.Serialize(cmdData.Target!.Bits)}", AppLogLevel.Debug);      
        }

        return configurableCmdDatas;
    }



    private async Task ConfirmSave()
    {
        try
        {
            //Get CC, TC, CV, FV Data
            var sliderValues = new List<double>();
            sliderValues = (await JS.InvokeAsync<double[]>("transferSliderValue")).ToList();
            Console.WriteLine($"sliderValues: {string.Join(", ", sliderValues)}");

            string port = string.Empty;
            string protocol = string.Empty;
            (port, protocol) = GetSelectedSubSystemPortAndProtocol();

            //1. 轉 UI值 成 WriteAPI值
            List<Post_RealSingleRawSettingCMD_JsonFormat> apiWriteData = nowUiData_transformTo_apiWriteData(sliderValues);

            //2. apiWriteData 傳到 SubSystemManager 發送
            bool isWriteSuccess = await SubSystemManager.WriteCmdsToFramework(port, protocol, apiWriteData, 0);
            if(isWriteSuccess is false)
            {
                AppLogger.Log_To_File_log(_category, $"[Battery_setting][ConfirmSave] Writing To device failed", AppLogLevel.Warning);
                return;
            }
        }
        catch(Exception ex)
        {
            AppLogger.Log_To_File_log(_category, $"[Battery_setting][ConfirmSave] Exception: {ex.Message}", AppLogLevel.Error);
        }
        finally
        {
            CloseAlert();
            CloseModal();
            Console.WriteLine("[ConfirmSave]");
        }
    }

