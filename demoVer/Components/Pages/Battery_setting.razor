        var currentSlider = Sliders[index];
        currentSlider.Value = value;
        
        switch(currentSlider.Label)
        {
            case "CC":
                var tempSlider_CC = Sliders[index];
                break;
            case "TC":
                break;
            case "CV":
                break;
            case "FV":
