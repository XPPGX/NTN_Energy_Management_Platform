@page "/Shortcut_setting"

@rendermode InteractiveServer
@inject IJSRuntime JS
@inject NavigationManager NavManager
@inject IStringLocalizer<SharedResource> Localizer
@using Microsoft.AspNetCore.Components.Forms

@using demoVer.Components.Layout
@using demoVer.Utils
@using demoVer.Resources
@using demoVer.Services
@using demoVer.Models
@inject BottomRowConfig BottomRowConfigService
@inject BottomRowImageService BottomRowImageService
<PageTitle>@Localizer["TopRow-ShortcutSettings"]</PageTitle>

<div class="shortcut-settings-page">
    <div class="page-header">
        <h1>@Localizer["TopRow-ShortcutSettings"]</h1>
        <p>Customize the navigation shortcuts in the bottom row</p>
    </div>

    <div class="settings-container">
        <div class="settings-paper">
            <h2 class="section-title">Bottom Row Button Configuration</h2>
            <p class="section-description">
                Configure which page each bottom row button navigates to. Changes will be applied immediately.
            </p>

            <div class="button-configurations">
                <!-- Button 1: Home -->
                <div class="config-item">
                    <div class="button-preview">
                        <span class="button-label">Button 1</span>
                    </div>
                    <div class="config-controls">
                        <div class="name-input-wrapper">
                            <label class="input-label">Button Image</label>
                            <img src="@GetButtonImageSrc(0)" alt="Bottom button 1" class="custom-input" onerror="this.src='/images/empty_img.svg';" />
                            <InputFile OnChange="@(e => OnImageSelected(e, 0))" accept="image/*" />
                        </div>
                        <div class="select-wrapper">
                            <label class="select-label">Navigate to</label>
                            <select @bind="Local_BottomRowItems_List[0].Route" class="custom-select">
                                @foreach (var option in pageOptions)
                                {
                                    <option value="@option.Key">@option.Value</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Button 2: Battery -->
                <div class="config-item">
                    <div class="button-preview">
                        <span class="button-label">Button 2</span>
                    </div>
                    <div class="config-controls">
                        <div class="name-input-wrapper">
                            <label class="input-label">Button Image</label>
                            <img src="@GetButtonImageSrc(1)" alt="Bottom button 2" class="custom-input" onerror="this.src='/images/empty_img.svg';" />
                            <InputFile OnChange="@(e => OnImageSelected(e, 1))" accept="image/*" />
                        </div>
                        <div class="select-wrapper">
                            <label class="select-label">Navigate to</label>
                            <select @bind="Local_BottomRowItems_List[1].Route" class="custom-select">
                                @foreach (var option in pageOptions)
                                {
                                    <option value="@option.Key">@option.Value</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Button 3: Inverter -->
                <div class="config-item">
                    <div class="button-preview">
                        <span class="button-label">Button 3</span>
                    </div>
                    <div class="config-controls">
                        <div class="name-input-wrapper">
                            <label class="input-label">Button Image</label>
                            <img src="@GetButtonImageSrc(2)" alt="Bottom button 3" class="custom-input" onerror="this.src='/images/empty_img.svg';" />
                            <InputFile OnChange="@(e => OnImageSelected(e, 2))" accept="image/*" />
                        </div>
                        <div class="select-wrapper">
                            <label class="select-label">Navigate to</label>
                            <select @bind="Local_BottomRowItems_List[2].Route" class="custom-select">
                                @foreach (var option in pageOptions)
                                {
                                    <option value="@option.Key">@option.Value</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Button 4: Link Status -->
                <div class="config-item">
                    <div class="button-preview">
                        <span class="button-label">Button 4</span>
                    </div>
                    <div class="config-controls">
                        <div class="name-input-wrapper">
                            <label class="input-label">Button Image</label>
                            <img src="@GetButtonImageSrc(3)" alt="Bottom button 4" class="custom-input" onerror="this.src='/images/empty_img.svg';" />
                            <InputFile OnChange="@(e => OnImageSelected(e, 3))" accept="image/*" />
                        </div>
                        <div class="select-wrapper">
                            <label class="select-label">Navigate to</label>
                            <select @bind="Local_BottomRowItems_List[3].Route" class="custom-select">
                                @foreach (var option in pageOptions)
                                {
                                    <option value="@option.Key">@option.Value</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="action-buttons">
                <button type="button" class="btn btn-primary" @onclick="() => ShowConfirmModal(ModalType.Save)">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    }
                    Save Settings
                </button>
                <button type="button" class="btn btn-secondary" @onclick="() => ShowConfirmModal(ModalType.Reset)">
                    @if (isResetting)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    }
                    Reset to Default
                </button>
            </div>
        </div>
    </div>

    <!-- Preview Section -->
    <div class="preview-section">
        <div class="preview-paper">
            <h3 class="preview-title">Bottom Row Preview</h3>
            <div class="bottom-row-preview">
                <button type="button" class="preview-btn" @onclick="() => NavigateTo(preview_BottomRowItems_List[0].Route)">
                    <img src="@GetButtonImageSrc(0)" alt="Preview button 1" onerror="this.src='/images/empty_img.svg';" />
                </button>
                <button type="button" class="preview-btn" @onclick="() => NavigateTo(preview_BottomRowItems_List[1].Route)">
                    <img src="@GetButtonImageSrc(1)" alt="Preview button 2" onerror="this.src='/images/empty_img.svg';" />
                </button>
                <button type="button" class="preview-btn" @onclick="() => NavigateTo(preview_BottomRowItems_List[2].Route)">
                    <img src="@GetButtonImageSrc(2)" alt="Preview button 3" onerror="this.src='/images/empty_img.svg';" />
                </button>
                <button type="button" class="preview-btn" @onclick="() => NavigateTo(preview_BottomRowItems_List[3].Route)">
                    <img src="@GetButtonImageSrc(3)" alt="Preview button 4" onerror="this.src='/images/empty_img.svg';" />
                </button>
            </div>
        </div>
    </div>
</div>

<!-- 頂部消息提示 -->
@if (showToast)
{
    <div class="toast-container">
        <div class="toast show @toastType">
            <div class="toast-content">
                <span class="toast-icon">@(toastType == "success" ? "✓" : "ℹ")</span>
                <span class="toast-message">@toastMessage</span>
            </div>
        </div>
    </div>
}

<!-- 確認對話框 Modal -->
@if (showModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show" style="display: block;" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@modalTitle</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>@modalMessage</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">取消</button>
                    <button type="button" class="btn btn-primary" @onclick="ConfirmAction">確定</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string _category = "";

    // Modal 相關狀態
    private bool showModal = false;
    private string modalTitle = "";
    private string modalMessage = "";
    private ModalType currentModalType;
    private bool isSaving = false;
    private bool isResetting = false;

    // Toast 消息相關狀態
    private bool showToast = false;
    private string toastMessage = "";
    private string toastType = "success"; // success, info, error
    private System.Threading.Timer? toastTimer;

    private enum ModalType
    {
        Save,
        Reset
    }
    
    private List<BottomRowItem> Local_BottomRowItems_List = new List<BottomRowItem>()
    {
        //預防Initialization還沒完成時，渲染畫面使用會 Index Out of Range
        new BottomRowItem(){Route = "/", imgUrl="Home"},
        new BottomRowItem(){Route = "/", imgUrl="Home"},
        new BottomRowItem(){Route = "/", imgUrl="Home"},
        new BottomRowItem(){Route = "/", imgUrl="Home"},
    };

    private List<BottomRowItem> preview_BottomRowItems_List = new List<BottomRowItem>()
    {
        //預防Initialization還沒完成時，渲染畫面使用會 Index Out of Range
        new BottomRowItem(){Route = "/", imgUrl="Home"},
        new BottomRowItem(){Route = "/", imgUrl="Home"},
        new BottomRowItem(){Route = "/", imgUrl="Home"},
        new BottomRowItem(){Route = "/", imgUrl="Home"},
    };
    private Dictionary<string, string> pageOptions = new Dictionary<string, string>();

    // Cache-buster for preview/images after overwrite
    private long[] _imageVersionTicks = new long[4];

    protected override async Task OnInitializedAsync()
    {
        _category = GetType().FullName!;
        
        await base.OnInitializedAsync();
        Load_Basic_Data_From_Service();
    }

    private void Load_Basic_Data_From_Service()
    {
        // Clean up any temporary images from previous sessions
        for (var i = 1; i <= 4; i++)
        {
            BottomRowImageService.DeleteTempVariants(i);
        }

        //初始化:使用者設定區塊
        Local_BottomRowItems_List = BottomRowConfigService.Get_UserDefinedList_snapshot();
        
        //初始化:預覽區塊
        preview_BottomRowItems_List = BottomRowConfigService.Get_UserDefinedList_snapshot();
        
        //初始化:可選頁面清單
        pageOptions = BottomRowConfigService.Get_FixedRouteToKeyMapping_snapshot();

        // initialize cache-buster
        for (var i = 0; i < _imageVersionTicks.Length; i++)
        {
            _imageVersionTicks[i] = DateTimeOffset.UtcNow.Ticks;
        }
    }

    private string GetButtonImageSrc(int index)
    {
        var imageIndex = index + 1;
        
        // Priority 1: Show temp image if exists (user uploaded but not saved)
        if (BottomRowImageService.TempImageExists(imageIndex))
        {
            var ticks = BottomRowImageService.GetTempImageLastWriteTicksUtc(imageIndex) ?? _imageVersionTicks[index];
            var url = BottomRowImageService.GetTempImageUrl(imageIndex);
            if (!string.IsNullOrEmpty(url)) return $"{url}?v={ticks}";
        }
        
        // Priority 2: Show official image if exists
        if (BottomRowImageService.ImageExists(imageIndex))
        {
            var ticks = BottomRowImageService.GetImageLastWriteTicksUtc(imageIndex) ?? _imageVersionTicks[index];
            var url = BottomRowImageService.GetImageUrl(imageIndex);
            if (!string.IsNullOrEmpty(url)) return $"{url}?v={ticks}";
        }

        // Priority 3: Use default SVG icon from btmRowSvgs folder
        return BottomRowImageService.GetDefaultImageUrl(imageIndex);
    }

    private async Task OnImageSelected(InputFileChangeEventArgs e, int index)
    {
        try
        {
            var file = e.File;
            if (file is null)
            {
                return;
            }

            var imageIndex = index + 1;
            // Save as temporary image (not committed until Save button)
            var url = await BottomRowImageService.SaveTempAsync(imageIndex, file);

            // Update cache-buster for preview
            _imageVersionTicks[index] = DateTimeOffset.UtcNow.Ticks;
            ShowToast("圖片上傳成功！請按 Save 儲存變更。", "success");
        }
        catch (Exception ex)
        {
            ShowToast($"圖片上傳失敗：{ex.Message}", "error");
        }
        finally
        {
            StateHasChanged();
        }
    }

    // 顯示 Toast 消息
    private void ShowToast(string message, string type = "success")
    {
        toastMessage = message;
        toastType = type;
        showToast = true;
        StateHasChanged();

        // 3秒後自動隱藏
        toastTimer?.Dispose();
        toastTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                showToast = false;
                StateHasChanged();
            });
        }, null, 3000, Timeout.Infinite);
    }

    // 顯示確認對話框
    private void ShowConfirmModal(ModalType type)
    {
        currentModalType = type;
        showModal = true;
        
        switch (type)
        {
            case ModalType.Save:
                modalTitle = "確認儲存";
                modalMessage = "確定要儲存嗎？";
                break;
            case ModalType.Reset:
                modalTitle = "確認還原";
                modalMessage = "確定要還原預設嗎？";
                break;
        }
        
        StateHasChanged();
    }

    // 關閉對話框
    private void CloseModal()
    {
        showModal = false;
        StateHasChanged();
    }

    // 確認操作
    private async Task ConfirmAction()
    {
        showModal = false;
        StateHasChanged();
        
        switch (currentModalType)
        {
            case ModalType.Save:
                await SaveSettings();
                break;
            case ModalType.Reset:
                await ResetToDefault();
                break;
        }
    }

    private async Task SaveSettings()
    {
        isSaving = true;
        StateHasChanged();
        
        try
        {
            // Commit all temporary images to official images
            for (var i = 0; i < 4; i++)
            {
                var imageIndex = i + 1;
                if (BottomRowImageService.TempImageExists(imageIndex))
                {
                    BottomRowImageService.CommitTempImage(imageIndex);
                    // Update imgUrl with official image URL
                    var url = BottomRowImageService.GetImageUrl(imageIndex);
                    if (!string.IsNullOrEmpty(url))
                    {
                        Local_BottomRowItems_List[i].imgUrl = url;
                    }
                }
            }
            
            // 模擬處理時間(如果處理太快)
            await Task.Delay(500);
            
            //將UI設定寫進Service記憶體，並存檔於硬碟
            var normalized = Local_BottomRowItems_List
                .Select(x => new BottomRowItem
                {
                    Route = x.Route,
                    // strip cache-busting query if present
                    imgUrl = (x.imgUrl ?? string.Empty).Split('?', 2)[0]
                })
                .ToList();

            var result = BottomRowConfigService.UpdateAndSave(normalized);
            if(result != ConfigResult.Success)
            {
                //跳個警告視窗 : 失敗了請稍後再試
                ShowToast("儲存失敗，請稍後再試", "error");
                return;
            }

            //若成功，同步更新預覽區塊
            preview_BottomRowItems_List = BottomRowConfigService.Get_UserDefinedList_snapshot();
            ShowToast("設定已成功儲存！", "success");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private async Task ResetToDefault()
    {
        isResetting = true;
        StateHasChanged();
        
        try
        {
            // Remove both temp and official images first
            for (var i = 1; i <= 4; i++)
            {
                BottomRowImageService.DeleteTempVariants(i);
                BottomRowImageService.DeleteAllVariants(i);
            }
            
            //將Service內的設定重設為預設值
            BottomRowConfigService.DefaultAndSave();
            
            // Give time for event propagation and UI update
            await Task.Delay(100);

            //初始化:使用者設定區塊
            Local_BottomRowItems_List = BottomRowConfigService.Get_UserDefinedList_snapshot();
            //初始化:預覽區塊
            preview_BottomRowItems_List = BottomRowConfigService.Get_UserDefinedList_snapshot();
            
            StateHasChanged();
            ShowToast("已還原為預設設定！", "success");
        }
        finally
        {
            isResetting = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        toastTimer?.Dispose();
    }

    private void NavigateTo(string route)
    {
        if (!string.IsNullOrEmpty(route))
        {
            NavManager.NavigateTo(route);
        }
    }
}




