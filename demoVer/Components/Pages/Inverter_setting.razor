@page "/Inverter_setting"

@rendermode InteractiveServer
@inject IJSRuntime JS
@inject DataCenter DataCenter
@inject WriteProcess writeProcess
@inject GlobalVar globalVar
@using System.Reflection.PortableExecutable
@using demoVer.Components.Layout
@using System.Text.Json
@using System.Linq
@using demoVer.Models
@using demoVer.Utils
@using Microsoft.JSInterop
@inject HeartbeatService Heartbeat
@inject SubSystemManager SubSystemManager
@inject IStringLocalizer<SharedResource> Localizer

<MudPopoverProvider/>
@*Web Content*@
<PageTitle>@Localizer["InverterSetting-PageTitle"]</PageTitle>

@if(modal_IsOpen)
{
    <div class="modal-overlay" @onclick="CloseModal">
        @if(!string.IsNullOrEmpty(AlertMessage_parent))
        {
            <AlertMessageBox
                Message         = "@AlertMessage_parent"
                ConfirmBtn_Text = "@ConfirmBtn_Text_parent"
                CancelBtn_Text  = "@CancelBtn_Text_parent"
                ConfirmBtn_Func = "@ConfirmBtn_Func_parent"
                CancelBtn_Func  = "@CancelBtn_Func_parent"
                />
        }
    </div>
}

<div class="page-wrapper">
    <div class="top-bar">
        <div class="leftPart">
            <div class="subsystem-select-group">
                <label for="subsystem-select" class="local-label">@Localizer["InverterSetting-Subsystem"]</label>
                <select id="subsystem-select" class="subsystem-select" value="@SelectedSubSystemKey" @onchange="Local_OnSubSystemChanged" @onclick:stopPropagation="true" @onchange:stopPropagation="true">
                    @if (_subSystemOptions.Count == 0)
                    {
                        <option value="">@Localizer["InverterSetting-PleaseSelectSubsystem"]</option>
                    }
                    else
                    {
                        foreach (var subSystem in _subSystemOptions)
                        {
                            <option value="@BuildKey(subSystem.Port, subSystem.Protocol)">@GetSubSystemDisplay(subSystem)</option>
                        }
                    }
                </select>
            </div>
        </div>
        <div class="rightPart">
            <button type="button" class="btn btn-primary no-flex" @onclick="OnSaveButtonClick">@Localizer["InverterSetting-SaveSettings"]</button>
        </div>
    </div>

    <div class="content-container">
        @* <MudOverlay DisablePortal="true" Visible="_isLoading" DarkBackground="true" Class="Mud-overlay d-flex justify-center align-center">
            <MudPaper Class="pa-6 d-flex flex-column align-center" Elevation="4" Rounded="true">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium"/>
                <MudText Typo="Typo.h6" Class="mt-4">Waiting for devices linking...</MudText>
            </MudPaper>
        </MudOverlay> *@

        <div class="card-grid">
            <div class="w50">
                <div class="card-container-layout card-container-base">
                    <canvas id="sinChart" class="canvas-width-height-limit"></canvas>
                    <div class="selection-container">
                        <div class="single-selection">
                            <select value="@selectedFreqType" @onchange="OnFreqTypeChanged" @onclick:stopPropagation="true" @onchange:stopPropagation="true">
                                <option value="@ConstDefinition.Str_50Hz">50Hz</option>
                                <option value="@ConstDefinition.Str_60Hz">60Hz</option>
                            </select>
                        </div>
                        <div class="single-selection">
                            <select value="@selectedVoltType" @onchange="OnVoltTypeChanged" @onclick:stopPropagation="true" @onchange:stopPropagation="true">
                                @foreach(var type in ShowSeriesSelelction_List)
                                {
                                    <option value="@type">@type</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="w50">
                <div class="right-part-layout card-container-base">
                    <div class="small-row">
                        <div class="cell">
                            @* <h3 class="desktop-only">AC模式充電器</h3> *@
                            <div class="alarm-label" style="font-size: 1.2rem; font-weight: bold;">@Localizer["InverterSetting-ACModeCharger"]</div>
                        </div>
                        <div class="cell">
                            <div class="toggle-with-text">
                                <label class="custom-toggle-button" title="@(AC_mode_charging_enable ? "On" : "Off")">
                                    <input type="checkbox" @bind="AC_mode_charging_enable" disabled="@(!AC_mode_charging_touchable)" />
                                    <span class="toggle-slider"></span>
                                </label>
                                <span>@(AC_mode_charging_enable ? "ON" : "OFF")</span>
                            </div>
                        </div>
                    </div>
                    <div class="small-row">
                        <div class="cell">
                            @* <h3 class="desktop-only">並網供電</h3> *@
                            <div class="alarm-label" style="font-size: 1.2rem; font-weight: bold;">@Localizer["InverterSetting-GridTiedPowerFeeding"]</div>
                        </div>
                        <div class="cell">
                            <div class="toggle-with-text">
                                <label class="custom-toggle-button" title="@(Grid_tied_power_feeding_enable ? "On" : "Off")">
                                    <input type="checkbox" @bind="Grid_tied_power_feeding_enable" disabled="@(!Grid_tied_power_feeding_touchable)" />
                                    <span class="toggle-slider"></span>
                                </label>
                                <span>@(Grid_tied_power_feeding_enable ? "ON" : "OFF")</span>
                            </div>
                        </div>
                    </div>
                    <div class="small-row">
                        <div class="cell">
                            @* <h3 class="desktop-only">輸出優先級</h3> *@
                            <div class="alarm-label" style="font-size: 1.2rem; font-weight: bold;">@Localizer["InverterSetting-OutputPriority"]</div>
                        </div>
                        <div class="cell">
                            <select value="@selectedOutputPriority.ToString()" @onchange="OnOutputPrioritySelectChanged" @onclick:stopPropagation="true" @onchange:stopPropagation="true" disabled="@(!Output_priority_touchable)" class="priority-select">
                                <option value="@OUTPUT_PRIORITY.Utility">Utility</option>
                                <option value="@OUTPUT_PRIORITY.Battery">Battery</option>
                                <option value="@OUTPUT_PRIORITY.Solar">Solar</option>
                            </select>
                        </div>
                    </div>
                    <div class="small-row">
                        <div class="cell">
                            @* <h3 class="desktop-only">充電優先級</h3> *@
                            <div class="alarm-label" style="font-size: 1.2rem; font-weight: bold;">@Localizer["InverterSetting-ChargingPriority"]</div>
                        </div>
                        <div class="cell">
                            <select value="@selectedChargingPriority.ToString()" @onchange="OnChargingPrioritySelectChanged" @onclick:stopPropagation="true" @onchange:stopPropagation="true" disabled="@(!Charge_priority_touchable)" class="priority-select">
                                <option value="Utility">Utility</option>
                                <option value="Solar">Solar</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="w100">
                <div class="bottom-container card-container-base">
                    <div class="alarms-col">
                        <div class="alarm-row">
                            <div class="alarm-label">@Localizer["InverterSetting-BatteryAlarm"]</div>
                            <div class="alarm-input">
                                <input type="number" @bind-value="Battery_alarm_value" @bind-value:after="OnBatteryAlarmChanged" placeholder="Battery alarm" min="@Battery_alarm_now_min" max="@Battery_alarm_now_max" step="0.1" />
                            </div>
                            <div class="alarm-slider">
                                <input type="range" @bind="Battery_alarm_value" @bind:event="oninput" @bind:after="OnBatteryAlarmChanged" min="@Battery_alarm_now_min" max="@Battery_alarm_now_max" step="0.1" class="custom-slider" />
                            </div>
                        </div>

                        <div class="alarm-row">
                            <div class="alarm-label">@Localizer["InverterSetting-BatteryShutdown"]</div>
                            <div class="alarm-input">
                                <input type="number" @bind-value="Battery_shutdown_value" @bind-value:after="OnBatteryShutdownChanged" placeholder="Battery shutdown" min="@(Battery_shdn_now_min)" max="@(Battery_shutdown_dynamic_upperBound)" step="0.1" />
                            </div>
                            <div class="alarm-slider">
                                <input type="range" @bind="Battery_shutdown_value" @bind:event="oninput" @bind:after="OnBatteryShutdownChanged" min="@(Battery_shdn_now_min)" max="@(Battery_shutdown_dynamic_upperBound)" step="0.1" class="custom-slider" />
                            </div>
                        </div>

                        
                    </div>
                    <div class="alarms-col">
                        <div class="alarm-row">
                            <div class="alarm-label">@Localizer["InverterSetting-BatteryRecharge"]</div>
                            <div class="alarm-input">
                                <input type="number" @bind-value="Battery_recharge_value" @bind-value:after="OnBatteryRechargeChanged" placeholder="Battery recharge" min="@(Battery_rchg_now_min)" max="@(Battery_recharge_dynamic_upperBound)" step="0.1" />
                            </div>
                            <div class="alarm-slider">
                                <input type="range" @bind="Battery_recharge_value" @bind:event="oninput" @bind:after="OnBatteryRechargeChanged" min="@(Battery_rchg_now_min)" max="@(Battery_recharge_dynamic_upperBound)" step="0.1" class="custom-slider" />
                            </div>
                        </div>
                        <div class="alarm-row">
                            <div class="alarm-label">@Localizer["InverterSetting-BatteryOVAlarm"]</div>
                            <div class="alarm-input">
                                <input type="number" @bind-value="Battery_ov_alarm_value" @bind-value:after="OnBatteryOVAlarmChanged" placeholder="Battery OV alarm"
                                       min="@(Battery_ov_alm_now_min)" max="@(Battery_ov_alm_now_max)" step="0.1" />
                            </div>
                            <div class="alarm-slider">
                                <input type="range" @bind="Battery_ov_alarm_value" @bind:event="oninput" @bind:after="OnBatteryOVAlarmChanged"
                                       min="@(Battery_ov_alm_now_min)" max="@(Battery_ov_alm_now_max)" step="0.1" class="custom-slider" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </div>
@code
{
    [CascadingParameter(Name = "MainLayout")] public MainLayout? MainLayout { get; set; }

    private string _category = string.Empty;
    private bool modal_IsOpen;
    private string? AlertMessage_parent;
    private string ConfirmBtn_Text_parent = string.Empty;
    private string CancelBtn_Text_parent = string.Empty;
    public EventCallback ConfirmBtn_Func_parent { get; set; } = EventCallback.Empty;
    public EventCallback CancelBtn_Func_parent { get; set; } = EventCallback.Empty;
    private bool _isLoading = true;
    private bool oldScalingFactor_OK;
    private string? selectedFreqType;
    private string? selectedVoltType;
    private int waveCount = 5;
    private double period = 144;
    private double peak = 240;
    private DotNetObjectReference<Inverter_setting>? dotNetRef;

    private bool AC_mode_charging_touchable = true;
    private bool Grid_tied_power_feeding_touchable = true;
    private bool Output_priority_touchable = true;
    private bool Charge_priority_touchable = true; 
    private bool _sliderRefreshRequested;

    private bool AC_mode_charging_enable = false;
    private bool Grid_tied_power_feeding_enable = false;
    private OUTPUT_PRIORITY selectedOutputPriority = OUTPUT_PRIORITY.Utility;
    private CHARGING_PRIORITY selectedChargingPriority = CHARGING_PRIORITY.Utility;

    private double  Battery_alarm_value = 0;
    private double  Battery_shutdown_value = 0;
    private double  Battery_recharge_value = 0;
    private int    Battery_capacity_value = 0;
    private double  Battery_ov_alarm_value = 0;
    private const double BAT_ALARM_SHDN_DIFF = 0.2;
    private bool topRowCallbacksRegistered = false;

    private IReadOnlyList<SubSystem> _subSystemOptions = Array.Empty<SubSystem>();
    private string? _selectedSubSystemKey;
    private string SelectedSubSystemKey => _selectedSubSystemKey ?? string.Empty;
    private bool _subsystemHeartbeatSubscribed = false;
    private string xLabel = string.Empty;
    private string yLabel = string.Empty;

    private double Battery_alarm_now_min = 0.0, Battery_alarm_now_max = 0.0;
    private double Battery_shdn_now_min = 0.0, Battery_shdn_now_max = 0.0;
    private double Battery_shutdown_dynamic_upperBound => Math.Min(ScalingComputer.AutoSnapToDecimal_doubleVer(Battery_alarm_value - BAT_ALARM_SHDN_DIFF), Battery_shdn_now_max);
    private double Battery_rchg_now_min = 0.0, Battery_rchg_now_max = 0.0, FV_now_val = 0.0;
    private double Battery_recharge_dynamic_upperBound => ScalingComputer.AutoSnapToDecimal_doubleVer(FV_now_val);
    private double Battery_ov_alm_now_min = 0.0, Battery_ov_alm_now_max = 0.0;



    bool FirstAutoGet_SubSys_done = false;
    bool DotNetHelper_Is_OK = false;
    List<string> Series100VAC_List = new List<string>{"100VAC","110VAC","115VAC","120VAC"};
    List<string> Series200VAC_List = new List<string>{"200VAC","220VAC","230VAC","240VAC"};
    List<string> ShowSeriesSelelction_List = new List<string>();
    protected override async Task OnInitializedAsync()
    {
        //For log
        _category = GetType().FullName!;
        ShowSeriesSelelction_List = Series100VAC_List;

        xLabel = Localizer["InverterSetting-AngleDegrees"];
        yLabel = Localizer["InverterSetting-OutputVoltageV"];

        await base.OnInitializedAsync();
    }

    protected override void OnParametersSet()
    {
        if (!topRowCallbacksRegistered && MainLayout != null)
        {
            MainLayout.RegisterTopRowCallbacks(
                this,
                informParentToApplySetting: ReceiveFrom_TopRow_SaveINVSetting,
                informParentToUseDefaultValue: ReceiveFrom_TopRow_ApplyDefaultValue);
            topRowCallbacksRegistered = true;
        }
    }
    public void Dispose()
    {
        if (_subsystemHeartbeatSubscribed)
        {
            Heartbeat.OnTick -= OnHeartbeatTickAsync;
            _subsystemHeartbeatSubscribed = false;
        }
        if (topRowCallbacksRegistered)
        {
            MainLayout?.ClearTopRowCallbacks(this);
            topRowCallbacksRegistered = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {

        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            DotNetHelper_Is_OK = true;
            await JS.InvokeVoidAsync("startINVHub", dotNetRef);

            await OnChartTypeChanged();
            await DrawChart();
            // Heartbeat.OnTick += Check_ScalingFactor_Status;
            if (!_subsystemHeartbeatSubscribed)
            {
                Heartbeat.OnTick += OnHeartbeatTickAsync;
                _subsystemHeartbeatSubscribed = true;
            }

            await RefreshSubSystemOptionsAsync();
        }

        if (_sliderRefreshRequested && DotNetHelper_Is_OK)
        {
            _sliderRefreshRequested = false;
            await JS.InvokeVoidAsync("sliderFill.refresh");
        }
    }


    #region SubSystemFuncs
    private static string BuildKey(string? port, string? protocol) => $"{port ?? string.Empty}|{protocol ?? string.Empty}";

    private bool ContainsSubSystemKey(string? key)
    {
        if (string.IsNullOrWhiteSpace(key))
        {
            return false;
        }
        foreach (var subSystem in _subSystemOptions)
        {
            if (string.Equals(BuildKey(subSystem.Port, subSystem.Protocol), key, System.StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }
        return false;
    }

    private string GetSubSystemDisplay(SubSystem subSystem)
    {
        var port = string.IsNullOrWhiteSpace(subSystem.Port) ? Localizer["InverterSetting-Unknown"] : subSystem.Port;
        var protocol = string.IsNullOrWhiteSpace(subSystem.Protocol) ? Localizer["InverterSetting-NA"] : subSystem.Protocol;
        return $"{port} - {protocol}";
    }

    private (string Port, string Protocol) GetSelectedSubSystemPortAndProtocol()
    {
        if (string.IsNullOrWhiteSpace(_selectedSubSystemKey))
        {
            return (string.Empty, string.Empty);
        }

        var parts = _selectedSubSystemKey.Split('|');
        if (parts.Length != 2)
        {
            return (string.Empty, string.Empty);
        }

        return (parts[0], parts[1]);
    }

    private async Task RefreshSubSystemOptionsAsync()
    {
        var snapshot = SubSystemManager.GetAllSubSystems_Ref_In_List();
        if(snapshot is null || snapshot.Count == 0)
        {
            _subSystemOptions = Array.Empty<SubSystem>();
            _selectedSubSystemKey = null;
            return;
        }

        //Local變數，取得最新的子系統List快照
        _subSystemOptions = snapshot;
        if(!string.IsNullOrWhiteSpace(_selectedSubSystemKey) && ContainsSubSystemKey(_selectedSubSystemKey))
        {
            return;
        }
        _selectedSubSystemKey = _subSystemOptions.Count > 0
            ? BuildKey(_subSystemOptions[0].Port, _subSystemOptions[0].Protocol)
            : null;
    }

    private async Task Local_OnSubSystemChanged(ChangeEventArgs e)
    {
        var rawValue = e.Value?.ToString();
        if(string.IsNullOrWhiteSpace(rawValue))
        {
            _selectedSubSystemKey = null;
        }
        Console.WriteLine($"[Inverter_setting][Local_OnSubSystemChanged] rawValue = {rawValue}");
        _selectedSubSystemKey = ContainsSubSystemKey(rawValue) ? rawValue : null;

        await subSystemSelectionChangedHandler();
    }

    private async Task ReSubscribeSubSys()
    {
        //1. [JS]嘗試解除當前訂閱的子系統
        await JS.InvokeVoidAsync("unsubscribeAllSubSys");
        //2. [JS]訂閱新的子系統
        var (port, protocol) = GetSelectedSubSystemPortAndProtocol();
        Console.WriteLine($"[ReSubscribeSubSys] port = {port}, protocol = {protocol}");
        await JS.InvokeVoidAsync("subscribeInverterHub", port, protocol);
    }

    private async Task subSystemSelectionChangedHandler()
    {
        //1. 重新訂閱子系統
        await ReSubscribeSubSys();
        //2. 改變VAC_List的Type
        char type = GetVAC_Series_By_mdlName();

        AppLogger.Log_To_File_log(_category, $"[Inverter_setting][subSystemSelectionChangedHandler] type = {type}", AppLogLevel.Debug);
        switch(type)
        {
            case '1': ShowSeriesSelelction_List = Series100VAC_List; break;
            case '2': ShowSeriesSelelction_List = Series200VAC_List; break;
            default : ShowSeriesSelelction_List = Series100VAC_List; break;
        }

    }
    #endregion SubSystemFuncs

    #region Value Change & Validation
    private void OnBatteryAlarmChanged()   { _ = AlarmValueChange_validation(Battery_alarm_value, "alarm"); }
    private void OnBatteryShutdownChanged() { _ = AlarmValueChange_validation(Battery_shutdown_value, "shutdown"); }
    private void OnBatteryRechargeChanged() { _ = AlarmValueChange_validation(Battery_recharge_value, "recharge"); }
    private void OnBatteryCapacityChanged()   { _ = AlarmValueChange_validation(Battery_capacity_value, "capacity"); }
    private void OnBatteryOVAlarmChanged() { _ = AlarmValueChange_validation(Battery_ov_alarm_value, "OV_alarm"); }

    private async Task AlarmValueChange_validation(double value, string type)
    {
        //value是Display值 (只有 capacity 是 uint類型)
        //用Display值進行比較
        double upperBound = 0;
        double lowerBound = 0;
        switch(type)
        {
            case "alarm":
                //check BAT_Alarm
                upperBound = Battery_alarm_now_max;
                lowerBound = Battery_alarm_now_min;
                // Console.WriteLine($"[alarm changed][Alarm] upperBound = {upperBound}, lowerBound = {lowerBound}");
                if(value > upperBound){Battery_alarm_value = upperBound;}
                else if(value < lowerBound){Battery_alarm_value = lowerBound;}
                else{Battery_alarm_value = value;}
                // Console.WriteLine($"Battery_alarm_value = {Battery_alarm_value}");

                //check BAT_shutdown (這裡的Battery_alarm_value已是更新過的)
                upperBound = Battery_shutdown_dynamic_upperBound;
                lowerBound = Battery_shdn_now_min;
                // Console.WriteLine($"[alarm changed][Shutdown] upperBound = {upperBound}, lowerBound = {lowerBound}");
                if(Battery_shutdown_value > upperBound){Battery_shutdown_value = upperBound;}
                else if(Battery_shutdown_value < lowerBound){Battery_shutdown_value = lowerBound;}

                break;
            case "shutdown":
                upperBound = Battery_shutdown_dynamic_upperBound;
                lowerBound = Battery_shdn_now_min;
                if(value > upperBound){Battery_shutdown_value = upperBound;}
                else if(value < lowerBound){Battery_shutdown_value = lowerBound;}
                else{Battery_shutdown_value = value;}

                break;
            case "recharge":
                upperBound = FV_now_val;
                lowerBound = Battery_rchg_now_min;
                if(value > upperBound){Battery_recharge_value = upperBound;}
                else if(value < lowerBound){Battery_recharge_value = lowerBound;}
                else{Battery_recharge_value = value;}

                break;
            case "OV_alarm":
                upperBound = Battery_ov_alm_now_max;
                lowerBound = Battery_ov_alm_now_min;
                if(value > upperBound){Battery_ov_alarm_value = upperBound;}
                else if(value < lowerBound){Battery_ov_alarm_value = lowerBound;}
                else{Battery_ov_alarm_value = value;}

                break;
            default:
                break;
        }
        _sliderRefreshRequested = true;
        StateHasChanged();
    }

    private async Task AlarmValueChange_validation(int value, string type)
    {
        if(type == "capacity")
        {
            int upperBound = 9999;
            int lowerBound = 0;
            if(value > upperBound){Battery_capacity_value = upperBound;}
            else if(value < lowerBound){Battery_capacity_value = lowerBound;}
            else{Battery_capacity_value = value;}
        }
        _sliderRefreshRequested = true;
    }
    #endregion Value Change & Validation

    #region UI Event Handlers
    private Task OnSaveButtonClick()
    {
        TriggerAlert("Save");
        return Task.CompletedTask;
    }

    private async Task OnHeartbeatTickAsync()
    {
        await RefreshSubSystemOptionsAsync();
        if(FirstAutoGet_SubSys_done is false && DotNetHelper_Is_OK is true)
        {
            FirstAutoGet_SubSys_done = true;
            await subSystemSelectionChangedHandler();
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnFreqTypeChanged(ChangeEventArgs e)
    {
        selectedFreqType = e.Value?.ToString() ?? "";
        await OnChartTypeChanged();
    }

    private async Task OnVoltTypeChanged(ChangeEventArgs e)
    {
        selectedVoltType = e.Value?.ToString() ?? "";
        await OnChartTypeChanged();
    }

    private void OnOutputPriorityChanged()
    {
        Console.WriteLine($"Output Priority : enum = {(int)selectedOutputPriority}, str = {selectedOutputPriority}");
    }

    private void OnOutputPrioritySelectChanged(ChangeEventArgs e)
    {
        if (e.Value != null && Enum.TryParse<OUTPUT_PRIORITY>(e.Value.ToString(), out var priority))
        {
            selectedOutputPriority = priority;
            OnOutputPriorityChanged();
        }
    }

    private void OnChargingPriorityChanged()
    {
        Console.WriteLine($"Charge Priority : enum = {(int)selectedChargingPriority}, str= {selectedChargingPriority}");
    }

    private void OnChargingPrioritySelectChanged(ChangeEventArgs e)
    {
        if (e.Value != null && Enum.TryParse<CHARGING_PRIORITY>(e.Value.ToString(), out var priority))
        {
            selectedChargingPriority = priority;
            OnChargingPriorityChanged();
        }
    }
    #endregion UI Event Handlers

    #region Chart Helpers
    private async Task OnChartTypeChanged()
    {
        switch(selectedFreqType)
        {
            case "50Hz":
                waveCount = 4;
                period = 720.0 / waveCount;
                break;
            case "60Hz":
                waveCount = 5;
                period = 720.0 / waveCount;
                break;
            default:
                break;
        }

        switch(selectedVoltType)
        {
            case "100VAC": peak = 100; break;
            case "110VAC": peak = 110; break;
            case "115VAC": peak = 115; break;
            case "120VAC": peak = 120; break;
            case "200VAC": peak = 200; break;
            case "220VAC": peak = 220; break;
            case "230VAC": peak = 230; break;
            case "240VAC": peak = 240; break;
            default:
                break;
        }

        Console.WriteLine($"Freq = {selectedFreqType}, Volt = {selectedVoltType}");
        Console.WriteLine($"計算得出 peak = {peak}, period = {period}");
        await DrawChart();
    }

    private async Task DrawChart()
    {
        await JS.InvokeVoidAsync("drawChart_Sin", new {
            canvasID = "sinChart",
            peak = peak,
            period = period,
            chartType = "line",
            xLabel = xLabel,
            yLabel = yLabel,
            yMin = -250,
            yMax = 250,
            totalDegrees = 720
        });
    }
    #endregion Chart Helpers

    #region Top Row & Alerts
    private async Task ReceiveFrom_TopRow_SaveINVSetting()
    {
        TriggerAlert("Save");
    }

    private async Task ReceiveFrom_TopRow_ApplyDefaultValue()
    {
        TriggerAlert("DefaultVal");
    }

    private void TriggerAlert(string _alertMessage_FromOtherFunc)
    {
        modal_IsOpen = true;

        AlertMessage_parent     = "";
        ConfirmBtn_Text_parent  = "";
        CancelBtn_Text_parent   = "";
        ConfirmBtn_Func_parent  = EventCallback.Empty;
        CancelBtn_Func_parent   = EventCallback.Empty;
        switch(_alertMessage_FromOtherFunc)
        {
            case "Save":
                AlertMessage_parent     = Localizer["InverterSetting-ConfirmSave"];
                ConfirmBtn_Text_parent  = "確定";
                CancelBtn_Text_parent   = "取消";
                ConfirmBtn_Func_parent  = EventCallback.Factory.Create(this, ConfirmSave);
                CancelBtn_Func_parent   = EventCallback.Factory.Create(this, CancelSave);
                break;
            default:
                break;
        }
    }

    private void CloseAlert()
    {
        AlertMessage_parent = null;
    }
    private void CloseModal()
    {   
        //close modal
        modal_IsOpen = false;
        //Close Alert
        AlertMessage_parent = null;
    }
    #endregion Top Row & Alerts


    #region Save Workflow
    private List<Post_RealSingleRawSettingCMD_JsonFormat> nowUiData_transformTo_apiWriteData()
    {
        List<Post_RealSingleRawSettingCMD_JsonFormat> configuredCmdData_list = new List<Post_RealSingleRawSettingCMD_JsonFormat>();

        string port = string.Empty;
        string protocol = string.Empty;
        (port, protocol) = GetSelectedSubSystemPortAndProtocol();
        Console.WriteLine($"[nowUiData_transformTo_apiWriteData] port = {port}, protocol = {protocol}");

        //Output_ACF_Set (0x0103 "BIT_0")
        var Output_ACF_BitKey = SubSystemManager.GetBitKey_FromSubSys(port, protocol, "0103", 0);
        var ACF_Bits_tmp = SubSystemManager.GetRealBitsFormat(port, protocol, "0103");
        if (ACF_Bits_tmp != null)
        {
            if(Output_ACF_BitKey is not null)
            {
                switch(selectedFreqType)
                {
                    //這邊是看命令支援表設定
                    case "50Hz": ACF_Bits_tmp[Output_ACF_BitKey] = 1; break; //命令支援表中 1 ，代表50Hz
                    case "60Hz": ACF_Bits_tmp[Output_ACF_BitKey] = 2; break; //命令支援表中 2 ，代表60Hz
                    //無效值
                    default:     ACF_Bits_tmp[Output_ACF_BitKey] = 3; break; //命令支援表中 3 ，無效值，用在這裡代表不做任何設定
                }

                if(ACF_Bits_tmp[Output_ACF_BitKey] != 3)
                {
                    var Output_ACF_Set_cmdData = SubSystemManager.createOneWriteCmdData(port, protocol, "0103", RealBits: ACF_Bits_tmp);
                    if(Output_ACF_Set_cmdData != null)
                    {
                        AppLogger.Log_To_File_log(_category, $"[Inverter_setting][nowUiData_transformTo_apiWriteData] cmdCode = 0103, cmdData add into configurableCmdData_list", AppLogLevel.Trace); 
                        configuredCmdData_list.Add(Output_ACF_Set_cmdData);
                    }
                }
            }
        }
        //Output_ACV_Set (0x0102 "BIT_0")
        var Output_ACV_BitKey = SubSystemManager.GetBitKey_FromSubSys(port, protocol, "0102", 0);
        Console.WriteLine($"[nowUiData_transformTo_apiWriteData] Output_ACV_BitKey = {Output_ACV_BitKey}");
        var ACV_Bits_tmp = SubSystemManager.GetRealBitsFormat(port, protocol, "0102");
        if(ACV_Bits_tmp != null)
        {
            if (Output_ACV_BitKey is not null)
            {
                switch(selectedVoltType)
                {
                    //這裡是看命令支援表設定
                    //100VAC Series
                    case "100VAC": ACV_Bits_tmp[Output_ACV_BitKey] = 1; break; //命令支援表中 1 ，代表100VAC
                    case "110VAC": ACV_Bits_tmp[Output_ACV_BitKey] = 2; break; //命令支援表中 2 ，代表110VAC
                    case "115VAC": ACV_Bits_tmp[Output_ACV_BitKey] = 3; break; //命令支援表中 3 ，代表115VAC
                    case "120VAC": ACV_Bits_tmp[Output_ACV_BitKey] = 4; break; //命令支援表中 4 ，代表120VAC
                    //200VAC Series
                    case "200VAC": ACV_Bits_tmp[Output_ACV_BitKey] = 1; break; //命令支援表中 1 ，代表200VAC
                    case "220VAC": ACV_Bits_tmp[Output_ACV_BitKey] = 2; break; //命令支援表中 2 ，代表220VAC
                    case "230VAC": ACV_Bits_tmp[Output_ACV_BitKey] = 3; break; //命令支援表中 3 ，代表230VAC
                    case "240VAC": ACV_Bits_tmp[Output_ACV_BitKey] = 4; break; //命令支援表中 4 ，代表240VAC
                    //無效值
                    default:       ACV_Bits_tmp[Output_ACV_BitKey] = 5; break; //命令支援表中 5 ，無效值，用在這裡代表不做任何設定
                }
                Console.WriteLine($"ACV_Bits_tmp[{Output_ACV_BitKey}] = {ACV_Bits_tmp[Output_ACV_BitKey]}");

                if(ACV_Bits_tmp[Output_ACV_BitKey] != 5)
                {
                    var Output_ACV_Set_cmdData = SubSystemManager.createOneWriteCmdData(port, protocol, "0102", RealBits: ACV_Bits_tmp);
                    if(Output_ACV_Set_cmdData != null)
                    {
                        AppLogger.Log_To_File_log(_category, $"[Inverter_setting][nowUiData_transformTo_apiWriteData] cmdCode = 0102, cmdData add into configurableCmdData_list", AppLogLevel.Trace);
                        configuredCmdData_list.Add(Output_ACV_Set_cmdData);
                    }
                }    
            }
        }

        //CHG_Enable (0x0100 "BIT_2")
        //GRID_Enable (0x0100 "BIT_3")
        var CHG_BitKey = SubSystemManager.GetBitKey_FromSubSys(port, protocol, "0100", 2);
        var GRID_BitKey = SubSystemManager.GetBitKey_FromSubSys(port, protocol, "0100", 3);
        var AddrValues_List = SubSystemManager.GetAddrValues_Copy(port, protocol, "0100");
        if(AddrValues_List != null && AddrValues_List.Count > 0)
        {
            foreach(var addrValue in AddrValues_List)
            {
                //Reference 到 Bits
                var Bits_tmp = addrValue.Value.Bits;
                if(Bits_tmp != null)
                {
                    //透過 reference 修改 addrValue.Value.Bits 的值
                    if(CHG_BitKey is not null) {Bits_tmp[CHG_BitKey] = AC_mode_charging_enable ? 1 : 0;}
                    if(GRID_BitKey is not null) {Bits_tmp[GRID_BitKey] = Grid_tied_power_feeding_enable ? 1 : 0;}
                }
            }


            var INV_OPERATION_cmdData = SubSystemManager.createOneWriteCmdData(port, protocol, "0100", RealPerAddrValues: AddrValues_List);
            if(INV_OPERATION_cmdData != null)
            {
                AppLogger.Log_To_File_log(_category, $"[Inverter_setting][nowUiData_transformTo_apiWriteData] cmdCode = 0100, cmdData add into configurableCmdData_list", AppLogLevel.Trace);
                configuredCmdData_list.Add(INV_OPERATION_cmdData);
            }
        }

        //OutputPrio (0x0101 "BIT_0")
        //ChargingPrio (0x0101 "BIT_2")
        var OutPutPrio_BitKey = SubSystemManager.GetBitKey_FromSubSys(port, protocol, "0101", 0);
        var ChargePrio_BitKey = SubSystemManager.GetBitKey_FromSubSys(port, protocol, "0101", 2);
        var INV_CONFIG_Bits_tmp = SubSystemManager.GetRealBitsFormat(port, protocol, "0101");
        if(INV_CONFIG_Bits_tmp != null)
        {
            if(OutPutPrio_BitKey is not null){INV_CONFIG_Bits_tmp[OutPutPrio_BitKey] = (int)selectedOutputPriority;}
            if(ChargePrio_BitKey is not null){INV_CONFIG_Bits_tmp[ChargePrio_BitKey] = (int)selectedChargingPriority;}
            var INV_CONFIG_cmdData = SubSystemManager.createOneWriteCmdData(port, protocol, "0101", RealBits: INV_CONFIG_Bits_tmp);
            if(INV_CONFIG_cmdData != null)
            {
                AppLogger.Log_To_File_log(_category, $"[Inverter_setting][nowUiData_transformTo_apiWriteData] cmdCode = 0101, cmdData add into configurableCmdData_list", AppLogLevel.Trace);
                configuredCmdData_list.Add(INV_CONFIG_cmdData);
            } 
        }

        // Battery_alarm_value
        var BAT_ALM_VOLT_val_cmdData = SubSystemManager.createOneWriteCmdData(port, protocol, "00B9", RealNumber: Battery_alarm_value);
        if(BAT_ALM_VOLT_val_cmdData != null)
        {
            AppLogger.Log_To_File_log(_category, $"[Inverter_setting][nowUiData_transformTo_apiWriteData] cmdCode = 00B9, cmdData add into configurableCmdData_list", AppLogLevel.Trace);
            configuredCmdData_list.Add(BAT_ALM_VOLT_val_cmdData);
        }
        // Battery_shutdown_value
        var BAT_SHUTDOWN_VOLT_val_cmdData = SubSystemManager.createOneWriteCmdData(port, protocol, "00BA", RealNumber: Battery_shutdown_value);
        if(BAT_SHUTDOWN_VOLT_val_cmdData != null)
        {
            AppLogger.Log_To_File_log(_category, $"[Inverter_setting][nowUiData_transformTo_apiWriteData] cmdCode = 00BA, cmdData add into configurableCmdData_list", AppLogLevel.Trace);
            configuredCmdData_list.Add(BAT_SHUTDOWN_VOLT_val_cmdData);
        }
        // Battery_recharge_value
        var BAT_RECHARGE_VOLT_val_cmdData = SubSystemManager.createOneWriteCmdData(port, protocol, "00BB", RealNumber: Battery_recharge_value);
        if(BAT_RECHARGE_VOLT_val_cmdData != null)
        {
            AppLogger.Log_To_File_log(_category, $"[Inverter_setting][nowUiData_transformTo_apiWriteData] cmdCode = 00BB, cmdData add into configurableCmdData_list", AppLogLevel.Trace);
            configuredCmdData_list.Add(BAT_RECHARGE_VOLT_val_cmdData);
        }
        // Battery_ov_alarm_value
        var BAT_OV_ALM_VOLT_val_cmdData = SubSystemManager.createOneWriteCmdData(port, protocol, "00BC", RealNumber: Battery_ov_alarm_value);
        if(BAT_OV_ALM_VOLT_val_cmdData != null)
        {
            AppLogger.Log_To_File_log(_category, $"[Inverter_setting][nowUiData_transformTo_apiWriteData] cmdCode = 00BC, cmdData add into configurableCmdData_list", AppLogLevel.Trace);
            configuredCmdData_list.Add(BAT_OV_ALM_VOLT_val_cmdData);
        }

        return configuredCmdData_list;
    }

    private async Task ConfirmSave()
    {

        try
        {
            string port = string.Empty;
            string protocol = string.Empty;
            (port, protocol) = GetSelectedSubSystemPortAndProtocol();

            //1. 轉 UI值 成 WriteAPI值
            var apiWriteData = nowUiData_transformTo_apiWriteData();

            //2. apiWriteData 傳到 SubSystemManager 發送
            bool isWriteSuccess = await SubSystemManager.WriteCmdsToFramework(port, protocol, apiWriteData, 1);
            if (isWriteSuccess is false)
            {
                AppLogger.Log_To_File_log(_category, $"[Inverter_setting][ConfirmSave] Writing To device failed", AppLogLevel.Warning);
                return;
            }
        }
        catch (Exception ex)
        {
            AppLogger.Log_To_File_log(_category, $"[Inverter_setting][ConfirmSave] Exception: {ex.Message}", AppLogLevel.Error);
            return;
        }
        finally
        {
            CloseAlert();
            CloseModal();
            Console.WriteLine("[ConfirmSave]");
        }
    }

    private async Task CancelSave()
    {
        CloseAlert();
        CloseModal();
    }
    #endregion Save Workflow


    #region JS Interop Callbacks
    [JSInvokable("OnSubSysUpdated")]
    public async Task OnSubSysUpdated(JsonElement SubSysConfigurableData)
    {
        // 解析 INVData → 更新 UI
        // 然後刷新畫面
        var options = new JsonSerializerOptions
        {
            PropertyNameCaseInsensitive = true
        };

        var ReceiveData_FromSignalR = SubSysConfigurableData.Deserialize<PageUsableVars>(options);
        if (ReceiveData_FromSignalR == null)
        {
            Console.WriteLine("❌[Inverter_setting][OnSubSysUpdated] 無法反序列化 SubSysConfigurableData_To_JS");
            return;
        }
        Console.WriteLine("🔁 收到 SubSysConfigurableData 更新");

        selectedFreqType = ReceiveData_FromSignalR.Output_ACF_Set;
        selectedVoltType = GetAC_InputType_By_mdlName(ReceiveData_FromSignalR.Output_ACV_Set);
        AC_mode_charging_enable = ReceiveData_FromSignalR.CHG_Enable;
        Grid_tied_power_feeding_enable = ReceiveData_FromSignalR.GRID_Enable;
        selectedOutputPriority = ReceiveData_FromSignalR.OutputPrio;
        selectedChargingPriority = ReceiveData_FromSignalR.ChargingPrio;

        //從FrameWork讀回來的時候，不會進到這四個if-statement，因為機器的值不會在上下限之外
        if( ReceiveData_FromSignalR.BAT_ALM_VOLT_val < ReceiveData_FromSignalR.BAT_ALM_VOLT_Min_val || 
            ReceiveData_FromSignalR.BAT_ALM_VOLT_val > ReceiveData_FromSignalR.BAT_ALM_VOLT_Max_val ) {ReceiveData_FromSignalR.BAT_ALM_VOLT_val = ReceiveData_FromSignalR.BAT_ALM_VOLT_Max_val;}
        if( ReceiveData_FromSignalR.BAT_SHDN_VOLT_val < ReceiveData_FromSignalR.BAT_SHDN_VOLT_Min_val || 
            ReceiveData_FromSignalR.BAT_SHDN_VOLT_val > ReceiveData_FromSignalR.BAT_SHDN_VOLT_Max_val ) {ReceiveData_FromSignalR.BAT_SHDN_VOLT_val = ReceiveData_FromSignalR.BAT_SHDN_VOLT_Max_val;}
        if( ReceiveData_FromSignalR.BAT_RCHG_VOLT_val < ReceiveData_FromSignalR.BAT_RCHG_VOLT_Min_val || 
            ReceiveData_FromSignalR.BAT_RCHG_VOLT_val > ReceiveData_FromSignalR.BAT_RCHG_VOLT_Max_val ) {ReceiveData_FromSignalR.BAT_RCHG_VOLT_val = ReceiveData_FromSignalR.BAT_RCHG_VOLT_Max_val;}
        if( ReceiveData_FromSignalR.BAT_OV_ALM_VOLT_val < ReceiveData_FromSignalR.BAT_OV_ALM_VOLT_Min_val || 
            ReceiveData_FromSignalR.BAT_OV_ALM_VOLT_val > ReceiveData_FromSignalR.BAT_OV_ALM_VOLT_Max_val ) {ReceiveData_FromSignalR.BAT_OV_ALM_VOLT_val = ReceiveData_FromSignalR.BAT_OV_ALM_VOLT_Max_val;}

        
        Battery_alarm_value = ReceiveData_FromSignalR.BAT_ALM_VOLT_val;
        Battery_alarm_now_min = ReceiveData_FromSignalR.BAT_ALM_VOLT_Min_val;
        Battery_alarm_now_max = ReceiveData_FromSignalR.BAT_ALM_VOLT_Max_val;

        Battery_shutdown_value = ReceiveData_FromSignalR.BAT_SHDN_VOLT_val;
        Battery_shdn_now_min = ReceiveData_FromSignalR.BAT_SHDN_VOLT_Min_val;
        Battery_shdn_now_max = ReceiveData_FromSignalR.BAT_SHDN_VOLT_Max_val;

        Battery_recharge_value = ReceiveData_FromSignalR.BAT_RCHG_VOLT_val;
        Battery_rchg_now_min = ReceiveData_FromSignalR.BAT_RCHG_VOLT_Min_val;
        Battery_rchg_now_max = ReceiveData_FromSignalR.BAT_RCHG_VOLT_Max_val;
        FV_now_val = ReceiveData_FromSignalR.CURVE_FV_val;

        Battery_ov_alarm_value = ReceiveData_FromSignalR.BAT_OV_ALM_VOLT_val;
        Battery_ov_alm_now_min = ReceiveData_FromSignalR.BAT_OV_ALM_VOLT_Min_val;
        Battery_ov_alm_now_max = ReceiveData_FromSignalR.BAT_OV_ALM_VOLT_Max_val;
        // Battery_capacity_value = ReceiveData_FromSignalR.bat_capacity_value;

        await OnChartTypeChanged();
        _sliderRefreshRequested = true;
        await InvokeAsync(StateHasChanged);
    }

    private string GetAC_InputType_By_mdlName(string rcv_fromSignalR_acv_display_str)
    {
        
        //0. 拆解 rcv_fromSignalR_acv_display_str
        var parts = rcv_fromSignalR_acv_display_str.Split('/');
        string Series100 = parts[0] + "VAC";
        string Series200 = parts[1] + "VAC";

        char type = GetVAC_Series_By_mdlName();
        switch(type)
        {
            case '1':
                return Series100;
            case '2':
                return Series200;
            default:
                return Series100;
        }
    }

    private char GetVAC_Series_By_mdlName()
    {
        //1. 取得選取的子系統的 port & protocol
        string port = string.Empty;
        string protocol = string.Empty;
        (port, protocol) = GetSelectedSubSystemPortAndProtocol();

        //2. 透過 SubSystemManager 取得 SubSystem 參考
        var subsys = SubSystemManager.GetOneSubSystem_Ref(port, protocol);
        if(subsys is null)
        {
            AppLogger.Log_To_File_log(_category, $"[Inverter_setting][GetAC_InputType_By_mdlName] 無法取得 SubSystem 參考，port = {port}, protocol = {protocol}", AppLogLevel.Warning);
            return '1';
        }

        //3. 取得SubSystem 的 ModelName
        string mdlName = subsys.ModelName ?? string.Empty;
        if(string.IsNullOrWhiteSpace(mdlName))
        {
            AppLogger.Log_To_File_log(_category, $"[Inverter_setting][GetAC_InputType_By_mdlName] SubSystem ModelName 為空，port = {port}, protocol = {protocol}", AppLogLevel.Warning);
            return '1';
        }

        //4. 根據 ModelName 判斷 AC_InputType
        AppLogger.Log_To_File_log(_category, $"[Inverter_setting][GetAC_InputType_By_mdlName] SubSystem ModelName = {mdlName}, ModelName Length = {mdlName.Length}, mdlName[7] = {(mdlName.Length >=8 ? mdlName[7].ToString() : "N/A")}", AppLogLevel.Debug);
        char type = mdlName.Length >= 8 ? mdlName[7] : '1'; //從第7個字元判斷，'1'代表100VAC系列，'2'代表200VAC系列，預設或錯誤都是'1'
        return type;
    }
    #endregion JS Interop Callbacks
