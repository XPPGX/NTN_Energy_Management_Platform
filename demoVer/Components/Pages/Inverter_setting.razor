@page "/Inverter_setting"

@rendermode InteractiveServer
@inject IJSRuntime JS
@inject DataCenter DataCenter
@using demoVer.Components.Layout
@using System.Text.Json
@using demoVer.Models
@using demoVer.Utils

<MudPopoverProvider/>
@*Web Content*@
<PageTitle>Inverter Setting</PageTitle>
<TopRow InformParentTo_ApplySetting="ReceiveFrom_TopRow_SaveINVSetting"
        InformParentTo_UseDefaultValue="ReceiveFrom_TopRow_ApplyDefaultValue"/>

@if(modal_IsOpen)
{
    <div class="modal-overlay" @onclick="CloseModal">
        @if(!string.IsNullOrEmpty(AlertMessage_parent))
        {
            <AlertMessageBox
                Message         = "@AlertMessage_parent"
                ConfirmBtn_Text = "@ConfirmBtn_Text_parent"
                CancelBtn_Text  = "@CancelBtn_Text_parent"
                ConfirmBtn_Func = "@ConfirmBtn_Func_parent"
                CancelBtn_Func  = "@CancelBtn_Func_parent"
                />
        }
    </div>
}


<div class="content-container">
    <div class="card-grid">
        <div class="w50">
            <div class="card-container">
                <canvas id="sinChart" class="canvas-width-height-limit"></canvas>
                <div class="selection-container">
                    <div class="single-selection">
                        <MudSelect T="string" Label="輸出頻率" Value="selectedFreqType" Immediate="true" Dense="true" Variant="Variant.Filled" ValueChanged="@(v => {selectedFreqType = v; OnChartTypeChanged();})">
                            @foreach(var pair in DataCenter.INV.ACF_DisplayMap)
                            {
                                <MudSelectItem Value="@(pair.Value)">@pair.Value</MudSelectItem>
                            }

                            @* <MudSelectItem Value="@("50Hz")">50Hz</MudSelectItem>
                            <MudSelectItem Value="@("60Hz")">60Hz</MudSelectItem> *@
                        </MudSelect>
                    </div>
                    <div class="single-selection">
                        <MudSelect T="string" Label="輸出電壓" Value="selectedVoltType" Immediate="true" Dense="true" Variant="Variant.Filled" ValueChanged="@(v => {selectedVoltType = v; OnChartTypeChanged();})">
                            @foreach(var pair in DataCenter.INV.ACV_DisplayMap)
                            {
                                <MudSelectItem Value="@(pair.Value)">@pair.Value</MudSelectItem>
                            }
                            
                            @* <MudSelectItem Value="@("220V")">220V</MudSelectItem>
                            <MudSelectItem Value="@("230V")">230V</MudSelectItem> *@
                        </MudSelect>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="w50">
            <div class="right-part">
                <div class="small-row">
                    <div class="cell">
                        <h3 class="desktop-only">AC模式充電器</h3>
                        <div class="mobile-only">AC模式充電器</div>
                    </div>
                    <div class="cell">
                        <MudSwitch  T="bool" 
                                @bind-Value="AC_mode_charging_enable" 
                                Color="Color.Primary"  
                                Size="Size.Large"
                                Disabled="@(!AC_mode_charging_touchable)">@(AC_mode_charging_enable ? "ON" : "OFF")</MudSwitch>
                    </div>
                </div>
                <div class="small-row">
                    <div class="cell">
                        <h3 class="desktop-only">並網供電</h3>
                        <div class="mobile-only">並網供電</div>
                    </div>
                    <div class="cell">
                        <MudSwitch  T="bool" 
                                @bind-Value="Grid_tied_power_feeding_enable" 
                                Color="Color.Primary"  
                                Size="Size.Large"
                                Disabled="@(!Grid_tied_power_feeding_touchable)">@(Grid_tied_power_feeding_enable ? "ON" : "OFF")</MudSwitch>
                    </div>
                </div>
                <div class="small-row">
                    <div class="cell">
                        <h3 class="desktop-only">輸出優先級</h3>
                        <div class="mobile-only">輸出優先級</div>
                    </div>
                    <div class="cell">
                        <MudSelect T="OUTPUT_PRIORITY" Label="" 
                                    Value="selectedOutputPriority" Immediate="true" 
                                    Dense="true" Variant="Variant.Filled" 
                                    FitContent="true"
                                    ValueChanged="@(v => {selectedOutputPriority = v; OnOutputPriorityChanged();})"
                                    Disabled="@(!Output_priority_touchable)">
                            <MudSelectItem Value="OUTPUT_PRIORITY.Utility">Utility</MudSelectItem>
                            <MudSelectItem Value="OUTPUT_PRIORITY.Battery">Battery</MudSelectItem>
                            @* <MudSelectItem Value="OUTPUT_PRIORITY.Solar">Solar</MudSelectItem> *@
                        </MudSelect>
                    </div>

                    
                </div>
                <div class="small-row">
                    <div class="cell">
                        <h3 class="desktop-only">充電優先級</h3>
                        <div class="mobile-only">充電優先級</div>
                    </div>
                    <div class="cell">
                        <MudSelect T="CHARGING_PRIORITY" Label="" 
                                    Value="selectedChargingPriority" Immediate="true" 
                                    Dense="true" Variant="Variant.Filled" 
                                    FitContent="true"
                                    ValueChanged="@(v => {selectedChargingPriority = v; OnChargingPriorityChanged();})"
                                    Disabled="@(!Charge_priority_touchable)">
                            <MudSelectItem Value="CHARGING_PRIORITY.Utility">Utility</MudSelectItem>
                            <MudSelectItem Value="CHARGING_PRIORITY.Solar">Solar</MudSelectItem>
                        </MudSelect>
                    </div>
                </div>
            </div>
        </div>

        <div class="w100">
            <div class="bottom-container">
                <div class="alarms-col">
                    <div class="alarm-row">
                        <div class="alarm-label">Battery alarm</div>
                        <div class="alarm-input">
                            <MudTextField @ref="_alarmFieldRef" T="double" InputType="InputType.Number" Value="@Battery_alarm_value" ValueChanged="OnBatteryAlarmChanged" ValueExpression="() => Battery_alarm_value" Label="Battery alarm" Variant="Variant.Outlined" Class="small-textField" 
                                            Min="@(DataCenter.INV.BAT_Alarm_Min_Display)" Max="@(DataCenter.INV.BAT_Alarm_Max_Display)" Step="0.1" Validation="@((double value) => ValidateHint<double>(value, DataCenter.INV.BAT_Alarm_Max_Display, DataCenter.INV.BAT_Alarm_Min_Display))"
                                            OnBlur="@(() => FixValue(_alarmFieldRef, Battery_alarm_value, DataCenter.INV.BAT_Alarm_Min_Display, DataCenter.INV.BAT_Alarm_Max_Display))"/> 
                        </div>
                        <div class="alarm-slider">
                            <MudSlider T="double" Value="@Battery_alarm_value" ValueChanged="OnBatteryAlarmChanged" ValueExpression="() => Battery_alarm_value"
                                  Variant="Variant.Filled" Min="@(DataCenter.INV.BAT_Alarm_Min_Display)" Max="@(DataCenter.INV.BAT_Alarm_Max_Display)" Step="0.1" Size="Size.Large" />
                        </div>
                    </div>
                    
                    <div class="alarm-row">
                        <div class="alarm-label">Battery shutdown</div>
                        <div class="alarm-input">
                            <MudTextField @ref="_shutdownFieldRef" T="double" Value="@Battery_shutdown_value" ValueChanged="OnBatteryShutdownChanged" ValueExpression="() => Battery_shutdown_value" Label="Battery shutdown" Variant="Variant.Outlined" Class="small-textField" 
                                            Min="@(DataCenter.INV.BAT_Shutdown_Min_Display)" Max="@(Battery_shutdown_dynamic_upperBound)" Step="0.1" Validation="@((double value) => ValidateHint<double>(value, Battery_shutdown_dynamic_upperBound, DataCenter.INV.BAT_Shutdown_Min_Display))"
                                            OnBlur="@(() => FixValue(_shutdownFieldRef, Battery_shutdown_value, DataCenter.INV.BAT_Shutdown_Min_Display, Battery_shutdown_dynamic_upperBound))"/>
                        </div>
                        <div class="alarm-slider">
                            <MudSlider T="double" Value="@Battery_shutdown_value" ValueChanged="OnBatteryShutdownChanged" ValueExpression="() => Battery_shutdown_value"   Variant="Variant.Filled"
                                    Min="@(DataCenter.INV.BAT_Shutdown_Min_Display)" Max="@(Battery_shutdown_dynamic_upperBound)" Step="0.1" Size="Size.Large" />
                        </div>
                    </div>

                    <div class="alarm-row">
                        <div class="alarm-label">Battery recharge</div>
                        <div class="alarm-input">
                            <MudTextField @ref="_rechargeFieldRef" T="double" Value="@Battery_recharge_value" ValueChanged="OnBatteryRechargeChanged" ValueExpression="() => Battery_recharge_value" Label="Battery recharge" Variant="Variant.Outlined" Class="small-textField" 
                                            Min="@(DataCenter.INV.BAT_Recharge_Min_Display)" Max="@(Battery_recharge_dynamic_upperBound)" Step="0.1" Validation="@((double value) => ValidateHint<double>(value, Battery_recharge_dynamic_upperBound, DataCenter.INV.BAT_Recharge_Min_Display))"
                                            OnBlur="@(() => FixValue(_rechargeFieldRef, Battery_recharge_value, DataCenter.INV.BAT_Recharge_Min_Display, Battery_recharge_dynamic_upperBound))"/>
                        </div>
                        <div class="alarm-slider">
                            <MudSlider T="double" Value="@Battery_recharge_value" ValueChanged="OnBatteryRechargeChanged" ValueExpression="() => Battery_recharge_value"   Variant="Variant.Filled"
                                    Min="@(DataCenter.INV.BAT_Recharge_Min_Display)" Max="@(Battery_recharge_dynamic_upperBound)" Step="0.1" Size="Size.Large" />
                        </div>
                    </div>
                </div>
                <div class="alarms-col">
                    <div class="alarm-row">
                        <div class="alarm-label">Battery capacity</div>
                        <div class="alarm-input">
                            <MudTextField @ref="_capacityFieldRef" T="int" Value="@Battery_capacity_value" ValueChanged="OnBatteryCapacityChanged" ValueExpression="() => Battery_capacity_value" Label="Battery capacity" Variant="Variant.Outlined" Class="small-textField" 
                                            Min="0" Max="@(DataCenter.INV.BAT_Capacity_Max)" step="1" Validation="@((int value) => ValidateHint<int>(value, DataCenter.INV.BAT_Capacity_Max, 0))"
                                            OnBlur="@(() => FixValue<int>(_capacityFieldRef, Battery_capacity_value, 0, DataCenter.INV.BAT_Capacity_Max))"/>
                        </div>
                        <div class="alarm-slider">
                            <MudSlider T="int" Value="@Battery_capacity_value" ValueChanged="OnBatteryCapacityChanged" ValueExpression="() => Battery_capacity_value"   Variant="Variant.Filled"
                                    Min="0" Max="@DataCenter.INV.BAT_Capacity_Max" Step="1" Size="Size.Large" />
                        </div>
                    </div>
                    <div class="alarm-row">
                        <div class="alarm-label">Battery OV alarm</div>
                        <div class="alarm-input">
                            <MudTextField @ref="_OV_alarmFieldRef" T="double" Value="@Battery_OV_alarm_value" ValueChanged="OnBatteryOVAlarmChanged" ValueExpression="() => Battery_OV_alarm_value" Label="Battery OV alarm" Variant="Variant.Outlined" Class="small-textField" 
                                            Min="@(DataCenter.INV.BAT_OV_Alarm_Min_Display)" Max="@(DataCenter.INV.BAT_OV_Alarm_Max_Display)" step="0.1" Validation="@((double value) => ValidateHint<double>(value, DataCenter.INV.BAT_OV_Alarm_Max_Display, DataCenter.INV.BAT_OV_Alarm_Min_Display))"
                                            OnBlur="@(() => FixValue<double>(_OV_alarmFieldRef, Battery_OV_alarm_value, DataCenter.INV.BAT_OV_Alarm_Min_Display, DataCenter.INV.BAT_OV_Alarm_Max_Display))" />
                        </div>
                        <div class="alarm-slider">
                            <MudSlider T="double" Value="@Battery_OV_alarm_value" ValueChanged="OnBatteryOVAlarmChanged" ValueExpression="() => Battery_OV_alarm_value"   Variant="Variant.Filled"
                                    Min="@DataCenter.INV.BAT_OV_Alarm_Min_Display" Max="@DataCenter.INV.BAT_OV_Alarm_Max_Display" Step="0.1" Size="Size.Large" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code
{
    private bool isMobile;
    private DotNetObjectReference<Inverter_setting> dotNetRef;
    
    bool modal_IsOpen = false;
    string AlertMessage_parent = null;
    string ConfirmBtn_Text_parent = null;
    string CancelBtn_Text_parent = null;
    public EventCallback ConfirmBtn_Func_parent {get; set;}
    public EventCallback CancelBtn_Func_parent {get; set;}

    //DataCenter紀錄共用的資料，只有多個user中的某個user按下儲存設定的時候，才會去寫到DataCenter的資料，然後用DataHub去推送到其他User的頁面
    private string selectedFreqType = null;
    private string selectedVoltType = null;
    private double peak;
    private double period;
    private int waveCount;
    
    private bool AC_mode_charging_touchable = true;
    private bool Grid_tied_power_feeding_touchable = true;
    private bool Output_priority_touchable = true;
    private bool Charge_priority_touchable = true; 

    private bool AC_mode_charging_enable = false;
    private bool Grid_tied_power_feeding_enable = false;
    private OUTPUT_PRIORITY selectedOutputPriority = OUTPUT_PRIORITY.Utility;
    private CHARGING_PRIORITY selectedChargingPriority = CHARGING_PRIORITY.Utility;
    

    private MudTextField<double>?   _alarmFieldRef;
    private MudTextField<double>?   _shutdownFieldRef;
    private MudTextField<double>?   _rechargeFieldRef;
    private MudTextField<int>?      _capacityFieldRef;
    private MudTextField<double>?   _OV_alarmFieldRef;

    private double  Battery_alarm_value = 0;
    private double  Battery_shutdown_value = 0;
    private double  Battery_recharge_value = 0;
    private int    Battery_capacity_value = 0;
    private double  Battery_OV_alarm_value = 0;
    private const double BAT_ALARM_SHDN_DIFF = 0.2;

    private double Battery_shutdown_dynamic_upperBound => Math.Min(ScalingComputer.AutoSnapToDecimal_doubleVer(Battery_alarm_value - BAT_ALARM_SHDN_DIFF), DataCenter.INV.BAT_Shutdown_Max_Display);
    private double Battery_recharge_dynamic_upperBound => ScalingComputer.AutoSnapToDecimal_doubleVer(DataCenter.Battery.FV_Display);

    private async Task OnBatteryAlarmChanged(double newValue)   {AlarmValueChange_validation(newValue, "alarm");}
    private async Task OnBatteryShutdownChanged(double newValue){AlarmValueChange_validation(newValue, "shutdown");}
    private async Task OnBatteryRechargeChanged(double newValue){AlarmValueChange_validation(newValue, "recharge");}
    private async Task OnBatteryCapacityChanged(int newValue)   {AlarmValueChange_validation(newValue, "capacity");}
    private async Task OnBatteryOVAlarmChanged(double newValue) {AlarmValueChange_validation(newValue, "OV_alarm");}

    private async Task AlarmValueChange_validation(double value, string type)
    {
        //value是Display值 (只有 capacity 是 uint類型)
        //用Display值進行比較
        double upperBound = 0;
        double lowerBound = 0;
        switch(type)
        {
            case "alarm":
                //check BAT_Alarm
                upperBound = Math.Min(DataCenter.Battery.FV_Display, DataCenter.INV.BAT_Alarm_Max_Display);
                lowerBound = DataCenter.INV.BAT_Alarm_Min_Display;
                Console.WriteLine($"[alarm changed][Alarm] upperBound = {upperBound}, lowerBound = {lowerBound}");
                if(value > upperBound){Battery_alarm_value = upperBound;}
                else if(value < lowerBound){Battery_alarm_value = lowerBound;}
                else{Battery_alarm_value = value;}
                Console.WriteLine($"Battery_alarm_value = {Battery_alarm_value}");

                //check BAT_shutdown (這裡的Battery_alarm_value已是更新過的)
                upperBound = Battery_shutdown_dynamic_upperBound;
                lowerBound = DataCenter.INV.BAT_Shutdown_Min_Display;
                Console.WriteLine($"[alarm changed][Shutdown] upperBound = {upperBound}, lowerBound = {lowerBound}");
                if(Battery_shutdown_value > upperBound){Battery_shutdown_value = upperBound;}
                else if(Battery_shutdown_value < lowerBound){Battery_shutdown_value = lowerBound;}

                break;
            case "shutdown":
                upperBound = Battery_shutdown_dynamic_upperBound;
                lowerBound = DataCenter.INV.BAT_Shutdown_Min_Display;
                if(value > upperBound){Battery_shutdown_value = upperBound;}
                else if(value < lowerBound){Battery_shutdown_value = lowerBound;}
                else{Battery_shutdown_value = value;}

                break;
            case "recharge":
                upperBound = DataCenter.Battery.FV_Display;
                lowerBound = DataCenter.INV.BAT_Recharge_Min_Display;
                if(value > upperBound){Battery_recharge_value = upperBound;}
                else if(value < lowerBound){Battery_recharge_value = lowerBound;}
                else{Battery_recharge_value = value;}
                
                break;
            case "OV_alarm":
                upperBound = DataCenter.INV.BAT_OV_Alarm_Max_Display;
                lowerBound = DataCenter.INV.BAT_OV_Alarm_Min_Display;
                if(value > upperBound){Battery_OV_alarm_value = upperBound;}
                else if(value < lowerBound){Battery_OV_alarm_value = lowerBound;}
                else{Battery_OV_alarm_value = value;}

                break;
            default:
                break;
        }
        StateHasChanged();
    }

    private async Task AlarmValueChange_validation(int value, string type)
    {
        if(type == "capacity")
        {
            int upperBound = DataCenter.INV.BAT_Capacity_Max;
            int lowerBound = 0;
            if(value > upperBound){Battery_capacity_value = upperBound;}
            else if(value < lowerBound){Battery_capacity_value = lowerBound;}
            else{Battery_capacity_value = value;}
        }
    }

    private IEnumerable<string> ValidateHint<T>(T value, T max, T min) where T : IComparable<T>
    {    
        if(value.CompareTo(min) < 0)
        {
            yield return $"輸入低於下限{min}";
        }
        else if(value.CompareTo(max) > 0)
        {
            yield return $"輸入高於上限{max}";
        }
    }

    

    private void FixValue<T>(MudTextField<T>? field, T val, T min, T max) where T : IComparable<T>
    {
        T corrected = val;
        

        if(val.CompareTo(min) < 0)
        {
            corrected = min;
        }
        else if(val.CompareTo(max) > 0)
        {
            corrected = max;
        }

        if(!EqualityComparer<T>.Default.Equals(val, corrected))
        {
            StateHasChanged();
        }

        field?.ResetValidation();
    }

    protected override void OnInitialized()
    {
        DataCenter.INV.OnUpdated += OnINVChanged;

        var newInit = new INV_InitData();
        DataCenter.INV.UpdateFrom(newInit);

        selectedFreqType = DataCenter.INV.ACF_Display_str;
        selectedVoltType = DataCenter.INV.ACV_Display_str;

        AC_mode_charging_enable = DataCenter.INV.AC_mode_charging_enable;
        Grid_tied_power_feeding_enable = DataCenter.INV.Grid_tied_power_feeding_enable;
        
        AC_mode_charging_touchable = DataCenter.INV.AC_mode_charging_touchable;
        Grid_tied_power_feeding_touchable = DataCenter.INV.Grid_tied_power_feeding_touchable;
        Output_priority_touchable = DataCenter.INV.Output_priority_touchable;
        Charge_priority_touchable = DataCenter.INV.Charge_priority_touchable;

        Battery_alarm_value = DataCenter.INV.BAT_Alarm_Display;
        Battery_shutdown_value = DataCenter.INV.BAT_Shutdown_Display;
        Battery_recharge_value = DataCenter.INV.BAT_Recharge_Display;
        Battery_OV_alarm_value = DataCenter.INV.BAT_OV_Alarm_Display;
        Battery_capacity_value = DataCenter.INV.BAT_Capacity_Display;

        Console.WriteLine($"[INV_Init] Battery_alarm_value = {Battery_alarm_value}");
        Console.WriteLine($"[INV_Init] Battery_shutdown_value = {Battery_shutdown_value}");
        Console.WriteLine($"[INV_Init] Battery_recharge_value = {Battery_recharge_value}");
        Console.WriteLine($"[INV_Init] Battery_OV_alarm_value = {Battery_OV_alarm_value}");
        Console.WriteLine($"[INV_Init] Battery_capacity_value = {Battery_capacity_value}");
        Console.WriteLine($"Grid_touchable = {Grid_tied_power_feeding_touchable}, AC_mode_touchable = {AC_mode_charging_touchable}");
    }

    private void OnINVChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        DataCenter.INV.OnUpdated -= OnINVChanged;
    }

    private void OnOutputPriorityChanged()
    {
        
        Console.WriteLine($"Output Priority : {selectedOutputPriority}");
    }

    private void OnChargingPriorityChanged()
    {
        Console.WriteLine($"Charge Priority : {selectedChargingPriority}");
    }

    private async Task OnChartTypeChanged()
    {
        switch(selectedFreqType)
        {
            case "50Hz":
                waveCount = 4;
                period = 720.0 / waveCount;
                break;
            case "60Hz":
                waveCount = 5;
                period = 720.0 / waveCount;
                break;
            default:
                break;
        }

        switch(selectedVoltType)
        {
            case "100VAC": peak = 100; break;
            case "110VAC": peak = 110; break;
            case "115VAC": peak = 115; break;
            case "120VAC": peak = 120; break;
            case "200VAC": peak = 200; break;
            case "220VAC": peak = 220; break;
            case "230VAC": peak = 230; break;
            case "240VAC": peak = 240; break;
            default:
                break;
        }

        Console.WriteLine($"Freq = {selectedFreqType}, Volt = {selectedVoltType}");
        Console.WriteLine($"計算得出 peak = {peak}, period = {period}");
        await DrawChart();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("startINVHub", dotNetRef);

            OnChartTypeChanged();
            await DrawChart();
            
        }
    }

    private async Task DrawChart()
    {
        await JS.InvokeVoidAsync("drawChart_Sin", new {
            canvasID = "sinChart",
            peak = peak,
            period = period,
            chartType = "line",
            xLabel = "角度 (°)",
            yLabel = "輸出電壓(V)",
            yMin = -250,
            yMax = 250,
            totalDegrees = 720
        });
    }
    
    private async Task ReceiveFrom_TopRow_SaveINVSetting()
    {
        TriggerAlert("Save");
    }

    private async Task ReceiveFrom_TopRow_ApplyDefaultValue()
    {
        TriggerAlert("DefaultVal");
    }

    private void TriggerAlert(string _alertMessage_FromOtherFunc)
    {
        modal_IsOpen = true;

        AlertMessage_parent     = "";
        ConfirmBtn_Text_parent  = "";
        CancelBtn_Text_parent   = "";
        ConfirmBtn_Func_parent  = EventCallback.Empty;
        CancelBtn_Func_parent   = EventCallback.Empty;
        switch(_alertMessage_FromOtherFunc)
        {
            case "Save":
                AlertMessage_parent     = "是否確定要保存？";
                ConfirmBtn_Text_parent  = "確定";
                CancelBtn_Text_parent   = "取消";
                ConfirmBtn_Func_parent  = EventCallback.Factory.Create(this, ConfirmSave);
                CancelBtn_Func_parent   = EventCallback.Factory.Create(this, CancelSave);
                break;
            case "DefaultVal":
                AlertMessage_parent     = "確定要還原預設？";
                ConfirmBtn_Text_parent  = "確定";
                CancelBtn_Text_parent   = "取消";
                ConfirmBtn_Func_parent  = EventCallback.Factory.Create(this, ConfirmDefault);
                CancelBtn_Func_parent   = EventCallback.Factory.Create(this, CancelDefault);
                break;
            default:
                break;
        }
    }

    private void CloseAlert()
    {
        AlertMessage_parent = null;
    }
    private void CloseModal()
    {   
        //close modal
        modal_IsOpen = false;
        //Close Alert
        AlertMessage_parent = null;
    }
    
    private async Task ConfirmSave()
    {
        
        INVSetting Data = new INVSetting()
        {
            new_ACF_Display_str = selectedFreqType,
            new_ACV_Display_str = selectedVoltType,

            new_AC_mode_charging_enable = AC_mode_charging_enable,
            new_Grid_tied_feeding_enable = Grid_tied_power_feeding_touchable,
            new_Output_priority = (byte)selectedOutputPriority,
            new_Charge_priority = (byte)selectedChargingPriority,

            new_BAT_Alarm_Display = Battery_alarm_value,
            new_BAT_Shutdown_Display = Battery_shutdown_value,
            new_BAT_Recharge_Display = Battery_recharge_value,
            new_BAT_OV_Alarm_Value = Battery_OV_alarm_value,
            new_BAT_Capacity_Value = Battery_capacity_value
        };

        Console.WriteLine($"new_BAT_Recharge_Display = {Data.new_BAT_Recharge_Display}");
        Console.WriteLine($"new_BAT_Recharge_Display = {Data.new_BAT_OV_Alarm_Value}");
        if(DataCenter.INV.SaveSettingData(Data))
        {
            await DataCenter.BroadcastINVChangeAsync();
        }

        CloseAlert();
        CloseModal();
        Console.WriteLine("[ConfirmSave]");
    }

    private async Task CancelSave()
    {
        CloseAlert();
        CloseModal();
    }

    private async Task ConfirmDefault()
    {
        DataCenter.INV.UpdateFrom(new INV_InitData()); //這邊已經把Default值存入DataCenter
        await DataCenter.BroadcastINVChangeAsync();
        CloseAlert();
        CloseModal();

        @* INVSetting DefaultVal = new INVSetting()
        {
