    private void TriggerAlert(string _alertMessage_FromOtherFunc)
    {
        modal_IsOpen = true;

        AlertMessage_parent     = "";
        ConfirmBtn_Text_parent  = "";
        CancelBtn_Text_parent   = "";
        ConfirmBtn_Func_parent  = EventCallback.Empty;
        CancelBtn_Func_parent   = EventCallback.Empty;
        switch(_alertMessage_FromOtherFunc)
        {
            case "Save":
                AlertMessage_parent     = "是否確定要保存？";
                ConfirmBtn_Text_parent  = "確定";
                CancelBtn_Text_parent   = "取消";
                ConfirmBtn_Func_parent  = EventCallback.Factory.Create(this, ConfirmSave);
                CancelBtn_Func_parent   = EventCallback.Factory.Create(this, CancelSave);
                break;
            case "DefaultVal":
                AlertMessage_parent     = "確定要還原預設？";
                ConfirmBtn_Text_parent  = "確定";
                CancelBtn_Text_parent   = "取消";
                ConfirmBtn_Func_parent  = EventCallback.Factory.Create(this, ConfirmDefault);
                CancelBtn_Func_parent   = EventCallback.Factory.Create(this, CancelDefault);
                break;
            default:
                break;
        }
    }

    private void CloseAlert()
    {
        AlertMessage_parent = null;
    }
    private void CloseModal()
    {   
        //close modal
        modal_IsOpen = false;
        //Close Alert
        AlertMessage_parent = null;
    }
    

    private async Task<Dictionary<string, byte[]>> nowUIData_transformTo_apiWriteData()
    {
        Dictionary<string, byte[]> packedByteData = new();
        byte[] Output_ACF_Set   = new byte[2];
        byte[] Output_ACV_Set   = new byte[2];
        byte[] INV_CONFIG       = new byte[2]; //Output_Prio, CHG_Prio
        byte[] BAT_ALM_VOLT     = new byte[2];
        byte[] BAT_SHDN_VOLT    = new byte[2];
        byte[] BAT_RCHG_VOLT    = new byte[2];
        byte[] BAT_OV_ALM_VOLT  = new byte[2];
        byte[] INV_OPERATION    = new byte[2]; //GRID_Enable, AC_CHARGER_Enable
        
        //Output ACF_Set
        switch(selectedFreqType?.ToLowerInvariant())
        {
            case "50hz": 
                Output_ACF_Set[0] = 1;
                break;
            case "60hz":
                Output_ACF_Set[0] = 2;
                break;
            default:
                Output_ACF_Set[0] = 0;
                break;
        }
        //Output ACV_Set
        switch(selectedVoltType?.ToLowerInvariant())
        {
            case "100vac" : 
            case "200vac" :
                Output_ACV_Set[0] = 1;
                break;
            case "110vac":
            case "220vac":
                Output_ACV_Set[0] = 2;
                break;
            case "115vac":
            case "230vac":
                Output_ACV_Set[0] = 3;
                break;
            case "120vac":
            case "240vac":
                Output_ACV_Set[0] = 4;
                break;
            default:
                Output_ACV_Set[0] = 0;
                break;
        }

        //INV_CONFIG(Output_Prio)
        switch(selectedOutputPriority)
        {
            case OUTPUT_PRIORITY.Utility:
                INV_CONFIG[0] = (byte)(INV_CONFIG[0] & (byte)(0b_1111_1100));
                break;
            case OUTPUT_PRIORITY.Battery:
                INV_CONFIG[0] = (byte)(INV_CONFIG[0] & (byte)(0b_1111_1100));
                INV_CONFIG[0] = (byte)(INV_CONFIG[0] | (byte)(0b_0000_0001));
                break;
            case OUTPUT_PRIORITY.Solar:
                INV_CONFIG[0] = (byte)(INV_CONFIG[0] & (byte)(0b_1111_1100));
                INV_CONFIG[0] = (byte)(INV_CONFIG[0] | (byte)(0b_0000_0010));
                break;
            default:
                INV_CONFIG[0] = (byte)(INV_CONFIG[0] & (byte)(0b_1111_1100));
                break;
        }
        
        //INV_CONFIG(CHG_PRIO)
        switch(selectedChargingPriority)
        {
            case CHARGING_PRIORITY.Utility:
                INV_CONFIG[0] = (byte)(INV_CONFIG[0] & (byte)(0b_1111_0011));
                break;
            case CHARGING_PRIORITY.Solar:
                INV_CONFIG[0] = (byte)(INV_CONFIG[0] & (byte)(0b_1111_0011));
                INV_CONFIG[0] = (byte)(INV_CONFIG[0] | (byte)(0b_0000_0100));
                break;
            default:
                INV_CONFIG[0] = (byte)(INV_CONFIG[0] & (byte)(0b_1111_0011));
                break;
        }

        //INV_OPERATION(CHG_EN) for all INV
        if(AC_mode_charging_enable is true)
        {
            INV_OPERATION[0] = (byte)(INV_OPERATION[0] | (byte)(0b_0000_0100));
        }
        else
        {
            INV_OPERATION[0] = (byte)(INV_OPERATION[0] & (byte)(0b_1111_1011));
        }

        //INV_OPERATION(GRID_EN) for all INV
        if(Grid_tied_power_feeding_enable is true)
        {
            INV_OPERATION[0] = (byte)(INV_OPERATION[0] | (byte)(0b_0000_1000));
        }
        else
        {
            INV_OPERATION[0] = (byte)(INV_OPERATION[0] & (byte)(0b_1111_0111));
        }
        
        BAT_ALM_VOLT    = await writeProcess.UIvalueTransformToWriteFormat(Battery_alarm_value,     "BAT_ALM_VOLT");
        BAT_SHDN_VOLT   = await writeProcess.UIvalueTransformToWriteFormat(Battery_shutdown_value,  "BAT_SHDN_VOLT");
        BAT_RCHG_VOLT   = await writeProcess.UIvalueTransformToWriteFormat(Battery_recharge_value,  "BAT_RCHG_VOLT");
        BAT_OV_ALM_VOLT = await writeProcess.UIvalueTransformToWriteFormat(Battery_OV_alarm_value,  "BAT_OV_ALM_VOLT");
    
        AppLogger.Log_To_File_log(_category, $"[Inverter_setting][nowUIData_transformTo_apiWriteData] Output_ACF_Set    = {Output_ACF_Set[1]:X2} {Output_ACF_Set[0]:X2}",      AppLogLevel.Trace);
        AppLogger.Log_To_File_log(_category, $"[Inverter_setting][nowUIData_transformTo_apiWriteData] Output_ACV_Set    = {Output_ACV_Set[1]:X2} {Output_ACV_Set[0]:X2}",      AppLogLevel.Trace);
        AppLogger.Log_To_File_log(_category, $"[Inverter_setting][nowUIData_transformTo_apiWriteData] INV_CONFIG        = {INV_CONFIG[1]:X2} {INV_CONFIG[0]:X2}",              AppLogLevel.Trace);
        AppLogger.Log_To_File_log(_category, $"[Inverter_setting][nowUIData_transformTo_apiWriteData] BAT_ALM_VOLT      = {BAT_ALM_VOLT[1]:X2} {BAT_ALM_VOLT[0]:X2}",          AppLogLevel.Trace);
        AppLogger.Log_To_File_log(_category, $"[Inverter_setting][nowUIData_transformTo_apiWriteData] BAT_SHDN_VOLT     = {BAT_SHDN_VOLT[1]:X2} {BAT_SHDN_VOLT[0]:X2}",        AppLogLevel.Trace);
        AppLogger.Log_To_File_log(_category, $"[Inverter_setting][nowUIData_transformTo_apiWriteData] BAT_RCHG_VOLT     = {BAT_RCHG_VOLT[1]:X2} {BAT_RCHG_VOLT[0]:X2}",        AppLogLevel.Trace);
        AppLogger.Log_To_File_log(_category, $"[Inverter_setting][nowUIData_transformTo_apiWriteData] BAT_OV_ALM_VOLT   = {BAT_OV_ALM_VOLT[1]:X2} {BAT_OV_ALM_VOLT[0]:X2}",    AppLogLevel.Trace);
        AppLogger.Log_To_File_log(_category, $"[Inverter_setting][nowUIData_transformTo_apiWriteData] INV_OPERATION     = {INV_OPERATION[1]:X2} {INV_OPERATION[0]:X2}",        AppLogLevel.Trace);
        
        //packing
        packedByteData["Output_ACF_Set"]    = Output_ACF_Set;
        packedByteData["Output_ACV_Set"]    = Output_ACV_Set;
        packedByteData["INV_CONFIG"]        = INV_CONFIG;
        packedByteData["BAT_ALM_VOLT"]      = BAT_ALM_VOLT;
        packedByteData["BAT_SHDN_VOLT"]     = BAT_SHDN_VOLT;
        packedByteData["BAT_RCHG_VOLT"]     = BAT_RCHG_VOLT;
        packedByteData["BAT_OV_ALM_VOLT"]   = BAT_OV_ALM_VOLT;
        packedByteData["INV_OPERATION"]     = INV_OPERATION;

        return packedByteData;
    }

    private async Task ConfirmSave()
    {
        
        INVSetting Data = new INVSetting()
        {
            new_ACF_Display_str = selectedFreqType ?? "",
            new_ACV_Display_str = selectedVoltType ?? "",

            new_AC_mode_charging_enable = AC_mode_charging_enable,
            new_Grid_tied_feeding_enable = Grid_tied_power_feeding_enable,
            new_Output_priority = (byte)selectedOutputPriority,
            new_Charge_priority = (byte)selectedChargingPriority,

            new_BAT_Alarm_Display = Battery_alarm_value,
            new_BAT_Shutdown_Display = Battery_shutdown_value,
            new_BAT_Recharge_Display = Battery_recharge_value,
            new_BAT_OV_Alarm_Value = Battery_OV_alarm_value,
            new_BAT_Capacity_Value = Battery_capacity_value
        };

        Console.WriteLine($"new_BAT_Recharge_Display = {Data.new_BAT_Recharge_Display}");
        Console.WriteLine($"new_BAT_Recharge_Display = {Data.new_BAT_OV_Alarm_Value}");
        
        //1. 轉 UI值 成 WriteAPI值
        var _packedByteData_dict = await nowUIData_transformTo_apiWriteData();

        //2. packedByteData 傳到 WriteProcess 發送
        try
        {
            bool isWriteSuccess = await writeProcess.Write_To_Framework(_packedByteData_dict, 0); //當前 SubSys是寫死的，會直接 assign成 _globalVar.ActiveSubAppSystemID 
            if(isWriteSuccess is false)
            {
                AppLogger.Log_To_File_log(_category, $"[Inverter_setting][ConfirmSave] Writing To device failed", AppLogLevel.Trace);
                return;
            }
            
            //成功寫值到Framework之後
            //3. 將設定值存於記憶體、JsonFile
            bool isSaveSettingToFile_Succ = await DataCenter.save_INVSetting(Data);
            if(isSaveSettingToFile_Succ is false)
            {
                AppLogger.Log_To_File_log(_category, $"[Inverter_setting][ConfirmSave] save To memory or Json failed", AppLogLevel.Trace);
                return;
            }
            //4. 同步INV setting值到其他Client端
            await DataCenter.BroadcastINVChangeAsync();     
        }
        finally
        {
            CloseAlert();
            CloseModal();
            Console.WriteLine("[ConfirmSave]");
        }
           
        
        //3. 成功設定的話
        // if(isWriteSuccess)
        // {
        //     //4. 將設定值儲存於json檔案(待辦)
        //     if(DataCenter.INV.SaveSettingData(Data))
        //     {   
        //         //5. 同步INV setting值到其他Client端
        //         await DataCenter.BroadcastINVChangeAsync();

        //         //6. 將設定值儲存於 JSON 檔案
        //         await DataCenter.save_INVSetting_To_JsonFile();
        //     }
        // }
    }

