    [JSInvokable("OnINVUpdated")]
    public void OnINVUpdated(JsonElement INVData)
    {
        // 解析 INVData → 更新 UI
        // 然後刷新畫面
        var options = new JsonSerializerOptions
        {
            PropertyNameCaseInsensitive = true
        };

        var ReceiveData_FromSignalR = INVData.Deserialize<INVSetting_To_JS>(options);
        if (ReceiveData_FromSignalR == null)
        {
            Console.WriteLine("❌ 無法反序列化 BatterySetting_To_JS");
            return;
        }
        Console.WriteLine("🔁 收到 INV資料 更新");


        selectedFreqType = ReceiveData_FromSignalR.acf_display_str;
        selectedVoltType = ReceiveData_FromSignalR.acv_display_str;

        AC_mode_charging_enable = ReceiveData_FromSignalR.ac_mode_charging_enable;
        Grid_tied_power_feeding_enable = ReceiveData_FromSignalR.grid_tied_feeding_enable;
        selectedOutputPriority = (OUTPUT_PRIORITY)ReceiveData_FromSignalR.output_priority;
        selectedChargingPriority = (CHARGING_PRIORITY)ReceiveData_FromSignalR.charge_priority;

        Battery_alarm_value = ReceiveData_FromSignalR.bat_alarm_display;
        Battery_shutdown_value = ReceiveData_FromSignalR.bat_shutdown_display;
        Battery_recharge_value = ReceiveData_FromSignalR.bat_recharge_display;
        Battery_OV_alarm_value = ReceiveData_FromSignalR.bat_ov_alarm_display;
        Battery_capacity_value = ReceiveData_FromSignalR.bat_capacity_value;
        
        InvokeAsync(StateHasChanged);
    }
