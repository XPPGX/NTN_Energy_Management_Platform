                }
                else
                {
                    AppLogger.Log_To_File_log(_category, $"[EditCard][getCMDs] Select : addr = {currentSelected_Addr}", AppLogLevel.Trace);
                } 
            }
            else
            {
                AppLogger.Log_To_File_log(_category, $"[EditCard][getCMDs] Got wrong addr : {currentSelected_Addr}", AppLogLevel.Information);
                return false;
            }
            return true;
        }
