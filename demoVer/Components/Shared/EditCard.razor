@namespace demoVer.Shared
@inherits LayoutComponentBase

@implements IDisposable

@using demoVer.Models
@using System
@using System.IO
@using System.Text.Json
@using Newtonsoft.Json.Linq
@using demoVer.Utils
@using System.Globalization

@inject IWebHostEnvironment WebHostEnvironment
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject GlobalVar globalVar
@inject HeartbeatService Heartbeat
@*每個要用MudBlazor的razor元件，都要引入如下元件*@
@*這邊還要引用MudBlazor可能是因為 _Imports.razor的引用不會給Shared內的razor檔案*@
@using MudBlazor
@using MudBlazor.Utilities
<MudThemeProvider/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

@*
edit-container是用來綁以下javascript事件的 id : 
1.電腦右鍵
2.手機長按
*@
<div id=edit-container @onclick="CloseMenu">
@switch(currentCardInfo.card_Type)
{
    case CardType.Info:
        @if(showMenu)
        {
            <div class="custom-menu" style="top:@($"{menuY}px"); left:@($"{menuX}px");" @onclick:stopPropagation="true">
                <div class="custom-menu-item" @onclick="Edit_inCorrespondingStage">編輯</div>
                <div class="custom-menu-item" @onclick="Delete_inCorrespondingStage">刪除</div>
            </div>
            
        }
        @if(ConfirmDialog)
        {
            <div id="confirmDialog" class="custom-dialog-overlay">
                <div class="custom-dialog">
                    <div class="custom-dialog-content">
                        <div class="icon-container">
                            ⚠️
                        </div>
                        <p id="dialogMessage" class="dialog-message">@AlertMessage</p>
                    </div>
                    <div class="custom-dialog-actions">
                        <button class="btn cancel-btn" @onclick="Cancel">取消</button>
                        <button class="btn confirm-btn" @onclick="Confirm">確定</button>
                    </div>
                </div>
            </div>
        }

        switch(INFO_setting_stage)
        {
            case INFO_SETTING_STAGE.ADD_ROW_STAGE:
                <div class="edit-info-top">
                    <input class="input-edit" @bind=edit_CardName placeholder="輸入卡片名稱" style="text-align: center;"/>
                </div>
                <br>
                @* <div class="underline"></div> *@
                <table class="custom-table" id="table-settingInfoDataItem">
                    <thead>
                        <tr>
                            <th>圖示</th>
                            <th>內容設定</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for(int i = 0 ; i < edit_INFO_DataItems.Count ; i ++)
                        {
                            var temp = edit_INFO_DataItems[i];
                            string iconPath;
                            iconPath = (string.IsNullOrEmpty(temp.iconPath)) ? "images/square.png" : temp.iconPath;
                            <tr>
                                <td>
                                    <button class="icon-button" @onclick="() => selectImg(temp)">
                                        <img src=@iconPath alt="waitImg"/>
                                    </button>
                                </td>
                                <td class="long-press-row" data-table="table-settingInfoDataItem" data-index="@i">
                                @* <td class="clickable-td" @onclick="() => AdjustValueCmdRow(temp)"> *@
                                    @{
                                        string hint = "";
                                        switch(temp.status)
                                        {
                                            case SettingStatus.YET:
                                                if(isMobile){hint = "長按此處編輯";}
                                                else{hint = "右鍵編輯";}
                                                break;
                                            case SettingStatus.PROGRESS:
                                                if(isMobile){hint = "未完成:長按此處編輯";}
                                                else{hint = "未完成:右鍵編輯";}
                                                break;
                                            case SettingStatus.DONE:
                                                hint = "設定完成";
                                                break;
                                            default:
                                                hint = "";
                                                break;
                                        }
                                    }
                                    @hint
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="confirm-cancel-container">
                    <MudButton Class="no-transform"
                            OnClick="Add_INFO_DataItem"
                            Variant="Variant.Filled"
                            Color="Color.Primary"
                            StartIcon="@Icons.Material.Filled.Add"
                            Style="width: 120px;">
                        新增
                    </MudButton>
                    <MudButton Class="no-transform" 
                            OnClick="Confirm_INFO_DataItem"
                            Variant="Variant.Filled"
                            Color="Color.Success"
                            Style="width: 120px;">
                        確定
                    </MudButton>
                </div>
                break;
            case INFO_SETTING_STAGE.SELECT_ICON_STAGE:
                <div class="img-select-grid">
                    @foreach(var imgPath in imgRelativePaths)
                    {
                        <div class="img-select-icon">
                            <button class="icon-button" @onclick="() => selectedImgFile(imgPath)">
                                <img src=@imgPath alt="waiting"/>
                            </button>
                        </div>
                    }
                </div>
                break;
            case INFO_SETTING_STAGE.SETTING_VALUE_AND_CMD_STAGE:
                <div class="edit-info-top">
                    <h3>數值與命令設定</h3>
                </div>
                <table class="custom-table">
                    <tbody>
                        @if(currentEdit_INFO_DataFormat_ref != null)
                        {
                            <tr>
                                <th>設備選擇</th>
                                <td style="cursor:pointer;" @onclick="() => selectMachine()">
                                    @(string.IsNullOrEmpty(currentEdit_INFO_DataFormat_ref.MachineName) ? "設定" : currentEdit_INFO_DataFormat_ref.MachineName)
                                </td>
                            </tr>
                            <tr>
                                <th>設備名稱</th>
                                <td>
                                    <input @bind="currentEdit_INFO_DataFormat_ref.UserSettingName" style="text-align: center;"/>
                                </td>
                            </tr>
                            <tr>
                                <th>命令選擇</th>
                                <td style="cursor:pointer;" @onclick="() => selectCMD()">
                                    @(string.IsNullOrEmpty(currentEdit_INFO_DataFormat_ref.Cmd) ? "設定" : currentEdit_INFO_DataFormat_ref.Cmd)
                                </td>
                            </tr>
                            <tr>
                                <th>數值名稱</th>
                                <td>
                                    <input @bind="currentEdit_INFO_DataFormat_ref.ValueName" style="text-align: center;"/>
                                </td>
                            </tr>
                            <tr>
                                <th>單位</th>
                                <td style="text-align: center;">
                                    @{
                                        string Uint_To_show = "";
                                        Uint_To_show = string.IsNullOrEmpty(currentEdit_INFO_DataFormat_ref.Unit) ? "Please select a CMD" : currentEdit_INFO_DataFormat_ref.Unit;
                                        @* if(string.IsNullOrEmpty(currentEdit_INFO_DataFormat_ref.Cmd))
                                        {
                                            Uint_To_show = "請先選擇命令";
                                        }
                                        else
                                        {
                                            if(string.IsNullOrEmpty(currentEdit_INFO_DataFormat_ref.Unit))
                                            {
                                                Uint_To_show = "設定";
                                            }
                                            else
                                            {
                                                Uint_To_show = currentEdit_INFO_DataFormat_ref.Unit;
                                            }
                                        } *@
                                    }
                                    @Uint_To_show
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="confirm-cancel-container">
                     <MudButton OnClick="confirm_INFO_DataFormat_ValueSetting"
                            Variant="Variant.Filled"
                            Color="Color.Success">
                        確定
                    </MudButton>
                    @* <button @onclick="confirm_INFO_DataFormat_ValueSetting">確認</button> *@
                </div>
                break;
            case INFO_SETTING_STAGE.MACHINE_SELECTION_STAGE:
                <MudPaper Elevation="2" Class="pa-2 rounded" Style="width: 250px; max-height: 240px; overflow-y: auto;">
                    <MudList T="string" Dense="true" Hover="true">
                        @foreach (var (addr, modelName) in deviceAddr_List)
                        {
                            <MudListItem T="string"
                                        @onclick="() => clickMachineName(addr, modelName)"
                                        Style="cursor: pointer;">
                                <MudListItemIcon>
                                    <MudIcon Icon="@Icons.Material.Filled.KeyboardCommandKey" />
                                </MudListItemIcon>
                                <MudText Class="ml-2">@($"[{addr}]: {modelName}")</MudText>
                            </MudListItem>
                        }
                    </MudList>
                </MudPaper>
                
                break;
            case INFO_SETTING_STAGE.CMD_SELECTION_STAGE:
                <MudPaper Elevation="2" Class="pa-2 rounded" Style="width: 300px; max-height: 240px; overflow-y: auto;">
                    <MudList T="string" Dense="true" Hover="true">
                        @foreach (var (cmd, unit) in show_cmd_unit_Dict_ref ?? Enumerable.Empty<KeyValuePair<string, string>>())
                        {
                            <MudListItem T="string"
                                        @onclick="() => clickCmd(cmd, unit)"
                                        Style="cursor: pointer;">
                                <MudListItemIcon>
                                    <MudIcon Icon="@Icons.Material.Filled.Code" />
                                </MudListItemIcon>
                                <MudText Class="ml-2">@cmd</MudText>
                            </MudListItem>
                        }
                    </MudList>
                </MudPaper>
                break;
            case INFO_SETTING_STAGE.UNIT_SELECTION_STAGE:
                <MudPaper Elevation="2" Class="pa-2 rounded" Style="width: 200px; max-height: 240px; overflow-y: auto;">
                    <MudList T="string" Dense="true" Hover="true">
                        @foreach (var unit in UnitLists)
                        {
                            <MudListItem T="string"
                                        @onclick="() => clickUnit(unit)"
                                        Style="cursor: pointer;">
                                <MudListItemIcon>
                                    <MudIcon Icon="@Icons.Material.Filled.Sensors" />
                                </MudListItemIcon>
                                <MudText Class="ml-2">@unit</MudText>
                            </MudListItem>
                        }
                    </MudList>
                </MudPaper>
                break;
            
            case INFO_SETTING_STAGE.ADD_VALUE_AND_CMD_ROW_STAGE:
                <div style="max-height: 300px; overflow-y: auto;">
                    <h4>@(isMobile? "長按編輯" : "右鍵編輯")</h4>
                    <table class="custom-table no-text-select" id="table-settingInfoDataFormat">
                        <thead>
                            <th>數值名稱</th>
                            <th>單位</th>
                        </thead>
                        <tbody @onclick:stopPropagation="true">
                            @for(int i = 0 ; i < currentEdit_INFO_DataItem_ref.INFO_DataFormats.Count ; i ++)
                            {
                                var tempDataFormat = currentEdit_INFO_DataItem_ref.INFO_DataFormats[i];
                                <tr class="long-press-row" data-table="table-settingInfoDataFormat" data-index="@i">
                                    <td>
                                        @(string.IsNullOrEmpty(tempDataFormat.ValueName) ? "" : tempDataFormat.ValueName)
                                    </td>
                                    <td>
                                        @(string.IsNullOrEmpty(tempDataFormat.Unit) ? "" : tempDataFormat.Unit)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="confirm-cancel-container">
                    <button class="btn btn-green no-flex" style="width: 120px;"
                            type="button"
                            @onclick="AddRow_ValueAndCmd">
                        新增
                    </button>
                    <button class="btn btn-primary no-flex" style="width: 120px;"
                            type="button"
                            @onclick="confirm_INFO_DataFormats_Setting">
                        確認
                    </button>
                </div>
                break;
            default:
                break;
        }
        
        break;
    case CardType.Chart:
        @if(showMenu)
        {
            <div class="custom-menu" style="top:@($"{menuY}px"); left:@($"{menuX}px");" @onclick:stopPropagation="true">
                <div class="custom-menu-item" @onclick="Edit_inCorrespondingStage">編輯</div>
                <div class="custom-menu-item" @onclick="Delete_inCorrespondingStage">刪除</div>
            </div>   
        }
        @if(ConfirmDialog)
        {
            <div id="confirmDialog" class="custom-dialog-overlay">
                <div class="custom-dialog">
                    <div class="custom-dialog-content">
                        <div class="icon-container">
                            ⚠️
                        </div>
                        <p id="dialogMessage" class="dialog-message">@AlertMessage</p>
                    </div>
                    <div class="custom-dialog-actions">
                        <button class="btn cancel-btn" @onclick="Cancel">取消</button>
                        <button class="btn confirm-btn" @onclick="Confirm">確定</button>
                    </div>
                </div>
            </div>
        }
        switch(CHART_setting_stage)
        {
            case CHART_SETTING_STAGE.SELECT_MACHINE_CMD:
                <div class="chart-machine-cmd-setting">
                    <h3>選擇設備與命令</h3>
                    <div class="chartForm">
                        <div class="chart-selector-panel">
                            <div class="chart-selector-grid">
                                <div class="custom-select-wrapper">
                                    <label for="chartMachineSelect" style="color: var(--text-primary);">Machine</label>
                                    <select id="chartMachineSelect"
                                            class="custom-select"
                                            style="color: #2a2a2a;"
                                            value="@blank_singleDataLine.addr"
                                            @onchange="MachineChanged">
                                        <option value="9999">請選擇一個機器</option>
                                        @foreach (var (addr, mdlName) in deviceAddr_List)
                                        {
                                            <option value="@addr">[@addr]: @mdlName</option>
                                        }
                                    </select>
                                </div>

                                <div class="custom-select-wrapper">
                                    <label for="chartCmdSelect" style="color: var(--text-primary);">CMD</label>
                                    <select id="chartCmdSelect"
                                            class="custom-select"
                                            style="color: #2a2a2a;"
                                            value="@blank_singleDataLine.Cmd"
                                            @onchange="ChartCmdChanged"
                                            disabled="@(show_cmd_unit_Dict_ref?.Any() != true)">
                                        <option value="">請選擇一個命令</option>
                                        @foreach (var (cmd, unit) in show_cmd_unit_Dict_ref ?? Enumerable.Empty<KeyValuePair<string, string>>())
                                        {
                                            <option value="@cmd">@cmd</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(chartMachineCmdError))
                            {
                                <div class="chart-step-error">@chartMachineCmdError</div>
                            }

                            <div class="chart-stepper-actions">
                                <button class="btn btn-primary no-flex"
                                        type="button"
                                        @onclick="ProceedToDisplaySetting">
                                    下一步
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                
                break;

            case CHART_SETTING_STAGE.OVERVIEW:
                <h5>編輯 : 圖表</h5>
                <div class="input-container">
                    <label for="tempChartTitle" class="input-label">圖表標題</label>
                    <input id="tempChartTitle" type="text" class="input" @bind="temp_chartTitle" required placeholder="輸入圖表標題" />
                </div>

                @for (int i = 0; i < edit_ChartSetting_Clone.chart_single_data_lines.Count; i++)
                {   
                    var index = i;
                    var temp = edit_ChartSetting_Clone.chart_single_data_lines[i];

                    var addr_mdlName_str = $"[{temp.addr}]{temp.mdlName}";
                    var hint_cmd = temp.status switch
                    {
                        SettingStatus.YET => isMobile ? "長按此處編輯" : "右鍵編輯",
                        SettingStatus.PROGRESS => isMobile ? "未完成:長按此處編輯" : "未完成:右鍵編輯",
                        SettingStatus.DONE => $"{temp.Cmd}({temp.Unit})",
                        _ => string.Empty
                    };
                    var hint = temp.Y_axis_selection == true
                        ? $"{edit_ChartSetting_Clone.Y_left_Title}"
                        : $"{edit_ChartSetting_Clone.Y_right_Title}";
                    var hint_axis = temp.Y_axis_selection == true ? "左" : "右";
                    var hint_color = string.IsNullOrEmpty(temp.color) ? "#000000" : temp.color;
                    <div class="detail-card" @onclick="() => OnLineClick(index, temp)">
                        <div class="detail-card-header">
                            <span class="detail-card-title">Line @(index + 1)</span>
                            <button type="button"
                                    class="detail-card-action"
                                    @onclick="() => DeleteCurve(temp)"
                                    @onclick:stopPropagation="true">
                                刪除
                            </button>
                        </div>
                        <div class="detail-card-body">
                            <div class="detail-card-row">
                                <span class="detail-card-label">設備 :</span>
                                <span class="detail-card-value">@(string.IsNullOrEmpty(addr_mdlName_str) ? "未設定" : addr_mdlName_str)</span>
                            </div>
                            <div class="detail-card-row">
                                <span class="detail-card-label">命令 :</span>
                                <span class="detail-card-value">@hint_cmd</span>
                            </div>
                            <div class="detail-card-row">
                                <span class="detail-card-label">Y軸標題:</span>
                                <span class="detail-card-value">@hint</span>
                            </div>
                            <div class="detail-card-row">
                                <span class="detail-card-label">參照軸:</span>
                                <span class="detail-card-value">@hint_axis</span>
                            </div>
                            <div class="detail-card-row detail-card-row-color">
                                <span class="detail-card-label">顏色:</span>
                                <span class="detail-card-value">
                                    <span class="detail-card-color" style="background-color:@hint_color;"></span>
                                </span>
                            </div>
                        </div>
                    </div>
                }

                <div class="confirm-cancel-container">
                    <button class="btn btn-green no-flex" style="width: 120px;"
                            type="button"
                            @onclick="Add_Curve">
                        新增
                    </button>
                    <button class="btn btn-primary no-flex" style="width: 120px;"
                            type="button"
                            @onclick="Confirm_CurveSetting">
                        確定
                    </button>
                </div>

                break;
            case CHART_SETTING_STAGE.DISPLAY_SETTING:
                <div class="chart-display-setting">
                    <h3>顯示設定</h3>
                    <div class="chartForm">
                        @{
                            string paper_style = (isMobile) ? "" : "width: 400px; max-height: 400px;" ;
                            <div class="chart-display-card" style="@paper_style">
                                <form class="custom-form">
                                    <div class="form-group">
                                        <label for="yTitleInput" class="form-label">Y-Title</label>
                                        <input type="text" id="yTitleInput" class="form-input" @bind="temp_Y_singleTitle" required />
                                        @if (!string.IsNullOrEmpty(yTitleError))
                                        {
                                            <div class="error-text">@yTitleError</div>
                                        }
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">Y-axis</label>
                                        <div class="radio-group" @onchange:stopPropagation="true" @onclick:stopPropagation="true">
                                            <label class="radio-option">
                                                <input type="radio"
                                                       name="yAxis"
                                                       value="true"
                                                       @onchange="YAxisChanged"
                                                       checked="@(blank_singleDataLine.Y_axis_selection == true)" />
                                                <span class="radio-label">Left-axis</span>
                                            </label>
                                            <label class="radio-option">
                                                <input type="radio"
                                                       name="yAxis"
                                                       value="false"
                                                       @onchange="YAxisChanged"
                                                       checked="@(blank_singleDataLine.Y_axis_selection == false)" />
                                                <span class="radio-label">Right-axis</span>
                                            </label>
                                        </div>
                                        @if (!string.IsNullOrEmpty(yAxisError))
                                        {
                                            <div class="error-text">@yAxisError</div>
                                        }
                                    </div>
                                    <div class="form-group">
                                        <label for="colorPicker" class="form-label">Data-Color</label>
                                        <input type="color" id="colorPicker" class="form-input color-input" @bind="blank_singleDataLine.color" style="@($"color: {blank_singleDataLine.color};")" required />
                                        @if (!string.IsNullOrEmpty(colorError))
                                        {
                                            <div class="error-text">@colorError</div>
                                        }
                                    </div>
                                    <button type="button" class="btn btn-primary ml-auto" @onclick="Confirm_SingleDataLine_setting">確定</button>
                                </form>
                            </div>
                        }
                    </div>  
                    @if(!string.IsNullOrEmpty(chartForm_errorMessage))
                    {
                        <div class="error-text mt-2">@chartForm_errorMessage</div>
                    }
                </div>
                break;
            case CHART_SETTING_STAGE.SELECT_CMD_STAGE:
                <MudPaper Elevation="2" Class="pa-2 rounded" Style="width: 200px; max-height: 240px; overflow-y: auto;">
                    <MudList T="string" Dense="true" Hover="true">
                        @foreach (var item in show_cmd_unit_Dict_ref ?? Enumerable.Empty<KeyValuePair<string, string>>())
                        {
                            <MudListItem T="string"
                                        @onclick="() => clickCmd_CHART(item.Key)"
                                        Style="cursor: pointer;">
                                <MudListItemIcon>
                                    <MudIcon Icon="@Icons.Material.Filled.Code" />
                                </MudListItemIcon>
                                <MudText Class="ml-2">@item.Key</MudText>
                            </MudListItem>
                        }
                    </MudList>
                </MudPaper>
                break;
            case CHART_SETTING_STAGE.UNIT_SELECTION_STAGE:
                <MudPaper Elevation="2" Class="pa-2 rounded" Style="width: 200px; max-height: 240px; overflow-y: auto;">
                    <MudList T="string" Dense="true" Hover="true">
                        @foreach (var unit in UnitLists)
                        {
                            <MudListItem T="string"
                                        @onclick="() => clickUnit_CHART(unit)"
                                        Style="cursor: pointer;">
                                <MudListItemIcon>
                                    <MudIcon Icon="@Icons.Material.Filled.Sensors" />
                                </MudListItemIcon>
                                <MudText Class="ml-2">@unit</MudText>
                            </MudListItem>
                        }
                    </MudList>
                </MudPaper>
                break;
            default:
                break;
            
        }
        
        break;
    case CardType.Status:
        <h3>編輯 : 連接狀態</h3>
        switch(STATUS_setting_stage)
        {
            case STATUS_SETTING_STAGE.OVERVIEW:
                <table class="custom-table no-text-select" id="table-linkingStatus">
                    <colgroup>
                        <col style="width: 20%;">
                        <col style="width: 30%;">
                        <col style="width: 60%;">
                    </colgroup>
                    <thead>
                        <tr>
                            <th>No.</th>
                            <th>圖示</th>
                            <th>文字</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for(int i = 0 ; i < 4 ; i ++)
                        {
                            var temp = edit_Link_STATUS_Pairs[i];
                            if(temp == null)
                            {
                                Console.WriteLine($"temp is null!!!!");
                                return;
                            }
                            string iconPath = (string.IsNullOrEmpty(temp.iconPath)) ? "images/square.png" : temp.iconPath;
                            <tr>
                                <td>
                                    @(i+1)
                                </td>
                                <td>
                                    <button class="icon-button" @onclick="() => selectImg_LINK_STATUS(temp)">
                                        <img src=@iconPath alt="waitImg"/>
                                    </button>
                                </td>
                                <td>
                                    <input @bind="temp.Label" class="td-input" style="text-align: center;"/>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <MudButton Class="no-transform" 
                        OnClick="Confirm_LINK_STATUS"
                        Variant="Variant.Filled"
                        Color="Color.Success"
                        Style="width: 120px;">
                    確定
                </MudButton>
                break;
            case STATUS_SETTING_STAGE.SELECT_ICON_STAGE:
                <div class="img-select-grid">
                    @foreach(var imgPath in imgRelativePaths)
                    {
                        <div class="img-select-icon">
                            <button class="icon-button" @onclick="() => selectedImgFile_LINK_STATUS(imgPath)">
                                <img src=@imgPath alt="waiting"/>
                            </button>
                        </div>
                    }
                </div>
                break;

            default:
                break;
        }
        
        break;
    default:
        break;
}


</div>

@code{
    
    //For log
    private string _category = "";
    //HeartbeatCounter
    private int HeartBeatCounter = 0;
    

