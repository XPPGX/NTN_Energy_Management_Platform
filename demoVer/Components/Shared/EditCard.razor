    private async Task OnPreviewInteraction(StepperInteractionEventArgs arg)
    {
        if (arg.Action == StepAction.Complete) 
        {
            // occurrs when clicking next
            //點Next的時候會觸發這個
            await ControlStepCompletion(arg);

        }
        else if (arg.Action == StepAction.Activate) 
        {
            // occurrs when clicking a step header with the mouse
            //直接點第幾步的時候會觸發這個
            await ControlStepNavigation(arg);
        }
    }

    private async Task ControlStepCompletion(StepperInteractionEventArgs arg)
    {
        //[Note]
        //不寫arg.Cancel = true
        //UI就會跳轉到下一步
        switch (arg.StepIndex) {
            case 0: //選擇設備後，按下Next會到這裡
                if (blank_singleDataLine.addr == 9999) 
                {
                    AppLogger.Log_To_File_log(_category, "[EditCard][ControlStepCompletion] Error, You have not select a machine", AppLogLevel.Trace);
                    arg.Cancel = true;
                }
                else
                {
                    AppLogger.Log_To_File_log(_category, $"[EditCard][ControlStepCompletion] You have selected a addr = {blank_singleDataLine.addr}, mdlName = {blank_singleDataLine.mdlName}", AppLogLevel.Trace);
                    currentSelected_Addr = blank_singleDataLine.addr;
                    if(getCMDs())
                    {
                        AppLogger.Log_To_File_log(_category, $"[EditCard][ControlStepCompletion] The CMDs are found, addr = {blank_singleDataLine.addr}, mdlName = {blank_singleDataLine.mdlName}", AppLogLevel.Trace);
                    }
                    else
                    {
                        AppLogger.Log_To_File_log(_category, $"[EditCard][ControlStepCompletion] The CMDs are not found, addr = {blank_singleDataLine.addr}, mdlName = {blank_singleDataLine.mdlName}", AppLogLevel.Trace);
                        arg.Cancel = false;
                    }
                }
                break;
            case 1: //選擇命令後按下Next會到這裡
                if(string.IsNullOrEmpty(blank_singleDataLine.Cmd))
                {//Cmd沒選，被擋下來
                    arg.Cancel = true;
                }
                else
                {//選擇CMD後

                    //Assign Unit
                    if (show_cmd_unit_Dict_ref is null || !show_cmd_unit_Dict_ref.TryGetValue(blank_singleDataLine.Cmd, out var selectedUnit))
                    {
                        AppLogger.Log_To_File_log(_category, "[EditCard][ControlStepCompletion] Unable to locate unit for selected CMD", AppLogLevel.Trace);
                        arg.Cancel = true;
                        break;
                    }

                    blank_singleDataLine.Unit = selectedUnit;
                    Console.WriteLine($"[EditCard][ControlStepCompletion] Selected CMD = {blank_singleDataLine.Cmd}, Unit = {blank_singleDataLine.Unit}");
                    
                    //Switch Stage
                    CHART_setting_stage = CHART_SETTING_STAGE.DISPLAY_SETTING;
                    Console.WriteLine($"[EditCard][ControlStepCompletion] switch to DISPLAY_SETTING");

                    await InvokeAsync(StateHasChanged);
                }
                break;
        }
    }

    private async Task ControlStepNavigation(StepperInteractionEventArgs arg)
    {
        switch (arg.StepIndex) {
            case 1:
                if (chartNowSelectedAddr == 9999) 
                {
                    arg.Cancel = true;
                }
                break;
            case 2:
                @* if (_step1Complete != true || (_step2TextInput?.Length ?? 0) == 0) 
                {
                    Console.WriteLine("Finish step 1 and 2 first");
                    arg.Cancel = true;
                } *@
                break;
        }
    }

