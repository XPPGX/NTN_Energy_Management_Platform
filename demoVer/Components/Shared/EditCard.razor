    private async Task Confirm_SingleDataLine_setting()
    {
        // Manual validation
        yTitleError = string.IsNullOrEmpty(temp_Y_singleTitle) ? "Y-Title is required!" : "";
        yAxisError = blank_singleDataLine.Y_axis_selection == null ? "Y-axis is required!" : "";
        colorError = string.IsNullOrEmpty(blank_singleDataLine.color) ? "Data-Color is required!" : "";
        
        var target_DataLine = edit_ChartSetting_Clone.chart_single_data_lines[SingleLine_index];
        bool sameAxis_Flag = false;
        if(edit_ChartSetting_Clone.chart_single_data_lines.Count == 2)
        {
            int opposite_index = (SingleLine_index == 0) ? 1 : 0;
            
            sameAxis_Flag = (blank_singleDataLine.Y_axis_selection == edit_ChartSetting_Clone.chart_single_data_lines[opposite_index].Y_axis_selection) ? true : false;
        }
        
        

        if(!string.IsNullOrEmpty(yTitleError) || !string.IsNullOrEmpty(yAxisError) || !string.IsNullOrEmpty(colorError) || sameAxis_Flag == true)
        {
            Console.WriteLine("表單驗證失敗");
            target_DataLine.status = SettingStatus.PROGRESS;
            if(!string.IsNullOrEmpty(yTitleError)){chartForm_errorMessage = yTitleError;}
            else if(!string.IsNullOrEmpty(yAxisError)){chartForm_errorMessage = yAxisError;}
            else if(!string.IsNullOrEmpty(colorError)){chartForm_errorMessage = colorError;}
            else if(sameAxis_Flag){chartForm_errorMessage = "兩組資料不可位於同一側";}
            return;
        }
        Console.WriteLine("表單驗證成功");
        
        target_DataLine.addr = blank_singleDataLine.addr;
        AppLogger.Log_To_File_log(_category, $"[EditCard][Confirm_SingleDataLine_setting] target_DataLine.addr = {target_DataLine.addr}, blank_singleDataLine.addr = {blank_singleDataLine.addr}, edit_ChartSetting_Clone.addr = {edit_ChartSetting_Clone.chart_single_data_lines[SingleLine_index]}", AppLogLevel.Trace);
        target_DataLine.mdlName = blank_singleDataLine.mdlName;
        target_DataLine.Cmd = blank_singleDataLine.Cmd;
        target_DataLine.Unit = blank_singleDataLine.Unit;
        target_DataLine.Y_axis_selection = blank_singleDataLine.Y_axis_selection;
        target_DataLine.color = blank_singleDataLine.color;
        
        if(target_DataLine.Y_axis_selection == true)
        {//left axis
            edit_ChartSetting_Clone.Y_left_Title = temp_Y_singleTitle;
        }
        else if(target_DataLine.Y_axis_selection == false)
        {//right axis
            edit_ChartSetting_Clone.Y_right_Title = temp_Y_singleTitle;
        }

        Console.WriteLine($"Y-Title = {temp_Y_singleTitle}, Y-axis = {edit_ChartSetting_Clone.chart_single_data_lines[SingleLine_index].Y_axis_selection}, color = {edit_ChartSetting_Clone.chart_single_data_lines[SingleLine_index].color}");
        
        target_DataLine.status = SettingStatus.DONE;
        CHART_setting_stage = CHART_SETTING_STAGE.OVERVIEW;

        
    }
