    private bool TryParseAddr_fromAddrModelName(string _addrModelName, out uint value)
    {
        value = 0;
        if(string.IsNullOrEmpty(_addrModelName)) return false;
        AppLogger.Log_To_File_log(_category, $"[EditCard][TryParseAddr_fromAddrModelName] _addrModelName not null or empty", AppLogLevel.Trace);

        int l = _addrModelName.IndexOf('[');
        if(l < 0) return false;
        AppLogger.Log_To_File_log(_category, $"[EditCard][TryParseAddr_fromAddrModelName] [ found", AppLogLevel.Trace);

        int r = _addrModelName.IndexOf(']', l +1);
        if(r < 0 || r == l + 1) return false;
        AppLogger.Log_To_File_log(_category, $"[EditCard][TryParseAddr_fromAddrModelName] ] found", AppLogLevel.Trace);

        ReadOnlySpan<char> span = _addrModelName.AsSpan(l + 1, r - l - 1).Trim();
        var tmp_return_val = uint.TryParse(span, out value);
        AppLogger.Log_To_File_log(_category, $"[EditCard][TryParseAddr_fromAddrModelName] tmp_return_val = {tmp_return_val}", AppLogLevel.Trace);
        return tmp_return_val;
    }

