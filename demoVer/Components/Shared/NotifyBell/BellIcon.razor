@namespace demoVer.Shared
@using demoVer.Services
@rendermode InteractiveServer
@inject NotificationService NotificationService

<div class="notification-container">
    <button class="topRow-btn notification-btn" @onclick="ToggleNotification" title="通知">
        <svg class="bell-icon" viewBox="0 0 448 512" fill="@bellIconColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M222.987,510c31.418,0,57.529-22.646,62.949-52.5H160.038C165.458,487.354,191.569,510,222.987,510z"/>
            <path d="M432.871,352.059c-22.25-22.25-49.884-32.941-49.884-141.059c0-79.394-57.831-145.269-133.663-157.83h-4.141c4.833-5.322,7.779-12.389,7.779-20.145c0-16.555-13.42-29.975-29.975-29.975s-29.975,13.42-29.975,29.975c0,7.755,2.946,14.823,7.779,20.145h-4.141C120.818,65.731,62.987,131.606,62.987,211c0,108.118-27.643,118.809-49.893,141.059C-17.055,382.208,4.312,434,47.035,434H398.93C441.568,434,463.081,382.269,432.871,352.059z"/>
        </svg>
        @if(unreadCount > 0)
        {
            <span class="notification-badge">@unreadCount</span>
        }
    </button>
    
    @*通知訊息列表*@
    @if(notificationOpen)
    {
        <div class="notification-dropdown" @onclick:stopPropagation="true">
            <div class="notification-header">
                <span class="notification-title">通知</span>
                <span class="notification-count">@notifications.Count 則通知</span>
            </div>
            
            
            <div class="notification-list">
                @foreach(var notification in notifications)
                {
                    <div class="notification-item @(notification.IsRead ? "read" : "unread")" @onclick="() => MarkAsRead(notification.Id)">
                        <div class="notification-icon @notification.Type">
                            @if(notification.Type == "warning")
                            {
                                // 黃色驚嘆號圖示, fileName = dialog-warning-symbolic-svgrepo-com.svg 
                                <svg class="icon-svg" viewBox="0 0 16 16" fill="@GetNotificationIconColor(notification.Type)" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M7.963 0a1.499 1.499 0 0 0-1.277.785l-6.502 12A1.5 1.5 0 0 0 1.5 15.002h13a1.5 1.5 0 0 0 1.317-2.217l-6.498-12A1.496 1.496 0 0 0 7.963 0zm.025 1a.494.494 0 0 1 .451.262l6.498 12c.203.374-.016.74-.437.74h-13c-.422 0-.64-.366-.438-.74l6.502-12A.493.493 0 0 1 7.988 1zm-.695 2.002v2.662c0 .793.03 1.517.086 2.168.057.642.128 1.284.213 1.926h.82c.085-.642.157-1.284.213-1.926.057-.651.086-1.375.086-2.168V3.002zm.71 8a1 1 0 0 0-1 1c0 .282.118.535.306.717.17.189.4.283.693.283.293 0 .524-.094.694-.283a.994.994 0 0 0 .306-.717 1 1 0 0 0-1-1z"/>
                                </svg>
                            }
                            else if(notification.Type == "info")
                            {
                                // 藍色資訊圖示, fileName = info-svgrepo-com.svg
                                <svg class="icon-svg" viewBox="0 0 24 24" fill="@GetNotificationIconColor(notification.Type)" xmlnx="http://www.w3.org/2000/svg">
                                    <path d="M10 10C10 10.5523 10.4477 11 11 11V17C10.4477 17 10 17.4477 10 18C10 18.5523 10.4477 19 11 19H13C13.5523 19 14 18.5523 14 18C14 17.4477 13.5523 17 13 17V9H11C10.4477 9 10 9.44772 10 10Z"/>
                                    <path d="M12 8C12.8284 8 13.5 7.32843 13.5 6.5C13.5 5.67157 12.8284 5 12 5C11.1716 5 10.5 5.67157 10.5 6.5C10.5 7.32843 11.1716 8 12 8Z"/>
                                    <path fill-rule="evenodd" clip-rule="evenodd" d="M23 4C23 2.34315 21.6569 1 20 1H4C2.34315 1 1 2.34315 1 4V20C1 21.6569 2.34315 23 4 23H20C21.6569 23 23 21.6569 23 20V4ZM21 4C21 3.44772 20.5523 3 20 3H4C3.44772 3 3 3.44772 3 4V20C3 20.5523 3.44772 21 4 21H20C20.5523 21 21 20.5523 21 20V4Z"/>
                                </svg>
                            }
                            else if(notification.Type == "success")
                            {
                                // 綠色勾勾圖示, fileName = check-svgrepo-com.svg
                                <svg class="icon-svg" viewBox="0 0 24 24" fill="@GetNotificationIconColor(notification.Type)" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M9.00001 18.25C8.8993 18.2466 8.80034 18.2227 8.70921 18.1797C8.61807 18.1367 8.53667 18.0756 8.47001 18L3.47001 13C3.37467 12.9382 3.29463 12.8556 3.23592 12.7583C3.17721 12.661 3.14136 12.5517 3.13109 12.4385C3.12082 12.3254 3.13639 12.2114 3.17663 12.1051C3.21686 11.9989 3.28071 11.9031 3.36336 11.8252C3.446 11.7472 3.54528 11.689 3.65369 11.6551C3.76211 11.6211 3.87682 11.6122 3.98918 11.629C4.10155 11.6458 4.20861 11.688 4.3023 11.7523C4.39599 11.8165 4.47385 11.9013 4.53001 12L9.00001 16.44L19.47 6.00003C19.611 5.90864 19.7785 5.86722 19.9458 5.88241C20.1131 5.89759 20.2705 5.96851 20.3927 6.08379C20.5149 6.19907 20.5948 6.35203 20.6197 6.51817C20.6446 6.68431 20.613 6.85399 20.53 7.00003L9.53001 18C9.46334 18.0756 9.38194 18.1367 9.29081 18.1797C9.19967 18.2227 9.10072 18.2466 9.00001 18.25Z"/>
                                </svg>
                            }
                            else
                            {
                                // 預設黑點圖示, fileName = circle-black-shape-svgrepo-com.svg
                                <svg class="icon-svg" viewBox="0 0 26 26" fill="@GetNotificationIconColor(notification.Type)" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M26,13c0,7.18-5.818,13-13,13C5.82,26,0,20.18,0,13C0,5.82,5.82,0,13,0C20.182,0,26,5.82,26,13z"/>
                                </svg>
                            }
                        </div>
                        <div class="notification-content">
                            <div class="notification-message">@notification.Message</div>
                            <div class="notification-time">@notification.Time</div>
                        </div>
                        @if(!notification.IsRead)
                        {
                            <div class="unread-indicator"></div>
                        }
                    </div>
                }
            </div>
            
            <div class="notification-footer">
                <button class="notification-footer-btn" @onclick="ViewAllNotifications">查看全部通知</button>
            </div>
        </div>
    }
</div>

@code {
    private bool notificationOpen = false;
    private List<NotificationItem> notifications = new();
    private int unreadCount => notifications.Count(n => !n.IsRead);

    /// <summary>
    /// 是否為暗色主題
    /// </summary>
    [Parameter]
    public bool IsDarkTheme { get; set; } = true;

    /// <summary>
    /// 當主選單開啟時的回調（用於關閉通知選單）
    /// </summary>
    [Parameter]
    public EventCallback OnMenuOpened { get; set; }

    protected override void OnInitialized()
    {
        // 訂閱通知服務
        NotificationService.OnNotificationReceived += HandleNotification;
        
        // 初始化 Mock 資料（可選）
        InitializeMockData();
    }

    private void HandleNotification(NotificationItem notification)
    {
        // 新通知插入到列表最前面
        notifications.Insert(0, notification);
        
        // 限制通知數量（例如最多保留 50 則）
        if (notifications.Count > 10)
        {
            notifications = notifications.Take(10).ToList();
        }
        
        // 通知 UI 更新
        StateHasChanged();
    }

    private void InitializeMockData()
    {
        notifications = new List<NotificationItem>
        {
            new NotificationItem { Id = 1, Message = "系統更新完成", Time = "5 分鐘前", Type = "success", IsRead = false },
            new NotificationItem { Id = 2, Message = "電池電量低於 20%", Time = "10 分鐘前", Type = "warning", IsRead = false },
            new NotificationItem { Id = 3, Message = "逆變器連線異常", Time = "30 分鐘前", Type = "warning", IsRead = false },
            new NotificationItem { Id = 4, Message = "資料同步成功", Time = "1 小時前", Type = "info", IsRead = true },
            new NotificationItem { Id = 5, Message = "設備維護提醒", Time = "2 小時前", Type = "info", IsRead = true },
        };
    }

    public void Dispose()
    {
        // 取消訂閱
        NotificationService.OnNotificationReceived -= HandleNotification;
    }

    // 鈴鐺圖示顏色邏輯
    private string bellIconColor => notificationOpen 
        ? "#3b82f6"      // 藍色
        : (unreadCount > 0 
            ? "#1D4ED8"  // 黃色
            : (IsDarkTheme ? "#ffffff" : "#212529"));  // 白色/黑色
    private string circleColor = "#ffffff";

    // 取得通知圖示顏色
    private string GetNotificationIconColor(string type) => type switch
    {
        "warning" => "#ffc107",  // 黃色
        "info" => "#3b82f6",     // 藍色
        "success" => "#28a745",  // 綠色
        _ => "#ffffff"           // 預設白色
    };



    private async Task ToggleNotification()
    {
        notificationOpen = !notificationOpen;
        if(notificationOpen)
        {
            // 打開通知選單時，標記所有通知為已讀
            foreach(var notification in notifications)
            {
                notification.IsRead = true;
            }
            // 通知父元件關閉主選單
            await OnMenuOpened.InvokeAsync();
        }
    }

    private void MarkAsRead(int id)
    {
        var notification = notifications.FirstOrDefault(n => n.Id == id);
        if(notification != null)
        {
            notification.IsRead = true;
        }
    }

    private void ViewAllNotifications()
    {
        // 未來可以導航到通知頁面
        Console.WriteLine("查看全部通知");
    }

    /// <summary>
    /// 公開方法：關閉通知選單
    /// </summary>
    public void CloseNotification()
    {
        if(notificationOpen)
        {
            notificationOpen = false;
            StateHasChanged();
        }
    }
}
