@namespace demoVer.Shared
@inject NavigationManager NavManager
@inject IStringLocalizer<SharedResource> Localizer

@if (MenuOpen)
{
    <div class="dropdown-menu @PositionClass" @onclick:stopPropagation="true">
        <button class="nav-link" @onclick="GoTo_NTN_HOME">@Localizer["TopRow-Home"]</button>

        <button class="nav-link expandable" @onclick="Toggle_expand_sys_setting">
            <span>@Localizer["TopRow-SystemSettings"]</span>
            <span class="caret">▾</span>
        </button>
        @if (expand_sys_setting)
        {
            <div class="sub-menu">
                <button class="nav-link" @onclick="GoTo_Battery_setting">@Localizer["TopRow-BatterySettings"]</button>
                <button class="nav-link" @onclick="GoTo_Inverter_setting">@Localizer["TopRow-InvSettings"]</button>
            </div>
        }

        <button class="nav-link expandable" @onclick="Toggle_expand_management">
            <span>@Localizer["TopRow-ModelManagement"]</span>
            <span class="caret">▾</span>
        </button>
        @if (expand_management)
        {
            <div class="sub-menu">
                <button class="nav-link" @onclick="GoTo_Link_status">@Localizer["TopRow-LinkStatus"]</button>
                <button class="nav-link" @onclick="GoTo_Log">@Localizer["TopRow-MonitoringReport"]</button>
            </div>
        }

        <button class="nav-link expandable" @onclick="Toggle_expand_AI_application">
            <span>@Localizer["TopRow-AIApplications"]</span>
            <span class="caret">▾</span>
        </button>
        @if (expand_AI_applicaiton)
        {
            <div class="sub-menu">
                <button class="nav-link nav-link-inactive">@Localizer["TopRow-EfficiencyAnalysis"]</button>
                <button class="nav-link nav-link-inactive">@Localizer["TopRow-SmartPowerUsage"]</button>
                <button class="nav-link nav-link-inactive">@Localizer["TopRow-FailureAnalysis"]</button>
                <button class="nav-link nav-link-inactive">@Localizer["TopRow-PredictiveMaintenance"]</button>
            </div>
        }
        
        <button class="nav-link" @onclick="GoTo_ShortcutSetting">@Localizer["TopRow-ShortcutSettings"]</button>
    </div>
}

@code {
    [Parameter] public bool MenuOpen { get; set; }
    [Parameter] public EventCallback<bool> MenuOpenChanged { get; set; }
    [Parameter] public string PositionClass { get; set; } = "";

    private bool expand_sys_setting = false;
    private bool expand_management = false;
    private bool expand_AI_applicaiton = false;

    private async Task Toggle_expand_sys_setting()
    {
        expand_sys_setting = !expand_sys_setting;
    }

    private async Task Toggle_expand_management()
    {
        expand_management = !expand_management;
    }

    private async Task Toggle_expand_AI_application()
    {
        expand_AI_applicaiton = !expand_AI_applicaiton;
    }

    private async Task GoTo_NTN_HOME()
    {
        await CloseMenu();
        NavManager.NavigateTo("/", forceLoad: false);
    }

    private async Task GoTo_Battery_setting()
    {
        await CloseMenu();
        NavManager.NavigateTo("/Battery_setting", forceLoad: false);
    }

    private async Task GoTo_Inverter_setting()
    {
        await CloseMenu();
        NavManager.NavigateTo("/Inverter_setting", forceLoad: false);
    }

    private async Task GoTo_Link_status()
    {
        await CloseMenu();
        NavManager.NavigateTo("/Link_status", forceLoad: false);
    }

    private async Task GoTo_Log()
    {
        await CloseMenu();
        NavManager.NavigateTo("/Log", forceLoad: false);
    }

    private async Task GoTo_ShortcutSetting()
    {
        await CloseMenu();
        NavManager.NavigateTo("/Shortcut_setting", forceLoad: false);
    }

    private async Task CloseMenu()
    {
        await MenuOpenChanged.InvokeAsync(false);
    }
}