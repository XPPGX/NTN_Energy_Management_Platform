            <button class="topRow-btn" @onclick="ToggleTheme" title="@(IsDarkTheme ? Localizer["TopRow-SwitchToLight"] : Localizer["TopRow-SwitchToDark"])">
                <img src="images/night-mode.png" class="iconBtn"/>
            </button>


            <BellNotification @ref="bellNotificationRef" OnViewAllClicked="GoTo_Log" />
        } *@

        <img src="images/logo.png" alt="logo" class="clickable-logo" @onclick="GoTo_Framework"/>
    </div>
</div>


@code{

    private bool local_debug = true;
    private PAGE Page_index;
    private bool isMobile;
    private bool afterFirstRender_Flag = false;
    private bool menuOpen = false;
    private bool expand_sys_setting = false;
    private bool expand_management = false;
    private bool expand_AI_applicaiton = false;

    private string currentPage;
    private string currentRoute = "test";


    private bool showEditBtn_Flag = false;
    private bool showAddBtn_Flag = false;

    [CascadingParameter(Name = "IsDarkTheme")]
    private bool IsDarkTheme { get; set; }
    @* private BellIcon? bellIconRef; *@

    [CascadingParameter(Name = "MainLayout")]
    private MainLayout? Layout { get; set; }

    private BellNotification? bellNotificationRef;

    [Parameter] public EventCallback<bool> OnSendToParent {get; set;}
    [Parameter] public EventCallback InformParentTo_OpenAddCard {get; set;}
    [Parameter] public EventCallback InformParentTo_SaveCardsInfo {get; set;}

    [Parameter] public EventCallback InformParentTo_ApplySetting {get; set;}
    [Parameter] public EventCallback InformParentTo_UseDefaultValue{get; set;}

    private async Task ToggleTheme()
    {
        await Layout?.ToggleTheme();
    }

    private async Task apply_INV_setting()
    {
        await InformParentTo_ApplySetting.InvokeAsync();
    }

    private async Task UseDefault_INV_setting()
    {
        await InformParentTo_UseDefaultValue.InvokeAsync();
    }

    private async Task apply_battery_setting()
    {
        await InformParentTo_ApplySetting.InvokeAsync();
    }

    private async Task UseDefault_battery_setting()
    {
        await InformParentTo_UseDefaultValue.InvokeAsync();
    }

    private async Task showEditButtons()
    {
        showEditBtn_Flag = !showEditBtn_Flag;
        await OnSendToParent.InvokeAsync(showEditBtn_Flag);
    }

    private async Task showAddCard()
    {
        await InformParentTo_OpenAddCard.InvokeAsync();
    }

    private async Task saveCardsInfo()
    {
        await InformParentTo_SaveCardsInfo.InvokeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            afterFirstRender_Flag = true;
            isMobile = await JS.InvokeAsync<bool>("checkIsMobile");
            StateHasChanged(); // 讓頁面更新
        }
    }

    private void toggleMenu()
    {
        menuOpen = !menuOpen;
        if(menuOpen)
        {
            // 關閉通知選單
            @* bellNotificationRef?.CloseNotifications(); *@
        }
    }

    public void CloseNotifications()
    {
        bellNotificationRef?.CloseNotifications();
    }

    private void CloseMainMenu()
    {
        // 當通知選單開啟時，關閉主選單
        if(menuOpen)
        {
            menuOpen = false;
        }
    }

    protected override void OnInitialized()
    {
        //update the label at the first
        UpdatePageLabel();

        //register the nav
        NavManager.LocationChanged += OnLocationChanged;
    }

    private async Task GoTo_Framework()
    {
        await JS.InvokeVoidAsync("jumpToApp", 5039);
    }

    private void GoTo_Log()
    {
        showEditBtn_Flag = false;
        NavManager.NavigateTo("/Log");
    }

    private bool IsPortInUse(string host, int port)
	{
		try
		{
			using var client = new TcpClient();
			var result = client.BeginConnect(host, port, null, null);
			return result.AsyncWaitHandle.WaitOne(TimeSpan.FromMilliseconds(300)) && client.Connected;
		}
		catch
		{
			return false;
		}
	}

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdatePageLabel();
        StateHasChanged();
    }

    private void UpdatePageLabel()
    {
        //collapse all the menu when switching to other pages
        menuOpen = false;
        expand_sys_setting = false;
        expand_management = false;

        currentRoute = NavManager.ToBaseRelativePath(NavManager.Uri);
        Console.WriteLine($"{currentRoute}");
        switch(currentRoute)
        {
            case "":
                currentPage = "NTN Home";
                Console.WriteLine("App started1");
                Page_index = PAGE.HOME;
                break;

            case "Battery_setting":
                currentPage = "Battery Setting";
                AppLogger.Log("[TopRow] Page : Battery Setting", local_debug);
                Page_index = PAGE.BATTERY_SETTING;
                break;

            case "Inverter_setting":
                currentPage = "Inverter Setting";
                AppLogger.Log("[TopRow] Page : Inverter Setting", local_debug);
                Page_index = PAGE.INV_SETTING;
                break;

            case "Link_status":
                currentPage = "Link Status";
                AppLogger.Log("[TopRow] Page : Link Status", local_debug);
                Page_index = PAGE.LINK_STATUS;
                break;

            case "Log":
                currentPage = "Log";
                AppLogger.Log("[TopRow] Page : Log", local_debug);
                Page_index = PAGE.LOG;
                break;

            case "Use_strategy":
                @* currentPage = "Use strategy"; *@
                break;

            default:
                currentPage = "Unknown Page";
                break;
        }
    }

    public void HideMenu()
    {
        Console.WriteLine($"[TopRow][HideMenu] menuOpen = {menuOpen}");
        if(menuOpen == false)
        {
            return;
        }

        menuOpen = false;
        StateHasChanged();
    }

    public void ToggleMenu()
    {
        toggleMenu();
    }

    public void Dispose()
    {
        NavManager.LocationChanged -= OnLocationChanged;
    }
}