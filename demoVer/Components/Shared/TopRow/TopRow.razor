@namespace demoVer.Shared
@inject IJSRuntime JS
@using System.Net.Sockets
@rendermode InteractiveServer
@inject NavigationManager NavManager
@using demoVer.Utils
@using demoVer.Models
@using demoVer.Components.Layout
@inject IStringLocalizer<SharedResource> Localizer

<div class="top-row">
    <div class="left-items">
        @* <button class="topRow-btn mobile-hide" @onclick="toggleMenu" @onclick:stopPropagation="true">
            <!-- <i class="fas fa-th-large"></i> -->
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="iconBtn" style="stroke: @(IsDarkTheme ? "#ffffff" : "#000000");">
