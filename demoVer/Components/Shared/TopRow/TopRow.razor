@namespace demoVer.Shared
@inject IJSRuntime JS
@using System.Net.Sockets
@rendermode InteractiveServer
@inject NavigationManager NavManager
@using demoVer.Utils
@using demoVer.Models

<div class="top-row">
    <div class="left-items">
        <button class="topRow-btn" @onclick="toggleMenu">
            <!-- <i class="fas fa-th-large"></i> -->
            <img src="@(IsDarkTheme ? "images/menu-forDark.png" : "images/menu-forLight.png")" alt="menu" class="iconBtn"/>
        </button>
        @if(afterFirstRender_Flag)
        {
            if(!isMobile)
            {
                <div class="current_page_label">
                    <div>@currentPage</div>
                </div>
            }
        }

        
        @if(menuOpen)
        {
            <div class="dropdown-menu">
                <button class="nav-link" @onclick="GoTo_NTN_HOME">NTN首頁</button>

                <button class="nav-link expandable" @onclick="Toggle_expand_sys_setting">
                    <span>系統設定</span>
                    <span class="caret">▾</span>
                </button>
                @if(expand_sys_setting)
                {
                    <div class="sub-menu">
                        <button class="nav-link" @onclick="GoTo_Battery_setting">電池設定</button>
                        <button class="nav-link" @onclick="GoTo_Inverter_setting">INV設定</button>
                    </div>
                }
                
                <button class="nav-link expandable" @onclick="Toggle_expand_management">
                    <span>機型管理</span>
                    <span class="caret">▾</span>
                </button>
                @if(expand_management)
                {
                    <div class="sub-menu">
                        <button class="nav-link" @onclick="GoTo_Link_status">連線狀態</button>
                        <button class="nav-link" @onclick="GoTo_Log">監測報告</button>
                    </div>
                }

                <button class="nav-link expandable" @onclick="Toggle_expand_AI_application">
                    <span>AI應用</span>
                    <span class="caret">▾</span>
                </button>
                @if(expand_AI_applicaiton)
                {
                    <div class="sub-menu">
                        <button class="nav-link nav-link-inactive">效率分析</button>
                        <button class="nav-link nav-link-inactive">智慧用電</button>
                        <button class="nav-link nav-link-inactive">失效分析</button>
                        <button class="nav-link nav-link-inactive">預測維護</button>
                    </div>
                }
            </div>
        }
        <div class="current-tab">
            
        </div>
    </div>

    <div class="right-items">
        @if(afterFirstRender_Flag)
        {
            
            if(showEditBtn_Flag && Page_index == PAGE.HOME)
            {
                //show "+" button
                <button class="topRow-btn" @onclick="saveCardsInfo">
                    <img src="images/diskette.png" alt="save-edit" class="iconBtn"/>
                </button>
                <button class="topRow-btn" @onclick="showAddCard">
                    <img src="images/add.png" alt="plus" class="iconBtn"/>
                </button>
            }
            @if(Page_index == PAGE.HOME)
            {
                <button class="topRow-btn" @onclick="showEditButtons">
                    <img src="images/edit.png" alt="edit" class="iconBtn"/>
                </button>
            }

            if( Page_index == PAGE.BATTERY_SETTING)
            {
                @* <button class="topRow-btn" @onclick="apply_battery_setting">
                    <img src="images/checked.png" alt="apply" class="iconBtn"/>
                </button>
                <button class="topRow-btn" @onclick="UseDefault_battery_setting">
                    <img src="images/settings.png" alt="restore" class="iconBtn"/>
                </button> *@
            }

            if( Page_index == PAGE.INV_SETTING)
            {
                @* <button class="topRow-btn" @onclick="apply_INV_setting">
                    <img src="images/checked.png" alt="apply" class="iconBtn"/>
                </button>
                <button class="topRow-btn" @onclick="UseDefault_INV_setting">
                    <img src="images/settings.png" alt="restore" class="iconBtn"/>
                </button> *@
            }

            <button class="topRow-btn" @onclick="ToggleTheme" title="@(IsDarkTheme ? "切換到亮色模式" : "切換到暗色模式")">
                <img src="images/night-mode.png" class="iconBtn"/>
            </button>

            @* <BellIcon @ref="bellIconRef" IsDarkTheme="@IsDarkTheme" OnMenuOpened="@CloseMainMenu" /> *@

        }

        <img src="images/logo.png" alt="logo" class="clickable-logo" @onclick="GoTo_Framework"/>
    </div>
</div>


@code{

    private bool local_debug = true;
    private PAGE Page_index;
    private bool isMobile;
    private bool afterFirstRender_Flag = false;
    private bool menuOpen = false;
    private bool expand_sys_setting = false;
    private bool expand_management = false;
    private bool expand_AI_applicaiton = false;

    private string currentPage;
    private string currentRoute = "test";


    private bool showEditBtn_Flag = false;
    private bool showAddBtn_Flag = false;

    private bool IsDarkTheme { get; set; } = true; // 默認暗色主題
    private BellIcon? bellIconRef;

    [Parameter] public EventCallback<bool> OnSendToParent {get; set;}
    [Parameter] public EventCallback InformParentTo_OpenAddCard {get; set;}
    [Parameter] public EventCallback InformParentTo_SaveCardsInfo {get; set;}

    [Parameter] public EventCallback InformParentTo_ApplySetting {get; set;}
    [Parameter] public EventCallback InformParentTo_UseDefaultValue{get; set;}

    private async Task ToggleTheme()
    {
        IsDarkTheme = !IsDarkTheme;
        await JS.InvokeVoidAsync("setThemePreference", IsDarkTheme);
        
        // 直接切換頁面主題
        if (IsDarkTheme)
        {
            await JS.InvokeVoidAsync("document.body.classList.remove", "theme-light");
        }
        else
        {
            await JS.InvokeVoidAsync("document.body.classList.add", "theme-light");
        }

        // 重新渲染所有圖表以應用新主題
        await JS.InvokeVoidAsync("redrawAllCharts");
    }

    private async Task apply_INV_setting()
    {
        await InformParentTo_ApplySetting.InvokeAsync();
    }

    private async Task UseDefault_INV_setting()
    {
        await InformParentTo_UseDefaultValue.InvokeAsync();
    }

    private async Task apply_battery_setting()
    {
        await InformParentTo_ApplySetting.InvokeAsync();
    }

    private async Task UseDefault_battery_setting()
    {
        await InformParentTo_UseDefaultValue.InvokeAsync();
    }

    private async Task showEditButtons()
    {
        showEditBtn_Flag = !showEditBtn_Flag;
        await OnSendToParent.InvokeAsync(showEditBtn_Flag);
    }

    private async Task showAddCard()
    {
        await InformParentTo_OpenAddCard.InvokeAsync();
    }

    private async Task saveCardsInfo()
    {
        await InformParentTo_SaveCardsInfo.InvokeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            afterFirstRender_Flag = true;
            isMobile = await JS.InvokeAsync<bool>("checkIsMobile");
            
            // 從 localStorage 讀取主題偏好
            var storedTheme = await JS.InvokeAsync<string>("getThemePreference");
            if (!string.IsNullOrEmpty(storedTheme))
            {
                IsDarkTheme = storedTheme == "dark";
                
                // 直接應用主題
                if (IsDarkTheme)
                {
                    await JS.InvokeVoidAsync("document.body.classList.remove", "theme-light");
                }
                else
                {
                    await JS.InvokeVoidAsync("document.body.classList.add", "theme-light");
                }
            }
            
            StateHasChanged(); // 讓頁面更新
        }
    }

    private void toggleMenu()
    {
        menuOpen = !menuOpen;
        if(menuOpen)
        {
            // 關閉通知選單
            bellIconRef?.CloseNotification();
        }
    }

    private void CloseMainMenu()
    {
        // 當通知選單開啟時，關閉主選單
        if(menuOpen)
        {
            menuOpen = false;
        }
    }
    
    private void Toggle_expand_management()
    {
        expand_management = !expand_management;
    }

    private void Toggle_expand_sys_setting()
    {
        expand_sys_setting = !expand_sys_setting;
    }

    private void Toggle_expand_AI_application()
    {
        expand_AI_applicaiton = !expand_AI_applicaiton;
    }
    @* private void GoTo_NTN_HOME()
    {
        NavManager.NavigateTo("/");
    } *@

    private void GoTo_NTN_HOME()
    {
        showEditBtn_Flag = false;
        NavManager.NavigateTo("/");
    }

    private void GoTo_Battery_setting()
    {
        showEditBtn_Flag = false;
        NavManager.NavigateTo("/Battery_setting");
    }

    private void GoTo_Inverter_setting()
    {
        showEditBtn_Flag = false;
        NavManager.NavigateTo("/Inverter_setting");
    }

    private void GoTo_Link_status()
    {
        showEditBtn_Flag = false;
        NavManager.NavigateTo("/Link_status");
    }

    private void GoTo_Log()
    {
        showEditBtn_Flag = false;
        NavManager.NavigateTo("/Log");
    }

    private void GoTo_Use_strategy()
    {
        @* showEditBtn_Flag = false;
        NavManager.NavigateTo("/Use_strategy"); *@
    }

    protected override void OnInitialized()
    {
        //update the label at the first
        UpdatePageLabel();

        //register the nav
        NavManager.LocationChanged += OnLocationChanged;
    }

    private async Task GoTo_Framework()
    {
        await JS.InvokeVoidAsync("jumpToApp", 5039);
    }

    private bool IsPortInUse(string host, int port)
	{
		try
		{
			using var client = new TcpClient();
			var result = client.BeginConnect(host, port, null, null);
			return result.AsyncWaitHandle.WaitOne(TimeSpan.FromMilliseconds(300)) && client.Connected;
		}
		catch
		{
			return false;
		}
	}

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdatePageLabel();
        StateHasChanged();
    }

    private void UpdatePageLabel()
    {
        //collapse all the menu when switching to other pages
        menuOpen = false;
        expand_sys_setting = false;
        expand_management = false;

        currentRoute = NavManager.ToBaseRelativePath(NavManager.Uri);
        Console.WriteLine($"{currentRoute}");
        switch(currentRoute)
        {
            case "":
                currentPage = "NTN Home";
                Console.WriteLine("App started1");
                Page_index = PAGE.HOME;
                break;

            case "Battery_setting":
                currentPage = "Battery Setting";
                AppLogger.Log("[TopRow] Page : Battery Setting", local_debug);
                Page_index = PAGE.BATTERY_SETTING;
                break;

            case "Inverter_setting":
                currentPage = "Inverter Setting";
                AppLogger.Log("[TopRow] Page : Inverter Setting", local_debug);
                Page_index = PAGE.INV_SETTING;
                break;

            case "Link_status":
                currentPage = "Link Status";
                AppLogger.Log("[TopRow] Page : Link Status", local_debug);
                Page_index = PAGE.LINK_STATUS;
                break;

            case "Log":
                currentPage = "Log";
                AppLogger.Log("[TopRow] Page : Log", local_debug);
                Page_index = PAGE.LOG;
                break;

            case "Use_strategy":
                @* currentPage = "Use strategy"; *@
                break;

            default:
                currentPage = "Unknown Page";
                break;
        }
    }

    public void HideMenu()
    {
        Console.WriteLine($"[TopRow][HideMenu] menuOpen = {menuOpen}");
        if(menuOpen == false)
        {
            return;
        }

        menuOpen = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        NavManager.LocationChanged -= OnLocationChanged;
    }
}