@namespace demoVer.Shared
@using demoVer.Components.Layout
@using demoVer.Services
@using Microsoft.AspNetCore.Components
@implements IDisposable

@inject NavigationManager NavManager
@inject IStringLocalizer<SharedResource> Localizer
@inject BottomRowConfig BottomRowConfigService
@inject BottomRowImageService BottomRowImageService

<div class="bottom-row" role="navigation" aria-label="@Localizer["BottomRow-NavLabel"]">
    @if (menuOpen)
    {
        <MenuDropdown @bind-MenuOpen="menuOpen" PositionClass="dropdown-menu-above" />
    }
    @for (int i = 0; i < bottomRowItems.Count; i++)
    {
        var item = bottomRowItems[i];
        var imageIndex = i + 1;
        var url = BottomRowImageService.GetImageUrl(imageIndex);
        var src = (!string.IsNullOrEmpty(url))
            ? $"{url}?v={BottomRowImageService.GetImageLastWriteTicksUtc(imageIndex) ?? refreshTimestamp}"
            : BottomRowImageService.GetDefaultImageUrl(imageIndex);

        <button type="button" class="bottomRow-btn" @onclick="@(() => NavigateTo(item.Route))" title="@item.Route">
            <img src="@src" alt="Bottom button @imageIndex" class="bottomRow-label" onerror="this.src='@BottomRowImageService.GetDefaultImageUrl(imageIndex)';" />
        </button>
    }
    <button type="button" class="bottomRow-btn" @onclick="ToggleMenu" @onclick:stopPropagation="true" title="Toggle Menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="iconBtn" style="stroke: @(IsDarkTheme ? "#ffffff" : "#000000");">
            <path d="M3 12H15M3 6H21M3 18H21" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
    </button>
</div>

@code {
    [CascadingParameter(Name = "MainLayout")]
    private MainLayout? Layout { get; set; }

    [CascadingParameter(Name = "IsDarkTheme")]
    private bool IsDarkTheme { get; set; }

    private bool menuOpen = false;
    private List<BottomRowItem> bottomRowItems = new List<BottomRowItem>();
    private long refreshTimestamp = DateTimeOffset.UtcNow.Ticks;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        LoadBottomRowItems();
        
        // 订阅配置变更事件
        BottomRowConfigService.OnConfigChanged += HandleConfigChanged;
    }

    private void LoadBottomRowItems()
    {
        bottomRowItems = BottomRowConfigService.Get_UserDefinedList_snapshot();
    }

    private async void HandleConfigChanged(object? sender, EventArgs e)
    {
        LoadBottomRowItems();
        refreshTimestamp = DateTimeOffset.UtcNow.Ticks; // Force refresh images
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleMenu()
    {
        menuOpen = !menuOpen;
    }

    private void NavigateTo(string uri)
    {
        Layout?.HideMenu();
        NavManager.NavigateTo(uri, forceLoad: false);
    }

    public void HideMenu()
    {
        Console.WriteLine($"[BottomRow][HideMenu] menuOpen = {menuOpen}");
        if(menuOpen == false)
        {
            return;
        }

        menuOpen = false;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // 主題由 MainLayout 管理，這裡不需要額外邏輯
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        BottomRowConfigService.OnConfigChanged -= HandleConfigChanged;
    }
}
