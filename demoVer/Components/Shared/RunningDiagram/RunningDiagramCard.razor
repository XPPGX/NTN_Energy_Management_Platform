@namespace demoVer.Shared
@inherits LayoutComponentBase
@implements IAsyncDisposable
@using demoVer.Models
@using demoVer.Services
@using demoVer.Utils
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks
@inject GlobalVar globalVar
@inject IStringLocalizer<SharedResource> Localizer
<div class="running-diagram-container @CssClass" @attributes="AdditionalAttributes">
    <div class="running-diagram-container top">
        <div class="leftPart">
            <span class="subsystem-badge @GetSubsystemModeClass()" title="@GetSubsystemBadgeTooltip()">
                @GetActiveSubsystemLabel()
            </span>
            <div class="adaptive">@Localizer["RunningDiagramCard-RunningMode"]</div>
            <div id="running_mode">@local_INV_MODE_str</div>
        </div>
        @* <div class="rightPart">
            
        </div> *@
        
        @if(showEditButton)
        {
            <button type="button"
                    class="top-right-button"
                    @onclick="openEditMenu">
                <MudIcon Icon="@Icons.Material.Filled.MoreHoriz" />
            </button>
        }
    </div>
    <div class="running-diagram-container bottom">
        <div class="grid-container" @ref="grid_container">
            <div class="grid-col" style="@Grid(1,1)">
                <div class="grid-item">
                    <img src="@currentCard.Link_STATUS_Pairs[0].iconPath" alt="Transmission Tower" style="width:48px; height:48px" @ref="tower"/>
                </div>
                <div class="grid-label">@currentCard.Link_STATUS_Pairs[0].Label</div>
            </div>
            <div class="grid-col" style="@Grid(1, 3)">
                <div class="grid-item">
                    <img src="@currentCard.Link_STATUS_Pairs[1].iconPath" alt="NTN" style="width:48px; height:48px" @ref="NTN"/>
                </div>
                <div class="grid-label">@currentCard.Link_STATUS_Pairs[1].Label</div>
            </div>
            <div class="grid-col" style="@Grid(1, 5)">
                <div class="grid-item">
                    <img src="@currentCard.Link_STATUS_Pairs[2].iconPath" alt="load" style="width:48px; height:48px" @ref="load"/>
                </div>
                <div class="grid-label">@currentCard.Link_STATUS_Pairs[2].Label</div>
            </div>
            <div class="grid-col" style="@Grid(3, 3)">
                <div class="grid-item">
                    <img src="@currentCard.Link_STATUS_Pairs[3].iconPath" alt="battery" style="width:48px; height:48px" @ref="battery"/>
                </div>
                
                <div class="grid-label">@currentCard.Link_STATUS_Pairs[3].Label</div>
            </div>
            <div class="grid-col" style="@Grid(3, 4)">
                <div class="grid-item-plain">
                    <BatteryInfoCard 
                        currentBAT_SOC="@currentBAT_SoC"/>
                </div>
            </div>
            @if (arrowService.triGroup1.get_showArrowFlag())
            {
                <div class="@arrowService.triGroup1.GetGroupClass()" style="@arrowService.triGroup1.GetGridAreaStyle()">
                    @for (int i = 0; i < arrowService.triGroup1.Count; i++)
                    {
                        var triangleClass = arrowService.triGroup1.GetTriangleClass(i);
                        <div class="@triangleClass"></div>
                    }
                </div>
            }
            @if (arrowService.triGroup2.get_showArrowFlag())
            {
                <div class="@arrowService.triGroup2.GetGroupClass()" style="@arrowService.triGroup2.GetGridAreaStyle()">
                    @for (int i = 0; i < arrowService.triGroup2.Count; i++)
                    {
                        var triangleClass = arrowService.triGroup2.GetTriangleClass(i);
                        <div class="@triangleClass"></div>
                    }
                </div>
            }

            @if (arrowService.triGroup3.get_showArrowFlag())
            {
                <div class="@arrowService.triGroup3.GetGroupClass()" style="@arrowService.triGroup3.GetGridAreaStyle()">
                    @for (int i = 0; i < arrowService.triGroup3.Count; i++)
                    {
                        var triangleClass = arrowService.triGroup3.GetTriangleClass(i);
                        <div class="@triangleClass"></div>
                    }
                </div>
            }
            <!-- 第一列 -->
            
            
            <div class="grid-col">
                <div class="placeholder">
                    @* Placeholder for future arrow rendering backups *@
                </div>
                <div class="grid-label"></div>
            </div>
            
            <div class="grid-col">
                <div class="placeholder">
                    @* Placeholder for future arrow rendering backups *@
                </div>
                <div class="grid-label"></div>
            </div>
            
            
            <!-- 第二列 -->
            <div class="placeholder"></div>
            <div class="placeholder"></div>
            <div class="grid-col">
                <div class="placeholder">
                    @* Placeholder for future arrow rendering backups *@
                </div>
            </div>
            <div class="placeholder"></div>
            <div class="placeholder"></div>

            <!-- 第三列 -->
            <div class="placeholder"></div>
            <div class="placeholder"></div>
            
            
            <div class="placeholder"></div>
            <div class="placeholder"></div>
            
        </div>
        
    </div>
</div>

@code{
    private readonly ArrowAnimationService arrowService = new();
    private readonly List<SubSystem> subsystemOptions = new();
    private string? selectedSubsystemKey;
    private string _category = string.Empty;
    private bool DEBUG_MODE = true;
    private string local_INV_MODE_str = ConstDefinition.DEFAULT_MODE_str;
    private SubSystem? activeSubSystem;
    private SOC currentBAT_SoC = new SOC();
    [Parameter] public string CssClass { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object> AdditionalAttributes { get; set; }
    [Parameter] public bool showEditButton { get; set; }
    [Parameter] public EventCallback<string> Inform_Home_openEditMenu { get; set; }
    [Parameter] public CardInfo currentCard { get; set; }

    private bool stopTimer_Flag = false;

    private void Log(string message)
    {
        if (DEBUG_MODE)
        {
            Console.WriteLine($"[Debug] {message}");
        }
    }

    private async Task openEditMenu()
    {
        if (Inform_Home_openEditMenu.HasDelegate)
        {
            await Inform_Home_openEditMenu.InvokeAsync(currentCard.ID);
        }
    }

    protected override void OnInitialized()
    {
        _category = GetType().FullName!;
    }

    protected override Task OnInitializedAsync()
    {
        SetSelectedSubsystemKey(currentCard?.SelectedSubsystemKey);
        arrowService.OnTick += OnArrowTick;
        RefreshSubsystems();
        return Task.CompletedTask;
    }

    protected override void OnParametersSet()
    {
        if (currentCard is null)
        {
            return;
        }

        if (!string.Equals(currentCard.SelectedSubsystemKey, selectedSubsystemKey, StringComparison.Ordinal))
        {
            SetSelectedSubsystemKey(currentCard.SelectedSubsystemKey);
            RefreshSubsystems();
        }
    }

    private static SubSystem? SelectSubsystem(IReadOnlyList<SubSystem> subsystems)
    {
        if (subsystems.Count == 0)
        {
            return null;
        }

        return subsystems.FirstOrDefault(s => s.isAnyDeviceOnline)
               ?? subsystems[0];
    }

    private void RefreshSubsystems()
    {
        var subsystems = globalVar.GetSubSystemsSnapshot();
        subsystemOptions.Clear();
        subsystemOptions.AddRange(subsystems);

        if (subsystemOptions.Count == 0)
        {
            activeSubSystem = null;
            SetSelectedSubsystemKey(null);
            ApplyActiveSubsystem();
            return;
        }

        if (!string.IsNullOrEmpty(selectedSubsystemKey))
        {
            activeSubSystem = subsystemOptions.FirstOrDefault(s => BuildSubsystemKey(s) == selectedSubsystemKey);
        }

        if (activeSubSystem is null)
        {
            activeSubSystem = SelectSubsystem(subsystemOptions);
        }

        if (activeSubSystem is not null)
        {
            SetSelectedSubsystemKey(BuildSubsystemKey(activeSubSystem));
        }
        else
        {
            SetSelectedSubsystemKey(null);
        }

        ApplyActiveSubsystem();
    }

    private void ApplyActiveSubsystem()
    {
        var directions = activeSubSystem?.ArrowDirections ?? ArrowDirections.Hidden;
        var shouldFallback = activeSubSystem is null || !directions.AnyVisible;

        arrowService.SetFallbackMode(shouldFallback);

        local_INV_MODE_str = activeSubSystem?.DisplayModeName ?? ConstDefinition.DEFAULT_MODE_str;
        arrowService.UpdateDirections(directions);

        // Update Local Battery SOC
        if(activeSubSystem?.SOC_Info is not null)
        {
            currentBAT_SoC.BAT_Capacity = activeSubSystem.SOC_Info.BAT_Capacity;
            currentBAT_SoC.BAT_level = activeSubSystem.SOC_Info.BAT_level;
            currentBAT_SoC.BAT_Remain_Time = activeSubSystem.SOC_Info.BAT_Remain_Time;
        }
        else
        {
            currentBAT_SoC.BAT_Capacity = 0;
            currentBAT_SoC.BAT_level = 0;
            currentBAT_SoC.BAT_Remain_Time = 0;
        }
    }

    private void OnArrowTick()
    {
        _ = InvokeAsync(() =>
        {
            RefreshSubsystems();
            StateHasChanged();
            return Task.CompletedTask;
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            arrowService.triGroup1.PlaceAt(1, 2);
            arrowService.triGroup1.SetDirection(ArrowDirection.Hidden);

            arrowService.triGroup2.PlaceAt(1, 4);
            arrowService.triGroup2.SetDirection(ArrowDirection.Hidden);

            arrowService.triGroup3.PlaceAt(2, 3);
            arrowService.triGroup3.SetDirection(ArrowDirection.Hidden);

            arrowService.triGroup1.show_arrows();
            arrowService.triGroup2.show_arrows();
            arrowService.triGroup3.show_arrows();
            Console.WriteLine("RunningDiagramCard: Arrows shown.");
            await InvokeAsync(StateHasChanged);
        }
    }

    #region arrowAnimation
    protected ElementReference leftRef;
    protected ElementReference rightRef;

    protected ElementReference tower;
    protected ElementReference NTN;
    protected ElementReference load;
    protected ElementReference battery;
    protected ElementReference grid_container;

    protected int arrowLeft;
    protected int arrowTop;
    protected int activeIndex = 0;
    protected bool showArrows = false;

    protected System.Threading.Timer? timer;

    [Inject] protected IJSRuntime JS { get; set; } = default!;

    protected class DomRect
    {
        public double Bottom { get; set; }
        public double Height { get; set; }
        public double Left { get; set; }
        public double Right { get; set; }
        public double Top { get; set; }
        public double Width { get; set; }
    }

    protected async Task UpdateArrowPosition()
    {
        var leftRect = await JS.InvokeAsync<DomRect>("getBoundingClientRect", tower, grid_container);
        var rightRect = await JS.InvokeAsync<DomRect>("getBoundingClientRect", NTN, grid_container);
        arrowLeft = (int)((leftRect.Right + rightRect.Left) / 2) - 8;
        arrowTop = (int)((leftRect.Top + rightRect.Top) / 2);
        arrowService.triGroup1.set_triGroup_postion(arrowLeft, arrowTop);
        arrowService.triGroup1.show_arrows();

        leftRect = await JS.InvokeAsync<DomRect>("getBoundingClientRect", NTN, grid_container);
        rightRect = await JS.InvokeAsync<DomRect>("getBoundingClientRect", load, grid_container);
        arrowLeft = (int)((leftRect.Right + rightRect.Left) / 2);
        arrowTop = (int)((leftRect.Top + rightRect.Top) / 2);
        arrowService.triGroup2.set_triGroup_postion(arrowLeft, arrowTop);
        arrowService.triGroup2.show_arrows();

        leftRect = await JS.InvokeAsync<DomRect>("getBoundingClientRect", NTN, grid_container);
        rightRect = await JS.InvokeAsync<DomRect>("getBoundingClientRect", battery, grid_container);
        arrowLeft = (int)((leftRect.Right + rightRect.Left) / 2);
        arrowTop = (int)((leftRect.Top + rightRect.Top) / 2);
        arrowService.triGroup3.set_triGroup_postion(arrowLeft, arrowTop);
        arrowService.triGroup3.show_arrows();
    }

    private static string Grid(int row, int col) => $"grid-row:{row}; grid-column:{col}";

    private static string BuildSubsystemKey(SubSystem subsystem) => $"{subsystem.Port}|{subsystem.Protocol}";

    private static string GetSubsystemDisplayName(SubSystem subsystem)
    {
        @* var identifier = string.IsNullOrWhiteSpace(subsystem.ModelName) ? subsystem.Protocol : subsystem.ModelName; *@
        var identifier = subsystem.Protocol;
        var withoutExtension_protocol = Path.GetFileNameWithoutExtension(identifier);
        return $"{subsystem.Port} - {withoutExtension_protocol}";
    }

    private void SetSelectedSubsystemKey(string? key)
    {
        if (string.Equals(selectedSubsystemKey, key, StringComparison.Ordinal))
        {
            return;
        }

        selectedSubsystemKey = key;
        if (currentCard is not null)
        {
            currentCard.SelectedSubsystemKey = key;
        }
    }

    private string GetActiveSubsystemLabel()
    {
        return activeSubSystem is not null
            ? GetSubsystemDisplayName(activeSubSystem)
            : Localizer["RunningDiagramCard-NoAvailableSubsystem"];
    }

    private string GetSubsystemModeClass()
    {
        if (activeSubSystem is null)
        {
            return "mode-disconnected";
        }

        return activeSubSystem.ComputedVals.nowMode switch
        {
            ConstDefinition.SYS_Mode_Options.INVERTER => "mode-inverter",
            ConstDefinition.SYS_Mode_Options.SAVING => "mode-saving",
            ConstDefinition.SYS_Mode_Options.BY_PASS => "mode-bypass",
            ConstDefinition.SYS_Mode_Options.BY_PASS_AC_CHARGER => "mode-bypass",
            ConstDefinition.SYS_Mode_Options.CHARGER => "mode-charger",
            ConstDefinition.SYS_Mode_Options.STANDBY => "mode-standby",
            ConstDefinition.SYS_Mode_Options.BATTERY_FIRST => "mode-battery-first",
            ConstDefinition.SYS_Mode_Options.AC_OK => "mode-ac-ok",
            ConstDefinition.SYS_Mode_Options.SHUTDOWN => "mode-shutdown",
            ConstDefinition.SYS_Mode_Options.ERROR => "mode-error",
            _ => "mode-disconnected"
        };
    }

    private string GetSubsystemBadgeTooltip()
    {
        if (activeSubSystem is null)
        {
            return Localizer["RunningDiagramCard-SubsystemStatusNotObtained"];
        }

        return string.IsNullOrWhiteSpace(local_INV_MODE_str)
            ? Localizer["RunningDiagramCard-RunningStatusUpdating"]
            : $"{Localizer["RunningDiagramCard-CurrentMode"]}{local_INV_MODE_str}";
    }

    public async ValueTask DisposeAsync()
    {
        arrowService.OnTick -= OnArrowTick;
        await arrowService.DisposeAsync();
    }
    #endregion //arrowAnimation
}