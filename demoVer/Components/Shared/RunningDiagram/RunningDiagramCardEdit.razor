@namespace demoVer.Shared
@inherits LayoutComponentBase
@implements IDisposable

@using System
@using System.Collections.Generic
@using System.IO
@using System.Linq
@using demoVer.Models
@using demoVer.Services
@using Microsoft.AspNetCore.Components
@using MudBlazor

@inject IWebHostEnvironment WebHostEnvironment
@inject GlobalVar globalVar
@inject IStringLocalizer<SharedResource> Localizer

<div class="status-editor">
	@if (STATUS_setting_stage == STATUS_SETTING_STAGE.OVERVIEW)
	{
		<h3>@Localizer["RunningDiagramCardEdit-EditConnectionStatus"]</h3>
		<div class="subsystem-editor">
			<label class="subsystem-select-label" for="subsystem-select-editor">@Localizer["RunningDiagramCardEdit-Subsystem"]</label>
			@if (subsystemOptions.Count > 0)
			{
				<select id="subsystem-select-editor"
						class="subsystem-select"
						value="@selectedSubsystemKey"
						@onchange="OnSubsystemSelectionChanged">
					@foreach (var subsystem in subsystemOptions)
					{
						var key = BuildSubsystemKey(subsystem);
						<option value="@key" selected="@(key == selectedSubsystemKey)">@GetSubsystemDisplayName(subsystem)</option>
					}
				</select>
			}
			else
			{
				<select id="subsystem-select-editor" class="subsystem-select" disabled>
					<option value="">@Localizer["RunningDiagramCardEdit-NoAvailableSubsystem"]</option>
				</select>
			}
		</div>
		<table class="custom-table no-text-select" id="table-linkingStatus">
			<colgroup>
				<col style="width: 20%;" />
				<col style="width: 30%;" />
				<col style="width: 60%;" />
			</colgroup>
			<thead>
				<tr>
					<th>@Localizer["RunningDiagramCardEdit-No"]</th>
					<th>@Localizer["RunningDiagramCardEdit-Icon"]</th>
					<th>@Localizer["RunningDiagramCardEdit-Text"]</th>
				</tr>
			</thead>
			<tbody>
				@for (var i = 0; i < edit_Link_STATUS_Pairs.Count; i++)
				{
					var pair = edit_Link_STATUS_Pairs[i];
					var iconPath = string.IsNullOrEmpty(pair.iconPath) ? "images/square.png" : pair.iconPath;

					<tr>
						<td>@(i + 1)</td>
						<td>
							<button class="icon-button" @onclick="() => selectImg_LINK_STATUS(pair)">
								<img src="@iconPath" alt="status icon" />
							</button>
						</td>
						<td>
							<input @bind="pair.Label" class="td-input" />
						</td>
					</tr>
				}
			</tbody>
		</table>

		<MudButton Class="no-transform"
				   OnClick="Confirm_LINK_STATUS"
				   Variant="Variant.Filled"
				   Color="Color.Success"
				   Style="width: 120px;">
			@Localizer["RunningDiagramCardEdit-Confirm"]
		</MudButton>
	}
	else if (STATUS_setting_stage == STATUS_SETTING_STAGE.SELECT_ICON_STAGE)
	{
		<div class="img-select-grid">
			@foreach (var icon in imgRelativePaths)
			{
				<div class="img-select-icon">
					<button class="icon-button" @onclick="() => selectedImgFile_LINK_STATUS(icon)">
						<img src="@icon" alt="icon option" />
					</button>
				</div>
			}
		</div>
	}
</div>

@code {
	[Parameter] public CardInfo currentCardInfo { get; set; } = default!;
	[Parameter] public EventCallback<CardInfo> OnCardInfoUpdated { get; set; }

	private readonly List<SubSystem> subsystemOptions = new();
	private string? selectedSubsystemKey;

	private string imgFolderPath = string.Empty;
	private List<string> imgRelativePaths = new();
	private STATUS_SETTING_STAGE STATUS_setting_stage = STATUS_SETTING_STAGE.OVERVIEW;
	private LINK_STATUS_Pair? currentEdit_LINK_STATUS_pair_ref;
	private List<LINK_STATUS_Pair> edit_Link_STATUS_Pairs = new();
	private int? _currentEditIndex;

    private bool _isFirstParameterSet = false;
	private static readonly Dictionary<string, RunningDiagramDraft> _draftStore = new(StringComparer.Ordinal);
	private bool _skipDraftSave;

	protected override void OnInitialized()
	{
		imgFolderPath = Path.Combine(WebHostEnvironment.WebRootPath, "images/user_selections");
		LoadIconPaths();

		InitializeFromCard();
		selectedSubsystemKey = currentCardInfo.SelectedSubsystemKey;
		RefreshSubsystemOptions();
		RestoreDraftIfAvailable();
	}

	protected override void OnParametersSet()
	{
        if(!_isFirstParameterSet)
        {
            _isFirstParameterSet = true;
            if (currentCardInfo.card_Type != CardType.Status)
            {
                return;
            }

			InitializeFromCard();
			selectedSubsystemKey = currentCardInfo.SelectedSubsystemKey;
			RefreshSubsystemOptions();
			RestoreDraftIfAvailable();
        }
	}

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            
        }
    }

	private void RefreshSubsystemOptions()
	{
		var subsystems = globalVar.GetSubSystemsSnapshot();
		subsystemOptions.Clear();
		subsystemOptions.AddRange(subsystems);

		if (subsystemOptions.Count == 0)
		{
			selectedSubsystemKey = null;
			currentCardInfo.SelectedSubsystemKey = null;
			return;
		}

		if (!string.IsNullOrEmpty(selectedSubsystemKey) && !subsystemOptions.Any(s => BuildSubsystemKey(s) == selectedSubsystemKey))
		{
			selectedSubsystemKey = null;
		}

		if (string.IsNullOrEmpty(selectedSubsystemKey))
		{
			var incoming = currentCardInfo.SelectedSubsystemKey;
			if (!string.IsNullOrEmpty(incoming) && subsystemOptions.Any(s => BuildSubsystemKey(s) == incoming))
			{
				selectedSubsystemKey = incoming;
			}
			else
			{
				var fallback = SelectSubsystem(subsystemOptions);
				selectedSubsystemKey = fallback is null ? null : BuildSubsystemKey(fallback);
			}
		}

		currentCardInfo.SelectedSubsystemKey = selectedSubsystemKey;
	}

	private void OnSubsystemSelectionChanged(ChangeEventArgs args)
	{
		selectedSubsystemKey = args.Value?.ToString();
		currentCardInfo.SelectedSubsystemKey = selectedSubsystemKey;
	}

	private static SubSystem? SelectSubsystem(IReadOnlyList<SubSystem> subsystems)
	{
		if (subsystems.Count == 0)
		{
			return null;
		}

		return subsystems.FirstOrDefault(s => s.isAnyDeviceOnline)
			?? subsystems[0];
	}

	private static string BuildSubsystemKey(SubSystem subsystem) => $"{subsystem.Port}|{subsystem.Protocol}";

	private static string GetSubsystemDisplayName(SubSystem subsystem)
	{
		@* var identifier = string.IsNullOrWhiteSpace(subsystem.ModelName) ? subsystem.Protocol : subsystem.ModelName; *@
		var identifier = subsystem.Protocol;
		var withoutExtension_protocol = Path.GetFileNameWithoutExtension(identifier);
		return $"{subsystem.Port} - {withoutExtension_protocol}";
		@* return $"{subsystem.Port} - {identifier}"; *@
	}

	private void LoadIconPaths()
	{
		if (!Directory.Exists(imgFolderPath))
		{
			return;
		}

		imgRelativePaths = Directory.GetFiles(imgFolderPath)
			.Select(path => $"images/user_selections/{Path.GetFileName(path)}")
			.ToList();
	}

	private void EnsureStatusSlots()
	{
		if (edit_Link_STATUS_Pairs.Count > 4)
		{
			edit_Link_STATUS_Pairs = edit_Link_STATUS_Pairs.Take(4).ToList();
		}

		while (edit_Link_STATUS_Pairs.Count < 4)
		{
			edit_Link_STATUS_Pairs.Add(new LINK_STATUS_Pair
			{
				iconPath = string.Empty,
				Label = string.Empty
			});
		}
	}

	private void selectImg_LINK_STATUS(LINK_STATUS_Pair item)
	{
		_currentEditIndex = edit_Link_STATUS_Pairs.IndexOf(item);
		currentEdit_LINK_STATUS_pair_ref = _currentEditIndex is >= 0 and < int.MaxValue
			? edit_Link_STATUS_Pairs[_currentEditIndex.Value]
			: null;
		STATUS_setting_stage = STATUS_SETTING_STAGE.SELECT_ICON_STAGE;
	}

	private void selectedImgFile_LINK_STATUS(string imgPath)
	{
		if (currentEdit_LINK_STATUS_pair_ref is null)
		{
			return;
		}

		currentEdit_LINK_STATUS_pair_ref.iconPath = imgPath;
		STATUS_setting_stage = STATUS_SETTING_STAGE.OVERVIEW;
		currentEdit_LINK_STATUS_pair_ref = null;
		_currentEditIndex = null;
	}

	private void Confirm_LINK_STATUS()
	{
		ClearDraft(skipSave: true);
		currentCardInfo.Link_STATUS_Pairs = edit_Link_STATUS_Pairs
			.Select(pair => pair.DeepClone())
			.ToList();

		currentCardInfo.SelectedSubsystemKey = selectedSubsystemKey;

		OnCardInfoUpdated.InvokeAsync(currentCardInfo);
	}

	private void InitializeFromCard()
	{
		edit_Link_STATUS_Pairs = currentCardInfo.Link_STATUS_Pairs?
			.Select(pair => pair.DeepClone()).ToList() ?? new List<LINK_STATUS_Pair>();
		EnsureStatusSlots();
		STATUS_setting_stage = STATUS_SETTING_STAGE.OVERVIEW;
		currentEdit_LINK_STATUS_pair_ref = null;
		_currentEditIndex = null;
		_skipDraftSave = false;
	}

	private void RestoreDraftIfAvailable()
	{
		if (currentCardInfo?.ID is not string id || string.IsNullOrWhiteSpace(id))
		{
			return;
		}

		if (!_draftStore.TryGetValue(id, out var draft))
		{
			return;
		}

		edit_Link_STATUS_Pairs = draft.StatusPairs
			.Select(pair => pair.DeepClone())
			.ToList();
		EnsureStatusSlots();
		STATUS_setting_stage = draft.Stage;
		_currentEditIndex = draft.EditingIndex;
		if (_currentEditIndex is >= 0 && _currentEditIndex < edit_Link_STATUS_Pairs.Count)
		{
			currentEdit_LINK_STATUS_pair_ref = edit_Link_STATUS_Pairs[_currentEditIndex.Value];
		}
		else
		{
			currentEdit_LINK_STATUS_pair_ref = null;
			_currentEditIndex = null;
			STATUS_setting_stage = STATUS_SETTING_STAGE.OVERVIEW;
		}
		_skipDraftSave = false;
	}

	private void SaveDraft()
	{
		if (_skipDraftSave)
		{
			_skipDraftSave = false;
			return;
		}

		if (currentCardInfo?.ID is not string id || string.IsNullOrWhiteSpace(id))
		{
			return;
		}

		var snapshot = edit_Link_STATUS_Pairs
			.Select(pair => pair.DeepClone())
			.ToList();

		var draft = new RunningDiagramDraft(snapshot, STATUS_setting_stage, _currentEditIndex);
		_draftStore[id] = draft;
	}

	private void ClearDraft()
	{
		ClearDraft(skipSave: false);
	}

	private void ClearDraft(bool skipSave)
	{
		if (currentCardInfo?.ID is not string id || string.IsNullOrWhiteSpace(id))
		{
			return;
		}

		_draftStore.Remove(id);
		if (skipSave)
		{
			_skipDraftSave = true;
			currentEdit_LINK_STATUS_pair_ref = null;
			_currentEditIndex = null;
		}
	}

	public void Dispose()
	{
		SaveDraft();
	}

	private sealed record RunningDiagramDraft(List<LINK_STATUS_Pair> StatusPairs, STATUS_SETTING_STAGE Stage, int? EditingIndex);
}
