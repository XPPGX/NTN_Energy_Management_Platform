@namespace demoVer.Shared
@inherits LayoutComponentBase
@implements IDisposable

@using demoVer.Models
@using demoVer.Utils
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@using MudBlazor
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Text.Json
@using System.Threading.Tasks
@using System.IO

@inject IJSRuntime JS
@inject GlobalVar globalVar
@inject HeartbeatService Heartbeat
@inject IStringLocalizer<SharedResource> Localizer

<div id="edit-container" @onclick="CloseMenu">
    @if (showMenu)
    {
        <div class="custom-menu" style="top:@($"{menuY}px"); left:@($"{menuX}px");" @onclick:stopPropagation="true">
            <div class="custom-menu-item" @onclick="Edit_inCorrespondingStage">@Localizer["ChartCardEdit-Edit"]</div>
            <div class="custom-menu-item" @onclick="Delete_inCorrespondingStage">@Localizer["ChartCardEdit-Delete"]</div>
        </div>
    }

    @if (ConfirmDialog)
    {
        <div id="confirmDialog" class="custom-dialog-overlay">
            <div class="custom-dialog">
                <div class="custom-dialog-content">
                    <div class="icon-container">⚠️</div>
                    <p id="dialogMessage" class="dialog-message">@AlertMessage</p>
                </div>
                <div class="custom-dialog-actions">
                    <button class="btn btn-neutral" @onclick="Cancel">@Localizer["Common-Cancel"]</button>
                    <button class="btn btn-green" @onclick="Confirm">@Localizer["Common-Confirm"]</button>
                </div>
            </div>
        </div>
    }

    @switch (CHART_setting_stage)
    {
        case CHART_SETTING_STAGE.SELECT_MACHINE_CMD:
            <div class="chart-machine-cmd-setting">
                <h3>@Localizer["ChartCardEdit-SelectDeviceAndCommand"]</h3>
                <div class="chartForm">
                    <div class="chart-selector-panel">
                        <div class="chart-selector-grid">
                            @if (string.IsNullOrEmpty(selectedSubsystemKey))
                            {
                                <div class="custom-select-wrapper">
                                    <label style="color: var(--text-primary);">@Localizer["ChartCardEdit-Subsystem"]</label>
                                    <div class="card-table subsystem-selection-panel" style="width: 100%; max-height: 240px; overflow-y: auto;">
                                        @if (subsystemOptions.Count == 0)
                                        {
                                            <div class="card-table-row subsystem-selection-item">
                                                <div class="card-table-item">
                                                    <span class="card-table-label">@Localizer["ChartCardEdit-NoSubsystemsAvailable"]</span>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            @foreach (var subsystem in subsystemOptions)
                                            {
                                                var key = BuildSubsystemKey(subsystem.Port, subsystem.Protocol);
                                                var display = GetSubsystemDisplayName(subsystem);
                                                <div class="card-table-row subsystem-selection-item @(string.Equals(selectedSubsystemKey, key, StringComparison.Ordinal) ? "selected" : string.Empty)"
                                                     @onclick="() => OnSubsystemChosen(subsystem)"
                                                     style="cursor: pointer;">
                                                    <div class="card-table-item">
                                                        <span class="card-table-label">@subsystem.Port</span>
                                                        <span class="card-table-value">@display</span>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="custom-select-wrapper">
                                    <label for="chartMachineSelect" style="color: var(--text-primary);">@Localizer["ChartCardEdit-Machine"]</label>
                                    <select id="chartMachineSelect"
                                            class="custom-select"
                                            @onchange="MachineChanged">
                                        <option value="9999">@Localizer["ChartCardEdit-PleaseSelectMachine"]</option>
                                        @foreach (var (port, protocol, realAddr, storingAddr) in port_protocol_realAddr_storingAddr_List)
                                        {
                                            string displayName = $"{port, -5} ({realAddr, 3})";
                                            string optionVal = $"{port}|{protocol}|{storingAddr}";
                                            <option value="@optionVal">@displayName</option>  
                                        }
                                        @* @foreach (var (addr, mdlName) in deviceAddr_List)
                                        {
                                            //addr 是存取記憶體時用的，顯示於UI時，是用port + realAddr
                                            var (port, realAddr) = globalVar.Get_Port_RealAddr_ByAddr(addr);
                                            string displayName = $"{port, -5} ({realAddr, 3}) → {mdlName}";
                                            <option value="@addr">@displayName</option>
                                        } *@
                                    </select>
                                </div>

                                <div class="custom-select-wrapper">
                                    <label for="chartCmdSelect" style="color: var(--text-primary);">@Localizer["ChartCardEdit-CMD"]</label>
                                    <select id="chartCmdSelect"
                                            class="custom-select"
                                            @onchange="ChartCmdChanged"
                                            disabled="@(show_cmd_unit_Dict_ref?.Any() != true)">
                                        <option value="">@Localizer["ChartCardEdit-PleaseSelectCommand"]</option>
                                        @foreach (var (cmd, unit) in show_cmd_unit_Dict_ref ?? Enumerable.Empty<KeyValuePair<string, string>>())
                                        {
                                            <option value="@cmd">@cmd</option>
                                        }
                                    </select>
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(chartMachineCmdError))
                        {
                            <div class="chart-step-error">@chartMachineCmdError</div>
                        }

                        <div class="chart-stepper-actions">
                            <button class="btn btn-add no-flex"
                                    type="button"
                                    @onclick="ProceedToDisplaySetting">
                                @Localizer["ChartCardEdit-Next"]
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            break;

        case CHART_SETTING_STAGE.OVERVIEW:
            <h5>@Localizer["ChartCardEdit-EditChart"]</h5>
            <div class="input-container">
                <label for="tempChartTitle" class="input-label">@Localizer["ChartCardEdit-ChartTitle"]</label>
                <input id="tempChartTitle" type="text" class="input" @bind="temp_chartTitle" required placeholder="@Localizer["ChartCardEdit-EnterChartTitle"]" />
            </div>

            @for (int i = 0; i < edit_ChartSetting_Clone.chart_single_data_lines.Count; i++)
            {
                var index = i;
                var temp = edit_ChartSetting_Clone.chart_single_data_lines[i];

                var (port, realAddr) = globalVar.Get_Port_RealAddr_ByAddr(temp.addr);
                string displayName = $"{port, -5} ({realAddr, 3}) → {temp.mdlName}";
                var addr_mdlName_str = displayName;
                var hint_cmd = temp.status switch
                {
                    SettingStatus.YET => Localizer["ChartCardEdit-PleaseClickCard"],
                    SettingStatus.PROGRESS => Localizer["ChartCardEdit-IncompletePleaseClickCard"],
                    SettingStatus.DONE => $"{temp.Cmd}({temp.Unit})",
                    _ => string.Empty
                };
                var hint = temp.Y_axis_selection == true
                    ? edit_ChartSetting_Clone.Y_left_Title
                    : edit_ChartSetting_Clone.Y_right_Title;
                var hint_axis = temp.Y_axis_selection == true ? Localizer["ChartCardEdit-Left"] : Localizer["ChartCardEdit-Right"];
                var hint_color = string.IsNullOrEmpty(temp.color) ? "#000000" : temp.color;
                <div class="detail-card" @onclick="() => OnLineClick(index, temp)">
                    <div class="detail-card-header">
                        <span class="detail-card-title">@Localizer["ChartCardEdit-Line"] @(index + 1)</span>
                        <button type="button"
                                class="detail-card-action"
                                @onclick="() => DeleteCurve(temp)"
                                @onclick:stopPropagation="true">
                            @Localizer["ChartCardEdit-Delete"]
                        </button>
                    </div>
                    <div class="detail-card-body">
                        <div class="detail-card-row">
                            <span class="detail-card-label">@Localizer["ChartCardEdit-Device"]:</span>
                            <span class="detail-card-value">@(string.IsNullOrEmpty(addr_mdlName_str) ? Localizer["ChartCardEdit-NotSet"] : addr_mdlName_str)</span>
                        </div>
                        <div class="detail-card-row">
                            <span class="detail-card-label">@Localizer["ChartCardEdit-Command"]:</span>
                            <span class="detail-card-value">@hint_cmd</span>
                        </div>
                        <div class="detail-card-row">
                            <span class="detail-card-label">@Localizer["ChartCardEdit-YAxisTitle"]:</span>
                            <span class="detail-card-value">@hint</span>
                        </div>
                        <div class="detail-card-row">
                            <span class="detail-card-label">@Localizer["ChartCardEdit-ReferenceAxis"]:</span>
                            <span class="detail-card-value">@hint_axis</span>
                        </div>
                        <div class="detail-card-row detail-card-row-color">
                            <span class="detail-card-label">@Localizer["ChartCardEdit-Color"]:</span>
                            <span class="detail-card-value">
                                <span class="detail-card-color" style="background-color:@hint_color;"></span>
                            </span>
                        </div>
                    </div>
                </div>
            }

            <div class="confirm-cancel-container">
                <button class="btn btn-add no-flex" style="width: 120px;"
                        type="button"
                        @onclick="Add_Curve">
                    @Localizer["ChartCardEdit-Add"]
                </button>
                <button class="btn btn-green no-flex" style="width: 120px;"
                        type="button"
                        @onclick="Confirm_CurveSetting">
                    @Localizer["Common-Confirm"]
                </button>
            </div>
            break;

        case CHART_SETTING_STAGE.DISPLAY_SETTING:
            <div class="chart-display-setting">
                <h3>@Localizer["ChartCardEdit-DisplaySettings"]</h3>
                <div class="chartForm">
                    @{ string paper_style = isMobile ? string.Empty : "width: 400px; max-height: 400px;"; }
                    <div class="chart-display-card" style="@paper_style">
                        <form class="custom-form">
                            <div class="form-group">
                                <label for="yTitleInput" class="form-label">@Localizer["ChartCardEdit-YTitle"]</label>
                                <input type="text" id="yTitleInput" class="form-input" @bind="temp_Y_singleTitle" required />
                                @if (!string.IsNullOrEmpty(yTitleError))
                                {
                                    <div class="error-text">@yTitleError</div>
                                }
                            </div>
                            <div class="form-group">
                                <label class="form-label">@Localizer["ChartCardEdit-YAxis"]</label>
                                <div class="radio-group" @onchange:stopPropagation="true" @onclick:stopPropagation="true">
                                    <label class="radio-option">
                                        <input type="radio"
                                               name="yAxis"
                                               value="true"
                                               @onchange="YAxisChanged"
                                               checked="@(blank_singleDataLine.Y_axis_selection == true)" />
                                        <span class="radio-label">@Localizer["ChartCardEdit-LeftAxis"]</span>
                                    </label>
                                    <label class="radio-option">
                                        <input type="radio"
                                               name="yAxis"
                                               value="false"
                                               @onchange="YAxisChanged"
                                               checked="@(blank_singleDataLine.Y_axis_selection == false)" />
                                        <span class="radio-label">@Localizer["ChartCardEdit-RightAxis"]</span>
                                    </label>
                                </div>
                                @if (!string.IsNullOrEmpty(yAxisError))
                                {
                                    <div class="error-text">@yAxisError</div>
                                }
                            </div>
                            <div class="form-group">
                                <label for="colorPicker" class="form-label">@Localizer["ChartCardEdit-DataColor"]</label>
                                <input type="color" id="colorPicker" class="form-input color-input" @bind="blank_singleDataLine.color" style="@($"color: {blank_singleDataLine.color};")" required />
                                @if (!string.IsNullOrEmpty(colorError))
                                {
                                    <div class="error-text">@colorError</div>
                                }
                            </div>
                            <button type="button" class="btn btn-add ml-auto" @onclick="Confirm_SingleDataLine_setting">@Localizer["Common-Confirm"]</button>
                        </form>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(chartForm_errorMessage))
                {
                    <div class="error-text mt-2">@chartForm_errorMessage</div>
                }
            </div>
            break;

        case CHART_SETTING_STAGE.SELECT_CMD_STAGE:
            <MudPaper Elevation="2" Class="pa-2 rounded" Style="width: 200px; max-height: 240px; overflow-y: auto;">
                <MudList T="string" Dense="true" Hover="true">
                    @foreach (var item in show_cmd_unit_Dict_ref ?? Enumerable.Empty<KeyValuePair<string, string>>())
                    {
                        <MudListItem T="string"
                                     @onclick="() => clickCmd_CHART(item.Key)"
                                     Style="cursor: pointer;">
                            <MudIcon Icon="@Icons.Material.Filled.Code" Class="mr-2" />
                            <MudText>@item.Key</MudText>
                        </MudListItem>
                    }
                </MudList>
            </MudPaper>
            break;

        case CHART_SETTING_STAGE.UNIT_SELECTION_STAGE:
            <MudPaper Elevation="2" Class="pa-2 rounded" Style="width: 200px; max-height: 240px; overflow-y: auto;">
                <MudList T="string" Dense="true" Hover="true">
                    @foreach (var unit in UnitLists)
                    {
                        <MudListItem T="string"
                                     @onclick="() => clickUnit_CHART(unit)"
                                     Style="cursor: pointer;">
                            <MudIcon Icon="@Icons.Material.Filled.Sensors" Class="mr-2" />
                            <MudText>@unit</MudText>
                        </MudListItem>
                    }
                </MudList>
            </MudPaper>
            break;
    }
</div>

@code {
    [Parameter] public CardInfo currentCardInfo { get; set; } = default!;
    [Parameter] public EventCallback<CardInfo> OnCardInfoUpdated { get; set; }

    private string _category = string.Empty;
    private DotNetObjectReference<ChartCardEdit>? objRef;
    private bool _isFirstParameterSet = true;
    private int HeartBeatCounter = 0;
    private bool isMobile = false;

    private bool showMenu = false;
    private double menuX;
    private double menuY;

    private bool ConfirmDialog = false;
    private string AlertMessage = string.Empty;
    private bool disableConfirmButton = false;
    private Action? ConfirmCallback;

    private List<(string, string, uint, uint)> port_protocol_realAddr_storingAddr_List = new();
    private List<(uint, string)> deviceAddr_List = new();
    private Dictionary<string, string> oneDevice_cmd_unit_Dict = new();
    private Dictionary<string, string> Summary_cmd_unit_Dict = new();
    private Dictionary<string, string>? show_cmd_unit_Dict_ref;
    private List<string> UnitLists = new();

    private List<SubSystem> subsystemOptions = new();
    private Dictionary<string, List<(string Port, string Protocol, uint RealAddr, uint StoringAddr)>> subsystemDeviceMap = new();
    private string? selectedSubsystemKey;

    private static readonly Dictionary<string, ChartCardDraftState> _draftStore = new(StringComparer.Ordinal);
    private ChartCardDraftState? _pendingDraft;

    private CHART_SETTING_STAGE CHART_setting_stage = CHART_SETTING_STAGE.OVERVIEW;
    private CHART_SETTING edit_ChartSetting_Clone = new();
    private CHART_SINGLE_DATA_LINE blank_singleDataLine = new();
    private int SingleLine_index = 0;
    private string temp_Y_singleTitle = string.Empty;
    private string temp_chartTitle = string.Empty;
    private string chartForm_errorMessage = string.Empty;
    private string chartMachineCmdError = string.Empty;
    private string yTitleError = string.Empty;
    private string yAxisError = string.Empty;
    private string colorError = string.Empty;

    private uint currentSelected_Addr = 9999;
    private uint chartNowSelectedAddr = 9999;
    private string currentSelected_Port = string.Empty;
    private string currentSelected_Protocol = string.Empty;
    private string chartNowSelectedCMD = string.Empty;

    protected override void OnInitialized()
    {
        _category = GetType().FullName ?? nameof(ChartCardEdit);
        AppLogger.Log_To_File_log(_category, "[ChartCardEdit][OnInitialized] Enter OnInitialized", AppLogLevel.Trace);
        Heartbeat.OnTick += OnHeartbeatTick;
        InitSummaryCMDs();
        refreshSubsystemOptions();
        refreshDevicesList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("registerGroupedTableTouchAndRightClick", "edit-container", objRef);
            isMobile = await JS.InvokeAsync<bool>("checkIsMobile");
        }
    }

    protected override void OnParametersSet()
    {
        if (currentCardInfo is null)
        {
            return;
        }

        if (_isFirstParameterSet)
        {
            _isFirstParameterSet = false;
            InitializeFromCurrentCard();
        }
    }

    private async Task OnHeartbeatTick()
    {
        if (HeartBeatCounter == 0)
        {
            refreshSubsystemOptions();
            refreshDevicesList();
        }

        HeartBeatCounter = (HeartBeatCounter + 1) % 3;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SaveDraft();
        Heartbeat.OnTick -= OnHeartbeatTick;
        objRef?.Dispose();
    }

    private void refreshDevicesList()
    {
        try
        {
            var tempList = globalVar.GetAllSubSys_PortAddrPair_InList_FromSubSysManager();
            subsystemDeviceMap.Clear();
            foreach (var (port, protocol, realAddr, storingAddr) in tempList ?? new List<(string, string, uint, uint)>())
            {
                var key = BuildSubsystemKey(port, protocol);
                if (!subsystemDeviceMap.TryGetValue(key, out var list))
                {
                    list = new List<(string Port, string Protocol, uint RealAddr, uint StoringAddr)>();
                    subsystemDeviceMap[key] = list;
                }
                list.Add((port, protocol, realAddr, storingAddr));
            }

            if (!string.IsNullOrEmpty(selectedSubsystemKey))
            {
                PrepareDevicesForSelectedSubsystem();
            }
            else
            {
                port_protocol_realAddr_storingAddr_List = new List<(string, string, uint, uint)>();
            }
        }
        catch (Exception e)
        {
            AppLogger.Log_To_File_log(_category, $"[ChartCardEdit][refreshDevicesList] Error : {e}", AppLogLevel.Error);
        }
    }

    private void refreshSubsystemOptions()
    {
        try
        {
            var snapshot = globalVar.GetSubSystemsSnapshot();
            subsystemOptions = snapshot?.ToList() ?? new List<SubSystem>();

            if (!string.IsNullOrEmpty(selectedSubsystemKey))
            {
                bool stillExists = subsystemOptions.Any(subsys => string.Equals(BuildSubsystemKey(subsys.Port, subsys.Protocol), selectedSubsystemKey, StringComparison.Ordinal));
                if (!stillExists)
                {
                    selectedSubsystemKey = null;
                    port_protocol_realAddr_storingAddr_List = new List<(string, string, uint, uint)>();
                    currentSelected_Port = string.Empty;
                    currentSelected_Protocol = string.Empty;
                }
            }
        }
        catch (Exception e)
        {
            AppLogger.Log_To_File_log(_category, $"[ChartCardEdit][refreshSubsystemOptions] Error : {e}", AppLogLevel.Error);
        }
    }

    private static string BuildSubsystemKey(string port, string protocol) => $"{port}|{protocol}";

    private static string GetSubsystemDisplayName(SubSystem subsystem)
    {
        var protocolWithoutSubName = Path.GetFileNameWithoutExtension(subsystem.Protocol);
        return protocolWithoutSubName;
    }

    private void PrepareDevicesForSelectedSubsystem()
    {
        if (string.IsNullOrEmpty(selectedSubsystemKey))
        {
            port_protocol_realAddr_storingAddr_List = new List<(string, string, uint, uint)>();
            return;
        }

        if (subsystemDeviceMap.TryGetValue(selectedSubsystemKey, out var devices))
        {
            port_protocol_realAddr_storingAddr_List = devices
                .Select(d => (d.Port, d.Protocol, d.RealAddr, d.StoringAddr))
                .ToList();
        }
        else
        {
            port_protocol_realAddr_storingAddr_List = new List<(string, string, uint, uint)>();
        }
    }

    private void OnSubsystemChosen(SubSystem subsystem)
    {
        var newKey = BuildSubsystemKey(subsystem.Port, subsystem.Protocol);
        bool isDifferent = !string.Equals(selectedSubsystemKey, newKey, StringComparison.Ordinal);
        selectedSubsystemKey = newKey;
        currentSelected_Port = subsystem.Port;
        currentSelected_Protocol = subsystem.Protocol;
        if (isDifferent)
        {
            blank_singleDataLine.addr = 9999;
            blank_singleDataLine.Cmd = string.Empty;
            blank_singleDataLine.Unit = string.Empty;
            currentSelected_Addr = 9999;
        }
        PrepareDevicesForSelectedSubsystem();
        CHART_setting_stage = CHART_SETTING_STAGE.SELECT_MACHINE_CMD;
    }

    private void CloseMenu()
    {
        if (!showMenu)
        {
            return;
        }

        showMenu = false;
    }

    [JSInvokable]
    public void OnShowContextMenu(string table, int index, double x, double y)
    {
        menuX = x;
        menuY = y;
        showMenu = true;

        if (index >= 0 && index < edit_ChartSetting_Clone.chart_single_data_lines.Count)
        {
            SingleLine_index = index;
        }

        InvokeAsync(StateHasChanged);
    }

    private void Edit_inCorrespondingStage()
    {
        showMenu = false;
        BeginChartEditing();
    }

    private void Delete_inCorrespondingStage()
    {
        showMenu = false;
        ShowDialog(Localizer["ChartCardEdit-ConfirmDelete"], DeleteAction_In_CHART_OVERVIEW_STAGE);
    }

    private void ShowDialog(string message, Action confirmAction)
    {
        AlertMessage = message;
        ConfirmCallback = confirmAction;
        disableConfirmButton = false;
        ConfirmDialog = true;
    }

    private void Confirm()
    {
        if (disableConfirmButton)
        {
            return;
        }

        disableConfirmButton = true;
        ConfirmDialog = false;
        ConfirmCallback?.Invoke();
    }

    private void Cancel()
    {
        ConfirmDialog = false;
        disableConfirmButton = false;
    }

    private void BeginChartEditing()
    {
        if (SingleLine_index < 0 || SingleLine_index >= edit_ChartSetting_Clone.chart_single_data_lines.Count)
        {
            return;
        }

        var target = edit_ChartSetting_Clone.chart_single_data_lines[SingleLine_index];

        blank_singleDataLine = new CHART_SINGLE_DATA_LINE
        {
            status = target.status,
            addr = target.addr,
            mdlName = target.mdlName,
            Cmd = target.Cmd ?? string.Empty,
            Unit = target.Unit ?? string.Empty,
            Y_axis_selection = target.Y_axis_selection,
            color = target.color ?? "#000000",
            Data = target.Data?.ToArray() ?? Array.Empty<double?>()
        };

        currentSelected_Addr = target.addr;
        chartNowSelectedAddr = target.addr;
        chartNowSelectedCMD = target.Cmd ?? string.Empty;

        temp_chartTitle = edit_ChartSetting_Clone.ChartTitle ?? string.Empty;

        if (target.Y_axis_selection == true)
        {
            temp_Y_singleTitle = edit_ChartSetting_Clone.Y_left_Title ?? string.Empty;
        }
        else if (target.Y_axis_selection == false)
        {
            temp_Y_singleTitle = edit_ChartSetting_Clone.Y_right_Title ?? string.Empty;
        }
        else
        {
            temp_Y_singleTitle = string.Empty;
        }

        chartForm_errorMessage = string.Empty;
        chartMachineCmdError = string.Empty;
        yTitleError = string.Empty;
        yAxisError = string.Empty;
        colorError = string.Empty;

        if (currentSelected_Addr <= 256)
        {
            if (!getCMDs())
            {
                chartMachineCmdError = Localizer["ChartCardEdit-NoAvailableCommands"];
            }
        }
        else
        {
            show_cmd_unit_Dict_ref = null;
        }

        CHART_setting_stage = CHART_SETTING_STAGE.SELECT_MACHINE_CMD;
        ApplyPendingDraftIfAvailable();
    }

    private void InitSummaryCMDs()
    {
        Summary_cmd_unit_Dict["Number of INV"] = "Unit";
        Summary_cmd_unit_Dict["Input Voltage"] = "VAC";
        Summary_cmd_unit_Dict["Output Voltage"] = "VAC";
    }

    private bool getCMDs()
    {
        try
        {
            if (currentSelected_Addr == 256)
            {
                show_cmd_unit_Dict_ref = Summary_cmd_unit_Dict;
            }
            else if (currentSelected_Addr < 256)
            {
                AppLogger.Log_To_File_log(_category, $"[ChartCardEdit][getCMDs] Get CMDs for Addr: {currentSelected_Addr}", AppLogLevel.Trace);
                var tmpCmdUnitDict = globalVar.Get_CmdUnit_Dict_FromSubsysManager_ForChart(currentSelected_Port, currentSelected_Protocol);
                if(tmpCmdUnitDict is null || tmpCmdUnitDict.Count == 0)
                {
                    Console.WriteLine($"[ChartCardEdit][getCMDs] No CMDs found for Addr: {currentSelected_Addr}, Port: {currentSelected_Port}, Protocol: {currentSelected_Protocol}");
                    // AppLogger.Log_To_File_log(_category, $"[ChartCardEdit][getCMDs] No CMDs found for Addr: {currentSelected_Addr}, Port: {currentSelected_Port}, Protocol: {currentSelected_Protocol}", AppLogLevel.Information);
                }

                show_cmd_unit_Dict_ref = tmpCmdUnitDict ?? new Dictionary<string, string>();
                //印出取得的CMD列表
                // foreach (var cmd in show_cmd_unit_Dict_ref)
                // {
                //     Console.WriteLine($"[ChartCardEdit][getCMDs] CMD: {cmd.Key}, Unit: {cmd.Value}");
                // }
            }
            else
            {
                AppLogger.Log_To_File_log(_category, $"[ChartCardEdit][getCMDs] Got wrong addr : {currentSelected_Addr}", AppLogLevel.Information);
                return false;
            }

            return true;
        }
        catch (Exception e)
        {
            Console.WriteLine($"[ChartCardEdit][getCMDs] Error : {e}");
            @* AppLogger.Log_To_File_log(_category, $"[ChartCardEdit][getCMDs] Error : {e}", AppLogLevel.Error); *@
            return false;
        }
    }

    

    private void ResetSelection()
    {
        currentSelected_Addr = 9999;
        currentSelected_Port = string.Empty;
        currentSelected_Protocol = string.Empty;
        show_cmd_unit_Dict_ref = null;
    }

    private void MachineChanged(ChangeEventArgs e)
    {
        @* string optionVal = $"{port}|{protocol}|{storingAddr}"; *@
        chartMachineCmdError = string.Empty;
        
        string valueStr = e.Value?.ToString() ?? string.Empty;
        if(string.IsNullOrEmpty(valueStr))
        {
            ResetSelection();
            return;
        }

        var parts = valueStr.Split('|');
        if(parts.Length < 3)
        {
            ResetSelection();
            return;
        }

        currentSelected_Port = parts[0];
        currentSelected_Protocol = parts[1];
        string storingAddr_str = parts[2];
        if(uint.TryParse(storingAddr_str, out var storingAddr_uint))
        {
            blank_singleDataLine.addr = storingAddr_uint;
        }
        else
        {
            blank_singleDataLine.addr = 9999;
        }

        blank_singleDataLine.Cmd = string.Empty;
        blank_singleDataLine.Unit = string.Empty;

        show_cmd_unit_Dict_ref = null;

        if (blank_singleDataLine.addr < 256)
        {
            @* var deviceInfo = deviceAddr_List.FirstOrDefault(x => x.Item1 == blank_singleDataLine.addr); *@
            @* blank_singleDataLine.mdlName = deviceInfo.Item2 ?? string.Empty; *@
            
            blank_singleDataLine.mdlName = string.Empty;
            currentSelected_Addr = blank_singleDataLine.addr;

            Console.WriteLine($"[ChartCardEdit][MachineChanged] Try to get CMDs");
            if (!getCMDs())
            {
                chartMachineCmdError = Localizer["ChartCardEdit-NoAvailableCommands"];
            }
        }
        else if (blank_singleDataLine.addr == 256)
        {
            currentSelected_Addr = blank_singleDataLine.addr;
            if (!getCMDs())
            {
                chartMachineCmdError = Localizer["ChartCardEdit-NoAvailableCommands"];
            }
        }
        else
        {
            Console.WriteLine($"[ChartCardEdit][MachineChanged] exit MachineChanged");
            blank_singleDataLine.mdlName = string.Empty;
        }

        AppLogger.Log_To_File_log(_category, $"[ChartCardEdit][MachineChanged] blank_singleDataLine.addr = {blank_singleDataLine.addr}, blank_singleDataLine.mdlName = {blank_singleDataLine.mdlName}", AppLogLevel.Trace);
    }

    private void ChartCmdChanged(ChangeEventArgs e)
    {
        chartMachineCmdError = string.Empty;

        if (show_cmd_unit_Dict_ref is null)
        {
            blank_singleDataLine.Cmd = string.Empty;
            blank_singleDataLine.Unit = string.Empty;
            return;
        }

        var selectedCmd = e.Value?.ToString() ?? string.Empty;
        blank_singleDataLine.Cmd = selectedCmd;
        blank_singleDataLine.Unit = string.Empty;

        if (string.IsNullOrEmpty(blank_singleDataLine.Cmd))
        {
            return;
        }

        if (show_cmd_unit_Dict_ref.TryGetValue(blank_singleDataLine.Cmd, out var unit))
        {
            blank_singleDataLine.Unit = unit;
            Console.WriteLine($"[ChartCardEdit][ChartCmdChanged] : Cmd = {blank_singleDataLine.Cmd}, Unit = {blank_singleDataLine.Unit}");
        }
        else
        {
            chartMachineCmdError = Localizer["ChartCardEdit-CommandInfoNotFound"];
        }
    }

    private void ProceedToDisplaySetting()
    {
        chartMachineCmdError = string.Empty;

        if (blank_singleDataLine.addr == 9999)
        {
            chartMachineCmdError = Localizer["ChartCardEdit-PleaseSelectMachineFirst"];
            return;
        }

        currentSelected_Addr = blank_singleDataLine.addr;

        if (show_cmd_unit_Dict_ref is null || show_cmd_unit_Dict_ref.Count == 0)
        {
            chartMachineCmdError = Localizer["ChartCardEdit-NoSelectableCommands"];
            return;
        }

        if (string.IsNullOrWhiteSpace(blank_singleDataLine.Cmd))
        {
            chartMachineCmdError = Localizer["ChartCardEdit-PleaseSelectCommandFirst"];
            return;
        }

        if (!show_cmd_unit_Dict_ref.TryGetValue(blank_singleDataLine.Cmd, out var unit))
        {
            chartMachineCmdError = Localizer["ChartCardEdit-CommandInfoNotFound"];
            return;
        }

        blank_singleDataLine.Unit = unit;
        CHART_setting_stage = CHART_SETTING_STAGE.DISPLAY_SETTING;
    }

    private void OnLineClick(int index, CHART_SINGLE_DATA_LINE temp)
    {
        SingleLine_index = index;
        if (TryRestoreDraft(out var draft))
        {
            if (draft.SingleLineIndex == index)
            {
                _pendingDraft = draft;
            }
            else
            {
                ClearDraft();
            }
        }
        else
        {
            _pendingDraft = null;
        }

        Edit_inCorrespondingStage();
    }

    private void DeleteCurve(CHART_SINGLE_DATA_LINE line)
    {
        if (edit_ChartSetting_Clone.chart_single_data_lines.Contains(line))
        {
            edit_ChartSetting_Clone.chart_single_data_lines.Remove(line);
        }
    }

    private void DeleteAction_In_CHART_OVERVIEW_STAGE()
    {
        if (SingleLine_index >= 0 && SingleLine_index < edit_ChartSetting_Clone.chart_single_data_lines.Count)
        {
            edit_ChartSetting_Clone.chart_single_data_lines.RemoveAt(SingleLine_index);
        }
    }

    private void Add_Curve()
    {
        if (edit_ChartSetting_Clone.chart_single_data_lines.Count >= 2)
        {
            return;
        }

        edit_ChartSetting_Clone.chart_single_data_lines.Add(new CHART_SINGLE_DATA_LINE
        {
            addr = 9999,
            mdlName = string.Empty,
            Cmd = string.Empty,
            Unit = string.Empty,
            Y_axis_selection = true,
            color = string.Empty,
            Data = Array.Empty<double?>(),
            status = SettingStatus.YET
        });
    }

