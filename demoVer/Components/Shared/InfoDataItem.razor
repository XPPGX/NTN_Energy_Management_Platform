@namespace demoVer.Shared
@inherits LayoutComponentBase
<div class="overview-inner-card">
    <div class="smallIcon">
        <img src="@IconPath" style="width:48px; height:48px" />
    </div>
    <div class="overview-inner-card rightPart">
        @foreach(var cell in Cells)
        {
            @* var ADDR = cell.addr?.ToString() ?? ""; *@
            <div class="overview-inner-card valueBlock">
                <div>@cell.UserSettingName</div>
                <div>@cell.Label</div>
                <div>:</div>
                <div>@(cell.Value ?? "--")</div> 
                <div>@cell.Unit</div>
            </div>
        }
    </div>
</div>

@code
{
    public record InfoCell(string UserSettingName, uint? addr, string Label, string? Value, string Unit);

    [Parameter] public string IconPath {get; set;}
    [Parameter] public List<InfoCell> Cells {get; set;} = new();

    protected override void OnInitialized()
    {
        Console.WriteLine("InfoDataItem loaded!");
    }
}