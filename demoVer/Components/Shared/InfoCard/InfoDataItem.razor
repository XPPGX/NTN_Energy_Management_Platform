@namespace demoVer.Shared
@inherits LayoutComponentBase
<div class="overview-inner-card">
    <div class="smallIcon">
        @if(string.Equals(IconPath, "images/square.png", StringComparison.OrdinalIgnoreCase))
        {
            <div class="icon-placeholder"></div>
        }
        else
        {
            <img src="@IconPath" alt="Icon" />
        }
    </div>
    <div class="overview-inner-card rightPart">
        @foreach(var cell in Cells)
        {
            @* var ADDR = cell.addr?.ToString() ?? ""; *@
             <div class="overview-inner-card valueBlock">
                <div class="valueBlock-header">
                    <span class="value-name">@cell.UserSettingName</span>
                    <span class="value-label">@cell.Label</span>
                </div>
                <div class="valueBlock-body">
                    <span class="value-value">@(cell.Value ?? "--")</span>
                    <span class="value-unit">@cell.Unit</span>
                </div>
            </div>
        }
    </div>
</div>

@code
{
    public record InfoCell(string UserSettingName, uint? addr, string Label, string? Value, string Unit);

    [Parameter] public string IconPath {get; set;}
    [Parameter] public List<InfoCell> Cells {get; set;} = new();

    protected override void OnInitialized()
    {
        Console.WriteLine("InfoDataItem loaded!");
    }
}